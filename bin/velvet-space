#!/usr/bin/env python3
"""
VELVET · velvet-space

Where the disk went. Every real filesystem gets a bar that fills in when the
program starts and then holds; the one you are closest to running out of is
called out at the top. Re-reads the numbers every few seconds, because a build
can eat ten gigabytes while you are looking at it.
"""

import os
import shutil
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _velvet import (BOLD, RESET, ease, fg, hbar, mix, run, shade)  # noqa: E402

IGNORE_TYPES = {
    "proc", "sysfs", "devtmpfs", "devpts", "tmpfs", "securityfs", "cgroup",
    "cgroup2", "pstore", "efivarfs", "bpf", "autofs", "mqueue", "hugetlbfs",
    "debugfs", "tracefs", "fusectl", "configfs", "ramfs", "binfmt_misc",
    "squashfs", "overlay", "nsfs", "rpc_pipefs", "fuse.portal", "fuse.gvfsd-fuse",
}

state = {"mounts": [], "at": 0.0, "born": None}


def collect():
    seen = set()
    out = []
    try:
        with open("/proc/mounts", "r", encoding="utf-8") as fh:
            rows = fh.readlines()
    except OSError:
        rows = []

    for row in rows:
        parts = row.split()
        if len(parts) < 3:
            continue
        device, point, kind = parts[0], parts[1].replace("\\040", " "), parts[2]
        if kind in IGNORE_TYPES or not device.startswith("/"):
            continue
        if point in seen:
            continue
        try:
            usage = shutil.disk_usage(point)
        except OSError:
            continue
        if usage.total < 64 * 1024 * 1024:
            continue
        seen.add(point)
        out.append({
            "point": point,
            "device": device.split("/")[-1],
            "kind": kind,
            "used": usage.used,
            "total": usage.total,
            "free": usage.free,
        })

    if not out:
        try:
            usage = shutil.disk_usage("/")
            out.append({"point": "/", "device": "root", "kind": "?",
                        "used": usage.used, "total": usage.total, "free": usage.free})
        except OSError:
            pass

    out.sort(key=lambda m: -m["total"])
    return out


def human(value):
    v = float(value)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if v < 1024 or unit == "TB":
            return "%.1f %s" % (v, unit)
        v /= 1024.0
    return "?"


def draw(scr, t):
    pal = scr.palette
    accent, ink, dim = pal.accent, pal.ink, pal.inkDim

    if state["born"] is None:
        state["born"] = t
    if t - state["at"] > 5.0 or not state["mounts"]:
        state["at"] = t
        state["mounts"] = collect()

    # One slow sweep as the program appears, then it simply holds.
    grow = ease(min(1.0, (t - state["born"]) / 0.9))

    mounts = state["mounts"]
    w = scr.cols
    lines = ["", ""]

    if mounts:
        worst = max(mounts, key=lambda m: m["used"] / max(1, m["total"]))
        pct = worst["used"] / max(1, worst["total"])
        big = "%d%%" % round(pct * 100 * grow)
        label = worst["point"]
        c = mix(accent, pal.accentAlt, 0.0) if pct < 0.85 else mix(accent, (255, 90, 90), 0.7)
        lines.append("  " + fg(c) + BOLD + big + RESET
                     + fg(dim) + "  FULLEST  ·  " + label + "  ·  "
                     + human(worst["free"]) + " FREE" + RESET)
        lines.append("")

    # 2 indent + 17 name + bar + 2 + 9 used + 3 + 9 total = w
    bar_w = max(8, w - 42)
    for m in mounts[:max(1, scr.rows - 8)]:
        frac = (m["used"] / max(1, m["total"])) * grow
        heat = min(1.0, max(0.0, (m["used"] / max(1, m["total"]) - 0.6) / 0.35))
        c = mix(accent, (255, 90, 90), heat)
        name = m["point"]
        if len(name) > 16:
            name = "…" + name[-15:]
        lines.append(
            "  " + fg(ink) + name.ljust(17)
            + fg(c) + hbar(bar_w, frac)
            + fg(dim) + "  " + human(m["used"]).rjust(9) + " / " + human(m["total"]).ljust(9)
            + RESET
        )
        lines.append("  " + fg(shade(dim, 0.55)) + " " * 17
                     + (m["device"] + "  ·  " + m["kind"]).upper() + RESET)

    lines.append("")
    lines.append("  " + fg(shade(dim, 0.7)) + "REFRESHED EVERY FIVE SECONDS  ·  Q TO CLOSE" + RESET)
    return lines[:scr.rows]


if __name__ == "__main__":
    raise SystemExit(run(draw, fps=16, title="velvet-space"))
