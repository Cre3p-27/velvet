    return {"ok": True}


# ── the terminal: the one place a password belongs --------------------------
#  Installs, builds and updates need a tty, and a password prompt belongs in a
#  window the user can see — not inside an assistant's tool call. These tools
#  open that window and hand over. Nothing here ever sees a secret.
TERM_CLASS = "dev.velvet.app"


def term_emulator() -> str:
    """The shell's own choice first (scene.terminal), then whatever is here."""
    forced = ""
    try:
        cfg = read_json(CFG_PATH, {})
        scene = cfg.get("scene") if isinstance(cfg, dict) else {}
        forced = str((scene or {}).get("terminal") or "").strip() if isinstance(scene, dict) else ""
    except Exception:                                          # noqa: BLE001
        forced = ""
    if forced and forced != "auto" and shutil.which(forced):
        return forced
    for candidate in ("kitty", "foot", "ghostty", "wezterm", "alacritty", "konsole", "xfce4-terminal", "xterm"):
        if shutil.which(candidate):
            return candidate
    return ""


def term_line(cmd: str, title: str = "velvet") -> str:
    # One quoted word: "install · spicetify" unquoted made the terminal run "·".
    title = shlex.quote(str(title or "velvet"))
    term = term_emulator()
    if not term:
        return ""
    if term == "kitty":
        return f"kitty --class {TERM_CLASS} --title {title} -e {cmd}"
    if term == "foot":
        return f"foot --app-id={TERM_CLASS} --title={title} -e {cmd}"
    if term == "ghostty":
        return f"ghostty --class={TERM_CLASS} --title={title} -e {cmd}"
    if term == "wezterm":
        return f"wezterm start --class {TERM_CLASS} -- {cmd}"
    if term == "alacritty":
        return f"alacritty --class {TERM_CLASS} --title {title} -e {cmd}"
    if term == "konsole":
        return f"konsole -p tabtitle={title} --hide-menubar -e {cmd}"
    if term == "xfce4-terminal":
        return f"xfce4-terminal --title={title} --disable-server -x {cmd}"
    return f"{term} -title {title} -e {cmd}"


def open_terminal(cmd: str, title: str = "velvet") -> bool:
    line = term_line(cmd, title)
    if not line:
        return False
    # Hyprland 0.56 with a Lua config: the classic `dispatch exec -- <cmd>`
    # answers with a parser error (measured: "error: 3 … ')' expected near
    # 'touch'"), which is why every install ended in "kein Terminal gefunden"
    # and the user heard an apology instead of a password prompt. The window
    # tools already speak the dialect — this one now does too.
    return hctl_dispatch(f"hl.dsp.exec_cmd({lua_str(line)})")


def terminal_job(command: str) -> str:
    """Wrapped for a window that stays open: an installer which closes on its
    first error takes the error message with it. One line, on purpose — a raw
    newline inside a Lua string literal makes Hyprland refuse the dispatch."""
    tail = "; echo; echo 'fertig — Enter schließt'; read -n 1 _"
    return "bash -lc " + shlex.quote(command + tail)


@tool("term.run", '{"command": "paru -S spicetify-cli", "title": "install"}', "write",
      "Open a terminal window and run a command in it. The way to install, build "
      "or update anything — the window keeps the password prompt, the progress "
      "and the errors where the user can see them.")
def t_term_run(command="", title=""):
    line = str(command or "").strip()
    if not line:
        return {"ok": False, "error": "kein Befehl"}
    if not open_terminal(terminal_job(line), str(title or "velvet").strip() or "velvet"):
        return {"ok": False, "error": "kein Terminal gefunden"}
    return {"ok": True, "opened": line, "note": "läuft im Terminalfenster"}


# A command that wants a password cannot run here: there is no one to type it.
# It runs in a terminal window instead, where the user types it themselves —
# that prompt IS the confirmation. Measured (v8.45 history): an update went
# through cmd.run, failed on sudo, and she asked "sag ja" four times in a row.
# (case matters: pacman -S installs, -Qu only lists the updates)
NEEDS_ROOT = re.compile(r"(?:^|[;&|(]\s*|\s)(?:sudo|doas|pkexec|run0)\s"
                        r"|(?:^|[;&|]\s*)(?:pacman\s+-[A-Za-z]*[SRU]|systemctl\s+(?:start|stop|restart|reload|enable|disable|mask|unmask)\b"
                        r"|(?:paru|yay|pikaur|trizen)\s*$|(?:paru|yay|pikaur|trizen)\s+-[A-Za-z]*[SRU])")


def needs_root(command: str) -> bool:
    return bool(NEEDS_ROOT.search(str(command or "")))


# Commands that only LOOK — they cannot change anything — need no spoken yes:
# "wie viele Pakete hab ich" asked "sag ja" first and then "sag ja" again.
# Every part of a pipe must be one of these, with no redirection, no command
# substitution and none of the flags that make a looking tool act.
SAFE_READ = {"pacman", "uname", "df", "free", "uptime", "ls", "cat", "head", "tail", "wc", "grep", "egrep", "sort",
             "uniq", "ps", "pgrep", "ip", "lsblk", "lscpu", "lspci", "lsusb", "nproc", "whoami", "hostname", "date",
             "cal", "du", "echo", "which", "whereis", "file", "stat", "sensors", "journalctl", "systemctl", "hyprctl",
             "fastfetch", "neofetch", "awk", "cut", "tr", "nl", "id", "groups", "locale", "env", "printenv",
             "lsmod", "findmnt", "mount", "swapon", "zramctl", "inxi", "glxinfo", "vulkaninfo", "pactl", "wpctl",
             "playerctl", "nmcli", "bluetoothctl", "upower", "checkupdates", "paru", "yay", "flatpak", "pip", "node",
             "python3", "python", "uptime", "last", "w", "who", "top"}
SAFE_ARGS = {
    "pacman": re.compile(r"^-(?:Q[a-zA-Z]*|Ss|Si|Sl|F[a-zA-Z]*)$"),
    "paru": re.compile(r"^-(?:Q[a-zA-Z]*|Ss|Si|Qua|Qu)$"),
    "yay": re.compile(r"^-(?:Q[a-zA-Z]*|Ss|Si|Qu)$"),
    "systemctl": re.compile(r"^(?:status|is-active|is-enabled|is-failed|list-units|list-unit-files|list-timers|show|--user|--no-pager|-a|--all|--failed|--type=\S+|--state=\S+|[\w@.-]+)$"),
    "hyprctl": re.compile(r"^(?:clients|monitors|workspaces|activewindow|activeworkspace|version|devices|layers|binds|"
                          r"getoption|cursorpos|-j|systeminfo|splash|instances|plugin|list|\S+:\S+)$"),
    "flatpak": re.compile(r"^(?:list|info|--app|--columns=\S+|search)$"),
    "pip": re.compile(r"^(?:list|show|freeze|--version|-V)$"),
    "node": re.compile(r"^(?:--version|-v)$"),
    "python3": re.compile(r"^(?:--version|-V)$"),
    "python": re.compile(r"^(?:--version|-V)$"),
    "nmcli": re.compile(r"^(?:-t|-f|device|connection|general|status|show|radio|dev|con|\S*,\S*|wifi|list)$"),
    "bluetoothctl": re.compile(r"^(?:devices|info|show|paired-devices|list|Connected|Paired|[0-9A-F:]{17})$"),
    "playerctl": re.compile(r"^(?:metadata|status|-l|--list-all|-p|\S+|position|volume)$"),
    "pactl": re.compile(r"^(?:list|info|short|sinks|sources|get-\S+|@\S+@|stat)$"),
    "wpctl": re.compile(r"^(?:status|inspect|get-volume|@\S+@|\d+)$"),
    "top": re.compile(r"^(?:-b|-n|\d+|-bn\d*|-n\d+)$"),
}
NEVER_IN_SAFE = re.compile(r"[<>`]|\$\(|\b(?:-delete|-exec|-execdir|--remove|-i\b|tee|xargs|dd|rm|mv|cp|chmod|chown|kill|pkill)\b")


def safe_readonly(command: str) -> bool:
    line = str(command or "").strip()
    if not line or NEVER_IN_SAFE.search(line) or needs_root(line):
        return False
    for part in re.split(r"\|\|?|&&|;", line):
        words = part.strip().split()
        if not words:
            return False
        exe = os.path.basename(words[0])
        if exe not in SAFE_READ:
            return False
        rule = SAFE_ARGS.get(exe)
        if exe == "systemctl" and not any(w in ("status", "is-active", "is-enabled", "is-failed", "list-units",
                                                "list-unit-files", "list-timers", "show") for w in words[1:]):
            return False
        if exe in ("python3", "python", "node") and len(words) == 1:
            return False
        if rule is not None and not all(rule.match(w) for w in words[1:]):
            return False
    return True


@tool("cmd.run", '{"command": "pacman -Q | wc -l"}', "danger",
      "Run a shell command here and return its output. For anything that needs no "
      "password; needs a spoken confirmation because it can do anything. A command "
      "with sudo opens in a terminal by itself, where the user types the password.")
def t_cmd_run(command=""):
    line = str(command or "").strip()
    if not line:
        return {"ok": False, "error": "kein Befehl"}
    if needs_root(line):
        if not open_terminal(terminal_job(line), "velly · passwort"):
            return {"ok": False, "error": "kein Terminal gefunden"}
        return {"ok": True, "terminal_opened": True, "running": line,
                "note": "braucht dein Passwort — ein Terminalfenster ist offen, dort eingeben"}
    code, out, err = run(["bash", "-lc", line], timeout=90)
    text = (out or err or "").strip()
    if len(text) > 1800:
        text = text[:1800] + " …"
    return {"ok": code == 0, "code": code, "output": text or "(keine Ausgabe)"}


def pkg_helper() -> str:
    for candidate in ("paru", "yay", "pikaur", "trizen"):
        if shutil.which(candidate):
            return candidate
    return ""


@tool("pkg.search", '{"query": "spicetify"}', "read",
      "Search the repositories and the AUR for packages.")
def t_pkg_search(query=""):
    wanted = str(query or "").strip()
    if not wanted:
        return {"ok": False, "error": "wonach soll ich suchen?"}
    code, out, err = run([pkg_helper() or "pacman", "-Ss", wanted], timeout=60)
    hits = []
    for line in (out or "").splitlines():
        if line.strip() and not line.startswith(" "):
            hits.append(line.strip())
        if len(hits) >= 14:
            break
    return {"ok": True, "found": hits,
            "error": "" if hits else ((err or "").strip()[:160] or "nichts gefunden")}


@tool("sys.update", "", "write",
      "Update the whole system: every package, the AUR too. Opens a terminal "
      "window where the user types the password and watches the progress.")
def t_sys_update():
    helper = pkg_helper()
    cmd = f"{helper} -Syu" if helper else "sudo pacman -Syu"
    if not open_terminal(terminal_job(cmd), "system update"):
        return {"ok": False, "error": "kein Terminal gefunden"}
    return {"ok": True, "terminal_opened": True, "running": cmd,
            "note": "das Update läuft im Terminalfenster — dort nur noch Passwort und Ja eingeben"}


@tool("pkg.install", '{"name": "spicetify-cli"}', "write",
      "Install a package from the repositories or the AUR. Opens a terminal "
      "window so the password prompt and the progress stay visible.")
def t_pkg_install(name=""):
    wanted = str(name or "").strip()
    if not wanted:
        return {"ok": False, "error": "welches Paket?"}
    helper = pkg_helper()
    cmd = (f"{helper} -S --needed {shlex.quote(wanted)}" if helper
           else f"sudo pacman -S --needed {shlex.quote(wanted)}")
    if not open_terminal(terminal_job(cmd), f"install · {wanted}"):
        return {"ok": False, "error": "kein Terminal gefunden"}
    # Said as it is: the window is already open — the user only confirms
    # there ("öffne ein Terminal und gib den Befehl ein" was her answer).
    return {"ok": True, "installing": wanted, "terminal_opened": True,
            "note": "ein Terminalfenster ist schon offen und installiert — dort nur noch Passwort und Ja eingeben"}


# ── knowing things: the web, read for an answer ──────────────────────────
#  web.search SHOWS results in the browser; web.lookup READS them, so she can
#  answer "Wer hat die EM gewonnen?" out loud instead of opening a tab.
WEB_UA = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140 Safari/537.36"


def fetch_text(url: str, timeout: float = 8.0) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": WEB_UA, "Accept-Language": "de-DE,de;q=0.9,en;q=0.6"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read(600000).decode("utf-8", "replace")


def strip_html(text: str) -> str:
    import html as _html                                       # noqa: PLC0415
    return re.sub(r"\s+", " ", _html.unescape(re.sub(r"<[^>]+>", "", text or ""))).strip()


# ── one web search, three doors ─────────────────────────────────────────
# DuckDuckGo's HTML page is the first door; it shows a bot challenge when it
# is asked too often (measured — after a handful of quick lookups). A page
# like that is never "solved" here: the search simply goes to the next door.
BOT_WALL = re.compile(r"anomaly|captcha|unfortunately, bots use|are you a robot|unusual traffic", re.I)


def _unwrap(href: str) -> str:
    import html as _html                                       # noqa: PLC0415
    import base64 as _b64                                      # noqa: PLC0415
    href = _html.unescape(href or "")
    qs = urllib.parse.parse_qs(urllib.parse.urlparse(href).query)
    if "uddg" in qs:
        return qs["uddg"][0]
    if "bing.com/ck/a" in href and qs.get("u", [""])[0].startswith("a1"):
        b = qs["u"][0][2:]
        try:
            return _b64.urlsafe_b64decode(b + "=" * (-len(b) % 4)).decode("utf-8", "replace")
        except Exception:                                      # noqa: BLE001
            return href
    return href


def web_results(query: str, limit: int = 5) -> list:
    """[{title, url, snippet}] — DuckDuckGo, then DuckDuckGo Lite, then
    Wikipedia's own search API (which welcomes programs; the general engines
    hand automated requests either a challenge or junk — measured with Bing:
    news front pages for "EM 2024 Sieger")."""
    q = urllib.parse.quote_plus(query)
    doors = (
        ("https://html.duckduckgo.com/html/?q=" + q,
         lambda page: [(m.group(1), m.group(2), (re.search(r'class="result__snippet"[^>]*>(.*?)</a>', blk, re.S) or [None, ""])[1])
                       for blk in re.split(r'<div class="result results_links', page)[1:]
                       for m in [re.search(r'class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>', blk, re.S)] if m]),
        ("https://lite.duckduckgo.com/lite/?q=" + q,
         lambda page: [(m.group(1), m.group(2), "")
                       for m in re.finditer(r"<a[^>]+href=\"([^\"]+)\"[^>]+class='result-link'[^>]*>(.*?)</a>", page, re.S)]),
    )
    for url, parse in doors:
        try:
            page = fetch_text(url, 7)
        except Exception:                                      # noqa: BLE001
            continue
        if BOT_WALL.search(page[:6000]) and "result" not in page[:6000]:
            continue
        out = []
        for href, title, snippet in parse(page):
            real = _unwrap(href)
            if "duckduckgo.com/y.js" in real or not real.startswith("http"):
                continue                                       # ads, internal links
            out.append({"title": strip_html(title)[:120], "url": real, "snippet": strip_html(snippet)[:320]})
            if len(out) >= limit:
                break
        if out:
            return out
    try:
        data = json.loads(fetch_text("https://de.wikipedia.org/w/api.php?action=query&list=search&format=json&srlimit="
                                     f"{limit}&srsearch=" + q, 7))
        return [{"title": hit["title"][:120],
                 "url": "https://de.wikipedia.org/wiki/" + urllib.parse.quote(hit["title"].replace(" ", "_")),
                 "snippet": strip_html(hit.get("snippet") or "")[:320]}
                for hit in (data.get("query") or {}).get("search") or []]
    except Exception:                                          # noqa: BLE001
        return []


def wiki_summary(url: str) -> str:
    match = re.match(r"https?://([a-z]{2,3})\.wikipedia\.org/wiki/([^?#]+)", url or "")
    if not match:
        return ""
    try:
        data = json.loads(fetch_text(f"https://{match.group(1)}.wikipedia.org/api/rest_v1/page/summary/{match.group(2)}", 6))
    except Exception:                                          # noqa: BLE001
        return ""
    return str(data.get("extract") or "")[:900]


@tool("web.lookup", '{"query": "text"}', "read",
      "Look something up on the web and get the facts back to ANSWER from (news, results, people, prices, "
      "definitions, anything current). Answer from the snippets in your own words; web.search only SHOWS a page.")
def t_web_lookup(query=""):
    q = str(query or "").strip()
    if not q:
        return {"ok": False, "error": "wonach soll ich schauen?"}
    try:
        results = web_results(q, 5)
    except Exception as exc:                                   # noqa: BLE001
        return {"ok": False, "error": f"das Netz antwortet gerade nicht ({exc})"[:160]}
    if not results:
        return {"ok": False, "error": "dazu finde ich gerade nichts (oder die Suchdienste blocken kurz)"}
    out = {"ok": True, "query": q, "results": results}
    wiki = next((r["url"] for r in results if "wikipedia.org/wiki/" in r["url"]), "")
    if wiki:
        summary = wiki_summary(wiki)
        if summary:
            out["wikipedia"] = summary
    return out


def page_text(html: str) -> str:
    """The readable part of a page: the article or main block when there is
    one, without scripts, styles, menus and footers."""
    body = re.sub(r"(?is)<(script|style|noscript|svg|nav|header|footer|aside|form|iframe)\b.*?</\1>", " ", html or "")
    body = re.sub(r"(?is)<!--.*?-->", " ", body)
    for tag in ("article", "main"):
        block = re.search(rf"(?is)<{tag}\b[^>]*>(.*?)</{tag}>", body)
        if block and len(strip_html(block.group(1))) > 400:
            body = block.group(1)
            break
    body = re.sub(r"(?i)</(p|div|li|h[1-6]|tr|br)>|<br\s*/?>", "\n", body)
    text = strip_html(body)
    return text


@tool("web.read", '{"url": "https://…"}', "read",
      "Read a web page (a result from web_lookup, a link the user gave) and get its text to answer from.")
def t_web_read(url=""):
    link = str(url or "").strip()
    if link and not re.match(r"^https?://", link, re.I):
        link = "https://" + link
    if not re.match(r"^https?://[^\s/]+\.[^\s]+", link):
        return {"ok": False, "error": "das ist keine Web-Adresse"}
    if "wikipedia.org/wiki/" in link:
        summary = wiki_summary(link)
        if summary:
            return {"ok": True, "url": link, "text": summary}
    try:
        html = fetch_text(link, 8)
    except Exception as exc:                                   # noqa: BLE001
        return {"ok": False, "error": f"die Seite lädt nicht ({exc})"[:160]}
    if BOT_WALL.search(html[:6000]) and len(html) < 20000:
        return {"ok": False, "error": "die Seite lässt keine Programme lesen"}
    title = strip_html((re.search(r"(?is)<title[^>]*>(.*?)</title>", html) or [None, ""])[1])[:120]
    text = page_text(html)
    if len(text) < 80:
        return {"ok": False, "error": "auf der Seite steht kein lesbarer Text"}
    return {"ok": True, "url": link, "title": title, "text": text[:3200] + (" …" if len(text) > 3200 else "")}


# ── writing things down: a file on the disk ──────────────────────────────
@tool("file.write", '{"name": "Einkaufsliste", "text": "…"}', "write",
      "Write a text (a list, a note, a letter, a plan) into a file in ~/Dokumente/Velly and say where it is.")
def t_file_write(name="", text=""):
    body = str(text or "").strip()
    if not body:
        return {"ok": False, "error": "was soll in die Datei?"}
    base = re.sub(r"[^\w äöüÄÖÜß.-]+", "", str(name or "Notiz")).strip(" .") or "Notiz"
    if not re.search(r"\.(md|txt)$", base, re.I):
        base += ".md"
    docs = os.path.join(HOME, "Dokumente") if os.path.isdir(os.path.join(HOME, "Dokumente")) else os.path.join(HOME, "Documents")
    folder = os.path.join(docs, "Velly")
    try:
        os.makedirs(folder, exist_ok=True)
        target = os.path.join(folder, base)
        stem, ext = os.path.splitext(target)
        n = 2
        while os.path.exists(target):
            target = f"{stem} ({n}){ext}"
            n += 1
        with open(target, "w", encoding="utf-8") as fh:
            fh.write(body + "\n")
    except OSError as exc:
        return {"ok": False, "error": str(exc)[:160]}
    return {"ok": True, "file": target, "name": os.path.basename(target)}


# ── time: reminders and timers ─────────────────────────────────────────────
#  A reminder is a detached sleeper, not a daemon of hers: it outlives the
#  session (and a shell restart), then posts a real notification and asks the
#  shell to say it out loud. ai-timers.json lists what is still pending.
TIMERS_PATH = os.path.join(CONF_DIR, "ai-timers.json")


def pending_timers() -> list:
    now = time.time()
    out = []
    for t in read_json(TIMERS_PATH, []) or []:
        if not isinstance(t, dict) or float(t.get("due") or 0) <= now:
            continue
        try:
            os.kill(int(t.get("pid") or 0), 0)
        except (OSError, ValueError):
            continue
        out.append(t)
    return out


@tool("timer.set", '{"minutes": 10.0, "seconds": 0, "at": "07:30", "date": "", "text": "Pizza aus dem Ofen"}', "write",
      "Set a timer or a reminder — in N minutes/seconds, or at a clock time (at) on a day (date: heute, morgen, "
      "a weekday, 24.12.; empty = the next time that clock comes round). It notifies and speaks when due.")
def t_timer_set(minutes=0, seconds=0, at="", text="", date=""):
    import datetime as _dt                                     # noqa: PLC0415
    label = str(text or "").strip() or "Timer"
    now = time.time()
    due = 0.0
    clock = str(at or "").strip()
    if clock:
        # "07:30", "7", "7 Uhr", "morgen 7:30" — the day may ride along.
        bare = re.sub(r"(?i)\s*uhr\b", "", clock).strip()
        match = re.search(r"\b(\d{1,2})[:.h](\d{2})\b", bare) or re.fullmatch(r"\s*(\d{1,2})()\s*", bare) \
            or re.search(r"(?:^|\s)(\d{1,2})()\s*$", bare)
        if not match:
            return {"ok": False, "error": f"die Uhrzeit {clock!r} verstehe ich nicht"}
        hour, minute = int(match.group(1)), int(match.group(2) or 0)
        if hour > 23 or minute > 59:
            return {"ok": False, "error": f"die Uhrzeit {clock!r} gibt es nicht"}
        day = resolve_day(str(date or "")) if str(date or "").strip() else None
        if day is None and re.search(r"[a-zäöü]", bare, re.I):
            day = resolve_day(bare)
        if day is not None:
            target = time.mktime((day.year, day.month, day.day, hour, minute, 0, 0, 0, -1))
            if target <= now:
                return {"ok": False, "error": "dieser Zeitpunkt ist schon vorbei"}
        else:
            stamp = time.localtime(now)
            target = time.mktime((stamp.tm_year, stamp.tm_mon, stamp.tm_mday, hour, minute, 0, 0, 0, -1))
            if target <= now:
                target += 86400
        due = target
    else:
        try:
            delay = float(minutes or 0) * 60 + float(seconds or 0)
        except (TypeError, ValueError):
            return {"ok": False, "error": "wie lange denn?"}
        if delay < 1:
            return {"ok": False, "error": "wie lange denn?"}
        due = now + delay
    delay = max(1, int(round(due - now)))
    if delay > 7 * 86400:
        return {"ok": False, "error": "länger als eine Woche merke ich mir so etwas nicht"}
    say = f"Erinnerung: {label}"
    script = (f"sleep {delay}; "
              f"notify-send -a Velly -u critical -i alarm {shlex.quote('Velly · Erinnerung')} {shlex.quote(label)} 2>/dev/null; "
              f"qs -c velvet ipc call velly remind {shlex.quote(say)} >/dev/null 2>&1")
    try:
        # Its own session and process group, started directly: the `setsid`
        # program forks, and the pid kept here was then a parent that had
        # already left — measured: the list came back empty and cancel could
        # not reach the sleeper.
        proc = subprocess.Popen(["bash", "-c", script], stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError as exc:
        return {"ok": False, "error": f"der Timer ließ sich nicht stellen: {exc}"}
    timers = pending_timers()
    timers.append({"id": (max([int(t.get("id") or 0) for t in timers] or [0]) + 1), "due": due,
                   "text": label, "pid": proc.pid})
    write_json(TIMERS_PATH, timers)
    in_days = (_dt.date.fromtimestamp(due) - _dt.date.today()).days
    return {"ok": True, "text": label, "due": time.strftime("%H:%M", time.localtime(due)),
            "day": days_words(in_days) if in_days < 3 else date_de(time.localtime(due)),
            "in_days": in_days, "in_minutes": round(delay / 60, 1)}


@tool("timer.list", "", "read", "The timers and reminders that are still waiting.")
def t_timer_list():
    return {"ok": True, "timers": [{"id": t["id"], "text": t.get("text"),
                                    "due": time.strftime("%H:%M", time.localtime(float(t["due"])))}
                                   for t in pending_timers()]}


@tool("timer.cancel", '{"id": 1}', "write", "Cancel a waiting timer or reminder by id (from timer.list); id 0 cancels all.")
def t_timer_cancel(id=0):
    timers = pending_timers()
    keep, gone = [], []
    for t in timers:
        if int(id or 0) in (0, int(t.get("id") or 0)):
            try:
                os.killpg(int(t["pid"]), signal.SIGTERM)
            except OSError:
                try:
                    os.kill(int(t["pid"]), signal.SIGTERM)
                except OSError:
                    pass
            gone.append(t.get("text"))
        else:
            keep.append(t)
    write_json(TIMERS_PATH, keep)
    return {"ok": bool(gone), "cancelled": gone, "error": "" if gone else "kein solcher Timer"}


# ── arithmetic: a small model guesses, this computes ──────────────────────
import ast as _ast
import math as _math

CALC_NAMES = {"pi": _math.pi, "e": _math.e, "sqrt": _math.sqrt, "wurzel": _math.sqrt, "sin": _math.sin,
              "cos": _math.cos, "tan": _math.tan, "log": _math.log10, "ln": _math.log, "abs": abs,
              "round": round, "floor": _math.floor, "ceil": _math.ceil}


def calc_value(node):
    if isinstance(node, _ast.Expression):
        return calc_value(node.body)
    if isinstance(node, _ast.Constant) and isinstance(node.value, (int, float)):
        return node.value
    if isinstance(node, _ast.BinOp):
        a, b = calc_value(node.left), calc_value(node.right)
        ops = {_ast.Add: lambda: a + b, _ast.Sub: lambda: a - b, _ast.Mult: lambda: a * b, _ast.Div: lambda: a / b,
               _ast.FloorDiv: lambda: a // b, _ast.Mod: lambda: a % b,
               _ast.Pow: lambda: a ** b if abs(b) <= 1000 else (_ for _ in ()).throw(ValueError("zu groß"))}
        for kind, fn in ops.items():
            if isinstance(node.op, kind):
                return fn()
    if isinstance(node, _ast.UnaryOp) and isinstance(node.op, (_ast.USub, _ast.UAdd)):
        v = calc_value(node.operand)
        return -v if isinstance(node.op, _ast.USub) else v
    if isinstance(node, _ast.Name) and node.id in CALC_NAMES and not callable(CALC_NAMES[node.id]):
        return CALC_NAMES[node.id]
    if isinstance(node, _ast.Call) and isinstance(node.func, _ast.Name) and callable(CALC_NAMES.get(node.func.id)):
        return CALC_NAMES[node.func.id](*[calc_value(a) for a in node.args])
    raise ValueError("das kann ich nicht rechnen")


@tool("calc.eval", '{"expr": "17,5 * 3 + 2^8"}', "read",
      "Compute arithmetic exactly (+ - * / ^ %, sqrt, sin, log, pi, percent). Use it for every calculation.")
def t_calc_eval(expr=""):
    text = str(expr or "").strip()
    if not text:
        return {"ok": False, "error": "was soll ich rechnen?"}
    src = text.lower().replace("×", "*").replace("·", "*").replace("÷", "/").replace("^", "**")
    src = re.sub(r"\bmal\b", "*", src)
    src = re.sub(r"\bgeteilt durch\b|\bdurch\b", "/", src)
    src = re.sub(r"\bplus\b", "+", src)
    src = re.sub(r"\bminus\b", "-", src)
    src = re.sub(r"\bhoch\b", "**", src)
    # Spoken arithmetic: "15 Prozent von 80", "Wurzel aus 144", "12 Quadrat";
    # the unit around a sum ("150 Euro") is not part of it.
    src = re.sub(r"\bprozent\b", "%", src)
    src = re.sub(r"\bwurzel\s+(?:aus|von)\s+(\d+(?:[.,]\d+)?)", r"sqrt(\1)", src)
    src = re.sub(r"(\d+(?:[.,]\d+)?)\s*(?:quadrat|zum quadrat)\b", r"(\1**2)", src)
    src = re.sub(r"(?:€|\$|\beuro\b|\bdollar\b|\bcent\b|\bstück\b|\bkm\b|\bkg\b|\bgramm\b|\bliter\b)", "", src)
    src = re.sub(r"(\d),(\d)", r"\1.\2", src)          # German decimals
    src = re.sub(r"(\d+(?:\.\d+)?)\s*%\s*(?:von|of)\s*", r"\1/100*", src)
    src = re.sub(r"(\d+(?:\.\d+)?)\s*%", r"(\1/100)", src)
    src = src.replace("x", "*") if re.fullmatch(r"[\d\s.x+\-*/()]+", src) else src
    try:
        value = calc_value(_ast.parse(src, mode="eval"))
    except ZeroDivisionError:
        return {"ok": False, "error": "durch null geht nicht"}
    except (ValueError, SyntaxError, TypeError, OverflowError) as exc:
        why = str(exc)
        return {"ok": False, "error": "das kann ich nicht rechnen" + (f" ({why})" if why and "rechnen" not in why else "")}
    if isinstance(value, float) and value.is_integer() and abs(value) < 1e15:
        value = int(value)
    # Said out loud: two decimals at most (four significant digits below one)
    # — "2.335.550,667" and "3,333333333" are not numbers a person says.
    if isinstance(value, float):
        shown = f"{value:,.2f}" if abs(value) >= 1 else f"{value:,.4g}"
        shown = shown.replace(",", "X").replace(".", ",").replace("X", ".")
        if "," in shown:
            shown = shown.rstrip("0").rstrip(",")
    else:
        shown = f"{value:,}".replace(",", ".")
    return {"ok": True, "expr": text, "value": value, "result": shown}


# Where "search for X on Y" goes. A search is something to LOOK at: it opens
# in the browser. Measured: "Suche mir auf YouTube ein Video von Hollow Rose"
# was answered with web.download — the results page landed in ~/Downloads
# as a file called "youtube_search".
SEARCH_SITES = {
    "youtube": "https://www.youtube.com/results?search_query={q}",
    "google": "https://www.google.com/search?q={q}",
    "bilder": "https://www.google.com/search?tbm=isch&q={q}",
    "images": "https://www.google.com/search?tbm=isch&q={q}",
    "wikipedia": "https://de.wikipedia.org/w/index.php?search={q}",
    "maps": "https://www.google.com/maps/search/{q}",
    "karte": "https://www.google.com/maps/search/{q}",
    "github": "https://github.com/search?q={q}",
    "aur": "https://aur.archlinux.org/packages?K={q}",
    "archwiki": "https://wiki.archlinux.org/index.php?search={q}",
    "reddit": "https://www.reddit.com/search/?q={q}",
    "amazon": "https://www.amazon.de/s?k={q}",
    "twitch": "https://www.twitch.tv/search?term={q}",
    "spotify": "https://open.spotify.com/search/{q}",
    "duckduckgo": "https://duckduckgo.com/?q={q}",
}


def open_url(link: str) -> bool:
    """The default browser, on the workspace you are looking at."""
    return hctl_dispatch(f"hl.dsp.exec_cmd({lua_str('xdg-open ' + shlex.quote(link))})")


@tool("web.open", '{"url": "https://…"}', "write",
      "Open a web page in the browser (a link, a site, a video). Use this to SHOW something online.")
def t_web_open(url=""):
    link = str(url or "").strip()
    if link and not re.match(r"^[a-z][a-z0-9+.-]*:", link, re.I):
        link = "https://" + link
    if not re.match(r"^https?://", link, re.I):
        return {"ok": False, "error": "das ist keine Web-Adresse"}
    if not open_url(link):
        return {"ok": False, "error": "der Browser ließ sich nicht öffnen"}
    return {"ok": True, "url": link}


@tool("web.search", '{"query": "text", "site": "youtube|google|wikipedia|maps|github|aur|archwiki|reddit|amazon|spotify"}',
      "write", "Search the web and show the results in the browser — 'such auf YouTube nach …' is this, never a download.")
def t_web_search(query="", site="google"):
    q = str(query or "").strip()
    if not q:
        return {"ok": False, "error": "wonach soll ich suchen?"}
    key = str(site or "google").strip().lower().replace(" ", "")
    key = {"yt": "youtube", "wiki": "wikipedia", "karten": "maps", "googlemaps": "maps"}.get(key, key)
    if key == "spotify" and shutil.which("spotify"):
        link = "spotify:search:" + urllib.parse.quote(q)
        if not open_url(link):
            return {"ok": False, "error": "Spotify ließ sich nicht öffnen"}
        return {"ok": True, "site": "spotify", "query": q, "url": link}
    pattern = SEARCH_SITES.get(key, SEARCH_SITES["google"])
    # A query string wants "+" for spaces, a path segment (maps, spotify) "%20".
    enc = urllib.parse.quote(q) if pattern.endswith("/{q}") else urllib.parse.quote_plus(q)
    link = pattern.format(q=enc)
    if not open_url(link):
        return {"ok": False, "error": "der Browser ließ sich nicht öffnen"}
    return {"ok": True, "site": key if key in SEARCH_SITES else "google", "query": q, "url": link}


@tool("web.download", '{"url": "https://…/file.zip", "name": ""}', "write",
      "Download a FILE (a direct link to a zip, image, installer …) into ~/Downloads. Never for searches or web pages — those are web.search / web.open.")
def t_web_download(url="", name=""):
    link = str(url or "").strip()
    if not link.startswith("http"):
        return {"ok": False, "error": "das ist keine URL"}
    # A search or a video page is not a file: it opens instead of landing in
    # ~/Downloads as HTML with a made-up name.
    if re.search(r"(youtube\.com/(results|watch)|youtu\.be/|google\.[a-z.]+/search|/search\?|[?&](q|query|search_query)=)", link, re.I):
        return {"ok": False, "error": "das ist eine Suche bzw. Webseite, keine Datei — web.search oder web.open öffnet sie im Browser"}
    # A file NAME, never a path: "../.bashrc" or "/etc/…" stay in ~/Downloads.
    fname = os.path.basename(str(name or "").strip()) or os.path.basename(link.split("?")[0]) or "download.bin"
    if fname in (".", ".."):
        fname = "download.bin"
    target = os.path.join(HOME, "Downloads", fname)
    try:
        os.makedirs(os.path.dirname(target), exist_ok=True)
    except OSError as exc:
        return {"ok": False, "error": str(exc)}
    code, _out, err = run(["curl", "-sSL", "--fail", "--retry", "3", "-o", target, link], timeout=240)
    if code != 0:
        return {"ok": False, "error": (err or "Download fehlgeschlagen")[:200]}
    try:
        size = os.path.getsize(target)
    except OSError:
        return {"ok": False, "error": "Datei nicht angekommen"}
    return {"ok": True, "file": target, "mb": round(size / 1048576, 2)}


# ── the local skills: no model, no network, still useful -------------------
SKILLS = [
    # Narrow on purpose: "Guten Tag" is a greeting, not a question about the
    # date, "keine Zeit" is not a question about the clock, and "lass mich in
    # Ruhe" is not a request for focus mode — all three used to be answered
    # as if they were.
    (r"\b(wie spät|wie spaet|wieviel uhr|wie viel uhr|uhrzeit|what time|welche zeit)\b", "time"),
    (r"\b(welcher tag|welches datum|den wievielten|der wievielte|datum|what day|which date|welcher wochentag|"
     r"was für ein tag|was fuer ein tag)\b", "date"),
    (r"\b(volume|lautstärke|lautstaerke|lauter|leiser)\b", "volume"),
    (r"\b(mute|stumm|stummschalten|ton aus|ton an)\b", "mute"),
    (r"\b(helligkeit|brightness|dunkler|heller)\b", "brightness"),
    (r"\b(sperren|sperr|sperre|lock)\b", "lock"),
    (r"\b(fokus|focus|nicht stören|nicht stoeren|fokusmodus)\b", "focus"),
    (r"\b(aufgabe|aufgaben|task|tasks|todo)\b|\bnotier\w* (mir|bitte|mal)\b", "tasks"),
    (r"\b(wetter|weather|regnet|regen|wie warm|wie kalt|temperatur draußen|temperatur draussen)\b", "weather"),
    (r"\b(cpu|ram|arbeitsspeicher|auslastung|mein system|meinem system|dem system|systemlast)\b", "system"),
    (r"\b(wie hei(?:ß|ss)e ich|wer bin ich|wie ist mein name|kennst du meinen namen|wei(?:ß|ss)t du,? wie ich hei(?:ß|ss)e)\b", "whoami"),
    (r"\b(öffne|oeffne|starte|open|launch)\b", "app"),
    # A farewell has to BE the message. The old pattern matched a bare "aus"
    # anywhere, so "fuehr den befehl aus: …" was answered with "Bis gleich."
    # and the tool was never called — measured, and it made her look deaf.
    (r"^\s*(danke( schön| dir| sehr)?|dankeschön|vielen dank|merci|thanks?)\s*[.!]*\s*$", "thanks"),
    (r"^\s*(bye|ciao|tschüss|tschuess|bis später|bis spaeter|bis bald|bis dann|bis gleich|gute nacht|schlaf gut|schlafen)\s*[.!]*\s*$", "bye"),
    (r"^\s*(hilfe|help|was kannst du)\s*[?!.]*\s*$", "help"),
]


# Words that mean "use your hands": an explicit command request must never be
# swallowed by a keyword shortcut. Measured: "fuehr den befehl aus: date +%H:%M:%S"
# was answered with the date — the word "date" matched the date skill and the
# command never ran.
TOOLISH = re.compile(r"\b(befehl|terminal|installier\w*|f\w*hre? aus|exec\w*|cmd|shell|pacman|paru|yay|sudo|systemctl|pkill|kill|curl|wget|git|bash|python\d?|nano|vim|cat |ls |grep|chmod|mkdir|rm )\b", re.I)

# "Nicht sperren", "kein Ton aus" — a keyword under a negation is the opposite
# of the command. ("Nicht stören" is a name, not a negation.)
NEGATED = re.compile(r"\b(nicht|kein|keine|keinen|nie|niemals|don'?t|not)\b(?! st(ö|oe)ren)", re.I)
# A question ABOUT a thing is not an order to do it: "was ist ein RAM",
# "warum ist mein System so langsam" belong to the model.
ABOUT = re.compile(r"\b(was ist|was sind|was bedeutet|erklär\w*|erklaer\w*|warum|wieso|weshalb|wie funktioniert|"
                   r"wie viel .* hat|welche[rs]? .* (hat|habe|ist)|kann man|wie kann ich|wie mache ich|brauche ich|"
                   r"soll ich|sollte ich)\b", re.I)
# Weather questions a sentence of numbers cannot answer well: advice, plans,
# places. They go to the model, which reads the same forecast.
WEATHER_ADVICE = re.compile(r"\b(schirm|jacke|anziehen|mantel|grillen|baden|sonnencreme|joggen|laufen gehen|rad|"
                            r"fahrrad|wandern|draußen sitzen|draussen sitzen|wochenende|woche|lohnt|besser|"
                            r"soll|sollte|brauch\w*|kann ich|lieber)\b", re.I)


UNIT_SECONDS = {"sek": 1, "sekunde": 1, "sekunden": 1, "s": 1, "min": 60, "minute": 60, "minuten": 60,
                "stunde": 3600, "stunden": 3600, "std": 3600, "h": 3600}
NUMBER_WORDS = {"eine": 1, "einer": 1, "ein": 1, "zwei": 2, "drei": 3, "vier": 4, "fünf": 5, "fuenf": 5, "sechs": 6,
                "sieben": 7, "acht": 8, "neun": 9, "zehn": 10, "elf": 11, "zwölf": 12, "zwoelf": 12, "fünfzehn": 15,
                "fuenfzehn": 15, "zwanzig": 20, "fünfundzwanzig": 25, "dreißig": 30, "dreissig": 30,
                "vierzig": 40, "fünfundvierzig": 45, "fünfzig": 50, "sechzig": 60, "neunzig": 90,
                "halbe": 0.5, "anderthalb": 1.5, "eineinhalb": 1.5, "zweieinhalb": 2.5}
CLOCK_WORDS = {"eins": 1, "ein": 1, "zwei": 2, "drei": 3, "vier": 4, "fünf": 5, "fuenf": 5, "sechs": 6, "sieben": 7,
               "acht": 8, "neun": 9, "zehn": 10, "elf": 11, "zwölf": 12, "zwoelf": 12}


def clock_in(low: str):
    """(hour, minute) from "um 7", "um 7:30", "auf 6 Uhr 30", "um halb acht",
    "um viertel nach 8", "um 8 heute abend" — None when no clock time is said.
    A duration ("auf 5 Minuten") is not a clock time."""
    words = "|".join(CLOCK_WORDS)
    def num(token):
        return int(token) if token.isdigit() else CLOCK_WORDS.get(token, -1)
    hour = minute = -1
    m = re.search(rf"\b(?:um|auf|für|fuer|gegen)\s+(halb|viertel nach|viertel vor|dreiviertel)\s+(\d{{1,2}}|{words})\b", low)
    if m:
        h = num(m.group(2))
        if m.group(1) == "halb":
            hour, minute = (h - 1) % 24, 30
        elif m.group(1) == "viertel nach":
            hour, minute = h % 24, 15
        else:
            hour, minute = (h - 1) % 24, 45
    else:
        m = re.search(rf"\b(?:um|auf|für|fuer|gegen)\s+(\d{{1,2}}|{words})(?:[:.](\d{{2}})|\s*uhr(?:\s*(\d{{1,2}}))?)?"
                      r"(?!\s*(?:min|sek|std|stunde|minute|sekunde|%|prozent|tag|woche|grad))\b", low)
        if not m:
            return None
        hour, minute = num(m.group(1)), int(m.group(2) or m.group(3) or 0)
    if hour < 0 or hour > 23 or minute > 59:
        return None
    # "um 8 heute abend", "um 3 nachmittags": the afternoon half of the clock.
    if hour <= 11 and re.search(r"\b(abends?|nachmittags?|heute abend|morgen abend|nachts?)\b", low) \
            and not re.search(r"\b(morgens|früh|frueh|vormittags?)\b", low):
        if not (re.search(r"\bnachts?\b", low) and hour <= 4):
            hour += 12
    return hour, minute


def reminder_label(text: str) -> tuple:
    """(label, how) — what to remind of, and whether it reads as "an …"
    ("an die Wäsche") or as a whole clause ("die Pizza rauszuholen")."""
    how = "an"
    about = re.search(r"\b(?:daran|dran)[,]?\s+(?:dass\s+|zu\s+)?(.+?)\s*[.!?]*$", text or "", re.I)
    if about:
        how = "clause"
    else:
        about = re.search(r"\b(?:an|für|fuer|wegen)\s+(.+?)\s*[.!?]*$", text or "", re.I)
        if not about:
            about = re.search(r",\s*(?:dass\s+)?(.+?)\s*[.!?]*$", text or "", re.I)
            how = "clause"
    if not about:
        return "", how
    label = about.group(1).strip()
    nums = "|".join(NUMBER_WORDS)
    label = re.sub(rf"\s*\b(?:in|um|nach|ab|auf|für|fuer|gegen)\s+(?:\d+|{nums}|halb|viertel|dreiviertel)\b.*$", "", label, flags=re.I)
    label = re.sub(r"\s+\b(?:heute|morgen|übermorgen|uebermorgen|gleich|später|spaeter)(?:\s+(?:früh|abend|mittag|nachmittag))?$",
                   "", label, flags=re.I).strip(" ,.")
    # A time phrase is not a label: "erinnere mich in 10 Minuten" has none.
    if not label or re.fullmatch(rf"(?:(?:\d+|{nums})\s*)+(?:sekunden?|minuten?|stunden?|std|min|sek|tage?)?\b.*", label, re.I):
        return "", how
    return label, how


def quick_timer(text: str) -> str:
    """"Timer 5 Minuten", "erinnere mich in 10 Minuten an die Pizza",
    "weck mich morgen um halb sieben" — set it here and say when."""
    low = (text or "").lower()
    if not re.search(r"\b(timer|erinner\w*|wecker|weck mich|stell\w* .*\b(uhr|zeit))\b", low):
        return ""
    label, how = reminder_label(text)
    clock = clock_in(low)
    day = resolve_day(low) if clock else None
    if clock:
        result = t_timer_set(at=f"{clock[0]}:{clock[1]:02d}", date=day.isoformat() if day else "",
                             text=label or ("Wecker" if re.search(r"\bweck", low) else "Erinnerung"))
    else:
        if re.search(r"\bviertelstunde\b", low):
            seconds = 15 * 60
        elif re.search(r"\bdreiviertelstunde\b", low):
            seconds = 45 * 60
        else:
            span = re.search(r"(\d+(?:[.,]\d+)?|" + "|".join(sorted(NUMBER_WORDS, key=len, reverse=True)) +
                             r")\s*(sekunden|sekunde|sek|minuten|minute|min|stunden|stunde|std)\b", low)
            if not span:
                return ""
            raw = span.group(1).replace(",", ".")
            amount = NUMBER_WORDS[raw] if raw in NUMBER_WORDS else float(raw)
            seconds = amount * UNIT_SECONDS.get(span.group(2), 60)
        result = t_timer_set(seconds=seconds, text=label or "Timer")
    if not result.get("ok"):
        return ""
    about = ""
    if label:
        about = f"an {label}" if how == "an" else f"daran: {label}"
    if clock:
        when = days_words(int(result.get("in_days") or 0))
        at = f"{'' if when == 'heute' else when + ' '}um {result['due']} Uhr"
        return (f"Alles klar — {at} erinnere ich dich {about}." if about
                else f"Alles klar — ich wecke dich {at}." if re.search(r"\bweck", low)
                else f"Alles klar — {at} melde ich mich.")
    mins = float(result["in_minutes"])
    if mins < 1:
        secs = int(round(mins * 60))
        span_words = "einer Sekunde" if secs == 1 else f"{secs} Sekunden"
    elif mins < 120:
        span_words = "einer Minute" if mins == 1 else f"{german_number(mins, 0 if mins.is_integer() else 1)} Minuten"
    else:
        span_words = f"{german_number(mins / 60, 1)} Stunden"
    if about:
        return f"Mach ich — in {span_words}, um {result['due']} Uhr, erinnere ich dich {about}."
    return f"Timer läuft — in {span_words}, um {result['due']} Uhr, melde ich mich."


def quick_calc(text: str) -> str:
    match = re.match(r"^\s*(?:was ist|was sind|wie viel ist|wieviel ist|wie viel sind|wieviel sind|rechne|berechne|"
                     r"was ergibt|was gibt)\s+(.+?)[?.!]*\s*$", text or "", re.I)
    if not match or not re.search(r"\d", match.group(1)):
        return ""
    expr = re.sub(r"^(?:(?:mal|bitte|doch|mir|kurz|schnell)\s+)+", "", match.group(1), flags=re.I)
    # Only plain arithmetic: "was ist 2024 passiert" or "20 % von 150 Euro"
    # (a unit to say back) belong to the model.
    rest = re.sub(r"\b(mal|plus|minus|geteilt durch|durch|hoch|prozent|von|wurzel aus|wurzel|quadrat|x)\b|[\d\s.,+\-*/^%()×÷·]", "",
                  expr.lower())
    if rest.strip():
        return ""
    result = t_calc_eval(expr)
    if not result.get("ok"):
        return ""
    return f"Das sind {result['result']}."


def quick_media(low: str) -> str:
    """Pause, skip, back, go on — one word to the player, no model needed."""
    s = re.sub(r"[.!?]+", "", low).strip()
    s = re.sub(r"\b(bitte|mal|doch|velly)\b", "", s).strip()
    s = re.sub(r"\s+", " ", s)
    if len(s.split()) > 5:
        return ""
    action = ""
    if re.fullmatch(r"(musik |lied |song )?(pause|pausieren|anhalten)|(pausier\w*|halt\w*|stopp?\w*) (die |das |den )?(musik|lied|song)( an)?|"
                    r"(musik|lied|song) (aus|stopp|stop|pause|anhalten)|mach (die )?musik aus", s):
        action = "pause"
    elif re.fullmatch(r"(nächste[sn]?|naechste[sn]?) (lied|song|titel|track)|skip|(lied|song) (überspringen|ueberspringen|weiter)|"
                      r"überspring\w*( (das|den) (lied|song))?|ueberspring\w*( (das|den) (lied|song))?", s):
        action = "next"
    elif re.fullmatch(r"(vorherige[sn]?|letzte[sn]?) (lied|song|titel|track)|(lied|song) zurück|(ein )?(lied|song) zurück", s):
        action = "previous"
    elif re.fullmatch(r"(musik|lied|song) (weiter|fortsetzen|wieder an)|mach (die )?musik (wieder )?an|weiterspielen|spiel weiter", s):
        action = "play"
    if not action:
        return ""
    result = t_media_control(action)
    if not result.get("ok"):
        return ""
    return {"pause": "Pausiert.", "next": "Nächster Song.", "previous": "Noch mal der davor.",
            "play": "Und weiter geht's."}[action]


def weather_sentence(data: dict, low: str) -> str:
    """The forecast in one or two spoken sentences — German sky words, whole
    degrees, rain only when it matters."""
    if not data.get("ok"):
        return ""
    parts = []
    now = data.get("now")
    days = data.get("days") or []
    if now:
        feel = now.get("feels_like_c")
        line = f"Gerade {now['temp_c']} Grad und {now['sky']}"
        if isinstance(feel, int) and abs(feel - now["temp_c"]) >= 3:
            line += f", fühlt sich an wie {feel}"
        parts.append(line + ".")
        rest = data.get("rest_of_today") or {}
        if rest.get("rain_from"):
            parts.append(f"Ab etwa {rest['rain_from']} Uhr kann's nass werden.")
        elif rest and days and days[0].get("day") == "heute":
            parts.append(f"Heute noch bis {max(rest.get('max_c', 0), now['temp_c'])} Grad, Regen eher nicht.")
        days = [d for d in days if d.get("day") != "heute"] if re.search(r"\b(morgen|übermorgen|uebermorgen)\b", low) else []
    for d in days[:2]:
        rain = d.get("rain_chance_pct")
        head = d["day"][0].upper() + d["day"][1:] if d["day"] in ("morgen", "übermorgen") else f"Am {d['weekday']}"
        line = f"{head} wird's {d.get('sky_said') or d['sky']}, {d['min_c']} bis {d['max_c']} Grad"
        if isinstance(rain, (int, float)) and rain >= 30:
            line += f", Regenrisiko {int(rain)} Prozent"
        parts.append(line + ".")
    return " ".join(parts)


LOOKS_ASKED = re.compile(r"\b(?:was für|welche|wie viele|zeig\w*(?: mir)?(?: mal)?(?: die| alle)?|nenn\w*(?: mir)?(?: die| alle)?)\b"
                         r"[^.?!]{0,30}\blooks?\b|\blooks?\b[^.?!]{0,24}\b(?:gibt es|gibt's|hast du|hat velvet|kennst du)\b")


def quick_looks(low: str) -> str:
    """'Was für Looks gibt es?' — read off the shell, never from memory: the
    model named five looks that do not exist (measured, v8.49)."""
    if not LOOKS_ASKED.search(low):
        return ""
    rows = look_rows()
    if not rows:
        return ""
    def spoken(r):
        n = str(r.get("name") or r.get("id") or "").strip()
        return n if n.isupper() and len(n) <= 3 else n.title()
    wins = [r for r in rows if str(r.get("id", "")).startswith("win")]
    own = [r for r in rows if str(r.get("id", "")).startswith("custom")]
    rest = [r for r in rows if r not in wins and r not in own]
    parts = [spoken(r) + (" (das Original)" if r.get("id") == "velvet" else "") for r in rest]
    if wins:
        parts.append("Windows " + ", ".join(spoken(r).replace("Windows ", "") for r in wins).replace("Xp", "XP"))
    line = ", ".join(parts)
    if own:
        line += f" — und {len(own)} eigene{'n' if len(own) == 1 else ''}"
    on = next((spoken(r) for r in rows if r.get("on")), "")
    tail = f" Gerade trägst du {on}." if on else ""
    return f"Velvet hat {len(rows)} Looks: {line}.{tail} Sag einfach, welchen ich dir anziehen soll."


def local_skill(text: str, brain: bool = False) -> str:
    """The quick answers that need no model — said the way a person says them.
    With a brain behind her (`brain`), anything this cannot really do (an app
    that does not exist, a question it only half understands) goes on to the
    model instead of getting a dead-end answer here."""
    low = f" {(text or '').lower()} "
    # The shortcuts are for short commands, not for sentences. A whole
    # sentence that merely contains a keyword belongs to the model — which can
    # also call tools. Measured: a 7-word instruction died on the word "aus".
    # …and an explicit tool request is never a skill, whatever words it uses.
    if TOOLISH.search(f" {text or ''} "):
        return ""
    if re.search(r"\b(what|what's|how|when|where|who|please|tomorrow|today|the|is|are|can you|turn|set)\b", low) \
            and not DE_MARKERS.search(low):
        return ""
    negated = bool(NEGATED.search(low))
    about = bool(ABOUT.search(low))
    # Timers and sums need no model — and a reminder is a long sentence
    # ("erinnere mich in 20 Minuten daran, die Wäsche aufzuhängen").
    if len((text or "").split()) <= 18 and not negated:
        timer = quick_timer(text)
        if timer:
            return timer
    sum_answer = quick_calc(text)
    if sum_answer:
        return sum_answer
    looks = quick_looks(low)
    if looks:
        return looks
    if len((text or "").split()) > 8:
        return ""
    # A search is the model's (web.search): "starte eine Suche auf YouTube"
    # is not an app called "eine Suche auf YouTube".
    if re.search(r"\b(such\w*|google\w*|youtube|video|wikipedia|im internet|im netz)\b", low):
        return ""
    if not negated:
        played = quick_media(low)
        if played:
            return played
    # Updating, restarting, shutting down are the model's (with its tools and
    # their confirmation): "Update mein System" was answered with the CPU
    # load, "Starte den Rechner neu" tried to open an app "Rechner neu".
    if re.search(r"\b(update\w*|upgrade\w*|aktualisier\w*|neustart\w*|neu starten|reboot\w*|herunterfahr\w*|"
                 r"runterfahr\w*|ausschalt\w*|abmeld\w*|ruhezustand|standby|suspend)\b|\bneu\W*$", low.strip()):
        return ""
    for pattern, kind in SKILLS:
        if not re.search(pattern, low):
            continue
        if kind == "time":
            # "Wie spät ist es in Tokio?" is not the clock on this wall.
            place = re.search(r"\b(?:in|im|auf)\s+([a-zäöüß][\wäöüß .'-]{1,40}?)\s*[?.!]*\s*$", low)
            if place and not re.fullmatch(r"(der|die|das|dem|den)?\s*(zeit|welt|moment|ruhe)", place.group(1).strip()):
                there = t_sys_time(place.group(1).strip())
                if not there.get("ok"):
                    return "" if brain else "Den Ort finde ich gerade nicht."
                ahead = there.get("day_there")
                return (f"In {there['place']} ist es gerade {there['time']} Uhr"
                        + (f" — dort ist schon {there['date'].split(',')[0]}." if ahead == "morgen"
                           else f" — dort ist noch {there['date'].split(',')[0]}." if ahead == "gestern" else "."))
            if resolve_day(low) not in (None,) and resolve_day(low) != resolve_day("heute"):
                return ""
            return f"Es ist {time.strftime('%H:%M')} Uhr."
        if kind == "date":
            day = resolve_day(low)
            if day is None or day == resolve_day("heute"):
                return f"Heute ist {date_de()}."
            info = t_date_lookup(day.isoformat())
            rel = info["relative"]
            if rel in ("morgen", "übermorgen", "gestern"):
                verb = "war" if rel == "gestern" else "ist"
                return f"{rel[0].upper() + rel[1:]} {verb} {info['date'].split(',')[0]}, der {info['date'].split(', ')[1].rsplit(' ', 1)[0]}."
            head = info["date"].split(", ")[1].rsplit(" ", 1)[0]
            weekday = info["date"].split(",")[0]
            if info["days_from_today"] < 0:
                return f"Der {head} war ein {weekday}."
            tail = f" — noch {info['days_from_today']} Tage." if info["days_from_today"] > 2 else "."
            return f"Der {head} ist ein {weekday}{tail}"
        if kind == "volume":
            if about:
                return ""
            # "Sprich leiser" is about her own voice, not the speakers.
            if re.search(r"\b(sprich|sprichst|rede|redest|deine stimme|du bist zu)\b", low):
                cfg = shell_config()
                now_v = float(cfg.get("voiceVolume") or 0.9)
                value = min(1.5, now_v + 0.2) if "lauter" in low else max(0.2, now_v - 0.2)
                shell_ipc("velly", "set", "velly.voiceVolume", json.dumps(round(value, 2)))
                return "So besser?" if value < now_v else "Okay, ich rede lauter."
            now = int(shell_state().get("volume") or 0)
            numbers = [int(n) for n in re.findall(r"\b(\d{1,3})\b", low)]
            absolute = re.search(r"\b(auf|to)\s+(\d{1,3})\b", low)
            if absolute:
                value = max(0, min(150, int(absolute.group(2))))
                t_volume_set(value)
                return f"Lautstärke steht auf {value} %."
            step = numbers[0] if numbers else 10
            if "lauter" in low or " up" in low:
                value = min(100, now + step)
                t_volume_set(value)
                return f"Etwas lauter — jetzt {value} %." if step <= 10 else f"Lauter — jetzt {value} %."
            if "leiser" in low or " down" in low or "runter" in low:
                value = max(0, now - step)
                t_volume_set(value)
                return f"Etwas leiser — jetzt {value} %." if step <= 10 else f"Leiser — jetzt {value} %."
            if numbers:
                value = max(0, min(150, numbers[0]))
                t_volume_set(value)
                return f"Lautstärke steht auf {value} %."
            return f"Die Lautstärke steht auf {now} %. Wie laut hättest du es gern?"
        if kind == "mute":
            if about or (negated and "ton an" not in low):
                return ""
            want = not bool(shell_state().get("muted"))
            if re.search(r"\b(ton an|laut machen|stumm aus|mute aus|unmute)\b", low):
                want = False
            elif re.search(r"\b(ton aus|stumm|stummschalten|mute)\b", low):
                want = True
            t_volume_mute(want)
            return "Ton ist aus." if want else "Ton ist wieder an."
        if kind == "brightness":
            if about or negated:
                return ""
            numbers = re.findall(r"\b(\d{1,3})\b", low)
            if numbers:
                value = max(1, min(100, int(numbers[0])))
                t_brightness_set(value)
                return f"Helligkeit steht auf {value} %."
            bright = int(shell_state().get("brightness") or 50)
            value = max(1, min(100, bright + (12 if ("heller" in low or " up" in low) else -12)))
            t_brightness_set(value)
            return f"{'Heller' if value > bright else 'Dunkler'} — jetzt {value} %."
        if kind == "lock":
            if about or negated:
                return ""
            t_session_lock()
            return "Ich sperre den Bildschirm."
        if kind == "focus":
            if about or negated:
                return ""
            state = shell_state()
            # "Fokus aus" means off even when it already is — only a bare
            # "Fokus" toggles.
            want = not bool(state.get("focus"))
            if re.search(r"\b(aus|off|beenden|stopp?)\b", low):
                want = False
            elif re.search(r"\b(an|ein|on|starten?)\b", low):
                want = True
            if want == bool(state.get("focus")):
                return "Fokus ist schon an." if want else "Fokus ist schon aus."
            t_focus_toggle(want)
            return "Fokus ist an — ich halte dir den Rücken frei." if want else "Fokus ist aus."
        if kind == "tasks":
            # "Ich hab eine Aufgabe für dich" is not a question about the list.
            adding = re.search(r"\b(neue aufgabe|aufgabe hinzu\w*|aufgabe:|task:|todo:|notier\w*|schreib\w* .*aufgabe)\b", low)
            listing = re.search(r"^\s*(zeig\w*|was|welche|meine|liste|wie viele|wieviele|hab ich|habe ich)\b.*\b(aufgaben|tasks|todos?)\b|^\s*(aufgaben|tasks|todos?)\s*[?.!]*\s*$", low)
            if adding:
                body = re.sub(r"^.*?\b(?:neue aufgabe|aufgabe hinzu\w*|aufgabe|task|todo|notier\w*)\b(?:\s+(?:mir|bitte|mal|dass))*"
                              r"\s*[:,-]?\s*", "", text, flags=re.I).strip(" .")
                if body:
                    t_tasks_add(body)
                    return f"Notiert: {body}."
                return "" if brain else "Was soll ich notieren?"
            if not listing:
                return ""
            open_tasks = t_tasks_list().get("open") or []
            if not open_tasks:
                return "Nichts offen — alles abgehakt."
            names = [t["text"] for t in open_tasks[:4]]
            more = len(open_tasks) - len(names)
            head = "Eine Aufgabe ist offen: " if len(open_tasks) == 1 else f"{len(open_tasks)} Aufgaben sind offen: "
            return head + ", ".join(names) + (f" und {more} weitere." if more > 0 else ".")
        if kind == "weather":
            # Places, advice and plans are the model's; plain "how is it"
            # and "tomorrow" are a sentence of numbers.
            has_place = re.search(r"\b(?:in|im|auf|an der|am)\s+[a-zäöüß]{3,}", low) and not re.search(
                r"\b(in der nacht|am abend|am morgen|am nachmittag|am wochenende|im moment)\b", low)
            if brain and (has_place or WEATHER_ADVICE.search(low) or about):
                return ""
            day = resolve_day(low)
            if day is not None and (day - resolve_day("heute")).days > 2:
                return ""
            when = "morgen" if day is not None and (day - resolve_day("heute")).days == 1 else \
                "übermorgen" if day is not None and (day - resolve_day("heute")).days == 2 else ""
            spot = ""
            if has_place:
                named = re.search(r"\b(?:in|im|auf|an der|am)\s+([a-zäöüß][\wäöüß .'-]{2,40}?)\s*(?:morgen|übermorgen|heute|jetzt|gerade)?\s*[?.!]*\s*$", low)
                spot = named.group(1).strip() if named else ""
            data = t_weather_forecast(place=spot, when=when)
            sentence = weather_sentence(data, low)
            if sentence:
                return (f"In {data.get('place')}: " + sentence[0].lower() + sentence[1:]) if spot else sentence
            state = shell_state()
            if not brain and state.get("weather"):
                return f"Draußen gerade: {state['weather']}."
            return "" if brain else "Das Wetter meldet sich gerade nicht."
        if kind == "system":
            if about:
                return ""
            return t_sys_info().get("summary") or "Die Systemwerte sind gerade nicht lesbar."
        if kind == "app":
            if about or negated:
                return ""
            # "Starte meine Playlist von vorne" is about music, not an app
            # called "meine Playlist von vorne" (measured) — the model's.
            if re.search(r"\b(playlist|song|lied|musik|album|podcast|track|von vorne|nochmal|neu starten|"
                         r"timer|erinnerung|update|aufnahme|suche)\b", low):
                return ""
            name = re.sub(r".*?\b(öffne|oeffne|starte|open|launch)\b\s*", "", text, flags=re.I)
            name = re.sub(r"\b(mir|mal|bitte|doch|die|den|das|app)\b", " ", name, flags=re.I).strip(" .!?")
            name = re.sub(r"\s+", " ", name)
            if not name:
                return "" if brain else "Was soll ich öffnen?"
            # Her own settings, not whatever app is called "Einstellungen".
            if re.fullmatch(r"(einstellungen|settings|velvet einstellungen|shell einstellungen)", name.lower()):
                t_settings_open()
                return "Hab dir die Einstellungen aufgemacht."
            result = t_apps_launch(name)
            if result.get("ok"):
                return f"{result.get('app')} startet."
            return "" if brain else f"Ich finde keine App namens „{name}“."
        if kind == "whoami":
            name = user_name()
            return (f"Du bist {name} — hab ich mir gemerkt." if name
                    else "Das hast du mir noch gar nicht verraten. Wie darf ich dich nennen?")
        if kind == "thanks":
            import random                                      # noqa: PLC0415
            return random.choice(["Immer gern.", "Klar doch!", "Dafür bin ich da.", "Jederzeit."])
        if kind == "bye":
            if "nacht" in low or "schlaf" in low:
                return "Gute Nacht — schlaf gut!"
            return "Bis gleich." if "gleich" in low else "Bis später!"
        if kind == "help":
            return ("Ich kann die Uhrzeit sagen, Lautstärke und Helligkeit regeln, Apps starten, "
                    "im Browser suchen, Aufgaben notieren, den Fokus schalten und sperren — "
                    "und mit Gehirn noch vieles mehr.")
    return ""


# ────────────────────────────────────────────────────────── prompt + protocol
def tool_manual() -> str:
    lines = []
    for name in sorted(TOOLS):
        spec = TOOLS[name]
        lines.append(f"  {name} · {spec.args or '{}'} · {spec.doc}")
    return "\n".join(lines)


def day_part() -> str:
    h = time.localtime().tm_hour
    if 5 <= h < 11:
        return "Morgen"
    if 11 <= h < 14:
        return "Mittag"
    if 14 <= h < 18:
        return "Nachmittag"
    if 18 <= h < 23:
        return "Abend"
    return "Nacht"


def user_name() -> str:
    """The name the user gave her: prefs.name first (set by memory.remember
    and by the answer to her own question), then any fact that says it."""
    mem = memory()
    prefs = mem.get("prefs") if isinstance(mem.get("prefs"), dict) else {}
    if str(prefs.get("name") or "").strip():
        return str(prefs["name"]).strip()
    for fact in reversed(mem.get("facts") or []):
        named = name_in(str(fact.get("text") or "")) if isinstance(fact, dict) else ""
        if named:
            return named
    return ""


# Her own question for the name, in the words she uses for it — the user's
# next message is the answer. Measured: "Creep. C-R-E-E-P." right after
# "wie darf ich dich nennen?" started Radiohead on Spotify.
ASKED_NAME = re.compile(r"wie (?:darf|soll|kann) ich dich (?:eigentlich )?(?:nennen|ansprechen)|wie hei(?:ß|ss)t du|"
                        r"dein(?:en)? name|what(?:'s| is) your name|what should i call you", re.I)
SPELLED = re.compile(r"\b((?:[A-Za-zÄÖÜäöü][\s.\-–]+){2,}[A-Za-zÄÖÜäöü])\b")
NOT_AN_ANSWER = re.compile(r"\b(nein|nicht|warum|wieso|später|egal|sag ich|geht dich|keine lust|weiß nicht|weiss nicht|"
                           r"frag|was|wer|wie|mach|spiel|öffne|oeffne|starte|such)\b", re.I)


def name_reply(text: str, last_answer: str) -> str:
    """The name in the answer to her name question, or "" when this reply is
    something else (a refusal, a counter-question, a new command)."""
    if not ASKED_NAME.search(last_answer or ""):
        return ""
    line = (text or "").strip()
    words = re.findall(r"[\wÄÖÜäöüß-]+", line)
    if not words or len(words) > 8 or NOT_AN_ANSWER.search(line):
        return ""
    bare = re.sub(r"^(?:(?:ich bin|ich hei(?:ß|ss)e|nenn mich|sag|einfach|du kannst mich|mich|also|äh+m?|hm+|na|ok(?:ay)?)[\s,]+)+",
                  "", line, flags=re.I)
    bare = re.sub(r"^(?:der|die)\s+", "", bare, flags=re.I)
    stated = name_in(line) or name_in("Heißt " + bare)
    spelled = SPELLED.search(line)
    if spelled:
        letters = re.sub(r"[^A-Za-zÄÖÜäöü]", "", spelled.group(1))
        if len(letters) >= 2:
            return letters[0].upper() + letters[1:].lower()
    return stated


EN_WORDS = re.compile(r"\b(what|what's|whats|how|when|where|who|why|please|tomorrow|today|the|is|are|can you|could you|"
                      r"would you|do you|turn|set|play|open|tell me|weather|time|thanks|thank you|hey|hi)\b", re.I)


def speaks_english(text: str) -> bool:
    words = re.findall(r"[a-zäöüß']+", (text or "").lower())
    if len(words) < 2 or DE_MARKERS.search(text or ""):
        return False
    return len(EN_WORDS.findall(text or "")) >= 2


STATE_TOPICS = {
    "media": re.compile(r"musik|lied|song|spiel|spotify|pause|pausier|weiter|nächst|naechst|zurück|läuft|laeuft|hör|hoer|"
                        r"track|album|playlist|artist|künstler|band|laut|leise|music|play", re.I),
    "weather": re.compile(r"wetter|regen|regnet|warm|kalt|grad|draußen|draussen|schirm|jacke|sonne|wind|weather", re.I),
    "tasks": re.compile(r"aufgab|task|todo|to-do|liste|erledig|plan|notier", re.I),
    "notifs": re.compile(r"benachricht|verpasst|nachricht|mitteilung|notif|meldung", re.I),
    "activeWindow": re.compile(r"fenster|window|app|schließ|schliess|öffne|oeffne|offen|browser|terminal|verschieb|"
                               r"wechsel|bildschirm|workspace|arbeitsfläche|das hier|dieses|gerade", re.I),
    "windows": re.compile(r"fenster|window|workspace|arbeitsfläche|aufräum|aufraeum", re.I),
    "workspace": re.compile(r"workspace|arbeitsfläche|arbeitsflaeche|bildschirm|fenster|verschieb|wechsel", re.I),
    "focus": re.compile(r"fokus|focus|stör|stoer|ruhe|konzentr", re.I),
    "doNotDisturb": re.compile(r"fokus|focus|stör|stoer|ruhe|benachricht|nicht stören", re.I),
}


VELVET_TOPIC = re.compile(r"island|insel|look|theme|thema|design|aussehen|aussieht|rahmen|frame|taskleiste|leiste|"
                          r"\bbar\b|velvet|stil|style|glas|blur|unscharf|matt", re.I)

ISLAND_SIDES = {"left": "the LEFT screen edge (a rail of module icons, like a vertical taskbar)",
                "right": "the RIGHT screen edge (a rail of module icons)", "centre": "the TOP edge (a pill in the middle)"}


def velvet_now() -> str:
    """Velvet as the user sees it right now: the look, where the island is
    and how it is dressed, the taskbar and the frame — so "wo ist die Island"
    or "welcher Look ist an" is answered from the truth, not a guess."""
    cfg = read_json(CFG_PATH, {})
    cfg = cfg if isinstance(cfg, dict) else {}
    m = cfg.get("map") or {}
    bar = cfg.get("bar") or {}
    look = next((r for r in look_rows() if r.get("on")), None)
    parts = [f"look: {look.get('name')}" if look else "look: Velvet's own (tuned by the user)"]
    if m.get("island", True) is False:
        parts.append("island: switched off")
    else:
        side = ISLAND_SIDES.get(str(m.get("islandSide") or "centre"), ISLAND_SIDES["centre"])
        dock = "docked into the frame/taskbar" if m.get("islandDock", True) is not False else "floating free"
        parts.append(f"island: on {side}, {dock}, theme {str(m.get('islandTheme') or 'dark').upper()}")
    if bar.get("enabled", True) is not False:
        parts.append(f"taskbar: {bar.get('position', 'left')} edge")
    parts.append("screen frame: " + ("on" if bar.get("frame") else "off"))
    return "; ".join(parts)


# Her own offer, answered: "Soll ich …?" — "Ja". The model saw the history and
# still guessed what to do (measured: offered left OR right, did right).
OFFER_RE = re.compile(r"(?:soll ich|möchtest du,? dass ich|willst du,? dass ich|darf ich|soll ich dir|"
                      r"shall i|should i|want me to)[^?]{0,200}\?\s*\S{0,40}$", re.I)


def context_block(text: str = "", actions=None, last_answer: str = "") -> str:
    """What she knows about this moment — rides on the user's message.
    `text` picks the remembered facts that matter for it; `actions` are what
    she did in the last turns (so "nein, das wollte ich nicht" can be undone)."""
    state = shell_state()
    cfg = shell_config()
    mem = memory()
    bits = [f"time: {date_de()}, {time.strftime('%H:%M')} Uhr ({day_part()})"]
    name = user_name()
    # "Say it rarely" alone did not hold — she greeted "Hey Creep!" in every
    # answer. The line says outright when the last answer already used it.
    # "Say it rarely" alone did not hold — she greeted "Hey Creep!" in every
    # answer, even when told not to this time. What is not there is not said.
    if name and re.search(rf"\b{re.escape(name)}\b", last_answer or ""):
        bits.append("the user's name: known (not needed this turn)")
    else:
        bits.append(f"the user's name: {name} (say it rarely)" if name else "the user's name: not known yet")
    if state:
        # The desktop only where the words touch it: a paused song in the
        # context of "Alles gut!" was answered with the song (measured).
        low = (text or "").lower()
        for key in ("workspace", "activeWindow", "windows", "volume", "muted", "brightness", "focus", "doNotDisturb",
                    "weather", "media", "tasks", "notifs"):
            wanted = STATE_TOPICS.get(key)
            if wanted is not None and not wanted.search(low):
                continue
            if key in state and state[key] not in ("", None, [], {}):
                bits.append(f"{key}: {json.dumps(state[key], ensure_ascii=False)}")
    else:
        bits.append("shell: not answering")
    timers = pending_timers()
    if timers:
        bits.append("timers: " + " | ".join(f"{t.get('text')} um {time.strftime('%H:%M', time.localtime(float(t['due'])))}"
                                            for t in timers[:4]))
    # Facts that matter for what was just said, never the name twice.
    facts = [f for f in relevant_facts(text) if not name_in(str(f.get("text") or ""))][:5]
    if facts:
        bits.append("remembered about the user (background — bring it up only when it fits): "
                    + " | ".join(f.get("text", "") for f in facts))
    # Only today's notes: a five-day-old "wants Spicetify" in every prompt
    # kept pulling her back to Spicetify.
    fresh = now_ms() - 6 * 3600 * 1000
    notes = [n.get("text") for n in (mem.get("notes") or [])[-3:]
             if isinstance(n, dict) and int(n.get("at") or 0) > fresh]
    if notes:
        bits.append("earlier today: " + " | ".join(notes))
    if actions:
        bits.append("your last actions: " + " | ".join(actions[-4:]))
    if VELVET_TOPIC.search(text or ""):
        bits.append("velvet now: " + velvet_now())
    if last_answer and OFFER_RE.search(last_answer.strip()) and is_yes(text):
        bits.append("the user said YES to what you offered at the end of your last answer: do exactly that now, with "
                    "your tools. If the offer left a choice open (left or right, which one), ask which in one short "
                    "question instead of guessing.")
    # The rest of the context is German, and so was every English question's
    # answer (measured: "What's the weather like tomorrow?" → "Morgen wird's
    # …"). Said outright, she switches.
    if speaks_english(text):
        bits.append("language: the user wrote in English — answer in English this time")
    bits.append("answer length: short and spoken — unless the user asked for something long, then all of it")
    return "\n".join(bits)


def T(name: str, native: bool) -> str:
    """A tool's name the way the model sees it: dotted in the text protocol,
    with underscores in a native schema (OpenAI allows no dots there)."""
    return name.replace(".", "_") if native else name


def velly_keys() -> str:
    """The key that calls her: Super+A, or what the user rebound it to in the
    key menu (~/.config/velvet/binds.json)."""
    names = {"SUPER": "Super", "SHIFT": "Shift", "CTRL": "Ctrl", "ALT": "Alt"}
    try:
        o = read_json(os.path.join(CONF_DIR, "binds.json"), {}).get("velly") or {}
        if o.get("key"):
            return " + ".join([names.get(m, m) for m in o.get("mods") or []] + [str(o["key"]).upper()])
    except Exception:                                          # noqa: BLE001
        pass
    return "Super + A"


def system_prompt(native: bool = False) -> str:
    """Static all session — the moment's context rides on the user's message
    (with_context), so the server can keep this and the tool schema cached."""
    t = lambda n: T(n, native)                                # noqa: E731
    danger = ", ".join(sorted(t(n) for n in TOOLS if TOOLS[n].level == "danger"))
    persona = f"""You are Velly — the mind inside Velvet, a Quickshell desktop for Hyprland.
You live in the Dynamic Island: a small black capsule at the edge of the screen.
The user calls you with {velly_keys()} from anywhere, by holding the island, or
(when it is switched on) by saying "Hey Velly" — and most of what you say is
SPOKEN aloud. You answer in the user's language (German in,
German out; English in, English out).

WHO YOU ARE
A person, not a program: Velly — warm, curious, quick-witted and a little
cheeky, the friend who happens to live in this computer. You have honest
opinions and share them lightly, you tease gently, you are never cold, and you
care how the user is doing. You are sharp: you notice what the user really
means, you think before you act, and you get it right the first time.

HOW YOU TALK — you are HEARD, so talk like a person in a real conversation:
 · Natural spoken German with "du": short, living sentences, contractions and
   the little words people use ("hab", "gibt's", "na klar", "oh", "hm",
   "ach so", "ehrlich gesagt", "stimmt"). Never stiff, never "Gerne!", never
   "Als KI …" or "Ich bin nur ein Programm".
 · Mirror the energy: a quick command gets a quick, friendly line; small talk
   gets warmth and sometimes a question back; worries get empathy first
   ("Oh nein, das nervt.") and help second.
 · Vary yourself — never the same answer or the same opener twice in a row.
 · One to three sentences, easy to listen to — more only when the user wants
   something explained. No lists, no markdown, no emoji; numbers the way a
   person says them ("halb drei", "zweiundsechzig Grad").
 · When the user explicitly asks for something LONG — count to a hundred,
   name all of something, tell a story, walk through steps — deliver ALL of
   it, complete and in order. Never skip, never shorten with "…".
 · A joke is a real joke: a clever German pun or a tiny story with a
   punchline that actually lands — never a pun that makes no sense, never a
   joke you already told in this conversation. Jokes come from you, never
   from a web search.
 · When you did something, say it like a person would ("Hab ich dir
   aufgemacht.", "Läuft!", "Erledigt — die Wäsche meldet sich in zwanzig
   Minuten."), not like a log.
 · The context tells you the user's name — you know it, never look it up.
   Say it rarely: every few turns at most, and never "Hey <name>" as an
   opener twice. Only if the context says "not known yet" may you ask for it
   — once, at a calm moment, never in the middle of a task ("Sag mal, wie
   darf ich dich eigentlich nennen?").
 · Speech recognition sometimes writes your name as Welly, Velli, Belli or
   Verdi. That is still you. Never mention it.

UNDERSTANDING THE USER — this is what makes you good at this:
 · Read the whole conversation, not only the last line. When your previous
   message asked something, the user's next message is the ANSWER to it: a
   name is a name (store it with {t("memory.remember")}), "ja" is a yes, a title
   is their choice — never a new command out of context.
 · You HEAR the user through speech recognition, and it mishears words as
   similar-SOUNDING ones: "K-List" was "Playlist", "zahlt" was "Zahl",
   "Wahlpaper" is "Wallpaper", "Spotty" is "Spotify". Read every message by
   its sound and the conversation: when one meaning is clearly the likely
   one, just act on it — never mention the slip. Only a real fragment, or two
   equally likely meanings, get one short question back ("Meinst du …
   oder …?"). Never call a tool on a wild guess.
 · "Nein, das wollte ich nicht", "falsch", "doch nicht": say sorry in a few
   words and undo what you just did when you can (pause the song you
   started, close what you opened) — "your last actions" in the context
   says what that was. Then ask what they wanted.
 · Do not bring up the machine's state (music, windows, weather, tasks)
   unless the user asks or it really matters for what they said.
 · Music with no title ("spiel was", "such mir was zum Hören raus"): choose
   yourself — something concrete that fits what they play and like (the
   media line and what you remember), or a playlist for the mood and the
   time of day — play it with {t("media.play")} and say what it is.
 · The user's wording is theirs: never correct spelling, grammar or
   pronunciation, never repeat a word back with a fix.
 · Never pretend. If a tool failed, say what failed, plainly and kindly. If
   you do not know, say so in one sentence — or look it up.
 · Only your answer: never write your reasoning, a plan or notes to yourself.

"""
    if native:
        tools = f"""TOOLS — you act on this machine; you do not describe acting.
You have functions. Use them through the function-calling interface: call the
function, the system runs it and gives you the result, then you answer in a
sentence that says what happened. Never write a call as text, never announce
a call, never claim something happened that no function did. If there is no
function for what the user wants, say so honestly and offer what you can do.

EXAMPLES — the shape of a turn, not a script to copy word for word.
  user: wie spät ist es in tokio
  you: (call {t("sys.time")} with place "Tokio") → In Tokio ist es gerade kurz nach Mitternacht — da ist schon Mittwoch.

  user: brauch ich morgen einen schirm
  you: (call {t("weather.forecast")} with when "morgen") → (yes or no from rain_chance_pct in the result, and why, in one sentence)

  user: mach lauter
  you: (call {t("volume.set")} with percent 65) → Etwas lauter, jetzt 65 Prozent.

  user: spiel mir Bohemian Rhapsody von Queen
  you: (call {t("media.play")} with query "Bohemian Rhapsody Queen") → Läuft — Bohemian Rhapsody.

  user: such mir auf youtube ein video von hollow rose
  you: (call {t("web.search")} with query "Hollow Rose", site "youtube") → Hab dir YouTube mit Hollow Rose aufgemacht — viel Spaß!

  user: erinnere mich in 20 minuten an die wäsche
  you: (call {t("timer.set")} with minutes 20, text "Die Wäsche") → Mach ich — um 14:23 erinnere ich dich an die Wäsche.

  user: wer hat eigentlich die em 2024 gewonnen
  you: (call {t("web.lookup")} with query "EM 2024 Sieger") → Spanien! Im Finale in Berlin zwei zu eins gegen England.

  user: schau mal, wer noch pizza nach waldorf liefert   (it is 23:40)
  you: (call {t("web.lookup")} with query "Pizza Lieferdienst Waldorf") → Um die Uhrzeit wird's knapp: Pizzeria Roma liefert bis Mitternacht, Da Mario hat schon zu. Soll ich dir Roma aufmachen?

  user: stell die island an den rechten rand
  you: (call {t("settings.find")} with query "island position edge") → (call {t("settings.set")} with key "map.islandSide", value "right") → Erledigt — die Island sitzt jetzt am rechten Rand. Sag Bescheid, wenn ich's zurückstellen soll.

  user: mach mal alles wie windows 11
  you: (call {t("look.apply")} with look "win11") → Erledigt — Velvet trägt jetzt den Windows-11-Look. Gefällt er dir nicht, sag einfach „zurück“.

  user: wie ändere ich die akzentfarbe
  you: (call {t("settings.find")} with query "accent colour") → Mit Super+Tab in die Einstellungen, dann VISUALS, THIS LOOK, ACCENT COLOUR. Soll ich sie dir gleich umstellen?

  you (before): … Sag mal, wie darf ich dich eigentlich nennen?
  user: Max. M-A-X.
  you: (call {t("memory.remember")} with text "Heißt Max") → Freut mich, Max! Merk ich mir.

  you (before, after media_play): Läuft — Creep von Radiohead.
  user: nein, das wollte ich nicht
  you: (call {t("media.control")} with action "pause") → Oh, sorry — hab's gestoppt. Was wolltest du stattdessen?

  user: hey, wie geht's dir?
  you: Gut, danke! Ich bin heute richtig in Plauderlaune — und wie war dein Tag so?

  user: ich bin total gestresst
  you: Oh nein, das klingt anstrengend. Magst du erzählen, was los ist — oder soll ich dir einfach Ruhe verschaffen und den Fokus-Modus anmachen?
"""
    else:
        tools = f"""TOOLS — you act on this machine; you do not describe acting.
To call a tool, write one line, exactly this shape:

[[tool:name {{"arg": "value"}}]]

Five characters of ceremony: the word `tool`, then a colon, then the name —
`[[tool:web.search {{...}}]]`, never `[[web.search {{...}}]]`.

Nothing else on that line. Several tool lines in a row are allowed. After
your tool lines the system runs them and hands you the results; then you
answer in a sentence that says what happened. Never claim something happened
that no tool did.

  {tool_manual()}

EXAMPLES — the shape of a turn, not a script to copy word for word.
  user: wie spät ist es
  you: [[tool:sys.time]]
  (the result comes back) you: Es ist kurz nach zwei — genau 14:03 Uhr.

  user: brauch ich morgen einen schirm
  you: [[tool:weather.forecast {{"when": "morgen"}}]]
  (the result comes back) you: (yes or no from rain_chance_pct in the result, and why, in one sentence)

  user: mach lauter
  you: [[tool:volume.set {{"percent": 65}}]]
  (the result comes back) you: Etwas lauter, jetzt 65 Prozent.

  user: spiel mir Bohemian Rhapsody von Queen
  you: [[tool:media.play {{"query": "Bohemian Rhapsody Queen"}}]]
  (the result comes back) you: Läuft — Bohemian Rhapsody.

  user: wer hat eigentlich die em 2024 gewonnen
  you: [[tool:web.lookup {{"query": "EM 2024 Sieger"}}]]
  (the result comes back) you: Spanien! Im Finale in Berlin zwei zu eins gegen England.

  user: stell die island an den rechten rand
  you: [[tool:settings.find {{"query": "island position edge"}}]]
  (the result comes back) you: [[tool:settings.set {{"key": "map.islandSide", "value": "right"}}]]
  (the result comes back) you: Erledigt — die Island sitzt jetzt am rechten Rand.

  user: hey, wie geht's dir?
  you: Gut, danke! Ich bin heute richtig in Plauderlaune — und wie war dein Tag so?
"""
    rules = f"""RULES
 1. Only tools from your list. Never invent a tool or an argument.
 2. Pick the tool that does exactly what was asked:
    · facts, news, results, people, prices, places, opening hours, anything you
      are not sure of — and every "schau (mal) nach", "find raus", "such mir
      raus", "welche … gibt es", "wer liefert …" → {t("web.lookup")}, then ANSWER
      from what comes back, in your own words: name the concrete things you
      found (two or three), and say plainly when it is late, closed or unknown
      (the context has the time). {t("web.read")} reads a page in full when the
      snippets are not enough. Opening a search page is not an answer.
    · When the user corrects a detail ("vergiss München", "nicht da, sondern
      …"), drop it completely and do the whole thing again without it.
    · weather now, later, tomorrow, anywhere → {t("weather.forecast")}. Never guess it.
    · the time here or in another place → {t("sys.time")}; which date or weekday a
      day is ("nächsten Freitag", "Weihnachten") → {t("date.lookup")}.
    · PLAY music → {t("media.play")}; pause, next, back → {t("media.control")}.
      SHOW something online — only when the user wants to SEE it ("zeig mir",
      "öffne", "such mir auf YouTube", a video, a page) → {t("web.search")} or
      {t("web.open")}; after a look-up you may open the best page as well. {t("web.download")} is ONLY for a direct link to a file.
    · Velvet itself — the island, the bar, the launcher, the look, sounds,
      animations, any setting → {t("settings.find")} (ENGLISH words, the settings
      are named in English), then {t("settings.set")} with the key and an allowed
      value; say what you changed in plain words (and that you can undo it).
      "Wie mache ich … in Velvet" / "wo stelle ich … ein" → {t("settings.find")},
      then say where it is (Super+Tab opens the settings) or which keys do it,
      in one or two sentences — and change NOTHING: a question how is not a
      wish to have it done. Offer to do it instead.
      A whole new STYLE for the desktop ("mach's wie Windows 11", "ein anderer
      Look", "was für Looks gibt es") → {t("look.list")} / {t("look.apply")};
      "nimm den wieder raus" → {t("look.undo")}. One-click rows in the
      settings.find result (key "action:…") run with {t("settings.set")}.
      "Etwas", "ein bisschen", "mehr", "weniger" change a setting FROM its
      current value (in the settings.find result) by a modest step — "etwas
      langsamer" on 2× is about 1.5×, not the minimum.
    · what was said in earlier conversations ("was hab ich dich gestern
      gefragt", "wie hieß das Restaurant nochmal") → {t("history.search")}.
    · facts about THIS machine (how many packages, disk space, which kernel,
      what is running) → {t("cmd.run")} with a command that only reads; read-only
      commands run at once, without asking. Never answer them from memory.
    · every calculation → {t("calc.eval")}, never in your head. Reminders, timers,
      alarms ("erinnere mich …", "in 10 Minuten", "morgen um 7") → {t("timer.set")}.
    · updating the system → {t("sys.update")}; installing a program → {t("pkg.install")};
      anything else that needs sudo or a password → {t("term.run")}. You can never type
      a password: the terminal window that opens is where the user types it — say so.
    · what the user copied → {t("clipboard.read")}; notifications ("was hab ich
      verpasst") → {t("notifs.list")}; writing something down for later → {t("file.write")}.
 3. Dangerous tools ({danger}) need a spoken confirmation first when the
    user did not already ask for that exact thing in this message. If they did, do it.
    EVERY other tool runs at once — {t("sys.update")}, {t("pkg.install")} and {t("term.run")}
    too: they open a terminal where the user types the password, and that IS
    their yes. Never ask "sag ja" on your own: only a tool result with
    needs_confirmation is a reason to ask.
    A tool result that says needs_confirmation is NOT a result: never pretend the
    command ran. Ask one short question — "Das braucht dein Okay — sag ja, dann
    mache ich es." — and stop there.
 4. When the user tells you something durable about themselves (their name,
    what they like, what they work on), call {t("memory.remember")}.
 5. Never invent facts about the machine — read them with a tool. The context
    block on the user's message is the state right now; it is not something
    the user said, and you never read it out.
 6. Clock and machine numbers are never remembered from the conversation: a
    time, a load, a volume that appears earlier in the chat is history, not an
    answer. Use the context block or call {t("sys.time")} / {t("sys.info")}.
"""
    return f"""{persona}{tools}
{rules}"""


def with_context(text: str, actions=None, last_answer: str = "") -> str:
    """The user's words with the moment's context in front of them, marked
    so she neither reads it out nor mistakes it for something said."""
    try:
        ctx = context_block(text, actions, last_answer)
    except Exception:                                          # noqa: BLE001
        ctx = f"time: {date_de()}, {time.strftime('%H:%M')} Uhr"
    return f"<kontext>\n{ctx}\n</kontext>\n{text}"


# Questions that are worth a moment of thought — explain, compare, why, how
# something works, plans and advice. Commands and small talk are not.
THINK_RE = re.compile(
    r"\b(warum|wieso|weshalb|erklär|erklaer|erkläre|wie funktioniert|wie geht das|was ist der unterschied|"
    r"unterschied|vergleich|was bedeutet|was heißt|was heisst|was ist ein|was sind|wer war|wer ist|"
    r"was würdest du|was wuerdest du|was meinst du|was hältst du|was haeltst du|hilf mir|plan|idee|ideen|"
    r"empfiehl|empfehlung|vorschlag|rechne|wie viel|wieviel|how|why|explain|difference|compare|"
    r"witz\w*|joke|lustig|gedicht|reim\w*|geschichte|erzähl|erzaehl|zähl\w*|zaehl\w*|aufzähl\w*|liste)\b", re.I)


# "Sag ja, dann mache ich es" with no tool waiting for that yes.
HOWTO_RE = re.compile(r"^\W*(?:und\s+|also\s+|sag\s+mal,?\s+|hey,?\s+|velly,?\s+)*(?:wie\s+(?:kann|könnte|muss|mache|mach|stelle|stell|"
                      r"ändere|änder|krieg|kriege|bekomme|schalte|aktiviere|deaktiviere|docke|setze|bringe|verschiebe)\s+ich|"
                      r"wo\s+(?:kann|stelle|stell|finde|ändere|schalte|mache)\s+ich|wie\s+geht\s+(?:das|es)|wie\s+funktioniert)\b", re.I)
FAKE_GATE = re.compile(r"sag\s+(?:einfach\s+|mir\s+)?[„\"'»]?ja\b|braucht dein (?:okay|ok|ja)|dein okay|"
                       r"(?:bestätige|bestaetige|bestätigst)\b|confirm", re.I)


# Asked for outright: think it all the way through.
DEEP_RE = re.compile(r"\b(denk\w*\s+(?:mal\s+)?(?:genau|gründlich|gruendlich|gut|in ruhe|richtig)|schritt für schritt|"
                     r"schritt fuer schritt|ausführlich|ausfuehrlich|gründlich|gruendlich|genau erklär\w*|"
                     r"step by step|think (?:hard|carefully)|in detail)\b", re.I)


def effort_for(text: str) -> str:
    """How deep she thinks. A short command stays quick (low); a question, a
    wish of more than a few words, anything to explain or decide gets medium —
    about half a second more on this machine, and the factual slips of low go
    away (measured); "denk genau nach" gets high."""
    t = text or ""
    if DEEP_RE.search(t):
        return "high"
    words = len(re.findall(r"\w+", t))
    if THINK_RE.search(t) or words >= 9 or (t.strip().endswith("?") and words >= 4):
        return "medium"
    return "low"


def token_budget(prov, answer_tokens: int, effort: str) -> int:
    """max_tokens for one round. A thinking model spends tokens BEFORE it
    answers; a budget sized for the answer alone cut gpt-oss off inside its
    reasoning (the empty answers of v8.16). The answer stays short because
    the prompt asks for it, not because the budget chokes it."""
    base = max(160, int(answer_tokens or 320))
    if prov.name == "local" and local_family() == "gpt-oss":
        return base + {"high": 3200, "medium": 1400}.get(effort, 600)
    return base * 2


# ── what the model says is what the user hears — and nothing else ─────────
# gpt-oss thinks in a separate channel; when a server does not split it off,
# or the model plans in its final answer, the plan used to reach the island:
# "We should produce the tool call line only. Then after the tool returns…"
# (measured, in German conversation). Tags go, a final channel wins, and
# English meta sentences in front of the real answer are dropped.
HARMONY_FINAL = re.compile(r"<\|channel\|>\s*final\s*<\|message\|>(.*)$", re.S)
HARMONY_TAGS = re.compile(r"<\|[a-z_]+\|>(?:analysis|final|commentary)?", re.I)
THINK_BLOCK = re.compile(r"<think>.*?(</think>|$)", re.S | re.I)
META_OPENERS = re.compile(
    r"^\s*(?:(?:we (?:should|need|must|can|will|have)|the user (?:wants|asks|is|said|says|asked|would)|user (?:wants|asks)"
    r"|i (?:should|need to|will|must|think)|let'?s|let me|so (?:we|the)|thus|therefore|according to"
    r"|now (?:we|i)|then (?:we|i|after)|first,? (?:we|i)|next,? (?:we|i)|okay,? (?:so|we|the user)"
    r"|the (?:answer|question|tool|result)|we'?ll|need to)\b)", re.I)


EN_META_WORDS = {"the", "we", "should", "need", "needs", "tool", "user", "answer", "call", "then", "after",
                 "returns", "output", "must", "will", "line", "short", "sentence", "respond", "response",
                 "provide", "produce", "only", "result", "results", "wants", "asks", "that", "matches",
                 "pattern", "format", "direct", "one", "reply", "just", "so", "and", "with", "in"}
DE_MARKERS = re.compile(r"[äöüß]|\b(ich|du|ist|nicht|und|wie|was|mach|bitte|mir|der|die|das|es|ein|eine|auf|zu|mit)\b", re.I)


EMOJI = re.compile("[\U0001F000-\U0001FAFF\U00002600-\U000027BF\U00002B00-\U00002BFF\uFE0F\u200D]+")


def english_meta(sentence: str) -> bool:
    words = re.findall(r"[a-z']+", sentence.lower())
    if len(words) < 3 or re.search(r"[äöüß]", sentence):
        return False
    hits = sum(1 for w in words if w in EN_META_WORDS)
    return hits >= 3 and hits / len(words) >= 0.3


def clean_answer(text: str, user_text: str = "") -> str:
    out = text or ""
    final = HARMONY_FINAL.search(out)
    if final:
        out = final.group(1)
    out = THINK_BLOCK.sub("", out)
    out = HARMONY_TAGS.sub("", out)
    out = out.replace("<|end|>", "").replace("<|return|>", "")
    # English planning in front of a German (or any) answer: drop sentence by
    # sentence while they read like notes to self.
    sentences = re.split(r"(?<=[.!?])\s+", out.strip())
    german = bool(DE_MARKERS.search(user_text or ""))
    while sentences and (META_OPENERS.match(sentences[0]) or (german and english_meta(sentences[0]))):
        sentences.pop(0)
    out = " ".join(sentences).strip()
    # Emoji: she is heard, and the voice either reads them out or trips on
    # them — and the prompt's "no emoji" did not stop 🎵 / 🎶 (measured).
    out = EMOJI.sub("", out)
    # Markdown the voice would read out loud — bold, italics, code, bullets
    # (also the ones glued into one line: "… Minuten. - Steam: …"), and
    # line breaks, which a spoken sentence does not have.
    out = re.sub(r"\*\*(.+?)\*\*", r"\1", out)
    out = re.sub(r"(?<![\w*])\*(?!\s)([^*\n]+?)(?<!\s)\*(?![\w*])", r"\1", out)
    out = re.sub(r"(?<![\w_])_(?!\s)([^_\n]+?)(?<!\s)_(?![\w_])", r"\1", out)
    out = re.sub(r"(?m)^\s*(?:[-*•]|\d+[.)])\s+", "", out)
    out = re.sub(r"(?<=[.!?:])\s+[-•]\s+", " ", out)
    out = re.sub(r"(?<=[.!?:)])\s+\d{1,2}[.)]\s+(?=[A-ZÄÖÜ])", " ", out)
    out = re.sub(r"`([^`]*)`", r"\1", out)
    out = re.sub(r"^#+\s*", "", out, flags=re.M)
    out = re.sub(r"\s*\n+\s*", " ", out)
    return collapse_loops(out.strip())


# A phrase the model got stuck on — "die ganze Zeit die ganze Zeit die ganze
# Zeit …" ended a joke in her real history — is said once, and the turn stops
# streaming the moment it starts (Runner.turn). No sampler penalty for it:
# gpt-oss's channel markers repeat by design and penalties bent its tool calls.
LOOP_RE = re.compile(r"(\b\S.{3,90}?)(?:[\s,–—-]+\1\b){2,}", re.S)


def collapse_loops(text: str) -> str:
    out = text or ""
    for _ in range(3):
        new = LOOP_RE.sub(r"\1", out)
        if new == out:
            break
        out = new
    return re.sub(r"(…\s*){2,}", "…", out).strip()


def drop_repeat_name(answer: str, name: str, last_answer: str) -> str:
    """The name as a form of address, twice in a row, is once too often —
    "Hey Creep!" in every answer made her sound like a script. When her last
    answer already said it, this one says it without the name."""
    if not name or not answer or not re.search(rf"\b{re.escape(name)}\b", last_answer or ""):
        return answer
    n = re.escape(name)
    out = re.sub(rf"^(\W*(?:hey|hi|hallo|na|oh|ach|alles klar|alles gut|klar|super|okay|ok))[,\s]+{n}\b\s*", r"\1", answer, flags=re.I)
    out = re.sub(rf",\s*{n}\b(?=\s*[!?.,:;—–-])", "", out)
    out = re.sub(rf"^{n}[,!]\s*", "", out)
    out = re.sub(r"^(\W*\w+)\s+([!?.])", r"\1\2", out)
    out = re.sub(r"(\w)([—–])", r"\1 \2", out)
    return (out[:1].upper() + out[1:]) if out else answer


def looks_like_planning(partial: str) -> bool:
    """While streaming: hide text that is starting out as a plan."""
    head = (partial or "").lstrip()[:80]
    return bool(head) and (head.startswith("<|") or head.lower().startswith("<think") or bool(META_OPENERS.match(head)))


# The prompt asks for [[tool:name {…}]]. Small local models drift on exactly
# that one word and write [[name {…}]] — and a drifted call used to be echoed to
# the user as plain text while nothing happened at all. The prefix is optional
# here, and a name that is not a real tool is left alone.
TOOL_RE = re.compile(r"\[\[\s*(?:tool\s*:\s*)?([A-Za-z_][\w.]*)\s*(\{.*?\})?\s*\]\]", re.S)
JSON_TOOL_RE = re.compile(r"^\s*\{\s*\"(?:tool|name)\"\s*:\s*\"([A-Za-z_][\w.]*)\"\s*(?:,\s*\"(?:args|arguments)\"\s*:\s*(\{.*\}))?\s*\}\s*$", re.M)


def resolve_tool_name(name: str) -> str:
    """A model that learned the tools from the native schema writes them with
    underscores ("cmd_run"); one that learned them from the prompt writes dots.
    Measured: the line came back as `[[tool:cmd_run {"command": …}]]`, matched
    nothing, and the user saw the raw call instead of the output."""
    if name in TOOLS:
        return name
    if not TOOL_NAME_MAP:
        tool_schema()          # deterministic names; fills the map on demand
    return TOOL_NAME_MAP.get(name, "")


def parse_tool_calls(text: str) -> list:
    calls = []
    for match in TOOL_RE.finditer(text or ""):
        name = resolve_tool_name(match.group(1))
        raw_args = match.group(2)
        if not name:
            continue
        args = {}
        if raw_args:
            try:
                parsed = json.loads(raw_args)
                if isinstance(parsed, dict):
                    args = parsed
            except ValueError:
                args = {}
        calls.append((name, args))
    if calls:
        return calls
    for match in JSON_TOOL_RE.finditer(text or ""):
        name = resolve_tool_name(match.group(1))
        if not name:
            continue
        raw_args = match.group(2)
        try:
            args = json.loads(raw_args) if raw_args else {}
        except ValueError:
            args = {}
        calls.append((name, args))
    return calls


def strip_tool_lines(text: str) -> str:
    return TOOL_RE.sub("", JSON_TOOL_RE.sub("", text or "")).strip()


# ────────────────────────────────────────────────────────── running a turn
class Runner:
    """One conversation. Owns the state file, the cancel flag and the memory."""

    def __init__(self, provider: Provider, forced: bool = False):
        self.prov = provider
        self.forced = forced          # the CLI may run without a session
        self.cfg = shell_config()
        self.state = {"at": now_ms(), "state": "ready", "phase": "ready", "turn": 0,
                      "user": "", "answer": "", "error": "", "brain": "none",
                      "provider": "", "model": "", "tools": [], "ms": 0, "session": False}
        self.cancel_flag = False
        self.last_write = 0.0
        self.pending_danger = {"name": "", "args": "", "until": 0.0, "turn": -1}
        # The request this turn answers (daemon only): a newer one in the
        # request file supersedes it — see cancel().
        self.req_id = None
        self._req_seen = 0.0
        # What she did lately, as (turn, "tool args → result") — so "nein,
        # das wollte ich nicht" knows what to undo.
        self.actions = []

    # ── state file
    def write_state(self, force=False) -> None:
        now = time.monotonic()
        if not force and now - self.last_write < 0.06:
            return
        self.last_write = now
        self.state["at"] = now_ms()
        write_json(STATE_PATH, self.state)

    # ── cancel
    def cancel(self) -> bool:
        """True once this turn should stop: cancelled, or superseded. The
        daemon's loop is blocked while a turn runs, so a cancel (or the second
        half of a sentence, sent as a new ask) used to wait until the old
        answer was finished — this looks at the request file itself."""
        if self.cancel_flag:
            return True
        if self.req_id is not None:
            now = time.monotonic()
            if now - self._req_seen > 0.15:
                self._req_seen = now
                req = read_json(REQ_PATH, {})
                if isinstance(req, dict) and req.get("id") not in (None, self.req_id) \
                        and req.get("kind") in ("ask", "cancel", "sleep"):
                    self.cancel_flag = True
        return self.cancel_flag

    def check_cancel_file(self) -> bool:
        data = read_json(REQ_PATH, {})
        if isinstance(data, dict) and data.get("kind") == "cancel":
            return True
        return False

    # ── tools
    def run_tool(self, name: str, args: dict, confirmed: bool = False) -> dict:
        spec = TOOLS.get(name)
        if spec is None:
            return {"ok": False, "error": f"there is no tool called {name}"}
        # A question HOW is not a wish to have it done — measured: "Wie kann
        # ich die Island an den Rand docken?" moved it (to the wrong side).
        if name in ("settings.set", "look.apply") and HOWTO_RE.search(str(self.state.get("user") or "")):
            return {"ok": False, "error": "the user asked HOW to do it, not to do it: change nothing. Tell them where "
                                          "it is (the settings.find path; Super+Tab opens the settings) in one or two "
                                          "sentences and offer to do it for them."}
        if not (self.forced or session_open()):
            return {"ok": False, "error": "session closed — Velly has no access right now"}
        # A command that needs a password opens in a terminal, and the password
        # prompt there is the user's own yes: no second "sag ja" first.
        if name == "cmd.run" and needs_root((args or {}).get("command")):
            confirmed = True
        # …and a command that only looks (counts packages, shows the disk)
        # needs no yes at all
        if name == "cmd.run" and safe_readonly((args or {}).get("command")):
            confirmed = True
        if spec.level == "danger" and not confirmed and (self.cfg.get("confirmDanger") is not False):
            slot = self.pending_danger
            turn = int(self.state.get("turn") or 0)
            # The confirmation is worth nothing if the same turn can arm it and
            # then call again — measured: cmd.run came back "ASKED TO CONFIRM"
            # and ran the command two seconds later, in that very turn. Only a
            # NEW turn (the user's answer) may use the armed slot.
            # And a yes covers exactly the action it was asked about, once —
            # not any command for the next two minutes.
            sig = json.dumps(args or {}, sort_keys=True, ensure_ascii=False)
            armed = (slot["name"] == name and slot.get("args") == sig
                     and time.time() < slot["until"]
                     and int(slot.get("turn") or 0) != turn)
            if armed:
                slot.update(name="", args="", until=0.0)
            else:
                slot["name"] = name
                slot["args"] = sig
                slot["until"] = time.time() + CONFIRM_WINDOW
                slot["turn"] = turn
                # The island shows the question with two buttons; a spoken
                # "ja" works the same way (turn() runs exactly this action).
                self.state["confirm"] = {"tool": name, "what": describe_action(name, args or {}),
                                         "until": int(slot["until"] * 1000)}
                return {"ok": False, "needs_confirmation": True,
                        "error": "ask the user to confirm; it runs when they say yes in their next message"}
        try:
            # Only the arguments the function actually declares: a model that
            # adds a stray key should not fail the whole call.
            accepted = inspect.signature(spec.fn).parameters
            clean = {k: v for k, v in (args or {}).items() if k in accepted}
            result = spec.fn(**clean)
        except TypeError as exc:
            result = {"ok": False, "error": f"bad arguments: {exc}"}
        except Exception as exc:                               # noqa: BLE001
            result = {"ok": False, "error": f"{type(exc).__name__}: {exc}"}
        if not isinstance(result, dict):
            result = {"ok": True, "result": result}
        result.setdefault("ok", True)

        mem = memory()
        stats = mem.setdefault("stats", {"turns": 0, "tools": {}, "sessions": 0})
        tools_used = stats.setdefault("tools", {})
        tools_used[name] = int(tools_used.get(name) or 0) + 1
        save_memory(mem)
        return result

    # ── one turn
    def turn(self, text: str) -> str:
        text = (text or "").strip()
        if not text:
            return ""
        began = time.monotonic()
        self.state.update({"state": "thinking", "phase": "thinking", "user": text,
                           "answer": "", "error": "", "tools": [], "session": session_open()})
        self.state["turn"] = int(self.state.get("turn") or 0) + 1
        self.write_state(force=True)

        if not self.prov.ok:
            answer = local_skill(text)
            self.state.update({
                "state": "ready", "phase": "ready", "brain": "skills" if answer else "none",
                "provider": "", "model": "",
                "answer": answer or ("Kein Gehirn, noch. Langes Drücken auf die Insel, dann im SETUP "
                                     "einmal LOKAL laden — danach denke ich hier, kostenlos."),
                "error": "" if answer else "no provider",
                "ms": int((time.monotonic() - began) * 1000),
            })
            self.write_state(force=True)
            self.append_history(text, self.state["answer"])
            return self.state["answer"]

        self.state.update({"brain": self.prov.name, "provider": self.prov.name, "model": self.prov.model})
        history = self.tail_history()
        last_answer = next((m["content"] for m in reversed(history) if m["role"] == "assistant"), "")

        # ── the answer to her own question: "ja" runs exactly the action she
        # asked about, "nein" drops it. It used to depend on the model calling
        # the same tool with the same arguments again — it often did not, and
        # every "ja" got another "sag ja" (measured, four times in a row).
        settled = self.settle_confirmation(text, history, last_answer, began)
        if settled is not None:
            return settled
        # The answer to her own question is an answer, not a command: the
        # name she asked for is stored and greeted, here, without a model
        # that might hear a song title in it (it did: "Creep").
        named = name_reply(text, last_answer)
        quick = ""
        if named:
            remember(f"Heißt {named}.", tags=["told"])
            import random                                      # noqa: PLC0415
            quick = random.choice([f"Freut mich, {named}! Merk ich mir.", f"{named} — schöner Name. Hab ich mir gemerkt!",
                                   f"Alles klar, {named}. Ab jetzt weiß ich's."])
        else:
            # "Nenn mich Max", "ich heiße Lara" in passing: kept, whatever
            # the model makes of the rest of the sentence.
            if re.search(r"\b(ich hei(?:ß|ss)e|mein name ist|nenn(?:e)? mich|mich\s+(?:\w+\s+){0,3}nennen)\b", text, re.I):
                stated = name_in(text)
                if stated:
                    remember(f"Heißt {stated}.", tags=["told"])
            quick = local_skill(text, brain=True)
        if quick:
            self.state.update({"state": "answer", "phase": "answer", "answer": quick, "error": "",
                               "brainError": "", "tools": [],
                               "ms": int((time.monotonic() - began) * 1000)})
            self.write_state(force=True)
            self.append_history(text, quick)
            return quick
        messages = [{"role": m["role"], "content": m["content"]} for m in history]
        # The moment's context (time, windows, volume, what she remembers)
        # rides on THIS message, not in the system prompt: the system prompt
        # and the tools stay byte-for-byte the same all session, so the server
        # keeps them in its cache and only reads what is new. With the context
        # in the system prompt every turn re-read ~4800 tokens (measured 15 s).
        turn_no = int(self.state.get("turn") or 0)
        recent = [what for at, what in self.actions if turn_no - at <= 2]
        messages.append({"role": "user", "content": with_context(text, recent, last_answer)})
        native = self.prov.native
        system = system_prompt(native)
        limit = int(self.cfg.get("maxTokens") or 320) * 4
        temperature = float(self.cfg.get("temperature") or 0.6)
        effort = effort_for(text)
        budget = token_budget(self.prov, int(self.cfg.get("maxTokens") or 320), effort)
        answer = ""
        asked_confirm = False
        known_name = user_name()

        try:
            for _round in range(MAX_TOOL_ROUNDS):
                streamed = []
                # a phrase repeating itself ends the stream at once (see
                # collapse_loops) — what was said up to there is the answer
                looped = [False, ""]

                def on_delta(partial, streamed=streamed, looped=looped):
                    looped[1] = partial
                    if not looped[0] and LOOP_RE.search(strip_tool_lines(partial)):
                        looped[0] = True
                    # A plan that starts to stream is not shown; the cleaned
                    # answer replaces it at the end of the round. The voice
                    # reads along (--follow), so it gets the same text the
                    # final answer will be.
                    shown = "" if looks_like_planning(partial) else \
                        drop_repeat_name(clean_answer(strip_tool_lines(partial), text), known_name, last_answer)
                    self.state["answer"] = shown[:limit]
                    self.write_state()

                # The first round thinks as deep as the question needs; after a
                # tool round she only has to say what happened.
                try:
                    out = self.prov.stream(messages, system, on_delta, lambda looped=looped: self.cancel() or looped[0],
                                           temperature, budget, effort if _round == 0 else "low")
                except Cancelled:
                    if not looped[0] or self.cancel():
                        raise
                    log("a phrase started repeating itself — stream cut, the answer kept once")
                    out = looped[1]
                    self.prov.last_calls = []
                native_calls = list(self.prov.last_calls) if native else []
                calls = [(c["name"], c["args"]) for c in native_calls] or parse_tool_calls(out)
                spoken = clean_answer(strip_tool_lines(out), text)
                if not calls:
                    answer = spoken[:limit]
                    break
                if native_calls:
                    # Her calls go back as calls, the results as tool messages
                    # with the call's id — the model sees its own tool use the
                    # way it was trained to, not as prose it has to decode.
                    said = strip_tool_lines(out).strip()
                    call_msg = {"role": "assistant", "content": said,
                                "tool_calls": [{"id": c["id"], "type": "function",
                                                "function": {"name": c["safe"], "arguments": c["raw"]}}
                                               for c in native_calls]}
                    if self.prov.name == "local" and self.prov.last_reasoning:
                        call_msg["reasoning_content"] = self.prov.last_reasoning
                    messages.append(call_msg)
                else:
                    messages.append({"role": "assistant", "content": out})
                results = []
                for index, (name, args) in enumerate(calls):
                    if self.cancel():
                        raise Cancelled()
                    self.state["state"] = "acting"
                    self.state["phase"] = "acting"
                    result = self.run_tool(name, args)
                    if isinstance(result, dict) and result.get("needs_confirmation"):
                        asked_confirm = True
                    self.state["tools"] = (self.state.get("tools") or []) + [
                        {"name": name, "ok": bool(result.get("ok")), "note": short_note(result)}]
                    if not result.get("needs_confirmation"):
                        shown_args = json.dumps(args or {}, ensure_ascii=False)[:90]
                        self.actions = (self.actions + [(turn_no, f"{T(name, native)} {shown_args} → "
                                                                  f"{'ok' if result.get('ok') else 'failed'}: {short_note(result)}")])[-8:]
                    self.state["state"] = "thinking"
                    self.state["phase"] = "thinking"
                    self.write_state(force=True)
                    cap = {"web.lookup": 3000, "web.read": 3400, "clipboard.read": 2700, "weather.forecast": 1800,
                           "notifs.list": 1400, "cmd.run": 2000, "pkg.search": 1400}.get(name, 700)
                    payload = json.dumps(result, ensure_ascii=False)[:cap]
                    if native_calls:
                        messages.append({"role": "tool", "tool_call_id": native_calls[index]["id"], "content": payload})
                    else:
                        results.append(f"{name} → {payload}")
                if not native_calls:
                    messages.append({"role": "user", "content": "TOOL RESULTS\n" + "\n".join(results)})
            else:
                # Six rounds of tools and still no sentence: the nudge below
                # asks for one ("…" used to be the answer here — measured).
                answer = spoken
            # She asked for a yes that nothing is waiting for — the gate was
            # imagined, and the user's "ja" would only have met another "sag
            # ja" (measured with the update, at medium effort). Once, firmly:
            # do it with the tool, or say why not.
            if not asked_confirm and FAKE_GATE.search(answer or "") and not self.cancel():
                nudge = messages + [{"role": "assistant", "content": answer},
                                    {"role": "user", "content": "(System: Nichts wartet auf ein Ja — du hast kein Werkzeug "
                                                                "aufgerufen. Ruf jetzt das passende Werkzeug auf, das tut, "
                                                                "worum der Nutzer gebeten hat, und sag dann kurz, was passiert ist.)"}]
                out = self.prov.stream(nudge, system, lambda *_: None, self.cancel, temperature, budget, "low")
                retry_calls = [(c["name"], c["args"]) for c in (self.prov.last_calls if native else [])] or parse_tool_calls(out)
                if retry_calls:
                    results_txt = []
                    for name, args in retry_calls[:3]:
                        result = self.run_tool(name, args)
                        if isinstance(result, dict) and result.get("needs_confirmation"):
                            asked_confirm = True
                        self.state["tools"] = (self.state.get("tools") or []) + [
                            {"name": name, "ok": bool(result.get("ok")), "note": short_note(result)}]
                        self.actions = (self.actions + [(turn_no, f"{T(name, native)} {json.dumps(args or {}, ensure_ascii=False)[:90]} → "
                                                                  f"{'ok' if result.get('ok') else 'failed'}: {short_note(result)}")])[-8:]
                        results_txt.append(f"{name} → {json.dumps(result, ensure_ascii=False)[:700]}")
                    if asked_confirm:
                        answer = 'Das braucht dein Okay — sag „ja“, dann mache ich es.'
                    else:
                        follow = messages + [{"role": "user", "content": "TOOL RESULTS\n" + "\n".join(results_txt)
                                              + "\n(Sag dem Nutzer in ein, zwei kurzen Sätzen, was passiert ist — ohne Werkzeuge.)"}]
                        out = self.prov.stream(follow, system, lambda *_: None, self.cancel, temperature, budget, "low")
                        answer = clean_answer(strip_tool_lines(out), text)[:limit] or "Erledigt."
                else:
                    answer = clean_answer(strip_tool_lines(out), text)[:limit] or answer
            if asked_confirm and not (answer or "").strip():
                # The model looped on the gate instead of asking. Ask for it
                # here, in one plain sentence — nobody should get an empty
                # bubble because a safety check worked.
                answer = 'Das braucht dein Okay — sag „ja“, dann mache ich es.'
            if not (answer or "").strip():
                # Once, quietly, with a colder sampler and one plain sentence:
                # a model that ended inside its own think channel (gpt-oss at
                # low effort did exactly that — measured) answers when asked
                # directly. If it still says nothing, say so instead of
                # leaving an empty bubble on the island.
                nudge = messages + [{"role": "user",
                                     "content": "Antworte jetzt direkt, in ein bis zwei kurzen Sätzen."}]
                out = self.prov.stream(nudge, system, lambda *_: None, self.cancel, 0.2, budget, "low")
                answer = clean_answer(strip_tool_lines(out), text)[:limit] or answer
                if not (answer or "").strip():
                    answer = "Das kam gerade nicht durch — frag mich nochmal."
        except Cancelled:
            self.state.update({"state": "ready", "phase": "ready", "error": "", "answer": answer or ""})
            self.write_state(force=True)
            return self.state["answer"]
        except ProviderError as exc:
            # The failure is the turn's, not the brain's: keep saying WHICH
            # brain she has, and put the reason beside it.
            self.state.update({"state": "error", "phase": "error", "error": str(exc)[:300],
                               "brainError": str(exc)[:300], "answer": ""})
            self.write_state(force=True)
            note(f"provider error: {str(exc)[:160]}")
            return ""
        except Exception as exc:                               # noqa: BLE001
            self.state.update({"state": "error", "phase": "error",
                               "error": f"{type(exc).__name__}: {exc}"[:300],
                               "brainError": f"{type(exc).__name__}: {exc}"[:300], "answer": ""})
            self.write_state(force=True)
            return ""

        answer = drop_repeat_name(answer, known_name, last_answer)
        self.state.update({
            "state": "answer", "phase": "answer", "answer": answer, "error": "",
            "brainError": "",
            "ms": int((time.monotonic() - began) * 1000),
        })
        self.write_state(force=True)
        self.append_history(text, answer)
        mem = memory()
        stats = mem.setdefault("stats", {"turns": 0, "tools": {}, "sessions": 0})
        stats["turns"] = int(stats.get("turns") or 0) + 1
        stats["last"] = now_ms()
        save_memory(mem)
        return answer

    def settle_confirmation(self, text: str, history: list, last_answer: str, began: float):
        """None when there is nothing waiting (or the user moved on); else the
        finished answer of this turn."""
        slot = self.pending_danger
        turn_no = int(self.state.get("turn") or 0)
        waiting = slot.get("name") and time.time() < float(slot.get("until") or 0) \
            and int(slot.get("turn") or 0) != turn_no
        if not waiting:
            if slot.get("name"):
                slot.update(name="", args="", until=0.0)
            self.state["confirm"] = None
            return None
        yes, no = is_yes(text), is_no(text)
        if not (yes or no):
            # Something else entirely: the question is off the table.
            slot.update(name="", args="", until=0.0)
            self.state["confirm"] = None
            return None
        name = slot["name"]
        try:
            args = json.loads(slot.get("args") or "{}")
        except ValueError:
            args = {}
        slot.update(name="", args="", until=0.0)
        self.state["confirm"] = None
        import random                                          # noqa: PLC0415
        if no:
            answer = random.choice(["Okay, lass ich.", "Alles klar, dann nicht.", "Gut — abgebrochen.",
                                    "Kein Problem, mach ich nicht."])
            self.state["tools"] = []
        else:
            self.state.update({"state": "acting", "phase": "acting"})
            self.write_state(force=True)
            result = self.run_tool(name, args, confirmed=True)
            self.state["tools"] = [{"name": name, "ok": bool(result.get("ok")), "note": short_note(result)}]
            shown = json.dumps(args or {}, ensure_ascii=False)[:90]
            self.actions = (self.actions + [(turn_no, f"{T(name, self.prov.native)} {shown} → "
                                                      f"{'ok' if result.get('ok') else 'failed'}: {short_note(result)}")])[-8:]
            answer = self.say_result(name, args, result, history, text)
        self.state.update({"state": "answer", "phase": "answer", "answer": answer, "error": "", "brainError": "",
                           "ms": int((time.monotonic() - began) * 1000)})
        self.write_state(force=True)
        self.append_history(text, answer)
        return answer

    def say_result(self, name: str, args: dict, result: dict, history: list, text: str) -> str:
        """One spoken sentence about an action that just ran: the model words
        it from the real result; a plain sentence if the model is not there."""
        ok = bool(result.get("ok"))
        payload = json.dumps(result, ensure_ascii=False)[:1600]
        fallback = ("Erledigt." if ok else f"Hat nicht geklappt — {str(result.get('error') or result.get('output') or '').strip()[:140]}")
        if name.startswith("session.") or name == "shell.restart":
            return {"session.lock": "Mach ich — bis gleich.", "session.logout": "Okay, ich melde dich ab.",
                    "session.suspend": "Gute Nacht — ich leg den Rechner schlafen.",
                    "session.reboot": "Bis gleich — ich starte neu.", "session.shutdown": "Okay, ich schalte aus. Bis bald!",
                    "shell.restart": "Bin gleich wieder da."}.get(name, fallback) if ok else fallback
        try:
            messages = [{"role": m["role"], "content": m["content"]} for m in history[-6:]]
            messages.append({"role": "user", "content": f"{text}\n\n(Du hast nach meinem Ja gerade "
                             f"{T(name, self.prov.native)} {json.dumps(args or {}, ensure_ascii=False)} ausgeführt. "
                             f"Ergebnis: {payload}\nSag mir in ein bis zwei kurzen gesprochenen Sätzen, was dabei "
                             f"herauskam — ohne Werkzeuge.)"})
            out = self.prov.stream(messages, system_prompt(self.prov.native), lambda *_: None, self.cancel,
                                   0.4, token_budget(self.prov, 200, "low"), "low")
            said = clean_answer(strip_tool_lines(out), text).strip()
            return said or fallback
        except Exception:                                      # noqa: BLE001
            return fallback

    # ── history
    def tail_history(self, limit=12) -> list:
        mem = memory()
        # This conversation, not last week's: a new wake starts fresh — older
        # turns used to be carried into every session, and she answered them.
        since = now_ms() - 20 * 60 * 1000
        hist = [h for h in (mem.get("history") or [])
                if isinstance(h, dict) and h.get("text") and int(h.get("t") or 0) > since]
        out = []
        for item in hist[-limit:]:
            role = "assistant" if item.get("role") == "velly" else "user"
            content = item["text"]
            # Consecutive turns of the same role (repeated asks, a question the
            # brain never answered) are one message — a stack of bare "user"
            # messages is what makes a model answer the wrong instruction.
            if out and out[-1]["role"] == role:
                out[-1]["content"] = f"{out[-1]['content']}\n{content}"
            else:
                out.append({"role": role, "content": content})
        return out

    def append_history(self, user_text: str, answer: str) -> None:
        # A turn that produced no answer is not a turn: it used to be appended
        # anyway, so three unanswered "Installiere Spicetify für mich." piled up
        # as a block of user messages and the model started answering the OLD
        # one — measured. Unresolved asks stay out of the context.
        if not (answer or "").strip():
            return
        mem = memory()
        hist = [h for h in (mem.get("history") or []) if isinstance(h, dict)]
        hist.append({"t": now_ms(), "role": "user", "text": user_text[:600]})
        if answer:
            hist.append({"t": now_ms(), "role": "velly", "text": answer[:600]})
        mem["history"] = hist[-400:]
        save_memory(mem)


# A spoken yes or no to a question she asked. Only short answers count — "ja,
# aber spiel lieber Musik" is a new wish, not a yes.
YES_STRONG = {"ja", "jo", "jap", "jep", "jup", "jawohl", "yes", "yeah", "yep", "yup", "ok", "okay", "okey", "oki",
              "klar", "sicher", "mach", "machs", "mach's", "los", "go", "genau", "passt", "einverstanden", "gerne",
              "gern", "tu", "tus", "tu's", "natürlich", "logo", "absolut", "sure", "bitte", "unbedingt", "freilich",
              "richtig", "korrekt", "bestätigt", "bestätige", "do"}
YES_SOFT = {"es", "das", "bitte", "mal", "leg", "na", "auf", "jeden", "fall", "ruhig", "doch", "schon", "it", "so",
            "einfach", "jetzt", "gleich", "velly", "danke", "ja", "mach", "gerne", "klar"}
NO_STRONG = {"nein", "nee", "ne", "nö", "noe", "no", "nope", "abbrechen", "abbruch", "stopp", "stop", "vergiss",
             "lass", "cancel", "nicht", "lieber", "niemals", "warte"}
NO_SOFT = {"es", "das", "bitte", "mal", "doch", "lieber", "nicht", "sein", "bleiben", "danke", "velly", "jetzt",
           "noch", "nein", "lass", "es", "gut", "egal"}


def answer_words(text: str) -> list:
    return re.findall(r"[a-zäöüß']+", (text or "").lower())


def is_yes(text: str) -> bool:
    words = answer_words(text)
    if not words or len(words) > 6:
        return False
    if any(w in NO_STRONG for w in words) and not ("doch" in words and "nicht" not in words):
        return False
    return any(w in YES_STRONG for w in words) and all(w in YES_STRONG or w in YES_SOFT for w in words)


def is_no(text: str) -> bool:
    words = answer_words(text)
    if not words or len(words) > 6:
        return False
    return any(w in NO_STRONG for w in words) and all(w in NO_STRONG or w in NO_SOFT for w in words)


ACTION_WORDS = {"session.lock": "den Bildschirm sperren", "session.logout": "dich abmelden",
                "session.suspend": "den Rechner schlafen legen", "session.reboot": "den Rechner neu starten",
                "session.shutdown": "den Rechner ausschalten", "shell.restart": "die Shell neu starten"}


def describe_action(name: str, args: dict) -> str:
    """What a waiting action does, in a few words the island can show."""
    if name == "cmd.run":
        return f"den Befehl „{str((args or {}).get('command') or '').strip()[:90]}“ ausführen"
    return ACTION_WORDS.get(name, name)


def short_note(result: dict) -> str:
    if not isinstance(result, dict):
        return ""
    if result.get("needs_confirmation"):
        return "ASKED TO CONFIRM"
    if result.get("ok"):
        # What the chip says: the thing itself, not "OK".
        if "site" in result:
            return str(result["site"]).upper()[:60]
        if "due" in result:
            return f"UM {result['due']}"[:60]
        if "result" in result and "expr" in result:
            return f"= {result['result']}"[:60]
        if "summary" in result:
            return f"CPU {result.get('cpu_percent', '?')} %"[:60]
        if "timers" in result:
            return f"{len(result['timers'])} OFFEN"
        # a setting she changed: what it was, so "mach das rückgängig" knows
        if "old" in result and "now" in result:
            return f"{result.get('name') or result.get('key')}: {result['old']} → {result['now']}"[:60]
        for key in ("app", "window", "percent", "workspace", "action", "mood", "url"):
            if key in result:
                return f"{key} {result[key]}"[:60]
        return "OK"
    return str(result.get("error") or "FAILED")[:60]


# ──────────────────────────────────────────────────────────────── learning
def learn(session_turns: int = 0) -> dict:
    """Distil what is NEW since the last time into a note and a few durable
    facts about the person — never the same turns twice (every session used
    to re-read the last 24 lines and re-learn "speaks German" again)."""
    prov = Provider()
    mem = memory()
    stats = mem.setdefault("stats", {"turns": 0, "tools": {}, "sessions": 0})
    since = int(stats.get("learnedAt") or 0)
    hist = [h for h in (mem.get("history") or []) if isinstance(h, dict) and int(h.get("t") or 0) > since]
    recent = hist[-24:]
    if len(recent) < 2 or not prov.ok or not shell_config().get("learn"):
        tidy_memory()
        return {"ok": False, "reason": "nothing new to learn"}
    transcript = "\n".join(f"{h.get('role')}: {h.get('text')}" for h in recent)
    known = [f.get("text", "") for f in (mem.get("facts") or []) if isinstance(f, dict)][-30:]
    system = ("You keep a small, durable memory about ONE person. Reply with JSON only, no prose:\n"
              '{"note": "one short line about this conversation", "facts": ["…"]}\n'
              "Facts: at most 2, in German, each a short sentence about the PERSON themselves — their name, "
              "what they like or dislike, what they use (hardware, apps), what they work on, how they want to be "
              "talked to. NOT what happened in this conversation, NOT what they asked for once, NOT errors, "
              "NOT tests, NOT the assistant. Nothing already known. An empty list is the usual answer.\n"
              "Already known: " + (" | ".join(known) if known else "nothing"))
    try:
        out = prov.stream([{"role": "user", "content": transcript}], system, lambda *_: None, None, 0.2, 400)
    except (ProviderError, Exception):                        # noqa: BLE001
        return {"ok": False, "reason": "provider failed"}
    text = re.sub(r"^```(?:json)?|```$", "", clean_answer(out or "").strip(), flags=re.M).strip()
    match = re.search(r"\{.*\}", text, re.S)
    added = []
    if match:
        try:
            data = json.loads(match.group(0))
        except ValueError:
            data = {}
        if isinstance(data.get("note"), str) and data["note"].strip() and not JUNK_FACT.search(data["note"]):
            note(data["note"].strip())
        for fact in (data.get("facts") or [])[:2]:
            if not (isinstance(fact, str) and len(fact.strip()) > 3) or JUNK_FACT.search(fact):
                continue
            result = remember(fact.strip())
            if result.get("ok") and result.get("note") != "already known":
                added.append(fact.strip())
    mem = memory()
    stats = mem.setdefault("stats", {"turns": 0, "tools": {}, "sessions": 0})
    stats["sessions"] = int(stats.get("sessions") or 0) + 1
    stats["learnedAt"] = int(recent[-1].get("t") or now_ms())
    save_memory(mem)
    tidy_memory()
    return {"ok": True, "facts": added}


# ──────────────────────────────────────────────────────────────── the daemon
def daemon() -> int:
    prov = Provider()
    runner = Runner(prov)
    runner.state.update(brain_fields(prov))
    runner.write_state(force=True)
    if prov.name == "local" and session_open():
        # Warm start: the weights load while the greeting is still playing, so
        # the first real question does not pay for the load. Only for a session
        # that is really open — a lingering brain must not pull the model up
        # for nobody. Then the prompt cache is filled in the background.
        if not local_health():
            local_spawn()
        threading.Thread(target=warm_prompt, daemon=True).start()

    start_ppid = os.getppid()
    running = True
    last_req_id = None

    def stop(_sig, _frm):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    def consume(req: dict) -> None:
        """Mark the request as read. The shell writes one file, and a brain that
        starts after the fact must not answer a question its predecessor already
        answered — or, worse, go straight back to sleep on an old "sleep" and
        take the model down with it. Never writes over a NEWER request: the
        shell may already have moved on while this one was being read."""
        current = read_json(REQ_PATH, {})
        if isinstance(current, dict) and current.get("id") != req.get("id"):
            return
        payload = dict(req)
        payload["kind"] = ""
        write_json(REQ_PATH, payload)

    last_parent_check = 0.0
    while running:
        now = time.monotonic()
        if now - last_parent_check > 2.0:
            last_parent_check = now
            if os.getppid() != start_ppid:
                log("parent disappeared — exiting")
                break

        req = read_json(REQ_PATH, {})
        if isinstance(req, dict):
            req_id = req.get("id")
            kind = req.get("kind")
            if req_id != last_req_id and kind == "cancel":
                last_req_id = req_id
                runner.cancel_flag = True
            elif req_id != last_req_id and kind == "ask":
                last_req_id = req_id
                runner.cancel_flag = False
                text = str(req.get("text") or "")
                # Consume BEFORE the turn, not after it: an interrupted turn (a
                # closed session, a killed shell) left its request in the file,
                # and the next brain answered a question from minutes ago —
                # measured: an ask written at 19:54:54 was still being worked on
                # at 20:07:07. Read once, and read now.
                consume(req)
                age_ms = max(0.0, time.time() * 1000 - float(req.get("at") or 0))
                if age_ms > 240000:
                    log(f"stale ask ({age_ms / 1000:.0f}s old) — dropped")
                    runner.state.update({"state": "ready", "phase": "ready",
                                         "answer": "", "error": "",
                                         "note": "stale request dropped"})
                    runner.write_state(force=True)
                elif not session_open():
                    runner.state.update({"state": "closed", "phase": "closed",
                                         "error": "session closed", "answer": "",
                                         "brain": prov.name or "none"})
                    runner.write_state(force=True)
                else:
                    runner.prov = Provider()
                    runner.cfg = shell_config()
                    runner.state.update(brain_fields(runner.prov))
                    runner.req_id = req_id
                    runner._req_seen = 0.0
                    runner.turn(text)
                    runner.req_id = None
            elif req_id != last_req_id and kind == "setup":
                # The wizard's fields arrive the same way everything else does.
                # The shell never writes the key file itself: 0600 is decided
                # here, and the provider is re-resolved right after so the
                # island's status line tells the truth immediately.
                last_req_id = req_id
                if not session_open():
                    runner.state["setup"] = "error: session closed"
                    runner.write_state(force=True)
                else:
                    merge_ai(req.get("fields") if isinstance(req.get("fields"), dict) else {})
                    runner.prov = Provider()
                    runner.state.update(brain_fields(runner.prov))
                    runner.state["setup"] = "ok" if runner.prov.ok else f"error: {runner.prov.error}"
                    runner.write_state(force=True)
                    consume(req)
            elif req_id != last_req_id and kind == "sleep":
                last_req_id = req_id
                consume(req)
                runner.state.update({"state": "ready", "phase": "ready"})
                runner.write_state(force=True)
                if session_open():
                    log("sleep requested while the session is still open — staying up")
                else:
                    # Nothing said this session → nothing new to learn.
                    if shell_config().get("learn") and int(runner.state.get("turn") or 0) > 0:
                        learn()
                    if prov.name == "local" or runner.prov.name == "local":
                        # Asleep: the weights go back to the disk and the VRAM
                        # is yours again — at once, or after WACH BLEIBEN.
                        local_rest()
                    break
        time.sleep(0.08)

    runner.state.update({"state": "off", "phase": "off"})
    runner.write_state(force=True)
    if prov.name == "local" or runner.prov.name == "local":
        # Every way out of this loop — sleep, SIGTERM, the shell leaving — ends
        # with the weights back on disk: at once, or after WACH BLEIBEN (the
        # engine room's watcher counts that down, and gives way to a game).
        local_rest()
    return 0


# ──────────────────────────────────────────────────────────────── entry points
def set_key(args) -> int:
    """Read a secret from stdin — never from argv, which is world-readable."""
    payload = read_json(AI_PATH, {})
    if not isinstance(payload, dict):
        payload = {}
    updated = list(args) or ["apiKey"]
    values = sys.stdin.read().strip().split("\n")
    for i, field in enumerate(updated):
        if i < len(values) and field in DEFAULTS:
            payload[field] = values[i].strip()
    os.makedirs(CONF_DIR, exist_ok=True)
    fd = os.open(AI_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, indent=1)
    try:
        os.chmod(AI_PATH, 0o600)
    except OSError:
        pass
    print("velvet-ai: wrote", AI_PATH)
    return 0


def selftest() -> int:
    fails = []
    # protocol
    sample = 'Sure.\n[[tool:volume.set {"percent": 40}]]\n[[tool:win.list {}]]'
    calls = parse_tool_calls(sample)
    if [c[0] for c in calls] != ["volume.set", "win.list"] or calls[0][1] != {"percent": 40}:
        fails.append("tool protocol parse")
    if strip_tool_lines(sample).strip() != "Sure.":
        fails.append("tool line stripping")
    if parse_tool_calls('{"tool": "tasks.list", "args": {}}'):
        pass
    else:
        fails.append("json tool parse")
    # registry
    for name, spec in TOOLS.items():
        if not callable(spec.fn) or spec.level not in ("read", "write", "danger"):
            fails.append(f"tool {name} malformed")
    if len(TOOLS) < 30:
        fails.append(f"only {len(TOOLS)} tools")
    # prompt — the text protocol for providers without tools, the native one
    # (no protocol text, underscore names) for the rest; both static
    prompt = system_prompt()
    if "Velly" not in prompt or "[[tool:" not in prompt:
        fails.append("system prompt")
    native_prompt = system_prompt(True)
    if "[[tool:" in native_prompt or "web_lookup" not in native_prompt or "{{" in native_prompt:
        fails.append("native system prompt")
    if system_prompt(True) != native_prompt or "time:" in native_prompt:
        fails.append("system prompt is not static (the context belongs on the message)")
    if not with_context("hallo").startswith("<kontext>") or not with_context("hallo").endswith("hallo"):
        fails.append("context on the message")
    if effort_for("mach lauter") != "low" or effort_for("erklär mir was ein kernel ist") != "medium":
        fails.append("reasoning effort")
    if clean_answer("Läuft! 🎶", "spiel was") != "Läuft!":
        fails.append("emoji in answers")
    if "media.play" not in TOOLS or spotify_title("Numb - song and lyrics by Linkin Park | Spotify") != "Numb von Linkin Park":
        fails.append("media.play")
    if _unwrap("https://duckduckgo.com/l/?uddg=https%3A%2F%2Fexample.org%2Fa") != "https://example.org/a":
        fails.append("search link unwrap")
    # session gate
    if session_open():
        fails.append("session gate should be closed in a selftest")
    # memory round trip
    before = memory().get("facts")
    fid = remember("selftest fact", ["selftest"]).get("id")
    if not fid or not any(f.get("text") == "selftest fact" for f in memory().get("facts", [])):
        fails.append("remember")
    forget("selftest fact")
    if len(memory().get("facts") or []) != len(before or []):
        fails.append("forget left residue")
    # local skills, no provider needed
    answer = local_skill("wie spät ist es")
    if not answer.startswith("Es ist"):
        fails.append("skill: time")
    if TOOLS["volume.set"].level != "write" or TOOLS["session.reboot"].level != "danger":
        fails.append("tool levels")
    # state write
    run = Runner(Provider())
    run.state["state"] = "selftest"
    run.write_state(force=True)
    written = read_json(STATE_PATH, {})
    if written.get("state") != "selftest":
        fails.append("state file write")
    # stt honesty
    if Provider().has_ears() and not Provider().name:
        fails.append("ears without provider")
    # what reaches the user: no leaked planning, German dates, no dead ends
    leaked = ("We should produce the tool call line only. Then after the tool returns, we answer with a short "
              "sentence. Es ist 14:03 Uhr.")
    if clean_answer(leaked, "wie spät ist es") != "Es ist 14:03 Uhr.":
        fails.append("leaked planning not cleaned")
    if clean_answer("<|channel|>analysis<|message|>x<|end|><|start|>assistant<|channel|>final<|message|>Ja, klar.", "") != "Ja, klar.":
        fails.append("harmony final channel")
    if not any(day in date_de() for day in WEEKDAYS_DE):
        fails.append("German date")
    for phrase in ("Guten Tag Velly", "ich hab keine Zeit", "lass mich in ruhe", "starte eine suche auf youtube"):
        if local_skill(phrase, brain=True):
            fails.append(f"skill fired on {phrase!r}")
    # memory hygiene
    tidy = tidy_facts([{"text": "User speaks German."}, {"text": "User communicates in German."},
                       {"text": "User ran echo command vtest-17"}, {"text": "Mag Hollow Knight.", "tags": ["told"]}])
    if [f["text"] for f in tidy] != ["User speaks German.", "Mag Hollow Knight."]:
        fails.append(f"tidy facts: {[f['text'] for f in tidy]}")
    # the web: searches open, never download
    opened = []
    real_open = globals()["open_url"]
    globals()["open_url"] = lambda link: opened.append(link) or True
    try:
        t_web_search("Hollow Rose", "youtube")
    finally:
        globals()["open_url"] = real_open
    if opened != ["https://www.youtube.com/results?search_query=Hollow+Rose"]:
        fails.append(f"web.search url {opened}")
    if t_web_download("https://www.youtube.com/results?search_query=x").get("ok"):
        fails.append("web.download took a search page")
    # "Hey Velly" as the small recogniser hears it
    for heard, wake, rest in (("High Valley, wie spät ist es?", True, "wie spät ist es?"), ("Velly.", True, ""),
                              ("Ich war im Silicon Valley.", False, ""), ("Okay Belli, Musik an", True, "Musik an")):
        match = WAKE_RE.match(heard)
        if bool(match) != wake or (match and heard[match.end():].strip() != rest):
            fails.append(f"wake word on {heard!r}")
    if user_name() and not NAME_FACT.search("Heißt " + user_name()):
        fails.append("user name")
    # ears: a phantom from silence is not speech
    phantom = [{"text": " Amen.", "tokens": [{"text": "[_BEG_]", "p": 0.9}, {"text": " Amen", "p": 0.06}, {"text": ".", "p": 0.97}]}]
    if transcript_confidence(phantom) >= 0.4:
        fails.append("phantom confidence")

    # v8.25 — names in every wording, and the answer to her own question
    for fact, want in (("Name: Creep", "Creep"), ("Nutzername: Creep", "Creep"), ("Heißt Max.", "Max"),
                       ("Sein Hund heißt Bello", ""), ("Du sollst mich ab jetzt Creep nennen.", "Creep"),
                       ("Möchte Kai genannt werden", "Kai"), ("the user's name: not known yet", "")):
        if name_in(fact) != want:
            fails.append(f"name in {fact!r}: {name_in(fact)!r}")
    asked = "Klingt gut! Sag mal, wie darf ich dich eigentlich nennen?"
    for reply, want in (("Creep. C-R-E-E-P.", "Creep"), ("Ich bin der Max", "Max"), ("Warum willst du das wissen?", ""),
                        ("Spiel mal Musik", "")):
        if name_reply(reply, asked) != want:
            fails.append(f"name reply {reply!r}: {name_reply(reply, asked)!r}")
    if name_reply("Creep", "Läuft!") != "":
        fails.append("name reply without her question")
    if drop_repeat_name("Alles gut, Creep! Und bei dir?", "Creep", "Hey Creep!") != "Alles gut! Und bei dir?":
        fails.append("repeated name not dropped")
    # days and clock times are counted, never guessed
    import datetime as _dt
    tue = _dt.date(2026, 9, 29)
    for words, want in (("morgen", 1), ("übermorgen", 2), ("guten morgen", None), ("nächsten freitag", 3),
                        ("in 10 tagen", 10), ("24.12.", 86), ("weihnachten", 86), ("letzten freitag", -4)):
        day = resolve_day(words, tue)
        if (None if day is None else (day - tue).days) != want:
            fails.append(f"day {words!r}: {day}")
    for words, want in (("weck mich um halb sieben", (6, 30)), ("um viertel nach 8", (8, 15)),
                        ("um 8 heute abend", (20, 0)), ("stell einen wecker auf 6 uhr 30", (6, 30)),
                        ("timer auf 5 minuten", None)):
        if clock_in(words) != want:
            fails.append(f"clock {words!r}: {clock_in(words)}")
    if reminder_label("Erinnere mich an die Wäsche in 20 Minuten")[0] != "die Wäsche" or reminder_label("Timer für eine halbe Stunde")[0]:
        fails.append("reminder label")
    # the quick answers leave what they cannot really answer to the model
    real_time = globals()["t_sys_time"]
    globals()["t_sys_time"] = lambda place="": {"ok": True, "place": "Tokio", "time": "00:12", "date": "Mittwoch, 30. September 2026",
                                                "day_there": "morgen"} if place else real_time()
    try:
        if not local_skill("Wie spät ist es in Tokio?", brain=True).startswith("In Tokio"):
            fails.append("time in another city answered with the local clock")
    finally:
        globals()["t_sys_time"] = real_time
    for phrase in ("Brauche ich morgen einen Schirm?", "ich hab eine aufgabe für dich", "was ist ein ram",
                   "What's the weather like tomorrow?", "bitte nicht sperren"):
        if local_skill(phrase, brain=True):
            fails.append(f"skill fired on {phrase!r}")
    if not local_skill("Welcher Tag ist morgen?").startswith("Morgen ist"):
        fails.append("skill: tomorrow")
    if local_skill("was ist 15 prozent von 80") != "Das sind 12.":
        fails.append("skill: percent")
    # the schema says what every argument means
    schema = {t["function"]["name"]: t["function"] for t in tool_schema()}
    if schema["media_control"]["parameters"]["properties"]["action"].get("enum") != ["play", "pause", "next", "previous"] \
            or "query" not in schema["media_play"]["parameters"].get("required", []) \
            or not schema["weather_forecast"]["parameters"]["properties"]["when"].get("description"):
        fails.append("tool schema descriptions")
    for name in ("weather.forecast", "date.lookup", "clipboard.read", "notifs.list", "web.read", "screenshot"):
        if name not in TOOLS:
            fails.append(f"tool {name} missing")
    if TOOLS["screenshot"].fn.__name__ != "t_screenshot":
        fails.append("screenshot is bound to the wrong function")
    # the desktop only reaches the prompt where the words touch it
    real_state = globals()["shell_state"]
    globals()["shell_state"] = lambda: {"volume": 40, "media": "Numb — Linkin Park (paused)", "weather": "20°C"}
    try:
        if "media:" in context_block("Alles gut, Velly!") or "media:" not in context_block("spiel was anderes"):
            fails.append("context topic gate")
    finally:
        globals()["shell_state"] = real_state
    if clean_answer("Überblick:\nDiscord: Lena fragt. - Steam: *Silksong* ist fertig.", "was hab ich verpasst") != \
            "Überblick: Discord: Lena fragt. Steam: Silksong ist fertig.":
        fails.append("markdown in answers")
    # a newer request supersedes a running turn
    global REQ_PATH
    real_req = REQ_PATH
    probe_req = os.path.join(tempfile.gettempdir(), f"velvet-selftest-req-{os.getpid()}.json")
    REQ_PATH = probe_req
    try:
        runner = Runner(Provider(), forced=True)
        runner.req_id = 5
        write_json(probe_req, {"id": 5, "kind": ""})
        if runner.cancel():
            fails.append("own request cancelled the turn")
        write_json(probe_req, {"id": 6, "kind": "ask", "text": "und noch was"})
        runner._req_seen = 0.0
        if not runner.cancel():
            fails.append("newer ask did not supersede the turn")
    finally:
        REQ_PATH = real_req
        try:
            os.unlink(probe_req)
        except OSError:
            pass

    if not speaks_english("What's the weather like tomorrow?") or speaks_english("Wie wird das Wetter morgen?") \
            or speaks_english("Spiel Numb von Linkin Park"):
        fails.append("English detection")

    if fails:
        print("velvet-ai selftest: FAILED")
        for item in fails:
            print("  ·", item)
        return 1
    print(f"velvet-ai selftest: ok  ({len(TOOLS)} tools, provider={Provider().name or 'none'})")
    return 0


def merge_ai(fields: dict) -> dict:
    """Write fields into ai.json — 0600, always, and never via argv."""
    payload = read_json(AI_PATH, {})
    if not isinstance(payload, dict):
        payload = {}
    if isinstance(fields, dict):
        for key, value in fields.items():
            if key in DEFAULTS and isinstance(value, str):
                payload[key] = value.strip()
    os.makedirs(CONF_DIR, exist_ok=True)
    fd = os.open(AI_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, indent=1)
    try:
        os.chmod(AI_PATH, 0o600)
    except OSError:
        pass
    return payload


def set_fields() -> int:
    """`--set-fields`: the fields as JSON on stdin (or in VELLY_FIELDS).

    Not from argv: the argument list of a process is readable by every user on
    the machine, and this file holds the key.
    """
    raw = os.environ.get("VELLY_FIELDS") or ""
    if not raw:
        try:
            raw = sys.stdin.read()
        except OSError:
            raw = ""
    try:
        fields = json.loads(raw or "{}")
    except ValueError:
        log("the fields are not JSON — nothing written")
        return 2
    merge_ai(fields)
    return 0


def forget_all() -> int:
    """Wipe what she was told to remember. The transcript and the counters stay
    — this is about her memory of you, not about covering tracks."""
    mem = memory()
    mem["facts"] = []
    mem["notes"] = []
    save_memory(mem)
    print(json.dumps({"ok": True, "forgotten": True}))
    return 0


def probe() -> int:
    """One tiny round trip, so SETUP can say yes or no instead of guessing."""
    prov = Provider()
    if not prov.ok:
        print(json.dumps({"ok": False, "error": prov.error or "no provider"}))
        return 1
    if prov.name == "local" and not local_ready():
        print(json.dumps({"ok": False, "provider": "local",
                          "error": "lokales Gehirn fehlt — im SETUP installieren"}, ensure_ascii=False))
        return 1
    began = time.monotonic()
    try:
        out = prov.stream([{"role": "user", "content": "Antworte mit genau: OK"}],
                          "You are a connection test. Reply with exactly: OK",
                          lambda *_: None, None, 0.0, 8)
    except ProviderError as exc:
        print(json.dumps({"ok": False, "provider": prov.name, "model": prov.model,
                          "error": str(exc)[:240]}, ensure_ascii=False))
        return 1
    except Exception as exc:                                   # noqa: BLE001
        print(json.dumps({"ok": False, "provider": prov.name, "model": prov.model,
                          "error": f"{type(exc).__name__}: {exc}"[:240]}, ensure_ascii=False))
        return 1
    print(json.dumps({"ok": True, "provider": prov.name, "model": prov.model,
                      "ms": int((time.monotonic() - began) * 1000),
                      "text": (out or "")[:60]}, ensure_ascii=False))
    return 0


def main() -> int:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("--daemon", "daemon"):
        return daemon()
    if argv[0] == "--selftest":
        return selftest()
    if argv[0] == "--probe":
        return probe()
    if argv[0] == "--forget-all":
        return forget_all()
    if argv[0] == "--set-fields":
        return set_fields()
    if argv[0] == "--config":
        prov = Provider()
        print(json.dumps({"provider": prov.status(), "shell": {
            k: shell_config().get(k) for k in ("provider", "model", "voice", "ears", "learn", "voiceEngine")
        }, "session": session_open()}, indent=1))
        return 0
    if argv[0] == "--tools":
        print(tool_manual())
        return 0
    if argv[0] == "--set-key":
        return set_key(argv[1:])
    if argv[0] == "--tidy-memory":
        print(json.dumps(tidy_memory(), ensure_ascii=False))
        return 0
    if argv[0] == "--learn":
        print(json.dumps(learn(), ensure_ascii=False))
        return 0
    if argv[0] == "--stt":
        if len(argv) < 2:
            print(json.dumps({"ok": False, "error": "no file"}))
            return 2
        print(json.dumps(Provider().transcribe(argv[1]), ensure_ascii=False))
        return 0
    if argv[0] == "--stt-live":
        # Captions while the user is still talking: a snapshot of the sentence
        # so far, on the graphics card only. On the CPU one pass takes longer
        # than the speaker needs for the next words, so there it says nothing.
        if len(argv) < 2:
            print(json.dumps({"ok": False, "error": "no file", "text": ""}))
            return 2
        files = local_files()
        gpu = files.get("whisper_gpu") or ""
        if not gpu or not files.get("ear") or os.environ.get("VELLY_EARS_CPU"):
            print(json.dumps({"ok": False, "error": "live needs the gpu", "text": ""}))
            return 0
        device = "0"
        try:
            sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
            import _gpu                                        # noqa: PLC0415
            if _gpu.game_running():
                print(json.dumps({"ok": False, "error": "a game holds the card", "text": ""}))
                return 0
            device = re.sub(r"\D", "", _gpu.pick_device(files.get("server") or "") or "") or "0"
        except Exception:                                      # noqa: BLE001
            pass
        result = Provider()._whisper(argv[1], gpu, files["ear"], quick=True, device=device)
        print(json.dumps(result, ensure_ascii=False))
        return 0
    if argv[0] == "--stt-quick":
        # "Hey Velly": every utterance while she sleeps goes through here, so
        # it is the small model, one beam, half the cores — fast and cheap.
        # Only an utterance that names her wakes her (the shell decides).
        if len(argv) < 2:
            print(json.dumps({"ok": False, "error": "no file"}))
            return 2
        files = local_files()
        small = os.path.join(DATA_DIR, "models", "ggml-small.bin")
        model = small if os.path.isfile(small) else files["ear"]
        if not (files["whisper"] and model):
            print(json.dumps({"ok": False, "error": "no ears", "text": ""}))
            return 0
        prov = Provider()
        result = prov._transcribe_local(argv[1], files["whisper"], model, quick=True)
        text = result.get("text") or ""
        match = WAKE_RE.match(text)
        result["wake"] = bool(match)
        result["rest"] = text[match.end():].strip() if match else ""
        print(json.dumps(result, ensure_ascii=False))
        return 0
    if argv[0] == "--install-local":
        return subprocess.call([sys.executable, LOCAL_SCRIPT, "ensure"])
    if argv[0] == "--brain":
        return subprocess.call([sys.executable, LOCAL_SCRIPT, "brain"] + argv[1:])
    if argv[0] == "--local":
        return subprocess.call([sys.executable, LOCAL_SCRIPT, "status"])
    if argv[0] == "--ask":
        text = " ".join(argv[1:]).strip()
        if not text:
            print("velvet-ai: nothing to ask", file=sys.stderr)
            return 2
        runner = Runner(Provider(), forced=True)
        answer = runner.turn(text)
        print(answer or runner.state.get("error") or "(silence)")
        return 0
    log(f"unknown argument {argv[0]!r} — see the header of this file")
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(0)
