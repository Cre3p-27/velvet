# ── playing a song for real ─────────────────────────────────────────────
# "Mach bitte direkt das Lied über Spotify an" used to open a SEARCH and the
# answer said "hab das Lied abgespielt" — measured, and it was not true. This
# finds the track on Spotify and starts it through Spotify's own MPRIS door.
SPOTIFY_BUS = "org.mpris.MediaPlayer2.spotify"
SPOTIFY_LINK = re.compile(r"https?://open\.spotify\.com/(?:intl-[a-z]{2}(?:-[a-z]{2})?/)?(track|album|artist|playlist)/([A-Za-z0-9]{22})")


def spotify_on_bus() -> bool:
    code, out, _err = run(["dbus-send", "--session", "--print-reply", "--dest=org.freedesktop.DBus",
                           "/org/freedesktop/DBus", "org.freedesktop.DBus.ListNames"], timeout=3)
    return code == 0 and SPOTIFY_BUS in out


def spotify_status() -> str:
    code, out, _err = run(["dbus-send", "--session", "--print-reply", f"--dest={SPOTIFY_BUS}",
                           "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties.Get",
                           "string:org.mpris.MediaPlayer2.Player", "string:PlaybackStatus"], timeout=3)
    match = re.search(r'string "(\w+)"', out or "") if code == 0 else None
    return match.group(1) if match else ""


def spotify_find(query: str) -> list:
    """[(kind, id, title)] for the query, best first — from a web search
    restricted to open.spotify.com (no account, no API key needed)."""
    # The words around a request are not the request: "irgendwas von
    # Linkin Park" searched for "irgendwas" and found nothing.
    clean = re.sub(r"\b(bitte|mal|mir|uns|doch|irgendwas|irgendetwas|etwas|was|ein paar|paar|lieder|songs?|"
                   r"musik|das lied|den song|das album|die platte|die playlist|von|auf spotify|spotify|"
                   r"spiel\w*|abspielen|an|ab)\b", " ", query, flags=re.I)
    clean = re.sub(r"\s+", " ", clean).strip() or query
    found = []
    for q in (f"site:open.spotify.com {clean}", f"{clean} open.spotify.com"):
        for hit in web_results(q, 10):
            match = SPOTIFY_LINK.match(hit["url"])
            if match and (match.group(1), match.group(2)) not in [(k, i) for k, i, _t in found]:
                found.append((match.group(1), match.group(2), hit["title"]))
        if found:
            break
    low = query.lower()
    if re.search(r"\b(album|platte)\b", low):
        order = {"album": 0, "track": 1, "playlist": 2, "artist": 3}
    elif re.search(r"\b(playlist|mix)\b", low):
        order = {"playlist": 0, "track": 1, "album": 2, "artist": 3}
    elif re.search(r"\b(künstler|kuenstler|artist|band|irgendwas von|etwas von|was von|lieder von|songs von)\b", low):
        order = {"artist": 0, "track": 1, "album": 2, "playlist": 3}
    else:
        order = {"track": 0, "album": 1, "artist": 2, "playlist": 3}
    return sorted(found, key=lambda f: order.get(f[0], 9))


def spotify_title(title: str) -> str:
    """"Bohemian Rhapsody - song and lyrics by Queen | Spotify" → "Bohemian Rhapsody von Queen"."""
    t = re.sub(r"\s*\|\s*Spotify\s*$", "", title or "").strip()
    t = re.sub(r"\s*-\s*(?:song and lyrics|song|album|single|ep|playlist)\s+(?:by|von)\s+", " von ", t, flags=re.I)
    t = re.sub(r"\s*-\s*Songtext und Lyrics von\s+", " von ", t, flags=re.I)
    return t.strip() or title


@tool("media.play", '{"query": "Bohemian Rhapsody Queen"}', "write",
      "PLAY a song, an album, a playlist or an artist right now on Spotify (finds it and starts it). "
      "Use this whenever the user wants to HEAR something — not web.search.")
def t_media_play(query=""):
    q = str(query or "").strip()
    if not q:
        return {"ok": False, "error": "was soll ich spielen?"}
    running = spotify_on_bus()
    if not running and not shutil.which("spotify"):
        return {"ok": False, "error": "Spotify ist hier nicht installiert"}
    try:
        found = spotify_find(q)
    except Exception as exc:                                   # noqa: BLE001
        return {"ok": False, "error": f"die Suche antwortet gerade nicht ({exc})"[:160]}
    if not found:
        if running:
            # Nothing to START — but Spotify's own search is one step away.
            # Said as what it is: opened, not playing.
            clean = re.sub(r"\s+", " ", q).strip()
            run(["dbus-send", "--session", "--type=method_call", f"--dest={SPOTIFY_BUS}", "/org/mpris/MediaPlayer2",
                 "org.mpris.MediaPlayer2.Player.OpenUri", "string:spotify:search:" + urllib.parse.quote(clean)], timeout=4)
            return {"ok": False, "playing": False, "opened": "spotify search",
                    "error": f"keinen Titel gefunden — die Spotify-Suche nach „{clean}“ ist offen, abspielen musst du selbst"}
        return {"ok": False, "error": f"auf Spotify finde ich nichts zu „{q}“"}
    kind, sid, title = found[0]
    uri = f"spotify:{kind}:{sid}"
    if not running:
        try:
            subprocess.Popen(["spotify", f"--uri={uri}"], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as exc:
            return {"ok": False, "error": f"Spotify startet nicht ({exc})"}
        for _ in range(24):
            time.sleep(0.5)
            if spotify_on_bus():
                running = True
                break
    if running:
        run(["dbus-send", "--session", "--type=method_call", f"--dest={SPOTIFY_BUS}", "/org/mpris/MediaPlayer2",
             "org.mpris.MediaPlayer2.Player.OpenUri", f"string:{uri}"], timeout=4)
    status = ""
    for _ in range(6):
        time.sleep(0.4)
        status = spotify_status()
        if status == "Playing":
            break
    out = {"ok": status == "Playing", "what": kind, "title": spotify_title(title),
           "playing": status == "Playing", "status": status or "unbekannt", "uri": uri}
    if not out["ok"]:
        # Honest: found, handed to Spotify, but it is not playing (yet).
        out["error"] = ("Spotify hat sich nicht gemeldet" if not running
                        else f"Spotify hat es geöffnet, spielt aber nicht (Status: {status or 'unbekannt'})")
    return out


