@tool("memory.recall", '{"query": "text"}', "read", "Search what Velly was told to remember.")
def t_memory_recall(query=""):
    mem = memory()
    needle = (query or "").lower()
    facts = [f for f in (mem.get("facts") or []) if isinstance(f, dict)]
    if needle:
        facts = [f for f in facts if needle in f.get("text", "").lower()]
    return {"facts": [f.get("text") for f in facts[:10]],
            "notes": [n.get("text") for n in (mem.get("notes") or [])[-4:]]}


@tool("memory.remember", '{"text": "text"}', "write", "Store a durable fact about the user (name, preferences, habits).")
def t_memory_remember(text=""):
    # Told, not guessed: a fact the user gave her is kept as it is.
    return remember(text, tags=["told"])


@tool("memory.forget", '{"query": "text"}', "write", "Delete remembered facts matching the text.")
def t_memory_forget(query=""):
    return forget(query)


@tool("tasks.list", "", "read", "The workflow list: open and done tasks with their ids.")
def t_tasks_list():
    raw = shell_ipc("tasks", "list")
    open_tasks, done_tasks = [], []
    for line in raw.split("\n"):
        parts = line.split("\x1f")
        if len(parts) == 3:
            item = {"id": int(parts[0]) if parts[0].isdigit() else parts[0], "text": parts[2]}
            (done_tasks if parts[1] == "1" else open_tasks).append(item)
    return {"open": open_tasks, "done": done_tasks}


@tool("tasks.add", '{"text": "text"}', "write",
      "Add a task to the workflow list — only when the user explicitly asks to note or add a task (Aufgabe, notier, To-do).")
def t_tasks_add(text=""):
    if not (text or "").strip():
        return {"ok": False, "error": "empty"}
    shell_ipc("tasks", "add", text.strip())
    return {"ok": True, "text": text.strip()}


@tool("tasks.done", '{"id": 3}', "write", "Check a task off by id (from tasks.list).")
def t_tasks_done(id=0):
    try:
        shell_ipc("tasks", "toggle", int(id))
        return {"ok": True}
    except (TypeError, ValueError):
        return {"ok": False, "error": "id must be a number"}


@tool("tasks.remove", '{"id": 3}', "write", "Remove a task by id.")
def t_tasks_remove(id=0):
    try:
        shell_ipc("tasks", "remove", int(id))
        return {"ok": True}
    except (TypeError, ValueError):
        return {"ok": False, "error": "id must be a number"}


@tool("apps.launch", '{"name": "text", "args": "text"}', "write", "Start an installed app by name.")
def t_apps_launch(name="", args=""):
    needle = (name or "").lower().strip()
    if not needle:
        return {"ok": False, "error": "no app named"}
    best = None
    for app in app_entries():
        if app["key"] == needle:
            best = app
            break
        if best is None and needle in app["key"]:
            best = app
    if best is None:
        return {"ok": False, "error": f"no app called {name!r}"}
    cmd = clean_exec(best["exec"])
    if args:
        # Arguments, not shell: "; anything" must not become a second command
        # (this tool needs no confirmation).
        try:
            parts = shlex.split(str(args))
        except ValueError:
            return {"ok": False, "error": "arguments do not parse"}
        cmd = f"{cmd} {' '.join(shlex.quote(a) for a in parts)}"
    if not hctl_dispatch(f"hl.dsp.exec_cmd({lua_str(cmd)})"):
        return {"ok": False, "error": "hyprland refused to start it"}
    return {"ok": True, "app": best["name"], "cmd": cmd}


