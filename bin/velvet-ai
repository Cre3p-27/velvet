# ── Velvet itself: every setting the settings window has, found by words and
#  set through the same door the window uses (services/Velly.qml findSettings
#  / applySetting). "Stell die Island an den rechten Rand", "mach die
#  Animationen schneller", "wie ändere ich die Akzentfarbe" — she used to be
#  able to open the settings and nothing else.
# The keys she has seen in a settings.find this session: settings.set takes
# no other. Measured: "Stell die Island an den rechten Rand" went straight to
# a guessed key (map.islandShift = 200) instead of POSITION = right.
FOUND_KEYS = set()


@tool("settings.find", '{"query": "island position"}', "read",
      "Find Velvet's own settings and shortcuts by ENGLISH words (the settings are named in English): what each "
      "does, where it is in the settings (Super+Tab), its current value and the values it takes. Use it before "
      "settings.set, and to answer 'how do I … in Velvet'.")
def t_settings_find(query=""):
    wanted = str(query or "").strip()
    if not wanted:
        return {"ok": False, "error": "which setting? a few English words"}
    raw = shell_ipc("velly", "settingsFind", wanted)
    try:
        data = json.loads(raw) if raw else None
    except ValueError:
        data = None
    if not isinstance(data, dict):
        return {"ok": False, "error": "the shell is not answering"}
    if not data.get("settings") and not data.get("shortcuts"):
        return {"ok": True, "settings": [], "note": "nothing found — try other English words"}
    for row in data.get("settings") or []:
        if isinstance(row, dict) and row.get("key"):
            FOUND_KEYS.add(str(row["key"]))
    return {"ok": True, **data}


@tool("settings.set", '{"key": "map.islandSide", "value": "right"}', "write",
      "Change one Velvet setting, by the key settings.find gave you. value: true/false for a switch, a number "
      "for a slider (a fraction where the setting says 1 = 100 %), one of the option VALUES for a choice. "
      "A key 'action:…' is a one-click row (e.g. ISLAND + FRAME AS ONE): it runs, no value needed. "
      "Returns the old value, so the change can be undone.")
def t_settings_set(key="", value=""):
    k = str(key or "").strip()
    if not k:
        return {"ok": False, "error": "which key? look it up with settings.find"}
    if k not in FOUND_KEYS:
        # never a guessed key: show her what is there for those words
        words = " ".join(w for w in re.split(r"[^A-Za-z]+", re.sub(r"([a-z])([A-Z])", r"\1 \2", k)) if len(w) > 2)
        found = t_settings_find(words or k)
        return {"ok": False, "error": "look a setting up with settings.find before you set it — "
                                      "these match the words of that key; pick the one that does what the user asked",
                "settings": found.get("settings") or []}
    if k.startswith("action:"):
        value = ""
    elif value is None or value == "":
        return {"ok": False, "error": "which value? the settings.find result lists what it takes"}
    raw = shell_ipc("velly", "settingApply", k, json.dumps(value, ensure_ascii=False))
    try:
        data = json.loads(raw) if raw else None
    except ValueError:
        data = None
    if not isinstance(data, dict):
        return {"ok": False, "error": "the shell is not answering"}
    return data


# ── the looks: whole-desktop styles (settings window, bar, lock, sounds, the
#  island) — "mach's wie Windows 11", "zeig mal einen anderen Look". She
#  could change single settings, but not put a look on.
LOOK_ALIASES = {
    "windows 11": "win11", "windows11": "win11", "win 11": "win11", "windows 10": "win10", "win 10": "win10",
    "windows 7": "win7", "win 7": "win7", "windows xp": "winxp", "xp": "winxp", "windows 95": "win95",
    "win 95": "win95", "windows": "windows", "glas": "glass", "glassmorphism": "glass", "papier": "paper",
    "zeitung": "paper", "retro": "arcade", "spiel": "arcade", "konsole": "terminal", "hacker": "terminal",
    "fantasy": "rpg", "rollenspiel": "rpg", "poster": "brutal", "brutalismus": "brutal", "neumorphism": "neu",
    "neumorphismus": "neu", "claymorphism": "clay", "knete": "clay", "kirschblüte": "sakura", "rosa": "sakura",
    "flach": "flat", "minimal": "minimal", "schlicht": "clean", "original": "velvet", "standard": "velvet",
}


def look_rows() -> list:
    raw = shell_ipc("looks", "describe")
    try:
        data = json.loads(raw) if raw else None
    except ValueError:
        data = None
    return data if isinstance(data, list) else []


@tool("look.list", "", "read",
      "Velvet's looks — whole-desktop styles (settings window, bar, lock screen, sounds, island): id, name, "
      "what each is like, and which one is on.")
def t_look_list():
    rows = look_rows()
    if not rows:
        return {"ok": False, "error": "the shell is not answering"}
    return {"ok": True, "looks": rows}


@tool("look.apply", '{"look": "win11"}', "write",
      "Put one of Velvet's looks on — the whole shell changes style at once. look: an id or name from "
      "look.list ('velvet' is the original). look.undo takes it off again.")
def t_look_apply(look=""):
    want = re.sub(r"\s+", " ", str(look or "").strip().lower().replace("-look", "").replace(" look", ""))
    if not want:
        return {"ok": False, "error": "which look? look.list names them"}
    rows = look_rows()
    if not rows:
        return {"ok": False, "error": "the shell is not answering"}
    ids = {str(r.get("id", "")).lower(): r for r in rows}
    pick = ids.get(LOOK_ALIASES.get(want, want))
    if pick is None:
        for r in rows:
            if want == str(r.get("name", "")).lower() or want in str(r.get("name", "")).lower():
                pick = r
                break
    if pick is None:
        close = difflib.get_close_matches(want, list(ids) + [str(r.get("name", "")).lower() for r in rows], n=1, cutoff=0.72)
        if close:
            pick = ids.get(close[0]) or next((r for r in rows if str(r.get("name", "")).lower() == close[0]), None)
    if pick is None and LOOK_ALIASES.get(want) == "windows":
        pick = {"id": "windows", "name": "WINDOWS"}
    if pick is None:
        return {"ok": False, "error": f"no look called '{look}'",
                "looks": [{"id": r.get("id"), "name": r.get("name"), "about": r.get("about")} for r in rows]}
    out = shell_ipc("looks", "apply", pick["id"], timeout=8.0)
    if not out.startswith("applied"):
        return {"ok": False, "error": out or "the shell is not answering"}
    return {"ok": True, "look": pick["id"], "name": pick.get("name"), "about": pick.get("about", ""),
            "undo": "look.undo puts the look from before back"}


@tool("look.undo", "", "write", "Take the look that was just put on off again — back to the look from before.")
def t_look_undo():
    out = shell_ipc("looks", "undo", timeout=8.0)
    return {"ok": out.startswith("back"), "said": out or "the shell is not answering"}


@tool("history.search", '{"query": "Restaurant"}', "read",
      "Search what was said in earlier conversations with the user — days back: what they asked, what you "
      "answered or recommended. For 'was hab ich dich gestern gefragt', 'wie hieß nochmal …'.")
def t_history_search(query=""):
    mem = memory()
    hist = [h for h in (mem.get("history") or []) if isinstance(h, dict) and h.get("text")]
    words = [w for w in re.findall(r"[\wäöüß]+", str(query or "").lower()) if len(w) > 2]
    found = []
    for i, h in enumerate(hist):
        if h.get("role") != "user":
            continue
        reply = hist[i + 1] if i + 1 < len(hist) and hist[i + 1].get("role") == "velly" else {}
        hay = f"{h.get('text')} {reply.get('text', '')}".lower()
        hits = sum(1 for w in words if w in hay) if words else 1
        if hits:
            when = time.localtime(int(h.get("t") or 0) / 1000)
            found.append((hits, int(h.get("t") or 0), {
                "when": f"{date_de(when)}, {time.strftime('%H:%M', when)}",
                "user": str(h.get("text"))[:240], "you": str(reply.get("text") or "")[:300]}))
    found.sort(key=lambda f: (-f[0], -f[1]))
    if not words:
        found.sort(key=lambda f: -f[1])
    return {"ok": True, "found": [f[2] for f in found[:6]],
            "note": "" if found else "nichts dazu in den früheren Gesprächen"}


@tool("toast.show", '{"text": "text", "kind": "ok|info|warn|error"}', "write", "Show a toast on the desktop.")
def t_toast_show(text="", kind="info"):
    if not (text or "").strip():
        return {"ok": False, "error": "empty"}
    shell_ipc("velly", "toast", text.strip()[:180], kind if kind in ("ok", "info", "warn", "error") else "info")
    return {"ok": True}


# The island's modules by name: the numbers move (TASKS can be switched off,
# Velly too), and "zeig mir das Wetter in der Island" is a name, not a 3.
ISLAND_WORDS = {
    "music": ("music", "musik", "song", "lied", "player", "now playing"),
    "map": ("map", "karte", "desktop", "übersicht", "uebersicht", "minimap"),
    "tasks": ("tasks", "task", "aufgaben", "aufgabe", "todo", "liste", "checklist"),
    "weather": ("weather", "wetter"),
    "system": ("system", "cpu", "ram", "speicher", "leistung", "auslastung"),
    "velly": ("velly", "assistant", "assistentin"),
}


def island_order() -> list:
    cfg = read_json(CFG_PATH, {})
    cfg = cfg if isinstance(cfg, dict) else {}
    tasks = (cfg.get("map") or {}).get("islandTasks", True) is not False
    velly = (cfg.get("velly") or {}).get("enabled", True) is not False
    return ["music", "map"] + (["tasks"] if tasks else []) + ["weather", "system"] + (["velly"] if velly else [])


@tool("island.module", '{"module": "weather"}', "write",
      "Open a module of the Dynamic Island: music, map, tasks, weather, system or velly (the map opens the mini desktop).")
def t_island_module(module="weather"):
    order = island_order()
    want = str(module if module is not None else "").strip().lower()
    name = next((k for k, words in ISLAND_WORDS.items() if want == k or any(w in want for w in words)), "")
    if not name and want.lstrip("-").isdigit() and 0 <= int(want) < len(order):
        name = order[int(want)]
    if name not in order:
        return {"ok": False, "error": f"the island has: {', '.join(order)}" + (" (TASKS is switched off)" if name == "tasks" else "")}
    shell_ipc("island", "pop", "")
    shell_ipc("island", "expand", order.index(name))
    return {"ok": True, "module": name}


def missing_programs(command: str) -> list:
    """The programs a shell line would start that are not installed — the
    shell only reports that it STARTED a line, so a missing grim used to come
    back as a successful screenshot."""
    names = re.findall(r"(?:^|[|;&]\s*|\$\(\s*)([A-Za-z0-9_./+-]+)", command or "")
    builtin = {"echo", "cd", "true", "false", "test", "[", "exec", "sleep", "printf", "export", "set"}
    return [n for n in dict.fromkeys(names) if n not in builtin and not shutil.which(os.path.expanduser(n))]


# The decorator used to sit on missing_programs() above — so "mach einen
# Screenshot" called THAT with no argument and every screenshot died in
# "bad arguments" (found in v8.25).
@tool("screenshot", "", "write", "Take a screenshot with the shell's configured command (select an area; it lands in the clipboard).")
def t_screenshot():
    cfg = read_json(CFG_PATH, {})
    command = ((cfg.get("services") or {}).get("screenshotCommand") or "").strip()
    if not command:
        return {"ok": False, "error": "no screenshot command configured"}
    missing = missing_programs(command)
    if missing:
        return {"ok": False, "missing": missing,
                "error": f"für Screenshots fehlt {', '.join(missing)} — mit pkg.install nachinstallierbar "
                         f"(grim slurp wl-clipboard)"}
    out = shell_ipc("velly", "run", command)
    # The command only STARTED: with slurp the user still picks the area, and
    # the picture goes wherever the command sends it. Said as it is, so she
    # does not report a finished screenshot nobody has taken yet.
    how = []
    if "slurp" in command:
        how.append("the user now drags a box around the area to capture")
    if "wl-copy" in command:
        how.append("the picture then lands in the clipboard (paste with Strg+V)")
    elif re.search(r"(\.png|\.jpg|Bilder|Pictures|screenshots?)", command, re.I):
        how.append("the picture is saved as a file")
    return {"ok": bool(out), "started": bool(out), "how": "; ".join(how) or "taken"}


@tool("record.toggle", "", "write", "Start or stop a screen recording.")
def t_record_toggle():
    script = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "hypr", "scripts", "velvet-record.sh")
    if not os.path.isfile(script):
        return {"ok": False, "error": "the recording script is missing"}
    if not hctl_dispatch(f"hl.dsp.exec_cmd({lua_str(script)})"):
        return {"ok": False, "error": "hyprland refused it"}
    return {"ok": True}


