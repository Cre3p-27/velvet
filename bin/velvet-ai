import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

HOME = os.path.expanduser("~")
CONF_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "velvet")

CFG_PATH = os.path.join(CONF_DIR, "config.json")          # the shell's own config
AI_PATH = os.path.join(CONF_DIR, "ai.json")               # secrets + endpoints (0600)
SESSION_PATH = os.path.join(CONF_DIR, "ai-session.json")  # the island's permission token
REQ_PATH = os.path.join(CONF_DIR, "ai-req.json")          # the shell asks here
STATE_PATH = os.path.join(CONF_DIR, "ai-state.json")      # the brain answers here
MEMORY_PATH = os.path.join(CONF_DIR, "ai-memory.json")

# The local engine (bin/velvet-local): where its files live, where its server
# listens. Nothing below this line needs a key, an account or a network.
DATA_DIR = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "velvet")
LOCAL_SCRIPT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "velvet-local")
LOCAL_PATH = os.path.join(CONF_DIR, "ai-local.json")
LOCAL_PORT = int(os.environ.get("VELLY_LOCAL_PORT") or "8137")
LOCAL_IDLE = 600.0

SESSION_GRACE = 8.0        # seconds a session file may lag behind its heartbeat
MAX_TOOL_ROUNDS = 6
CONFIRM_WINDOW = 120.0     # how long "yes" stays valid for a dangerous action

DEFAULTS = {
    "provider": "auto",
    "model": "",
    "baseUrl": "",
    "apiKey": "",
    "sttModel": "",
    "sttBaseUrl": "",
    "sttLang": "",
    "voiceName": "",
    "localModel": "",
    "earModel": "",
}

PROVIDER_DEFAULTS = {
    "openai": {"base": "https://api.openai.com/v1", "model": "gpt-4o-mini",
               "env": ["VELLY_API_KEY", "OPENAI_API_KEY"]},
    "deepseek": {"base": "https://api.deepseek.com/v1", "model": "deepseek-chat",
                 "env": ["VELLY_API_KEY", "DEEPSEEK_API_KEY"]},
    "anthropic": {"base": "https://api.anthropic.com", "model": "claude-haiku-4-5-20251001",
                  "env": ["VELLY_API_KEY", "ANTHROPIC_API_KEY"]},
    "ollama": {"base": "http://127.0.0.1:11434", "model": "llama3.2", "env": []},
    # Not a cloud at all: llama.cpp's own server on localhost, started and
    # stopped by bin/velvet-local. No key, no meter, no account.
    "local": {"base": f"http://127.0.0.1:{LOCAL_PORT}/v1", "model": "velvet", "env": []},
}


# ─────────────────────────────────────────────────────────────── tiny utilities
def log(msg: str) -> None:
    print(f"velvet-ai: {msg}", file=sys.stderr, flush=True)


def now_ms() -> int:
    return int(time.time() * 1000)


def read_json(path: str, fallback):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data
    except (OSError, ValueError):
        return fallback


def write_json(path: str, payload) -> None:
    """Write in place — the shell watches this exact inode, never a rename."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(payload, separators=(",", ":"), ensure_ascii=False))
            fh.flush()
            os.fsync(fh.fileno())
    except OSError as exc:
        log(f"cannot write {path}: {exc}")


def ai_config() -> dict:
    data = read_json(AI_PATH, {})
    out = dict(DEFAULTS)
    if isinstance(data, dict):
        for key in DEFAULTS:
            if isinstance(data.get(key), str):
                out[key] = data[key]
    return out


def shell_config() -> dict:
    """The shell's config.json, but only the part that is Velly's business."""
    data = read_json(CFG_PATH, {})
    velly = data.get("velly") if isinstance(data, dict) else None
    out = {
        "voice": True,
        "ears": True,
        "learn": True,
        "confirmDanger": True,
        "autoListen": True,
        "greet": False,
        "provider": "auto",
        "model": "",
        "temperature": 0.6,
        "maxTokens": 320,
        "voiceEngine": "auto",
        "voiceName": "",
        "voiceVolume": 0.9,
        "forceTier": False,
    }
    if isinstance(velly, dict):
        out.update(velly)
    return out


def env_first(names) -> str:
    for name in names:
        value = os.environ.get(name)
        if value:
            return value.strip()
    return ""


# Speech recognition has exactly one job to get wrong around here: her name.
# "Welly", "Velli", "Velley" are the same person, and the user must never be
# corrected for saying it out loud — so it is normalised before the model ever
# sees it, and the prompt is told not to mention it either.
NAME_FIX = re.compile(r"\b(vell+y|well+y|vell+i|vel+i|vele?y|vally|felly|welli|verdi|verdy|werdi|veldy|feldy|feli|bell+i|belly|pell+i|pelly|velie|welly)\b", re.I)


# The words the recogniser keeps getting wrong in what people say to her —
# each one heard in her history or in a test clip. Fixed before the model
# reads them: a model that is handed "K-List" plays a song called K-List.
MISHEARD = [
    (re.compile(r"\b(?:k|kay|key|ke|tee|t)[\s-]?lists?\b", re.I), "Playlist"),
    (re.compile(r"\b(?:play[\s-]?list|plejlist|pleylist|plaeylist|bläylist)\b", re.I), "Playlist"),
    (re.compile(r"\b(?:wahl|wal|wall|wol|vall|val)[\s-]?pa+p+(?:er|a|r)\b", re.I), "Wallpaper"),
    (re.compile(r"\b(?:spotty|spoti|sputif\w*|spotifei|spotifai|spotifie|spoddify|spotefy)\b", re.I), "Spotify"),
    (re.compile(r"\b(?:work[\s-]?space|wörk[\s-]?space|workspeis|wörkspeis)\b", re.I), "Workspace"),
    (re.compile(r"\b(?:screen[\s-]?shot|skrienschott|skrinschott|screenschott)\b", re.I), "Screenshot"),
    (re.compile(r"\b(?:hyper[\s-]?land|heiperland|hyperlend)\b", re.I), "Hyprland"),
    (re.compile(r"\b(?:dis[\s-]?cord|discort|diskord)\b", re.I), "Discord"),
    (re.compile(r"\b(?:you[\s-]?tube|jutjub|jutube|youtub)\b", re.I), "YouTube"),
]


def normalise_transcript(text: str) -> str:
    out = NAME_FIX.sub("Velly", text or "")
    for pattern, word in MISHEARD:
        out = pattern.sub(word, out)
    return out


# "Hey Velly" as the small recogniser hears it: "High Valley", "Hey Welly",
# "Valley." (measured). Only at the START of an utterance — "… im Silicon
# Valley …" in the middle of a sentence is not her name.
WAKE_RE = re.compile(
    r"^\W*(?:(?:hey|hei|hi|high|ei|ey|he|ok(?:ay)?|hallo|na|du)\W+)?"
    r"(?:velly|valley|valli|vally|velli|vellie|velle|welly|welli|wally|belly|belli|felly|feli|verdi)\b[\s,.:;!?-]*", re.I)


# The short phrases whisper produces from nothing — only dropped when the
# recognition was unsure as well, so a clear "Okay." still counts.
PHANTOM = re.compile(
    r"(?i)\s*(amen|okay|ok|ja|nein|hm+|äh+m?|eins|danke|vielen dank|vielen dank fürs zuschauen|"
    r"tschüss|bis zum nächsten mal|bis dann|musik|applaus|untertitel.*|copyright.*|swr.*|zdf.*|wdr.*)[.!?…]*\s*")


def transcript_confidence(segments) -> float:
    """Mean probability of the word tokens (special tokens and punctuation
    left out); 1.0 when the file carries no token detail."""
    probs = []
    for seg in segments or []:
        for tok in seg.get("tokens") or []:
            txt = str(tok.get("text") or "")
            if txt.startswith("[_") or not re.search(r"\w", txt):
                continue
            try:
                probs.append(float(tok.get("p")))
            except (TypeError, ValueError):
                continue
    return sum(probs) / len(probs) if probs else 1.0


# ─────────────────────────────────────────────────────────── the local engine
#  Everything here talks to bin/velvet-local, which owns the files and the
#  server. This side asks two questions only: is it installed, and is it up?
def local_files() -> dict:
    """Where the engine room keeps its pieces — empty strings where a piece is
    missing. No process, no import: a glob and a stat."""
    def exe(name: str) -> str:
        root = os.path.join(DATA_DIR, "engines")
        hits = [p for p in glob.glob(os.path.join(root, "**", name), recursive=True)
                if os.path.isfile(p) and os.access(p, os.X_OK) and os.sep + "whisper-gpu" + os.sep not in p]
        hits.sort(key=lambda p: ("-cpu" in p, -os.path.getmtime(p)))
        return hits[0] if hits else ""
    gpu = os.path.join(DATA_DIR, "engines", "whisper-gpu", "whisper-cli")
    return {
        "server": exe("llama-server"),
        "whisper": exe("whisper-cli") or exe("main"),
        # whisper.cpp with Vulkan, built by `velvet-local ears-gpu`: the same
        # words in 0.4 s instead of ~3 s (measured on this machine).
        "whisper_gpu": gpu if os.path.isfile(gpu) and os.access(gpu, os.X_OK) else "",
        "brain": os.path.join(DATA_DIR, "models", "brain.gguf"),
        "ear": ear_model_file(),
    }


def local_installed() -> bool:
    files = local_files()
    try:
        size = os.path.getsize(files["brain"])
    except OSError:
        return False
    if not files["server"]:
        return False
    # velvet-local's marker is the proof that the download finished; the size
    # is only the fallback for a model that was put there by hand.
    try:
        with open(files["brain"] + ".ok", "r", encoding="utf-8") as fh:
            return int((fh.read() or "0").strip() or 0) == size
    except (OSError, ValueError):
        return size > 2_000_000_000


def local_health(timeout: float = 0.6) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{LOCAL_PORT}/health", timeout=timeout) as resp:
            return resp.status == 200
    except Exception:                                          # noqa: BLE001
        return False


def local_spawn() -> None:
    """Start the engine room and walk away: it outlives this call on purpose,
    so the weights can load while you are still talking. `forceTier` comes from
    the shell's config: it means "these weights even if they do not fit", and
    the engine room then keeps the chosen model (experts on the CPU, measured
    ~1 token/s) instead of quietly serving a smaller one."""
    cmd = [sys.executable, LOCAL_SCRIPT, "serve", "--idle", str(int(keep_warm_seconds() or LOCAL_IDLE))]
    try:
        if shell_config().get("forceTier"):
            cmd.append("--force")
    except Exception:                                          # noqa: BLE001
        pass
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as exc:
        log(f"cannot start velvet-local: {exc}")


def keep_warm_seconds() -> int:
    """VELLY → WACH BLEIBEN, in seconds (0: unload at once)."""
    try:
        minutes = shell_config().get("keepWarm", 5)
        return max(0, int(float(minutes if minutes is not None else 5) * 60))
    except (TypeError, ValueError):
        return 300


def local_rest() -> None:
    """The end of a session. Kept warm (WACH BLEIBEN), the model stays up and
    the engine room's own watcher takes it down after that long without a
    question — or at once when a fullscreen game takes the screen. Otherwise:
    asleep means asleep, the VRAM is yours again right now."""
    if keep_warm_seconds() > 0:
        try:
            sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
            import _gpu                                        # noqa: PLC0415
            gaming = _gpu.game_running()
        except Exception:                                      # noqa: BLE001
            gaming = False
        if not gaming:
            log(f"session over — the brain stays warm for {keep_warm_seconds() // 60} min")
            return
    local_stop()


def warm_prompt() -> None:
    """Fill the server's prompt cache with what every turn starts with — the
    system prompt and the tool schema, ~4800 tokens — while the greeting is
    still playing, so the first question only pays for its own words. For
    gpt-oss once per reasoning effort: the effort is written near the top of
    its prompt, so each one lives in its own of the server's two slots."""
    end = time.monotonic() + 200
    while time.monotonic() < end and not local_health(1.0):
        time.sleep(1.0)
    if not local_health(1.0):
        return
    system = system_prompt(True)
    family = local_family()
    for effort in (["low", "medium"] if family == "gpt-oss" else ["low"]):
        payload = {"model": "velvet", "stream": False, "max_tokens": 1, "cache_prompt": True,
                   "messages": [{"role": "system", "content": system},
                                {"role": "user", "content": with_context("Hallo")}],
                   "tools": tool_schema()}
        if family == "gpt-oss":
            payload["chat_template_kwargs"] = {"reasoning_effort": effort}
        began = time.monotonic()
        try:
            body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
            req = urllib.request.Request(f"http://127.0.0.1:{LOCAL_PORT}/v1/chat/completions", data=body, method="POST")
            req.add_header("Content-Type", "application/json")
            with urllib.request.urlopen(req, timeout=180) as resp:
                resp.read()
            log(f"prompt warmed ({effort}) in {time.monotonic() - began:.1f}s")
        except Exception as exc:                               # noqa: BLE001
            log(f"warm-up ({effort}) failed: {exc}")
            return


def local_ready(deadline: float = 150.0) -> bool:
    """True once the server answers. The wait is the model loading, not a
    hang — and when nothing is installed it says so at once."""
    if local_health():
        return True
    if not local_installed():
        return False
    local_spawn()
    end = time.monotonic() + deadline
    while time.monotonic() < end:
        if local_health(1.0):
            return True
        time.sleep(0.5)
    return False


def local_family() -> str:
    """gpt-oss or the Qwen family — they want different sampling and only
    gpt-oss has a reasoning effort to set. Read from what the engine room
    says is running (it may have served a smaller tier than was chosen)."""
    running = str(read_json(LOCAL_PATH, {}).get("model") or "")
    if not running:
        try:
            running = os.path.basename(os.path.realpath(os.path.join(DATA_DIR, "models", "brain.gguf")))
        except OSError:
            running = ""
    return "gpt-oss" if "oss" in running.lower() else "qwen"


def other_brain_running() -> bool:
    """Is a second brain daemon alive? A lingering one used to shoot the
    server a fresh one had just started: the exit path below asks this first."""
    me = os.getpid()
    try:
        names = os.listdir("/proc")
    except OSError:
        return False
    for name in names:
        if not name.isdigit() or int(name) == me:
            continue
        try:
            with open(f"/proc/{name}/cmdline", "rb") as fh:
                cmd = fh.read().decode("utf-8", "replace")
        except OSError:
            continue
        if "velvet-ai" in cmd and "--daemon" in cmd:
            return True
    return False


def local_stop(force: bool = False) -> None:
    """Take the weights down — but not while a session is still open. A brain
    that leaves (restarted, replaced, killed) used to shoot the server the
    NEXT ask was already using: measured, kill at 20:07:12 and a fresh load at
    20:07:14, so the answer paid for the model twice. With a live session the
    engine room's own watchdog decides when the VRAM goes back."""
    if not force and (session_open() or other_brain_running()):
        log("session still open — leaving the local server up")
        return
    try:
        subprocess.run([sys.executable, LOCAL_SCRIPT, "stop"], capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        pass


# ── what the ears should expect to hear ───────────────────────────────────
#  Whisper takes a short text as "what came before", and spells what it hears
#  the way that text does. Fed the words people actually say to her — the
#  commands, the user's name, the apps on this machine — it stops turning
#  "Playlist" into "K-List" (measured in her history). Built once an hour into
#  the cache: the recogniser must not pay for a scan of every .desktop file.
EAR_COMMANDS = ("Velly, Velvet, Hyprland, Quickshell, Spotify, Playlist, Song, Album, nächstes Lied, Pause, "
                "lauter, leiser, Lautstärke, Wallpaper, Hintergrundbild, Workspace, Arbeitsfläche, Fenster, "
                "Terminal, Screenshot, Erinnerung, Timer, Wecker, Wetter, Benachrichtigungen, Fokus-Modus, "
                "Update, installieren, YouTube, Discord, Steam, Minecraft, Firefox, Kitty")
EAR_VOCAB_PATH = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "velvet", "ear-vocab.txt")


def ear_vocabulary() -> str:
    try:
        if time.time() - os.path.getmtime(EAR_VOCAB_PATH) < 3600:
            with open(EAR_VOCAB_PATH, encoding="utf-8") as fh:
                cached = fh.read().strip()
            if cached:
                return cached
    except OSError:
        pass
    words = [w.strip() for w in EAR_COMMANDS.split(",")]
    seen = {w.lower() for w in words}
    extra = []
    try:
        name = user_name()
        if name and name.lower() not in seen:
            extra.append(name)
            seen.add(name.lower())
    except Exception:                                          # noqa: BLE001
        pass
    # The apps the user starts most (the launcher's frecency), then the rest.
    used = {}
    try:
        usage = read_json(os.path.join(CONF_DIR, "usage.json"), {})
        if isinstance(usage, dict):
            for key, val in usage.items():
                n = val.get("count", 0) if isinstance(val, dict) else val
                try:
                    used[str(key).lower()] = float(n)
                except (TypeError, ValueError):
                    continue
    except Exception:                                          # noqa: BLE001
        used = {}
    try:
        entries = app_entries()
    except Exception:                                          # noqa: BLE001
        entries = []

    def rank(e):
        key = str(e.get("key") or "").lower()
        return -max((v for k, v in used.items() if key and (k in key or key in k)), default=0.0)
    # Only apps the user really starts: a long list of everything installed
    # is noise the recogniser starts to "hear" in silence.
    for e in sorted(entries, key=rank):
        if rank(e) >= 0:
            break
        label = re.sub(r"\s+", " ", str(e.get("name") or "")).strip()
        if not label or len(label) > 24 or label.lower() in seen or not re.search(r"[A-Za-zÄÖÜäöü]", label):
            continue
        extra.append(label)
        seen.add(label.lower())
        if len(extra) >= 14:
            break
    # whisper reads at most ~220 tokens of it; this stays well inside
    text = (", ".join(words + extra) + ".")[:520]
    try:
        os.makedirs(os.path.dirname(EAR_VOCAB_PATH), exist_ok=True)
        with open(EAR_VOCAB_PATH, "w", encoding="utf-8") as fh:
            fh.write(text)
    except OSError:
        pass
    return text


# Best first. A bigger model is only used when it is really there — and
# `earModel` in ai.json can pin one by name (see `velvet-local ears`).
EAR_MODELS = ("ggml-large-v3-turbo-q5_0.bin", "ggml-large-v3-turbo.bin", "ggml-medium-q5_0.bin",
              "ggml-medium.bin", "ggml-small.bin")


def ear_model_file() -> str:
    models = os.path.join(DATA_DIR, "models")
    want = str(ai_config().get("earModel") or "").strip()
    if want:
        path = os.path.join(models, want if want.endswith(".bin") else f"ggml-{want}.bin")
        if os.path.isfile(path):
            return path
    for name in EAR_MODELS:
        path = os.path.join(models, name)
        try:
            if os.path.getsize(path) > 20_000_000:
                return path
        except OSError:
            continue
    return ""


def brain_fields(prov) -> dict:
    """What brain she HAS — as opposed to how the last turn went. A failed turn
    (a server that was still loading, a probe that timed out) must never make
    the island claim she has no brain at all: that is a lie the user looks at
    for as long as the file keeps it."""
    return {
        "brain": prov.name or "none",
        "provider": prov.name,
        "model": prov.model,
        "brainReady": bool(prov.ok),
        "brainInstalled": local_installed(),
    }


class Provider:
    """Resolved model access. `ok` is false in the normal, honest way."""

    def __init__(self):
        self.ai = ai_config()
        self.cfg = shell_config()
        self.name = ""
        self.model = ""
        self.base = ""
        self.key = ""
        self.error = ""
        self.asked = ""
        self._tried_fallback = False
        # Native tool calling: the calls of the last round, with their ids,
        # and the reasoning that led to them (handed back with the calls so a
        # thinking model keeps its train of thought through the tool round).
        self.last_calls = []
        self.last_reasoning = ""
        self.resolve()

    @property
    def native(self) -> bool:
        """Providers that take the tools as a real schema and answer with
        real calls: llama-server (--jinja) and the OpenAI dialect."""
        return self.name in ("local", "openai", "deepseek")

    def resolve(self) -> None:
        want = (self.ai.get("provider") or "").strip()
        choice = str(self.cfg.get("provider") or "auto").strip()
        if choice and choice != "auto":
            want = choice
        self.asked = want if want not in ("", "auto") else ""
        if not want or want == "auto":
            want = self.detect()
        if not want:
            self.error = "kein Anbieter gefunden"
            return

        # "openai" is also the generic OpenAI-compatible dialect — a DeepSeek
        # or OpenRouter key in the same slot just needs its own base URL.
        if want in ("openai", "deepseek"):
            info = PROVIDER_DEFAULTS[want]
            self.name = want
            self.base = (self.ai.get("baseUrl") or info["base"]).rstrip("/")
            self.key = (self.ai.get("apiKey") or "").strip() or env_first(info["env"])
            self.model = (self.cfg.get("model") or "").strip() or self.ai.get("model") or info["model"]
            if not self.key:
                self.unusable(f"kein Schlüssel für {want}")
            return

        if want == "anthropic":
            info = PROVIDER_DEFAULTS["anthropic"]
            self.name = "anthropic"
            self.base = (self.ai.get("baseUrl") or info["base"]).rstrip("/")
            # One key slot serves every provider, so the shape has to be checked
            # or a DeepSeek key would "work" for Anthropic until the first 401.
            stored = (self.ai.get("apiKey") or "").strip()
            self.key = stored if stored.startswith("sk-ant-") else env_first(info["env"])
            self.model = (self.cfg.get("model") or "").strip() or self.ai.get("model") or info["model"]
            if not self.key:
                self.unusable("kein Schlüssel für anthropic")
            return

        if want == "ollama":
            info = PROVIDER_DEFAULTS["ollama"]
            self.name = "ollama"
            self.base = (self.ai.get("baseUrl") or os.environ.get("OLLAMA_HOST") or info["base"]).rstrip("/")
            if not self.base.startswith("http"):
                self.base = f"http://{self.base}"
            self.key = ""
            self.model = (self.cfg.get("model") or "").strip() or self.ai.get("model") or info["model"]
            return

        if want == "local":
            info = PROVIDER_DEFAULTS["local"]
            if not local_installed():
                # Chosen but not downloaded: say so, and use whatever else works.
                self.unusable("lokales Gehirn ist nicht installiert")
                return
            self.name = "local"
            self.base = (self.ai.get("baseUrl") or info["base"]).rstrip("/")
            self.key = "local"
            # The model NAME is cosmetic here — llama-server serves whatever
            # brain.gguf points at. A cloud name left in the shell config must
            # not travel into the request.
            self.model = self.ai.get("localModel") or info["model"]
            return

        self.unusable(f"unbekannter Anbieter {want!r}")

    def unusable(self, reason: str) -> None:
        """Keep the reason, then use what auto would have picked — once. An
        explicit choice that cannot work (a key that was deleted, a model tier
        that is not downloaded) must not leave her mute."""
        self.name = ""
        self.error = reason
        if self._tried_fallback:
            return
        self._tried_fallback = True
        picked = self.detect()
        if not picked or picked == self.asked:
            return
        keep = self.error
        self.ai = dict(self.ai, provider=picked)
        # The shell config still names the failing provider — without this the
        # fallback would walk into the same branch again and give up.
        self.cfg = dict(self.cfg, provider="auto")
        self.resolve()
        if self.ok:
            self.error = f"{keep} — automatisch {picked}"

    @staticmethod
    def detect() -> str:
        """Auto: the engine room wins, then a reachable ollama, then a key."""
        # The engine room first: no account, no meter, nothing to leak. A
        # machine that has it never has to be configured at all.
        if local_installed():
            return "local"
        host = os.environ.get("OLLAMA_HOST") or "127.0.0.1:11434"
        if "://" not in host:
            host = f"http://{host}"
        try:
            with urllib.request.urlopen(f"{host.rstrip('/')}/api/tags", timeout=1.2) as resp:
                if resp.status == 200:
                    return "ollama"
        except Exception:                                  # noqa: BLE001
            pass
        for name in ("openai", "deepseek", "anthropic"):
            if env_first(PROVIDER_DEFAULTS[name]["env"]):
                return name
        ai = ai_config()
        if ai.get("apiKey"):
            return "openai"
        return ""

    @property
    def ok(self) -> bool:
        return bool(self.name)

    def status(self) -> dict:
        return {
            "ok": self.ok,
            "provider": self.name,
            "model": self.model if self.ok else "",
            "base": self.base if self.ok else "",
            "error": self.error,
        }

    # ── talking ─────────────────────────────────────────────────────────────
    def stream(self, messages, system, on_delta, cancel, temperature, max_tokens, effort="low") -> str:
        self.last_calls = []
        self.last_reasoning = ""
        if self.name == "local":
            # llama-server speaks the OpenAI dialect; the only difference is
            # that somebody has to start it first.
            if not local_ready():
                raise ProviderError("lokales Gehirn nicht bereit — im SETUP installieren")
            return self._openai(messages, system, on_delta, cancel, temperature, max_tokens, effort)
        if self.name in ("openai", "deepseek"):
            return self._openai(messages, system, on_delta, cancel, temperature, max_tokens, effort)
        if self.name == "anthropic":
            return self._anthropic(messages, system, on_delta, cancel, temperature, max_tokens)
        if self.name == "ollama":
            return self._ollama(messages, system, on_delta, cancel, temperature, max_tokens)
        raise ProviderError(self.error or "no provider")

    def _open(self, url, payload, headers, timeout=120):
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        req = urllib.request.Request(url, data=body, method="POST")
        req.add_header("Content-Type", "application/json")
        for key, value in headers.items():
            req.add_header(key, value)
        try:
            return urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError as exc:
            detail = ""
            try:
                detail = exc.read().decode("utf-8", "replace")[:400]
            except Exception:                              # noqa: BLE001
                pass
            raise ProviderError(f"HTTP {exc.code}: {detail or exc.reason}") from exc
        except urllib.error.URLError as exc:
            raise ProviderError(f"unreachable: {exc.reason}") from exc

    def _read_lines(self, resp, cancel):
        for raw in resp:
            if cancel and cancel():
                resp.close()
                raise Cancelled()
            line = raw.decode("utf-8", "replace").strip()
            if line:
                yield line

    def _openai(self, messages, system, on_delta, cancel, temperature, max_tokens, effort="low") -> str:
        payload = {
            "model": self.model,
            "messages": ([{"role": "system", "content": system}] if system else []) + messages,
            "stream": True,
            "temperature": temperature,
        }
        if max_tokens:
            payload["max_tokens"] = int(max_tokens)
        # The tools as a real schema, and her calls come back as real calls:
        # for gpt-oss that is the difference between clean tool use and an
        # answer that stopped inside its own reasoning (measured).
        payload["tools"] = tool_schema()
        if self.name == "local":
            family = local_family()
            if family == "gpt-oss":
                # gpt-oss thinks in its own channel before it answers. LOW
                # for commands and chat, MEDIUM when there is something to
                # work out — asked per request, the server's default is low.
                payload["chat_template_kwargs"] = {"reasoning_effort": effort if effort in ("low", "medium", "high") else "low"}
                # Its own card's sampling: no penalties — they bend the JSON
                # of a tool call and the rhythm of German sentences.
                payload.update({"top_p": 1.0, "top_k": 0, "min_p": 0.0})
            else:
                # Qwen's own card values, tightened for tool calls: less
                # invention, fewer repeats — the two failure modes a small
                # model has.
                payload.update({"top_p": 0.9, "top_k": 40, "min_p": 0.02,
                                "repeat_penalty": 1.08, "frequency_penalty": 0.15, "presence_penalty": 0.1})
        headers = {"Authorization": f"Bearer {self.key}"}
        resp = self._open(f"{self.base}/chat/completions", payload, headers)
        out = []
        thought = []
        native = {}
        for line in self._read_lines(resp, cancel):
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            try:
                chunk = json.loads(data)
            except ValueError:
                continue
            if isinstance(chunk.get("error"), dict):
                raise ProviderError(str(chunk["error"].get("message") or chunk["error"]))
            choices = chunk.get("choices") or []
            if not choices:
                continue
            delta = choices[0].get("delta") or {}
            if delta.get("reasoning_content"):
                thought.append(str(delta["reasoning_content"]))
            piece = delta.get("content")
            if piece:
                out.append(piece)
                on_delta("".join(out))
            for call in (delta.get("tool_calls") or []):
                index = int(call.get("index") or 0)
                slot = native.setdefault(index, {"id": "", "name": "", "args": ""})
                if call.get("id"):
                    slot["id"] = str(call["id"])
                fn = call.get("function") or {}
                if fn.get("name"):
                    slot["name"] += str(fn["name"])
                if fn.get("arguments"):
                    slot["args"] += str(fn["arguments"])
        text = "".join(out)
        self.last_reasoning = "".join(thought)
        calls = []
        for index in sorted(native):
            slot = native[index]
            safe = slot["name"].strip()
            if not TOOL_NAME_MAP:
                tool_schema()
            name = TOOL_NAME_MAP.get(safe, safe)
            if name not in TOOLS:
                continue
            raw = slot["args"].strip() or "{}"
            try:
                args = json.loads(raw)
                if not isinstance(args, dict):
                    args = {}
            except ValueError:
                args = {}
            calls.append({"id": slot["id"] or f"call_{uuid.uuid4().hex[:12]}", "name": name,
                          "safe": safe, "raw": raw, "args": args})
        self.last_calls = calls
        return text

    def _anthropic(self, messages, system, on_delta, cancel, temperature, max_tokens) -> str:
        payload = {
            "model": self.model,
            "max_tokens": int(max_tokens or 512),
            "messages": messages,
            "stream": True,
            "temperature": temperature,
        }
        if system:
            payload["system"] = system
        headers = {"x-api-key": self.key, "anthropic-version": "2023-06-01"}
        resp = self._open(f"{self.base}/v1/messages", payload, headers)
        out = []
        for line in self._read_lines(resp, cancel):
            if not line.startswith("data:"):
                continue
            try:
                chunk = json.loads(line[5:].strip())
            except ValueError:
                continue
            kind = chunk.get("type")
            if kind == "error":
                raise ProviderError(str((chunk.get("error") or {}).get("message") or "error"))
            if kind == "content_block_delta":
                piece = (chunk.get("delta") or {}).get("text")
                if piece:
                    out.append(piece)
                    on_delta("".join(out))
        return "".join(out)

    def _ollama(self, messages, system, on_delta, cancel, temperature, max_tokens) -> str:
        payload = {
            "model": self.model,
            "messages": ([{"role": "system", "content": system}] if system else []) + messages,
            "stream": True,
            "options": {"temperature": temperature},
        }
        if max_tokens:
            payload["options"]["num_predict"] = int(max_tokens)
        resp = self._open(f"{self.base}/api/chat", payload, {})
        out = []
        for line in self._read_lines(resp, cancel):
            try:
                chunk = json.loads(line)
            except ValueError:
                continue
            if chunk.get("error"):
                raise ProviderError(str(chunk["error"]))
            piece = (chunk.get("message") or {}).get("content")
            if piece:
                out.append(piece)
                on_delta("".join(out))
            if chunk.get("done"):
                break
        return "".join(out)

    # ── ears: speech to text, when the provider has any ─────────────────────
    def has_ears(self) -> bool:
        files = local_files()
        if files["whisper"] and os.path.isfile(files["ear"]):
            return True
        if not self.name:
            return False
        ai = self.ai
        if ai.get("sttModel") or ai.get("sttBaseUrl"):
            return True
        return self.name in ("openai", "deepseek")

    def _transcribe_local(self, path: str, cli: str, model: str, quick: bool = False) -> dict:
        """whisper.cpp on this machine — on the graphics card when the Vulkan
        build is there and no game holds the card, else on the CPU."""
        gpu = local_files().get("whisper_gpu") or ""
        if gpu and not os.environ.get("VELLY_EARS_CPU"):
            device = ""
            try:
                sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
                import _gpu                                    # noqa: PLC0415
                busy = _gpu.game_running()
                device = _gpu.pick_device(local_files().get("server") or "") if not busy else ""
            except Exception:                                  # noqa: BLE001
                busy = False
            if not busy:
                began = time.monotonic()
                result = self._whisper(path, gpu, model, quick, device=re.sub(r"\D", "", device) or "0")
                if result.get("ok"):
                    result["engine"] = f"gpu {time.monotonic() - began:.2f}s"
                    return result
                log(f"ears on the GPU failed ({result.get('error')}) — the CPU listens instead")
        return self._whisper(path, cli, model, quick)

    def _whisper(self, path: str, cli: str, model: str, quick: bool = False, device: str = "") -> dict:
        """One whisper.cpp run. German by default, because that is what gets
        spoken to her; `sttLang` in ai.json changes it. `device` set = the
        Vulkan build on that card: then the whole 30-second window costs
        0.15 s, so no audio-context trimming (and none of its loops)."""
        lang = (self.ai.get("sttLang") or self.cfg.get("sttLang") or "de").strip() or "de"
        base = os.path.join(tempfile.gettempdir(), f"velvet-stt-{os.getpid()}")
        big = "large" in os.path.basename(model).lower() or "turbo" in os.path.basename(model).lower()
        # A big model gets every core for its one burst; the small one leaves
        # the machine half to itself.
        threads = max(2, (os.cpu_count() or 4) if (big and not quick) else (os.cpu_count() or 4) // 2)
        # Whisper's encoder always works on a 30-second window, and on this
        # CPU that window IS the wait: 7.6 s for an 8.6 s sentence. An audio
        # context sized to the recording (1500 = 30 s) gives the same words in
        # 2.6 s — measured on the turbo model with a German test sentence.
        # Beam search bought nothing there and repeated the last clause, so
        # greedy decoding it is.
        seconds = 0.0
        try:
            import wave as _wave                               # noqa: PLC0415
            with _wave.open(path, "rb") as clip:
                seconds = clip.getnframes() / float(clip.getframerate() or 16000)
        except Exception:                                      # noqa: BLE001
            seconds = 0.0
        # Too tight a context makes a short clip loop ("Mach bitte lauter.
        # Mach bitte lauter. Mach bitte lauter." at 203/384 — measured); from
        # 512 up it did not, and 512 still halves the wait for short commands.
        ctx = 0
        if 0 < seconds < 29 and not device:
            ctx = min(1500, max(512, int(seconds / 30.0 * 1500) + 128))
        if device:
            threads = 4
        cmd = [cli, "-m", model, "-f", path, "-l", lang, "-t", str(threads), "-bs", "1",
               # No context carried between segments: that is what makes whisper
               # repeat its last sentence on silence.
               "-mc", "128",
               # -ojf: every token with its probability — what tells a word
               # you said from a word whisper made up out of silence.
               "-oj", "-ojf", "-of", base] + (["-ac", str(ctx)] if ctx else []) + (["-dev", device] if device else [])
        if lang != "auto":
            # Words it would otherwise guess wrong: her name, the commands
            # people give her, the user's name and the apps on this machine.
            cmd += ["--prompt", ear_vocabulary()]
        try:
            proc = subprocess.run(cmd, capture_output=True, timeout=25 if device else 240)
        except (OSError, subprocess.TimeoutExpired) as exc:
            return {"ok": False, "error": f"whisper: {exc}", "text": ""}
        data = read_json(base + ".json", {})
        try:
            os.unlink(base + ".json")
        except OSError:
            pass
        if proc.returncode != 0 or not isinstance(data, dict):
            detail = (proc.stderr.decode("utf-8", "replace") or "").strip().splitlines()
            return {"ok": False, "text": "",
                    "error": f"whisper failed: {detail[-1] if detail else proc.returncode}"}
        segments = data.get("transcription") or []
        text = " ".join(str(seg.get("text") or "").strip() for seg in segments).strip()
        text = normalise_transcript(text)
        confidence = transcript_confidence(segments)
        # Whisper on silence or noise does not return nothing — it returns
        # "Amen.", "Okay.", "Vielen Dank." (measured here: silence and white
        # noise both came back "Amen.", a hum "Okay."). Those words carry
        # probabilities around 0.1; real speech sits at 0.7 and up.
        if text and confidence < 0.4:
            return {"ok": True, "text": "", "error": "", "dropped": text, "confidence": round(confidence, 2)}
        if text and confidence < 0.6 and PHANTOM.fullmatch(text.strip()):
            return {"ok": True, "text": "", "error": "", "dropped": text, "confidence": round(confidence, 2)}
        # Whisper's two habits on silence: subtitle credits, and one word five
        # times. Neither is something you said.
        if re.fullmatch(r"(?i)\s*(\[.*?\]|\(.*?\)|untertitel.*|amara\.org.*|thanks for watching.*)\s*", text):
            text = ""
        if text and re.fullmatch(r"(?i)\s*(\S+)(\s+\1){3,}\s*", text):
            text = ""
        # Quotes round the whole sentence are whisper's, not yours.
        text = re.sub(r"^[\s»«„“”\"']+|[\s»«„“”\"']+$", "", text or "")
        # Nothing to say: punctuation only ("…", "."), a web address out of
        # nowhere ("www.….com" from silence — measured once the prompt was
        # really read), or the vocabulary prompt read back.
        if not re.search(r"[A-Za-zÄÖÜäöüß]{2}", text):
            text = ""
        if text and re.fullmatch(r"(?i)\s*(?:https?://|www\.)?[\w.-]+\.(?:com|de|org|net|at|ch|tv|au|uk|eu|info|io)(?:/\S*)?[\s.]*", text):
            text = ""
        if text and text.count(",") >= 3:
            vocab = {w.strip().lower() for w in EAR_COMMANDS.split(",")}
            pieces = [w.strip(" .").lower() for w in text.split(",")]
            if sum(1 for w in pieces if w in vocab) >= max(3, len(pieces) * 0.6):
                text = ""
        # A sentence heard twice in a row is one sentence said once.
        if text:
            parts = re.split(r"(?<=[.!?])\s+", text.strip())
            kept = [part for i, part in enumerate(parts) if i == 0 or part.lower() != parts[i - 1].lower()]
            text = " ".join(kept)
        return {"ok": True, "text": text, "error": ""}

    def transcribe(self, path: str) -> dict:
        files = local_files()
        if files["whisper"] and os.path.isfile(files["ear"]):
            return self._transcribe_local(path, files["whisper"], files["ear"])
        if not self.has_ears():
            return {"ok": False, "error": "no ears", "text": ""}
        base = (self.ai.get("sttBaseUrl") or self.base).rstrip("/")
        model = self.ai.get("sttModel") or ("whisper-1" if self.name != "deepseek" else "whisper-1")
        try:
            with open(path, "rb") as fh:
                audio = fh.read()
        except OSError as exc:
            return {"ok": False, "error": f"cannot read {path}: {exc}", "text": ""}
        boundary = "----velvet" + uuid.uuid4().hex
        parts = []
        for name, value in (("model", model), ("response_format", "json"), ("language", "auto")):
            parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n{value}\r\n".encode())
        mime = mimetypes.guess_type(path)[0] or "audio/wav"
        parts.append(
            f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{os.path.basename(path)}\"\r\n"
            f"Content-Type: {mime}\r\n\r\n".encode())
        parts.append(audio)
        parts.append(f"\r\n--{boundary}--\r\n".encode())
        body = b"".join(parts)
        req = urllib.request.Request(f"{base}/audio/transcriptions", data=body, method="POST")
        req.add_header("Content-Type", f"multipart/form-data; boundary={boundary}")
        req.add_header("Authorization", f"Bearer {self.key}")
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                data = json.loads(resp.read().decode("utf-8", "replace") or "{}")
            return {"ok": True, "text": normalise_transcript(str(data.get("text") or "").strip()),
                    "error": ""}
        except urllib.error.HTTPError as exc:
            detail = ""
            try:
                detail = exc.read().decode("utf-8", "replace")[:300]
            except Exception:                                  # noqa: BLE001
                pass
            return {"ok": False, "error": f"HTTP {exc.code}: {detail}", "text": ""}
        except Exception as exc:                               # noqa: BLE001
            return {"ok": False, "error": str(exc), "text": ""}


class ProviderError(RuntimeError):
    pass


class Cancelled(RuntimeError):
    pass


# ───────────────────────────────────────────────────────────── the session gate
def session_state() -> dict:
    data = read_json(SESSION_PATH, {})
    if not isinstance(data, dict):
        return {"active": False, "until": 0}
    return data


def session_open() -> bool:
    data = session_state()
    if data.get("active") is not True:
        return False
    try:
        until = float(data.get("until") or 0) / 1000.0
    except (TypeError, ValueError):
        return False
    return time.time() < until + SESSION_GRACE


# ──────────────────────────────────────────────────────────────────── memory
def memory() -> dict:
    data = read_json(MEMORY_PATH, {})
    out = {"facts": [], "notes": [], "history": [], "prefs": {}, "stats": {"turns": 0, "tools": {}, "sessions": 0}}
    if isinstance(data, dict):
        for key in out:
            if key in data:
                out[key] = data[key]
    return out


def save_memory(mem: dict) -> None:
    if isinstance(mem.get("history"), list) and len(mem["history"]) > 400:
        mem["history"] = mem["history"][-400:]
    write_json(MEMORY_PATH, mem)


# The name she calls the user by, in every wording a fact has used for it:
# "Heißt Max", "Name: Creep", "Nutzername: Creep", "möchte Creep genannt
# werden", "User wants to be called Creep". The old pattern knew two of them,
# so she asked for a name she had been told twice (measured).
# Only the user's own name: "Sein Hund heißt Bello" is not one.
NAME_FACT = re.compile(
    r"(?:(?:^\W*|\b(?:der nutzer|der user|der benutzer|user|nutzer|benutzer|er|sie|ich)\s+)hei(?:ß|ss)(?:t|e)"
    r"|\b(?:nutzer|user|benutzer|mein|sein|ihr|dein)?name(?:\s+ist|\s+is|\s*:)"
    r"|\bnenn(?:e|t)?\s+(?:mich|ihn|sie)(?:\s+(?:ab jetzt|ab sofort|einfach|bitte|lieber))*"
    r"|\b(?:be )?called|\bcall me|\bnamed)\s+[„\"'»]?([A-ZÄÖÜ][\wäöüß-]{1,30})"
    r"|\bmich\s+(?:(?:ab jetzt|ab sofort|einfach|bitte|lieber)\s+)*[„\"'»]?([A-ZÄÖÜ][\wäöüß-]{1,30})[“\"'«]?\s+nennen"
    r"|\b([A-ZÄÖÜ][\wäöüß-]{1,30})\s+genannt\s+werden", re.I)
NOT_A_NAME = {"nicht", "noch", "unbekannt", "unknown", "der", "die", "das", "den", "dem", "ein", "eine", "er", "sie", "es",
              "the", "a", "an", "not", "user", "nutzer", "benutzer", "velly", "velvet", "du", "dich", "mich", "ich",
              "so", "wie", "was", "jetzt", "ab", "bitte", "einfach", "gern", "gerne", "lieber", "mal", "the user"}


def name_in(text: str) -> str:
    for match in NAME_FACT.finditer(text or ""):
        cand = (match.group(1) or match.group(2) or match.group(3) or "").strip("-")
        if len(cand) >= 2 and cand.lower() not in NOT_A_NAME:
            return cand[0].upper() + cand[1:]
    return ""


def remember(text: str, tags=None) -> dict:
    text = (text or "").strip()
    if not text:
        return {"ok": False, "error": "empty"}
    mem = memory()
    facts = mem.get("facts") or []
    named = name_in(text)
    if named:
        # A name is not one fact among many: the newest one wins, and it is
        # kept where every part of her looks first (prefs.name).
        prefs = mem.get("prefs") if isinstance(mem.get("prefs"), dict) else {}
        prefs["name"] = named
        mem["prefs"] = prefs
        facts = [f for f in facts if not (isinstance(f, dict) and name_in(str(f.get("text") or "")))]
        text = f"Heißt {named}."
    for fact in facts:
        if isinstance(fact, dict) and (fact.get("text", "").lower() == text.lower() or same_fact(fact.get("text", ""), text)):
            return {"ok": True, "id": fact.get("id"), "note": "already known"}
    entry = {"id": (max([f.get("id", 0) for f in facts if isinstance(f, dict)] or [0]) + 1),
             "text": text, "tags": [t for t in (tags or []) if isinstance(t, str)][:4],
             "added": now_ms(), "hits": 0}
    facts.append(entry)
    mem["facts"] = facts
    save_memory(mem)
    return {"ok": True, "id": entry["id"]}


def forget(query: str) -> dict:
    query = (query or "").strip().lower()
    mem = memory()
    facts = mem.get("facts") or []
    if not query:
        return {"ok": False, "error": "empty"}
    keep = [f for f in facts if not (isinstance(f, dict) and query in f.get("text", "").lower())]
    removed = len(facts) - len(keep)
    mem["facts"] = keep
    save_memory(mem)
    return {"ok": True, "removed": removed}


# ── memory hygiene ─────────────────────────────────────────────────────────
# What the distiller used to keep: "User speaks German" eight times, "User ran
# echo command vtest-17", "Velly repeatedly states brain is not loaded", "User
# prefers short answers" (from a test that asked for "OK")… 78 facts, most of
# them about a session, an error or a test — and all of them in the prompt,
# which is how she ended up answering "Ja." A fact is about the PERSON: who
# they are, what they like, what they use and work on.
JUNK_FACT = re.compile(
    r"(velly|velvet|assistant|assistent|brain|gehirn|lokal|setup|error|fehler|terminal|confirm|bestätig|"
    r"\btest|echo|vtest|probe|download|herunterge|\basked\b|\basks?\b|fragt|frage|requested|request|inquir|"
    r"verlangt|wants to (install|download)|wants .* installed|möchte .* install|uhrzeit|current time|\btime\b|"
    r"seems|scheint|might|possibly|repeatedly|multiple times|mehrfach|häufig|frequently|regularly|"
    r"session|command|befehl|\btool|respon|antwort|'ok'|\"ok\"|\bok\b|patient|interacting|conversing|messages|"
    r"greets|begrüß|confirmed|bestätigt|executed|ausgeführt|system load|auslastung|is checking|monitoring|"
    r"capital|hauptstadt|moon|mond|birth|geburt|was downloaded|is open|encounter|status|\bload\b|geograf|"
    r"concise|prägnant|knapp|short answer|kurze antwort|direct interaction|prefers direct|"
    r"\d+[.,]?\d*\s*gb (?:ram )?(?:used|belegt|frei|free)|\bused\b|belegt)", re.I)

# Two facts on the same topic are one fact, however they are worded:
# "communicates in German", "speaks German", "uses German language".
FACT_TOPICS = {
    "language": re.compile(r"\b(german|deutsch|english|englisch|language|sprache)\b", re.I),
    "memory": re.compile(r"\b(\d+[.,]?\d*\s*gb ram|ram|arbeitsspeicher)\b", re.I),
    "gpu": re.compile(r"\b(gpu|grafikkarte|radeon|geforce|rtx|rx \d+)\b", re.I),
    "music service": re.compile(r"\b(spotify|youtube music|apple music|deezer|tidal)\b", re.I),
}


def fact_topic(text: str) -> str:
    for key, pattern in FACT_TOPICS.items():
        if pattern.search(text or ""):
            return key
    return ""


def fact_words(text: str) -> set:
    low = re.sub(r"\b(the user|user|der user|der nutzer|nutzer|they|their|his|her|er|sie)\b", " ", (text or "").lower())
    return {w for w in re.split(r"[^\wäöüß]+", low) if len(w) > 2}


def same_fact(a: str, b: str) -> bool:
    ta = fact_topic(a)
    if ta and ta == fact_topic(b):
        return True
    wa, wb = fact_words(a), fact_words(b)
    if not wa or not wb:
        return False
    return len(wa & wb) / len(wa | wb) >= 0.5


def tidy_facts(facts: list) -> list:
    """Keep facts about the person, once each. Facts the user TOLD her
    (memory.remember) are never judged, only de-duplicated."""
    kept = []
    # "Name: Creep" and "Nutzername: Creep" both survived the word overlap —
    # one name, the newest, is all she needs.
    names = [i for i, f in enumerate(facts) if isinstance(f, dict) and name_in(str(f.get("text") or ""))]
    for index, fact in enumerate(facts):
        if not isinstance(fact, dict) or not str(fact.get("text", "")).strip():
            continue
        if index in names and index != names[-1]:
            continue
        told = "told" in (fact.get("tags") or []) or index in names
        if not told and JUNK_FACT.search(fact["text"]):
            continue
        if any(same_fact(fact["text"], k["text"]) for k in kept):
            continue
        kept.append(fact)
    return kept[-60:]


def tidy_memory() -> dict:
    mem = memory()
    before = len(mem.get("facts") or [])
    mem["facts"] = tidy_facts(mem.get("facts") or [])
    notes = [n for n in (mem.get("notes") or []) if isinstance(n, dict) and not JUNK_FACT.search(n.get("text", "") or "")]
    mem["notes"] = notes[-40:]
    save_memory(mem)
    return {"ok": True, "facts_before": before, "facts_after": len(mem["facts"])}


def relevant_facts(text: str, limit: int = 6) -> list:
    mem = memory()
    facts = [f for f in (mem.get("facts") or []) if isinstance(f, dict)]
    if not facts:
        return []
    words = {w for w in re.split(r"[^\wäöüß]+", (text or "").lower()) if len(w) > 2}

    def score(fact):
        hay = f"{fact.get('text', '')} {' '.join(fact.get('tags') or [])}".lower()
        hits = sum(1 for w in words if w in hay)
        return (hits, fact.get("added", 0))

    # Facts that share a word with the message first, then at most two of the
    # newest others — four Spotify facts in front of a weather question kept
    # turning her talk back to music.
    ranked = sorted(facts, key=score, reverse=True)
    hits = [f for f in ranked if score(f)[0] > 0][:limit]
    newest = sorted((f for f in facts if f not in hits), key=lambda f: f.get("added", 0), reverse=True)
    return hits + newest[:max(0, min(2, limit - len(hits)))]


def note(text: str) -> None:
    mem = memory()
    notes = mem.get("notes") or []
    notes.append({"at": now_ms(), "text": text.strip()[:400]})
    mem["notes"] = notes[-40:]
    save_memory(mem)


# ────────────────────────────────────────────────────────────────── the shell
def shell_ipc(target: str, *args, timeout: float = 4.0) -> str:
    """Ask the running shell to do something. Empty string when it is gone."""
    cmd = ["qs", "-c", "velvet", "ipc", "call", target] + [str(a) for a in args]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return (proc.stdout or "").strip()


def shell_state() -> dict:
    raw = shell_ipc("velly", "state")
    if not raw:
        return {}
    try:
        data = json.loads(raw)
        return data if isinstance(data, dict) else {}
    except ValueError:
        return {}


def hctl_json(*args) -> dict | list:
    try:
        proc = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True, timeout=4)
        return json.loads(proc.stdout or "null")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return {}


def hctl_dispatch(lua_expr: str) -> bool:
    """Hyprland 0.56 wants Lua dispatchers; the classic strings are gone."""
    try:
        proc = subprocess.run(["hyprctl", "dispatch", lua_expr], capture_output=True, text=True, timeout=4)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return "ok" in (proc.stdout or "").lower()


def run(cmd, timeout: float = 10.0) -> tuple:
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return proc.returncode, (proc.stdout or "").strip(), (proc.stderr or "").strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, "", str(exc)


def lua_str(s: str) -> str:
    # Newlines included: a Lua short string cannot carry a raw line break, and
    # a terminal command arrives wrapped in a quoted shell command with real
    # newlines in it. Measured: the dispatch answered with a syntax error and
    # every install died in "kein Terminal gefunden".
    body = (str(s).replace("\\", "\\\\").replace("'", "\\'")
            .replace("\n", "\\n").replace("\r", "\\r"))
    return "'" + body + "'"


# ──────────────────────────────────────────────────────────────── the tools
class Tool:
    def __init__(self, name, args, level, doc, fn):
        self.name = name
        self.args = args
        self.level = level
        self.doc = doc
        self.fn = fn


TOOLS = {}

# OpenAI's spec allows [a-zA-Z0-9_-] in a tool name, so our dotted names travel
# as `pkg_install` and come home through this map. gpt-oss calls tools natively
# and cleanly (measured: 36 tokens, perfect arguments); asked for the same thing
# in prose it ended inside its analysis channel and answered NOTHING — three
# times in a row, which is what "unbenutzbar" looked like.
TOOL_NAME_MAP = {}


# What each argument means. A schema of bare types left the model guessing:
# a whole sentence as the query of media.play, "stop" as a media action, a
# relative "+10" as a volume. A description (and an enum where a tool only
# takes a few words) is the cheapest intelligence there is.
ARG_DOCS = {
    "apps.search": {"query": "part of the app name"},
    "apps.launch": {"name": "the app's name as the user said it (Firefox, Spotify, Discord …)",
                    "args": "optional: a file or link to open with it"},
    "win.focus": {"match": "window class or part of its title"},
    "win.close": {"match": "window class or part of its title"},
    "win.float": {"match": "window class or part of its title"},
