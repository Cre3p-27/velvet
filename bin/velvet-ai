@tool("apps.search", '{"query": "text"}', "read", "Find installed apps by name.")
def t_apps_search(query=""):
    needle = (query or "").lower().strip()
    hits = []
    for app in app_entries():
        if not needle or needle in app["key"] or needle in app["comment"].lower():
            hits.append(app["name"])
        if len(hits) >= 12:
            break
    return {"apps": hits}


