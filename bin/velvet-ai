REQUIRED = {"apps.search": ["query"], "apps.launch": ["name"], "win.focus": ["match"], "win.close": ["match"],
            "win.float": ["match"], "win.move": ["match", "workspace"], "ws.switch": ["workspace"],
            "volume.set": ["percent"], "brightness.set": ["percent"], "media.control": ["action"],
            "media.play": ["query"], "memory.remember": ["text"], "memory.forget": ["query"], "tasks.add": ["text"],
            "tasks.done": ["id"], "tasks.remove": ["id"], "theme.accent": ["hex"], "toast.show": ["text"],
            "island.module": ["module"], "term.run": ["command"], "cmd.run": ["command"], "pkg.search": ["query"],
            "pkg.install": ["name"], "web.lookup": ["query"], "web.read": ["url"], "web.open": ["url"],
            "web.search": ["query"], "web.download": ["url"], "file.write": ["name", "text"], "calc.eval": ["expr"],
            "date.lookup": ["when"], "clipboard.write": ["text"], "settings.find": ["query"],
            "settings.set": ["key"], "look.apply": ["look"]}


def tool_schema() -> list:
    """The tool list in the format a real tool-calling model expects."""
    TOOL_NAME_MAP.clear()
    out = []
    for name in sorted(TOOLS):
        spec = TOOLS[name]
        safe = name.replace(".", "_")
        TOOL_NAME_MAP[safe] = name
        try:
            example = json.loads(spec.args) if spec.args else {}
        except ValueError:
            example = {}
        docs = ARG_DOCS.get(name) or {}
        props = {}
        for key, value in (example or {}).items():
            if isinstance(value, bool):
                kind = "boolean"
            elif isinstance(value, int):
                kind = "integer"
            elif isinstance(value, float):
                kind = "number"
            else:
                kind = "string"
            prop = {"type": kind}
            doc = docs.get(key)
            if isinstance(doc, tuple):
                prop["description"], prop["enum"] = doc[0], list(doc[1])
            elif doc:
                prop["description"] = doc
            props[key] = prop
        params = {"type": "object", "properties": props}
        need = [k for k in REQUIRED.get(name, []) if k in props]
        if need:
            params["required"] = need
        out.append({"type": "function", "function": {
            "name": safe,
            "description": (spec.doc or "")[:320],
            "parameters": params}})
    return out


def tool(name, args="", level="write", doc=""):
    def wrap(fn):
        TOOLS[name] = Tool(name, args, level, doc or (fn.__doc__ or "").strip().split("\n")[0], fn)
        return fn
    return wrap


def app_entries() -> list:
    """Every .desktop app, as {name, exec, comment, key}."""
    dirs = ["/usr/share/applications", "/usr/local/share/applications",
            os.path.join(HOME, ".local/share/applications"),
            "/var/lib/flatpak/exports/share/applications",
            os.path.join(HOME, ".local/share/flatpak/exports/share/applications")]
    out = []
    seen = set()
    for folder in dirs:
        if not os.path.isdir(folder):
            continue
        for entry in sorted(os.listdir(folder)):
            if not entry.endswith(".desktop"):
                continue
            path = os.path.join(folder, entry)
            name = exec_line = comment = ""
            hidden = False
            try:
                with open(path, "r", encoding="utf-8", errors="replace") as fh:
                    for line in fh:
                        if line.startswith("Name=") and not name:
                            name = line[5:].strip()
                        elif line.startswith("Exec=") and not exec_line:
                            exec_line = line[5:].strip()
                        elif line.startswith("Comment=") and not comment:
                            comment = line[8:].strip()
                        elif line.startswith("NoDisplay=true"):
                            hidden = True
            except OSError:
                continue
            if hidden or not name or not exec_line:
                continue
            key = name.lower()
            if key in seen:
                continue
            seen.add(key)
            out.append({"name": name, "exec": exec_line, "comment": comment, "key": key})
    return out


def clean_exec(exec_line: str) -> str:
    """Desktop Exec lines carry field codes (%U, %f) that no shell wants."""
    return re.sub(r"\s%[fFuUdDnNickvm]\b", "", exec_line).strip()


def windows() -> list:
    data = hctl_json("clients")
    return data if isinstance(data, list) else []


def match_window(needle: str):
    needle = (needle or "").strip().lower()
    if not needle:
        return None
    best = None
    for win in windows():
        hay = f"{win.get('class', '')} {win.get('initialClass', '')} {win.get('title', '')}".lower()
        if needle == (win.get("class") or "").lower() or needle in hay:
            if best is None or (needle in (win.get("class") or "").lower() and needle not in (best.get("class") or "").lower()):
                best = win
    return best


@tool("shell.state", "", "read", "The desktop right now: volume, brightness, workspace, windows, tasks, weather, media, focus, wallpaper, clock.")
def t_shell_state():
    return shell_state() or {"error": "the shell is not answering"}


@tool("sys.info", "", "read", "CPU, memory, swap, disk, uptime and load of this machine.")
def t_sys_info():
    out = {}
    try:
        with open("/proc/loadavg") as fh:
            out["load"] = fh.read().split()[:3]
        with open("/proc/uptime") as fh:
            up = float(fh.read().split()[0])
        out["uptime"] = f"{int(up // 3600)}h {int(up % 3600 // 60)}m"
        mem = {}
        with open("/proc/meminfo") as fh:
            for line in fh:
                key, _, rest = line.partition(":")
                mem[key] = rest.strip()
        total = int(mem.get("MemTotal", "0 kB").split()[0])
        avail = int(mem.get("MemAvailable", "0 kB").split()[0])
        out["memory_used_gb"] = round((total - avail) / 1048576, 1)
        out["memory_total_gb"] = round(total / 1048576, 1)
    except (OSError, ValueError):
        pass
    code, disk, _ = run(["df", "-h", "--output=pcent,avail", HOME])
    if code == 0:
        out["disk"] = disk.split("\n")[-1].split()
    code, temp, _ = run(["bash", "-c", "sensors 2>/dev/null | grep -m1 -E 'Package id 0|Tctl' | awk '{print $2}'"])
    if code == 0 and temp:
        out["temp"] = temp
    # Load averages mean nothing to a person ("Load 3.88, 5.18" was the
    # answer to "wie geht es meinem System?") — a real CPU percentage does.
    pct = cpu_percent()
    if pct is not None:
        out["cpu_percent"] = pct
    out["cores"] = os.cpu_count() or 0
    # what people ask next: how many packages, which kernel, how many updates
    # wait — read, never guessed (she made a number up once, measured)
    code, pkgs, _ = run(["bash", "-c", "pacman -Qq 2>/dev/null | wc -l"])
    if code == 0 and pkgs.strip().isdigit():
        out["packages"] = int(pkgs.strip())
    out["kernel"] = os.uname().release
    out["summary"] = system_sentence(out)
    return out


def cpu_percent(window: float = 0.3):
    """Busy share of all cores over a short window, from /proc/stat."""
    def sample():
        with open("/proc/stat") as fh:
            parts = [int(x) for x in fh.readline().split()[1:]]
        idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
        return idle, sum(parts)
    try:
        i0, t0 = sample()
        time.sleep(window)
        i1, t1 = sample()
    except (OSError, ValueError, IndexError):
        return None
    total = t1 - t0
    if total <= 0:
        return None
    return round(100.0 * (1 - (i1 - i0) / total))


def german_number(value, digits=1) -> str:
    return f"{value:.{digits}f}".replace(".", ",")


def system_sentence(info: dict) -> str:
    """How the machine is doing, the way a person would say it."""
    bits = []
    pct = info.get("cpu_percent")
    if pct is not None:
        mood = "entspannt" if pct < 30 else ("gut beschäftigt" if pct < 70 else "unter Volllast")
        bits.append(f"der Prozessor ist {mood} ({pct} %)")
    if info.get("memory_total_gb"):
        bits.append(f"{german_number(info.get('memory_used_gb', 0))} von "
                    f"{german_number(info['memory_total_gb'])} GB Arbeitsspeicher sind belegt")
    temp = str(info.get("temp") or "").strip().lstrip("+").replace("°C", "").strip()
    if temp:
        try:
            bits.append(f"die CPU hat {round(float(temp))} °C")
        except ValueError:
            pass
    if not bits:
        return "Die Systemwerte sind gerade nicht lesbar."
    parts = [bits[0][0].upper() + bits[0][1:]] + bits[1:]
    if len(parts) == 1:
        return parts[0] + "."
    return ", ".join(parts[:-1]) + " und " + parts[-1] + "."


WEEKDAYS_DE = ("Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag")
MONTHS_DE = ("Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September",
             "Oktober", "November", "Dezember")


def date_de(stamp=None) -> str:
    """"Montag, 28. September 2026" — strftime("%A") follows the locale, and
    the daemon runs without one: the answer used to be "Heute ist Tuesday"."""
    t = stamp or time.localtime()
    return f"{WEEKDAYS_DE[t.tm_wday]}, {t.tm_mday}. {MONTHS_DE[t.tm_mon - 1]} {t.tm_year}"


# ── days: "morgen", "nächsten Freitag", "in 10 Tagen", "24.12." ──────────
#  A model that works out a weekday in its head gets it wrong often enough;
#  this counts. None when the text names no day at all.
DAY_WORDS = {"montag": 0, "dienstag": 1, "mittwoch": 2, "donnerstag": 3, "freitag": 4, "samstag": 5,
             "sonnabend": 5, "sonntag": 6}
MONTH_WORDS = {"januar": 1, "jänner": 1, "februar": 2, "märz": 3, "maerz": 3, "april": 4, "mai": 5, "juni": 6,
               "juli": 7, "august": 8, "september": 9, "oktober": 10, "november": 11, "dezember": 12}
FEAST_DAYS = {"heiligabend": (12, 24), "weihnachten": (12, 24), "silvester": (12, 31), "neujahr": (1, 1),
              "halloween": (10, 31), "valentinstag": (2, 14), "tag der deutschen einheit": (10, 3),
              "nikolaus": (12, 6)}
COUNT_WORDS = {"einem": 1, "einer": 1, "eins": 1, "ein": 1, "eine": 1, "zwei": 2, "drei": 3, "vier": 4, "fünf": 5,
               "fuenf": 5, "sechs": 6, "sieben": 7, "acht": 8, "neun": 9, "zehn": 10, "elf": 11, "zwölf": 12,
               "zwoelf": 12, "vierzehn": 14, "zwanzig": 20, "dreißig": 30, "dreissig": 30, "hundert": 100}


def resolve_day(text: str, today=None):
    import datetime as _dt                                     # noqa: PLC0415
    today = today or _dt.date.today()
    low = f" {(text or '').lower()} "
    if re.search(r"\b(heute|today|jetzt|gerade)\b", low) and not re.search(r"\bheute in\b", low):
        base = today
    else:
        base = None
    if re.search(r"\b(übermorgen|uebermorgen)\b", low):
        return today + _dt.timedelta(days=2)
    if re.search(r"\bvorgestern\b", low):
        return today - _dt.timedelta(days=2)
    if re.search(r"\bgestern\b|\byesterday\b", low):
        return today - _dt.timedelta(days=1)
    # "morgen", but not "guten Morgen" or "heute Morgen" (that is today).
    if re.search(r"(?<!guten )(?<!heute )\bmorgen\b(?!s)|\btomorrow\b", low):
        return today + _dt.timedelta(days=1)
    span = re.search(r"\bin\s+(\d+|" + "|".join(COUNT_WORDS) + r")\s+(tag|tagen|woche|wochen|monat|monaten)\b", low)
    if span:
        n = int(span.group(1)) if span.group(1).isdigit() else COUNT_WORDS[span.group(1)]
        unit = span.group(2)
        days = n * (7 if unit.startswith("woche") else 30 if unit.startswith("monat") else 1)
        return today + _dt.timedelta(days=days)
    for word, (month, day) in FEAST_DAYS.items():
        if word in low:
            when = _dt.date(today.year, month, day)
            return when if when >= today else _dt.date(today.year + 1, month, day)
    iso = re.search(r"\b(\d{4})-(\d{2})-(\d{2})\b", low)
    dotted = re.search(r"\b(\d{1,2})\.\s*(\d{1,2})\.(?:\s*(\d{2,4}))?", low)
    named = re.search(r"\b(\d{1,2})\.?\s+(" + "|".join(MONTH_WORDS) + r")\b(?:\s+(\d{4}))?", low)
    try:
        if iso:
            return _dt.date(int(iso.group(1)), int(iso.group(2)), int(iso.group(3)))
        if dotted or named:
            m = dotted or named
            day = int(m.group(1))
            month = int(m.group(2)) if dotted else MONTH_WORDS[m.group(2)]
            year = int(m.group(3)) if m.group(3) else today.year
            if year < 100:
                year += 2000
            when = _dt.date(year, month, day)
            if not m.group(3) and when < today:
                when = _dt.date(year + 1, month, day)
            return when
    except ValueError:
        return None
    if re.search(r"\b(wochenende|weekend)\b", low):
        ahead = (5 - today.weekday()) % 7
        return today if today.weekday() >= 5 else today + _dt.timedelta(days=ahead)
    for word, index in DAY_WORDS.items():
        if re.search(rf"\b{word}\b", low):
            ahead = (index - today.weekday()) % 7
            if re.search(rf"\b(nächste[nrs]?|naechste[nrs]?|kommende[nrs]?)\s+{word}\b", low) and ahead == 0:
                ahead = 7
            if re.search(rf"\b(letzte[nrs]?|vergangene[nrs]?)\s+{word}\b", low):
                ahead = ahead - 7 if ahead else -7
            return today + _dt.timedelta(days=ahead)
    if re.search(r"\b(nächste|naechste|kommende) woche\b", low):
        return today + _dt.timedelta(days=7)
    return base


def days_words(delta: int) -> str:
    if delta == 0:
        return "heute"
    if delta == 1:
        return "morgen"
    if delta == 2:
        return "übermorgen"
    if delta == -1:
        return "gestern"
    return f"in {delta} Tagen" if delta > 0 else f"vor {-delta} Tagen"


@tool("date.lookup", '{"when": "nächsten Freitag"}', "read",
      "Which date and weekday a day is ('morgen', 'nächsten Freitag', 'in 10 Tagen', '24.12.', 'Weihnachten') and how many days away it is.")
def t_date_lookup(when=""):
    import datetime as _dt                                     # noqa: PLC0415
    day = resolve_day(str(when or "heute"))
    if day is None:
        return {"ok": False, "error": f"welchen Tag meinst du mit {when!r}?"}
    delta = (day - _dt.date.today()).days
    return {"ok": True, "date": date_de(day.timetuple()), "iso": day.isoformat(),
            "weekday": WEEKDAYS_DE[day.weekday()], "days_from_today": delta, "relative": days_words(delta)}


# ── places: where something is, and what time it is there ───────────────
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "velvet")
WHERE_PATH = os.path.join(CACHE_DIR, "where.json")


def geocode(place: str) -> dict:
    """{name, country, lat, lon, tz} for a place name — Open-Meteo's own
    geocoder (no key, made for programs), German names first."""
    q = re.sub(r"^(?:in|im|nach|aus|für|fuer)\s+", "", str(place or "").strip(), flags=re.I).strip(" ?.!")
    q = q.split(",")[0].strip()
    if not q:
        return {}
    # The German list alone answered "new york" with York (7 864 people):
    # the English one knows the city. Both are asked when the first has no
    # real town of that name, and the biggest place of that name wins.
    hits = []
    for lang in ("de", "en"):
        try:
            data = json.loads(fetch_text("https://geocoding-api.open-meteo.com/v1/search?count=5&language="
                                         f"{lang}&name=" + urllib.parse.quote(q), 5))
        except Exception:                                      # noqa: BLE001
            break
        hits += [h for h in (data.get("results") or []) if isinstance(h, dict)]
        named = [h for h in hits if str(h.get("name") or "").lower() == q.lower()]
        if any((h.get("population") or 0) >= 50000 or h.get("feature_code") == "PPLC" for h in named):
            break
    if not hits:
        return {}
    named = [h for h in hits if str(h.get("name") or "").lower() == q.lower()]
    hit = max(named or hits, key=lambda h: (h.get("feature_code") == "PPLC", h.get("population") or 0))
    return {"name": hit.get("name") or q, "country": hit.get("country") or "",
            "lat": hit.get("latitude"), "lon": hit.get("longitude"), "tz": hit.get("timezone") or ""}


def here() -> dict:
    """Where this machine is: the shell's weather location when one is set,
    else what wttr.in (the shell's own weather source) says — cached a day."""
    try:
        cfg = read_json(CFG_PATH, {})
        named = str(((cfg.get("services") or {}).get("weatherLocation") or "")).strip()
    except Exception:                                          # noqa: BLE001
        named = ""
    cached = read_json(WHERE_PATH, {})
    if isinstance(cached, dict) and cached.get("lat") is not None and cached.get("for") == named \
            and time.time() - float(cached.get("at") or 0) < 86400:
        return cached
    spot = {}
    if named:
        spot = geocode(named)
    else:
        try:
            data = json.loads(fetch_text("https://wttr.in/?format=j1", 8))
            area = (data.get("nearest_area") or [{}])[0]
            spot = {"name": ((area.get("areaName") or [{}])[0]).get("value") or "hier",
                    "country": ((area.get("country") or [{}])[0]).get("value") or "",
                    "lat": float(area.get("latitude")), "lon": float(area.get("longitude")), "tz": ""}
        except Exception:                                      # noqa: BLE001
            spot = {}
    if spot:
        spot.update({"for": named, "at": time.time()})
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            write_json(WHERE_PATH, spot)
        except Exception:                                      # noqa: BLE001
            pass
    return spot


@tool("sys.time", '{"place": ""}', "read",
      "The current date and time — here, or in another city or country (place).")
def t_sys_time(place=""):
    if str(place or "").strip():
        spot = geocode(place)
        if not spot or not spot.get("tz"):
            return {"ok": False, "error": f"den Ort {place!r} finde ich nicht"}
        try:
            from zoneinfo import ZoneInfo                      # noqa: PLC0415
            import datetime as _dt                             # noqa: PLC0415
            there = _dt.datetime.now(ZoneInfo(spot["tz"]))
            local = _dt.datetime.now().astimezone()
        except Exception as exc:                               # noqa: BLE001
            return {"ok": False, "error": f"Zeitzone {spot.get('tz')}: {exc}"}
        offset = (there.utcoffset() - local.utcoffset()).total_seconds() / 3600
        return {"ok": True, "place": spot["name"], "country": spot.get("country", ""), "time": there.strftime("%H:%M"),
                "date": date_de(there.timetuple()), "hours_ahead_of_here": round(offset, 2),
                "day_there": days_words((there.date() - local.date()).days)}
    return {"time": time.strftime("%H:%M"), "date": date_de(), "weekday": WEEKDAYS_DE[time.localtime().tm_wday]}


# ── weather: now and the next days, here or anywhere ─────────────────────
WMO_DE = {0: "klar", 1: "überwiegend klar", 2: "teils bewölkt", 3: "bedeckt", 45: "neblig", 48: "neblig mit Reif",
          51: "leichter Nieselregen", 53: "Nieselregen", 55: "starker Nieselregen", 56: "gefrierender Niesel",
          57: "gefrierender Niesel", 61: "leichter Regen", 63: "Regen", 65: "starker Regen",
          66: "gefrierender Regen", 67: "gefrierender Regen", 71: "leichter Schneefall", 73: "Schneefall",
          75: "starker Schneefall", 77: "Schneegriesel", 80: "leichte Regenschauer", 81: "Regenschauer",
          82: "heftige Regenschauer", 85: "Schneeschauer", 86: "heftige Schneeschauer", 95: "Gewitter",
          96: "Gewitter mit Hagel", 99: "schweres Gewitter mit Hagel"}


# The same codes the way they sound after "morgen wird's …".
WMO_SAY = {0: "sonnig", 1: "überwiegend sonnig", 2: "teils bewölkt", 3: "grau und bedeckt", 45: "neblig",
           48: "neblig", 51: "nieselig", 53: "nieselig", 55: "richtig nieselig", 56: "glatt", 57: "glatt",
           61: "leicht regnerisch", 63: "regnerisch", 65: "richtig nass", 66: "glatt mit gefrierendem Regen",
           67: "glatt mit gefrierendem Regen", 71: "leicht verschneit", 73: "verschneit", 75: "richtig verschneit",
           77: "leicht verschneit", 80: "zwischendurch schauerig", 81: "schauerig", 82: "stürmisch mit Schauern",
           85: "schneeschauerig", 86: "schneeschauerig", 95: "gewittrig", 96: "gewittrig mit Hagel",
           99: "gewittrig mit Hagel"}


def weather_data(spot: dict, days: int = 7) -> dict:
    url = ("https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&timezone=auto&forecast_days={d}"
           "&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m,precipitation"
           "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,"
           "precipitation_sum,sunrise,sunset,wind_speed_10m_max"
           "&hourly=temperature_2m,precipitation_probability,weather_code").format(lat=spot["lat"], lon=spot["lon"], d=days)
    return json.loads(fetch_text(url, 7))


@tool("weather.forecast", '{"place": "", "when": "morgen"}', "read",
      "Weather now and the forecast for up to 7 days — here, or anywhere (place). when: heute, morgen, "
      "übermorgen, Wochenende, a weekday or a date; empty for the next days. Never guess the weather.")
def t_weather_forecast(place="", when=""):
    import datetime as _dt                                     # noqa: PLC0415
    spot = geocode(place) if str(place or "").strip() else here()
    if not spot:
        return {"ok": False, "error": (f"den Ort {place!r} finde ich nicht" if str(place or "").strip()
                                       else "ich weiß gerade nicht, wo wir sind")}
    try:
        data = weather_data(spot)
    except Exception as exc:                                   # noqa: BLE001
        return {"ok": False, "error": f"der Wetterdienst antwortet gerade nicht ({exc})"[:160]}
    daily = data.get("daily") or {}
    dates = daily.get("time") or []
    today = _dt.date.fromisoformat(dates[0]) if dates else _dt.date.today()

    def day_entry(i):
        code = (daily.get("weather_code") or [None] * 8)[i]
        rain = (daily.get("precipitation_probability_max") or [None] * 8)[i]
        rel = days_words((_dt.date.fromisoformat(dates[i]) - today).days)
        head = rel if rel in ("heute", "morgen", "übermorgen") else f"am {WEEKDAYS_DE[_dt.date.fromisoformat(dates[i]).weekday()]}"
        # The day in one German line, numbers already read: the model had
        # made "sonnig" out of a grey, dry forecast (measured).
        said = (f"{head}: {WMO_SAY.get(code, 'wechselhaft')}, "
                f"{round((daily.get('temperature_2m_min') or [0] * 8)[i])} bis "
                f"{round((daily.get('temperature_2m_max') or [0] * 8)[i])} Grad, "
                + (f"Regenrisiko {int(rain)} Prozent" if isinstance(rain, (int, float)) else "Regen unbekannt"))
        return {"summary": said, "day": rel,
                "weekday": WEEKDAYS_DE[_dt.date.fromisoformat(dates[i]).weekday()],
                "sky": WMO_DE.get(code, "wechselhaft"), "sky_said": WMO_SAY.get(code, "wechselhaft"),
                "max_c": round((daily.get("temperature_2m_max") or [0] * 8)[i]),
                "min_c": round((daily.get("temperature_2m_min") or [0] * 8)[i]),
                "rain_chance_pct": (daily.get("precipitation_probability_max") or [None] * 8)[i],
                "rain_mm": (daily.get("precipitation_sum") or [None] * 8)[i],
                "wind_max_kmh": round((daily.get("wind_speed_10m_max") or [0] * 8)[i] or 0),
                "sunset": str((daily.get("sunset") or [""] * 8)[i])[-5:]}

    cur = data.get("current") or {}
    out = {"ok": True, "place": spot.get("name") or "hier", "country": spot.get("country", "")}
    wanted = str(when or "").strip().lower()
    target = resolve_day(wanted, today) if wanted else None
    if wanted and re.search(r"\b(wochenende|weekend)\b", wanted) and target:
        picks = [i for i, d in enumerate(dates) if _dt.date.fromisoformat(d) in (target, target + _dt.timedelta(days=1))
                 and _dt.date.fromisoformat(d).weekday() >= 5]
    elif target is not None:
        picks = [i for i, d in enumerate(dates) if _dt.date.fromisoformat(d) == target]
        if not picks:
            return {"ok": False, "error": "so weit reicht die Vorhersage nicht (7 Tage)"}
    else:
        picks = [0, 1, 2]
    if not wanted or (target is not None and (target - today).days == 0) or re.search(r"\b(jetzt|gerade|nachher|später|abend|nacht|heute)\b", wanted):
        out["now"] = {"summary": f"gerade {round(cur.get('temperature_2m') or 0)} Grad, "
                                 f"{WMO_DE.get(cur.get('weather_code'), 'wechselhaft')}",
                      "temp_c": round(cur.get("temperature_2m") or 0), "feels_like_c": round(cur.get("apparent_temperature") or 0),
                      "sky": WMO_DE.get(cur.get("weather_code"), "wechselhaft"), "wind_kmh": round(cur.get("wind_speed_10m") or 0)}
        # The rest of today, hour by hour folded down: will it rain later?
        hourly = data.get("hourly") or {}
        stamp = str(cur.get("time") or "")
        rest = [(t, hourly["temperature_2m"][i], hourly["precipitation_probability"][i], hourly["weather_code"][i])
                for i, t in enumerate(hourly.get("time") or []) if stamp <= t < (today + _dt.timedelta(days=1)).isoformat()]
        if rest:
            rainy = [r for r in rest if (r[2] or 0) >= 50]
            out["rest_of_today"] = {"min_c": round(min(r[1] for r in rest)), "max_c": round(max(r[1] for r in rest)),
                                    "rain_chance_max_pct": max((r[2] or 0) for r in rest),
                                    "rain_from": rainy[0][0][-5:] if rainy else ""}
    out["days"] = [day_entry(i) for i in picks]
    return out


# ── the clipboard ─────────────────────────────────────────────────────────
@tool("clipboard.read", "", "read", "What the user copied last (text in the clipboard) — for 'übersetz/erklär/fass zusammen, was ich kopiert habe'.")
def t_clipboard_read():
    code, out, err = run(["wl-paste", "--no-newline", "--type", "text"], timeout=3)
    if code != 0:
        return {"ok": False, "error": "die Zwischenablage ist leer" if "nothing" in (err or "").lower() or not err else err[:120]}
    text = out.strip()
    return {"ok": True, "text": text[:2500] + (" …" if len(text) > 2500 else ""), "chars": len(text)}


@tool("clipboard.write", '{"text": "text"}', "write", "Put text into the clipboard (so the user can paste it).")
def t_clipboard_write(text=""):
    body = str(text or "")
    if not body.strip():
        return {"ok": False, "error": "was soll in die Zwischenablage?"}
    try:
        proc = subprocess.run(["wl-copy"], input=body.encode("utf-8"), timeout=3)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)[:120]}
    return {"ok": proc.returncode == 0, "chars": len(body)}


# ── notifications: what she can tell you that you missed ─────────────────
@tool("notifs.list", "", "read", "The latest notifications (app, title, text, how long ago, read or not).")
def t_notifs_list():
    raw = shell_ipc("velly", "notifs")
    try:
        items = json.loads(raw) if raw else []
    except ValueError:
        items = []
    if not isinstance(items, list):
        items = []
    now = time.time()
    out = []
    for n in items[:8]:
        if not isinstance(n, dict):
            continue
        age = max(0, int(now - float(n.get("time") or now * 1000) / 1000))
        # German words in, German words out: "unread" came back in her answer.
        ago = (f"vor {max(1, age // 60)} Minuten" if age < 3600 else
               f"vor {age // 3600} Stunden" if age < 86400 else f"vor {age // 86400} Tagen")
        out.append({"app": n.get("app") or "", "titel": n.get("summary") or "", "text": str(n.get("body") or "")[:160],
                    "wann": ago, "neu": not n.get("seen")})
    return {"ok": True, "benachrichtigungen": out, "neu": sum(1 for n in out if n["neu"])}


