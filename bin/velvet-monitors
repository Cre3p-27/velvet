#!/usr/bin/env python3
#  VELVET  ·  bin/velvet-monitors
#  What every connected screen is, and what suits it best: its own (native)
#  resolution, the fastest refresh at it, and a scale that fits its size.
#  Prints one JSON list; services/Monitors.qml reads it and sets the screens.
#
#  The screen's own resolution is the panel's: the first detailed timing in
#  its EDID (a cheap 26" panel says 1366x768 there and still offers 1920x1080,
#  which it can only show blurred). Its size is in the same block — the EDID
#  header often says 0 x 0 cm, which is why Hyprland reports 0 mm.
#
#  Each screen also says which graphics card drives it ("gpu"), and — when it
#  hangs on a processor's integrated graphics while a real graphics card sits
#  in the machine — which card it should be on ("better"). Plugged into the
#  mainboard, a game still renders on the card, but every frame is copied
#  across to the processor's graphics to reach the screen, and that port's
#  ceiling is the screen's ceiling (the user's 4K 240 Hz screen got 120 Hz).
#
#    velvet-monitors            JSON for every screen
#    velvet-monitors --watch    one JSON line whenever a screen mode does not take
#    velvet-monitors --selftest the picking rules on made-up screens
#
#  --watch reads Hyprland's own log as it grows. A mode the screen lists is not
#  always one the port and the cable can carry (4K at 240 Hz over HDMI needs the
#  full 48 Gbit/s link — the processor's graphics list it and fail it every time,
#  a long or older cable fails it every few plug-ins). Measured on the user's
#  4K 240 Hz screen, two ways it goes wrong after "Modesetting <output> with <mode>":
#    · the driver REFUSES the mode change itself ("failed to commit … ALLOW_MODESET",
#      once with max_bpc and once without), then every frame — "no signal";
#    · the screen DROPS the cable a moment later (Connector … disconnected) and
#      comes back, sometimes without its EDID (Hyprland then offers 1024×768).
#  Either is a failure of that mode on that port. One or two refused page flips
#  right after a mode change (a flip still pending) are normal and ignored.
import glob
import json
import math
import os
import re
import subprocess
import sys
import time

SCALES = (1.0, 1.25, 1.5, 1.6, 1.75, 2.0, 2.5, 3.0)


def edid_of(name: str) -> dict:
    """{'native': [w, h], 'mm': [w, h]} from the connector's EDID, if any."""
    for path in glob.glob(f"/sys/class/drm/card*-{name}/edid"):
        try:
            with open(path, "rb") as fh:
                e = fh.read()
        except OSError:
            continue
        if len(e) < 128 or e[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00":
            continue
        out = {}
        if e[21] and e[22]:
            out["mm"] = [e[21] * 10, e[22] * 10]
        d = e[54:72]
        if d[0] or d[1]:                       # a detailed timing, not a text block
            w = d[2] | ((d[4] & 0xF0) << 4)
            h = d[5] | ((d[7] & 0xF0) << 4)
            if d[17] & 0x80:                   # interlaced: the frame is twice the field
                h *= 2
            if w and h:
                out["native"] = [w, h]
            mw = d[12] | ((d[14] & 0xF0) << 4)
            mh = d[13] | ((d[14] & 0x0F) << 8)
            if mw and mh:
                out["mm"] = [mw, mh]
        return out
    return {}


def parse_mode(text: str):
    m = re.match(r"^(\d+)x(\d+)@([\d.]+)", str(text or ""))
    if not m:
        return None
    return int(m.group(1)), int(m.group(2)), float(m.group(3))


def mode_str(w: int, h: int, rr: float) -> str:
    return f"{w}x{h}@{rr:.2f}"


def read(path: str) -> str:
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def card_info(card: str) -> dict:
    """{'card', 'name', 'driver', 'vram', 'integrated'} for /sys/class/drm/<card>."""
    dev = f"/sys/class/drm/{card}/device"
    driver = os.path.basename(os.path.realpath(dev + "/driver")) if os.path.exists(dev + "/driver") else ""
    vram = int(read(dev + "/mem_info_vram_total") or 0) // 1048576
    slot = os.path.basename(os.path.realpath(dev))
    name = ""
    try:
        line = subprocess.run(["lspci", "-mm", "-s", slot], capture_output=True, text=True, timeout=3).stdout
        parts = line.split('"')
        name = parts[5] if len(parts) > 5 else ""
    except (OSError, subprocess.TimeoutExpired):
        pass
    return {"card": card, "name": short_name(name), "driver": driver, "vram": vram,
            "integrated": is_integrated(driver, vram, name)}


def short_name(name: str) -> str:
    """'Navi 48 [Radeon RX 9070/9070 XT/9070 GRE]' → 'Radeon RX 9070 series'."""
    inner = name[name.find("[") + 1:name.rfind("]")] if "[" in name and "]" in name else name
    if "/" in inner:
        inner = inner.split("/")[0] + " series"
    return inner.strip()


def is_integrated(driver: str, vram_mb: int, name: str) -> bool:
    """A processor's own graphics: AMD's APUs carve out a little memory (the
    Ryzen 9000's Radeon 610M: 512 MB; a card has gigabytes), Intel's i915 has
    none of its own; Arc cards (xe) and NVIDIA are cards."""
    if driver == "amdgpu":
        return 0 < vram_mb < 3072
    if driver == "i915":
        return True
    if driver == "xe":
        return "Arc" not in name
    return False


def gpus() -> list:
    out = []
    for path in sorted(glob.glob("/sys/class/drm/card[0-9]*")):
        card = os.path.basename(path)
        if "-" in card:
            continue
        out.append(card_info(card))
    return out


def gpu_of(output: str, cards: list) -> dict:
    for path in glob.glob(f"/sys/class/drm/card*-{output}"):
        card = os.path.basename(path).split("-", 1)[0]
        for c in cards:
            if c["card"] == card:
                return c
    return {}


def best_mode(modes: list, native) -> tuple:
    """The screen's own resolution at its fastest refresh. Without a native
    resolution: the first one the screen lists (the kernel puts its
    preferred mode first), else the biggest that runs at 50 Hz or more."""
    parsed = [p for p in (parse_mode(m) for m in modes) if p]
    if not parsed:
        return None
    want = None
    if native and any((p[0], p[1]) == tuple(native) for p in parsed):
        want = tuple(native)
    if want is None:
        want = (parsed[0][0], parsed[0][1])
    at = [p for p in parsed if (p[0], p[1]) == want]
    if not at:
        smooth = [p for p in parsed if p[2] >= 49] or parsed
        biggest = max(smooth, key=lambda p: (p[0] * p[1], p[2]))
        at = [p for p in parsed if (p[0], p[1]) == (biggest[0], biggest[1])]
    return max(at, key=lambda p: p[2])


def best_scale(w: int, h: int, mm) -> float:
    """About 110 logical dots an inch: a 27" 4K screen gets 1.5, a 14" laptop
    at 2560x1600 gets 2, anything coarse (a 26" 1366x768 panel, a television
    across the room) stays at 1 — never below: that only blurs."""
    want = 1.0
    if mm and 50 < mm[0] < 1500 and 30 < mm[1] < 1000:
        ppi = math.hypot(w, h) / (math.hypot(mm[0], mm[1]) / 25.4)
        want = ppi / 110.0
    elif h > 2160:
        want = 2.0
    elif h > 1600:
        want = 1.5
    if want < 1.12:
        return 1.0
    clean = [s for s in SCALES if abs(w / s - round(w / s)) < 1e-6 and abs(h / s - round(h / s)) < 1e-6]
    return min(clean or [1.0], key=lambda s: abs(s - want))


def screens() -> list:
    try:
        raw = subprocess.run(["hyprctl", "monitors", "all", "-j"], capture_output=True, text=True, timeout=5).stdout
        mons = json.loads(raw or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    out = []
    cards = gpus()
    discrete = [c for c in cards if not c["integrated"] and c["driver"]]
    for m in mons:
        name = str(m.get("name") or "")
        if not name:
            continue
        modes = []
        seen = set()
        for text in m.get("availableModes") or []:
            p = parse_mode(text)
            if not p:
                continue
            key = (p[0], p[1], round(p[2], 1))
            if key in seen:
                continue
            seen.add(key)
            modes.append(mode_str(*p))
        edid = edid_of(name)
        # no EDID (an empty file — the screen did not answer, often for a moment
        # after it dropped the link): Hyprland falls back to 1024x768 and nothing
        # read from it says what the screen really is
        told = bool(edid)
        mm = edid.get("mm")
        if not mm and m.get("physicalWidth") and m.get("physicalHeight"):
            mm = [int(m["physicalWidth"]), int(m["physicalHeight"])]
        best = best_mode(modes, edid.get("native"))
        if best is None:
            continue
        gpu = gpu_of(name, cards)
        out.append({
            "gpu": gpu,
            # the card this screen should hang on, when it is on the processor's graphics
            "better": discrete[0]["name"] if gpu.get("integrated") and discrete else "",
            "name": name,
            "description": str(m.get("description") or ""),
            "disabled": bool(m.get("disabled")),
            "current": {"w": int(m.get("width") or 0), "h": int(m.get("height") or 0),
                        "rr": float(m.get("refreshRate") or 0), "scale": float(m.get("scale") or 1),
                        "x": int(m.get("x") or 0), "y": int(m.get("y") or 0)},
            "modes": modes,
            "native": edid.get("native"),
            "edid": told,
            "mm": mm,
            "best": {"mode": mode_str(*best), "w": best[0], "h": best[1], "rr": round(best[2], 2),
                     "scale": best_scale(best[0], best[1], mm)},
        })
    return out


def selftest() -> int:
    problems = []
    tv = ["1366x768@59.96Hz", "1920x1080@60.00Hz", "1280x720@60.00Hz", "720x400@70.08Hz"]
    b = best_mode(tv, [1366, 768])
    if b[:2] != (1366, 768):
        problems.append(f"native first: {b}")
    gamer = ["2560x1440@59.95Hz", "2560x1440@143.97Hz", "1920x1080@60.00Hz"]
    if best_mode(gamer, [2560, 1440])[2] < 143:
        problems.append("fastest refresh at the native resolution")
    if best_mode(["3840x2160@30.00Hz", "2560x1440@60.00Hz"], None)[:2] != (3840, 2160):
        problems.append("no EDID: the first listed mode")
    cases = [((1366, 768, [575, 323]), 1.0), ((3840, 2160, [597, 336]), 1.5), ((2560, 1440, [597, 336]), 1.0),
             ((2560, 1600, [302, 189]), 2.0), ((1920, 1080, [294, 165]), 1.5), ((1920, 1080, None), 1.0),
             ((3840, 2160, [1210, 680]), 1.0), ((3840, 2160, None), 1.5)]
    for (w, h, mm), want in cases:
        got = best_scale(w, h, mm)
        if got != want:
            problems.append(f"scale {w}x{h} {mm}: {got} (want {want})")
    for driver, vram, name, want in (("amdgpu", 512, "Granite Ridge [Radeon 610M]", True),
                                     ("amdgpu", 16304, "Navi 48 [Radeon RX 9070/9070 XT/9070 GRE]", False),
                                     ("i915", 0, "Raptor Lake-S GT1 [UHD Graphics 770]", True),
                                     ("xe", 0, "DG2 [Arc A770]", False), ("nvidia", 0, "AD104 [GeForce RTX 4070]", False)):
        if is_integrated(driver, vram, name) != want:
            problems.append(f"integrated? {driver} {vram} {name}: want {want}")
    if short_name("Navi 48 [Radeon RX 9070/9070 XT/9070 GRE]") != "Radeon RX 9070 series":
        problems.append("short name of a card with variants")
    selftest_watch(problems)
    if problems:
        print("velvet-monitors selftest: FAILED")
        for p in problems:
            print("  ·", p)
        return 1
    print(f"velvet-monitors selftest: ok  ({len(screens())} screen(s) now)")
    return 0


# ─────────────────────────────────────────────────────────────── --watch
MODESET = re.compile(r"Modesetting (\S+) with (\d+)x(\d+)@([\d.]+)Hz")
REFUSED = re.compile(r"failed to commit|atomic commit failed")
REFUSED_MODE = re.compile(r"failed to commit.*ALLOW_MODESET")
DROPPED = re.compile(r"Connector (\S+) disconnected")
FAIL_AFTER = 8          # refused page flips …
FAIL_WITHIN = 4.0       # … within this many seconds of a mode change
DROP_WITHIN = 6.0       # the screen let go of the cable this soon after a mode change


class Watch:
    """turns log lines into failure events; time is passed in (testable)"""

    def __init__(self):
        self.last = None        # (output, mode, t)
        self.modesets = 0       # refused mode changes since
        self.flips = 0          # refused page flips since
        self.told = False

    def fail(self, why: str):
        self.told = True
        out, mode, _ = self.last
        return {"event": "fail", "output": out, "mode": mode, "why": why, "refused": self.modesets + self.flips}

    def line(self, text: str, t: float):
        m = MODESET.search(text)
        if m:
            self.last = (m.group(1), mode_str(int(m.group(2)), int(m.group(3)), float(m.group(4))), t)
            self.modesets = self.flips = 0
            self.told = False
            return None
        if not self.last or self.told:
            return None
        out, _, at = self.last
        d = DROPPED.search(text)
        if d:
            if d.group(1) != out:
                return None
            if t - at <= DROP_WITHIN:
                return self.fail("dropped")
            self.last = None    # unplugged long after: not this mode's doing
            return None
        if REFUSED.search(text):
            if t - at > FAIL_WITHIN:
                return None
            if REFUSED_MODE.search(text):
                self.modesets += 1
            else:
                self.flips += 1
            # the driver said no to the mode itself (twice: with and without
            # max_bpc), or once and the frames after it bounce, or a flood of
            # refused frames
            if self.modesets >= 2 or (self.modesets and self.flips >= 4) or self.flips >= FAIL_AFTER:
                return self.fail("refused")
        return None


def log_path():
    rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    path = os.path.join(rt, "hypr", sig, "hyprland.log") if sig else ""
    if path and os.path.exists(path):
        return path
    logs = sorted(glob.glob(os.path.join(rt, "hypr", "*", "hyprland.log")), key=os.path.getmtime)
    return logs[-1] if logs else ""


def watch() -> int:
    path = log_path()
    if not path:
        print(json.dumps({"event": "nolog"}), flush=True)
        return 1
    w = Watch()
    f = open(path, "r", errors="replace")
    f.seek(0, os.SEEK_END)
    # gone with the shell that started it: a shell that is killed (not reloaded)
    # leaves its children behind, and every restart used to add one more watcher
    start_ppid = os.getppid()
    while True:
        line = f.readline()
        if not line:
            if os.getppid() != start_ppid:
                return 0
            # Hyprland restarted (a new log) or rotated it: follow the new one
            try:
                if os.path.getsize(path) < f.tell() or log_path() != path:
                    f.close()
                    path = log_path() or path
                    f = open(path, "r", errors="replace")
            except OSError:
                pass
            time.sleep(0.25)
            continue
        ev = w.line(line, time.monotonic())
        if ev:
            print(json.dumps(ev), flush=True)


def selftest_watch(problems: list):
    def run(lines):
        w = Watch()
        return [e for e in (w.line(text, t) for t, text in lines) if e]

    flood = [(0.0, "DEBUG from aquamarine ]: drm: Modesetting HDMI-A-2 with 3840x2160@60.00Hz"),
             (0.1, "ERR from aquamarine ]: drm: Cannot commit when a page-flip is awaiting"),
             (0.2, "ERR from aquamarine ]: drm: Cannot commit when a page-flip is awaiting"),
             (5.0, "DEBUG from aquamarine ]: drm: Modesetting HDMI-A-2 with 3840x2160@240.02Hz")]
    flood += [(5.1 + i * 0.05, "ERR from aquamarine ]: atomic drm request: failed to commit: Invalid argument, flags: ATOMIC_NONBLOCK") for i in range(12)]
    ev = run(flood)
    if len(ev) != 1 or ev[0]["output"] != "HDMI-A-2" or ev[0]["mode"] != "3840x2160@240.02":
        problems.append(f"watch: one failure for a flood of refused frames, got {ev}")

    # the real sequence (Hyprland log, 2026-10-22): the mode change itself refused twice, then frames
    refused = [(0.0, "DEBUG from aquamarine ]: drm: Modesetting HDMI-A-1 with 3840x2160@240.02Hz"),
               (0.05, "ERR from aquamarine ]: drm: No Adaptive sync support for output"),
               (0.06, "ERR from aquamarine ]: atomic drm request: failed to commit: Invalid argument, flags: ATOMIC_NONBLOCK PAGE_FLIP_EVENT "),
               (0.07, "ERR from aquamarine ]: atomic drm request: failed to commit: Invalid argument, flags: ATOMIC_ALLOW_MODESET PAGE_FLIP_EVENT "),
               (0.08, "WARN from aquamarine ]: drm: atomic commit failed with max_bpc set, retrying without max_bpc"),
               (0.09, "ERR from aquamarine ]: atomic drm request: failed to commit: Invalid argument, flags: ATOMIC_ALLOW_MODESET PAGE_FLIP_EVENT ")]
    refused += [(0.1 + i * 0.02, "ERR from aquamarine ]: atomic drm request: failed to commit: Invalid argument, flags: ATOMIC_NONBLOCK PAGE_FLIP_EVENT ") for i in range(25)]
    refused += [(1.2, "DEBUG from aquamarine ]: drm: Connector HDMI-A-1 disconnected")]
    ev = run(refused)
    if len(ev) != 1 or ev[0]["why"] != "refused" or ev[0]["mode"] != "3840x2160@240.02":
        problems.append(f"watch: a refused mode change is one failure, got {ev}")

    dropped = [(0.0, "drm: Modesetting HDMI-A-1 with 3840x2160@240.02Hz"),
               (0.4, "drm: Got a hotplug event for /dev/dri/card1"),
               (0.5, "drm: Connector HDMI-A-1 disconnected")]
    ev = run(dropped)
    if len(ev) != 1 or ev[0]["why"] != "dropped":
        problems.append(f"watch: the screen letting go right after a mode change, got {ev}")

    later = [(0.0, "drm: Modesetting HDMI-A-1 with 3840x2160@240.02Hz"), (900.0, "drm: Connector HDMI-A-1 disconnected")]
    if run(later):
        problems.append("watch: an unplug long after a mode change is not this mode's")
    other = [(0.0, "drm: Modesetting HDMI-A-1 with 3840x2160@240.02Hz"), (0.5, "drm: Connector DP-1 disconnected")]
    if run(other):
        problems.append("watch: another screen letting go is not this one's")
    late = [(0.0, "drm: Modesetting DP-1 with 2560x1440@143.97Hz")] + [(10.0 + i, "failed to commit") for i in range(20)]
    if run(late):
        problems.append("watch: refusals long after a mode change are not this mode's")
    retry = [(0.0, "drm: Modesetting DP-1 with 2560x1440@143.97Hz"),
             (0.1, "failed to commit: Invalid argument, flags: ATOMIC_ALLOW_MODESET PAGE_FLIP_EVENT"),
             (0.1, "drm: atomic commit failed with max_bpc set, retrying without max_bpc")]
    if run(retry):
        problems.append("watch: one refusal that the retry without max_bpc fixed is no failure")


if __name__ == "__main__":
    if "--watch" in sys.argv[1:]:
        try:
            sys.exit(watch())
        except KeyboardInterrupt:
            sys.exit(0)
    if "--selftest" in sys.argv[1:]:
        sys.exit(selftest())
    print(json.dumps(screens(), ensure_ascii=False))
