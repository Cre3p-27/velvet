def load_index() -> dict:
    ix = read_json(INDEX_PATH, {})
    if not isinstance(ix, dict):
        ix = {}
    ix.setdefault("books", [])
    ix.setdefault("next", 1)
    ix.setdefault("made", [])          # idea keys already made
    return ix


def save_index(ix: dict) -> None:
    write_json(INDEX_PATH, ix)


def book_path(book: dict, name: str = "") -> str:
    return os.path.join(book["dir"], name) if name else book["dir"]


def load_book(bid: str) -> dict:
    ix = load_index()
    for entry in ix["books"]:
        if entry["id"] == bid or entry["id"] == str(bid).zfill(3):
            book = read_json(os.path.join(entry["dir"], "book.json"), None)
            if isinstance(book, dict):
                return book
    raise KeyError(f"no book {bid}")


def save_book(book: dict) -> None:
    book["updated"] = datetime.datetime.now().isoformat(timespec="seconds")
    write_json(book_path(book, "book.json"), book)
    ix = load_index()
    row = {"id": book["id"], "dir": book["dir"], "kind": book["kind"], "title": book.get("title", ""),
           "state": book.get("state", ""), "step": book.get("step", ""), "created": book.get("created", ""),
           "uploaded": book.get("uploaded", "")}
    ix["books"] = [b for b in ix["books"] if b["id"] != book["id"]] + [row]
    ix["books"].sort(key=lambda b: b["id"])
    save_index(ix)


def note(book: dict, text: str) -> None:
    book.setdefault("log", []).append(f"{datetime.datetime.now().strftime('%d.%m. %H:%M')} · {text}")
    book["log"] = book["log"][-60:]
    log(f"{book['id']}: {text}")


def next_idea(kind: str, made: list):
    for idea in IDEAS[kind]:
        if idea["key"] not in made:
            return dict(idea)
    # all made once: the first again, with another seed (a "Band 2")
    idea = dict(IDEAS[kind][len(made) % len(IDEAS[kind])])
    idea["key"] = f"{idea['key']}-{len(made) + 1}"
    idea["volume"] = 2 + len([m for m in made if m.startswith(idea["key"].rsplit("-", 1)[0])]) // 1
    return idea


def new_book(kind: str = "", idea_text: str = "", lang: str = "", audience: str = "") -> dict:
    cfg = config()
    ix = load_index()
    if not kind:
        kinds = [k for k in cfg.get("kinds") or KINDS if k in KINDS]
        if not engine_status()["ok"]:
            kinds = [k for k in kinds if k != "picture"] or ["puzzle"]
        made_by_kind = {k: sum(1 for b in ix["books"] if b["kind"] == k) for k in kinds}
        kind = min(kinds, key=lambda k: made_by_kind[k])
    if kind not in KINDS:
        raise ValueError(f"unknown kind {kind!r}: coloring, puzzle or picture")
    idea = next_idea(kind, ix["made"]) if not idea_text else {"key": f"own-{ix['next']}", "idea": idea_text}
    if idea_text and kind != "picture":
        idea.update(next_idea(kind, ix["made"]), key=f"own-{ix['next']}", wish=idea_text)
    bid = str(ix["next"]).zfill(3)
    title = idea.get("title") or ("Bilderbuch" if kind == "picture" else KINDS[kind]["label"]["de"])
    folder = os.path.join(studio_dir(), f"{bid} {slug(title)}")
    os.makedirs(folder, exist_ok=True)
    spec = KINDS[kind]
    book = {"id": bid, "kind": kind, "dir": folder, "lang": lang or cfg.get("lang") or "de",
            "audience": audience or idea.get("audience") or cfg.get("audience") or "adults", "idea": idea,
            "title": idea.get("title", ""), "subtitle": idea.get("subtitle", ""), "author": author_name(),
            "trim": list(spec["trim"]), "ink": spec["ink"], "bleed": spec["bleed"],
            "created": datetime.datetime.now().isoformat(timespec="seconds"), "seed": random.randrange(1, 2 ** 31),
            "step": STEPS[kind][0], "done": [], "state": "working", "log": []}
    ix["next"] += 1
    ix["made"].append(idea["key"])
    save_index(ix)
    note(book, f"new {kind}: {book['title'] or idea.get('idea', '')}")
    save_book(book)
    return book


def waiting_count() -> int:
    """Finished books that still wait for your upload."""
    return sum(1 for b in load_index()["books"] if b.get("state") == "ready")


# ─────────────────────────────────────────────────────────── shared page parts
INK = (0.08, 0.08, 0.10)
SOFT = (0.42, 0.42, 0.46)


def lang_of(book: dict) -> str:
    return "en" if book.get("lang") == "en" else "de"


def T(book: dict, de: str, en: str) -> str:
    return en if lang_of(book) == "en" else de


def copyright_page(doc: Doc, book: dict, x: float, w: float, y_bottom: float, ai_text: bool, ai_images: bool) -> None:
    year = datetime.date.today().year
    lines = [f"© {year} {book['author']}", T(book, "Alle Rechte vorbehalten.", "All rights reserved."), ""]
    if ai_text or ai_images:
        what = []
        if ai_text:
            what.append(T(book, "Text", "text"))
        if ai_images:
            what.append(T(book, "Illustrationen", "illustrations"))
        lines.append(T(book, f"{' und '.join(what)} wurden mit Hilfe künstlicher Intelligenz erstellt "
                             f"und von der Herausgeberin geprüft.",
                       f"The {' and '.join(what)} were created with the help of artificial intelligence and "
                       f"reviewed by the publisher."))
    lines.append(T(book, "Unabhängig veröffentlicht.", "Independently published."))
    text = "\n".join(lines)
    _tw, th = doc.measure(text, "Noto Sans", 8.5, w, 1.25)
    doc.text(x, y_bottom - th, text, "Noto Sans", 8.5, w, "left", SOFT, 1.25)


def thanks_page(doc: Doc, book: dict, w: float, h: float) -> None:
    msg = T(book, "Danke, dass du dieses Buch gewählt hast!\n\nHat es dir Freude gemacht? Eine kurze Bewertung "
                  "auf Amazon hilft sehr – und zeigt anderen, ob es zu ihnen passt.",
            "Thank you for choosing this book!\n\nDid you enjoy it? A short review on Amazon helps a lot – and "
            "tells others whether it is for them.")
    bw = w * 0.62
    _tw, th = doc.measure(msg, "Noto Serif", 15, bw, 1.3)
    doc.text((w - bw) / 2, h * 0.42 - th / 2, msg, "Noto Serif", 15, bw, "center", INK, 1.3)


# ─────────────────────────────────────────────────────────────── coloring book
def mandala_for(book: dict, i: int) -> Mandala:
    idea = book["idea"]
    bold = book["audience"] in ("kids", "seniors")
    md = Mandala(book["seed"] + i * 7919, bold=bold)
    style = idea.get("style", "mixed")
    if style != "mixed":
        favour = {"flower": ("petals", "petals2", "leaves", "teardrops", "dots", "scallops"),
                  "geo": ("lattice", "zigzag", "rays", "dots", "scallops", "petals"),
                  "heart": ("hearts", "petals", "dots", "scallops", "hearts", "teardrops")}[style]
        rng = random.Random(book["seed"] + i)
        for ring in md.rings:
            if rng.random() < 0.75:
                ring["motif"] = rng.choice(favour)
        if style == "flower":
            md.core = "flower"
    return md


def coloring_plan(book: dict) -> None:
    idea = book["idea"]
    count = int(idea.get("count", 50))
    # title, copyright, "belongs to", colour test, then each mandala on a right
    # page with an empty back (no bleeding through), a thank-you, an end page
    book["count"] = count
    book["pages"] = even(4 + count * 2 + 2)
    if not book.get("title"):
        book["title"] = idea.get("title", "Mandala Malbuch")
        book["subtitle"] = idea.get("subtitle", "")
    note(book, f"{count} mandalas, {book['pages']} pages")


def coloring_interior(book: dict) -> None:
    w_in, h_in = book["trim"]
    path = book_path(book, "interior.pdf")
    doc = Doc(path + ".part", w_in, h_in)
    W, H = doc.w, doc.h
    inside, outside = gutter_for(book["pages"]) * PT + 0.25 * PT, 0.5 * PT
    # 1 · title
    doc.page()
    tw = W - 2 * 0.9 * PT
    y = H * 0.16
    y += doc.text(0.9 * PT, y, book["title"], "Noto Serif Bold", doc.fit(book["title"], "Noto Serif Bold", 34, tw, 120),
                  tw, "center", INK, 1.1) + 14
    if book.get("subtitle"):
        y += doc.text(0.9 * PT, y, book["subtitle"], "Noto Sans", 13, tw, "center", SOFT, 1.25) + 10
    mandala_for(book, 999).draw(doc.ctx, W / 2, H * 0.62, min(W, H) * 0.26)
    doc.text(0.9 * PT, H - 1.1 * PT, book["author"], "Noto Sans SemiBold", 12, tw, "center", INK)
    # 2 · copyright
    doc.page()
    copyright_page(doc, book, 0.9 * PT, W - 1.8 * PT, H - 0.9 * PT, False, False)
    tip = T(book, "Tipp: Leg beim Malen mit Filzstiften ein Blatt Papier unter die Seite.",
            "Tip: with felt pens, put a sheet of paper under the page.")
    doc.text(0.9 * PT, H * 0.4, tip, "Noto Sans Italic", 10, W - 1.8 * PT, "center", SOFT)
    # 3 · this book belongs to
    doc.page()
    doc.text(0.9 * PT, H * 0.36, T(book, "Dieses Buch gehört", "This book belongs to"), "Noto Serif SemiBold", 24,
             W - 1.8 * PT, "center", INK)
    doc.ctx.set_source_rgb(*SOFT)
    doc.ctx.set_line_width(1)
    doc.ctx.move_to(W * 0.25, H * 0.5)
    doc.ctx.line_to(W * 0.75, H * 0.5)
    doc.ctx.stroke()
    mandala_for(book, 998).draw(doc.ctx, W / 2, H * 0.72, W * 0.12)
    # 4 · test your colours
    doc.page()
    doc.text(0.9 * PT, 0.9 * PT, T(book, "Farben ausprobieren", "Test your colours"), "Noto Serif SemiBold", 20,
             W - 1.8 * PT, "center", INK)
    doc.ctx.set_line_width(1.2)
    for r in range(7):
        for c in range(6):
            cx = 1.3 * PT + c * (W - 2.6 * PT) / 5
            cy = 2.0 * PT + r * (H - 3.2 * PT) / 6.5
            doc.ctx.new_path()
            doc.ctx.arc(cx, cy, 0.42 * PT, 0, 2 * math.pi)
            doc.ctx.set_source_rgb(*INK)
            doc.ctx.stroke()
    # the mandalas: right pages, empty backs
    R = min(W - inside - outside, H - 1.2 * PT) / 2
    for i in range(book["count"]):
        if stopping():
            raise InterruptedError()
        doc.page()
        cx = inside + (W - inside - outside) / 2           # right page: the gutter is on the left
        mandala_for(book, i).draw(doc.ctx, cx, H / 2, R)
        doc.text(0, H - 0.55 * PT, f"{i + 1}", "Noto Sans", 8, W - outside, "right", SOFT)
        doc.page()                                           # the empty back
    doc.page()
    thanks_page(doc, book, W, H)
    while doc.count < book["pages"]:
        doc.page()
    n = doc.close()
    os.replace(path + ".part", path)
    book["pages"] = n
    note(book, f"interior.pdf: {n} pages")


# ──────────────────────────────────────────────────────────────── puzzle book
def puzzle_plan(book: dict) -> None:
    idea = book["idea"]
    rng = random.Random(book["seed"])
    levels = idea.get("levels") or ["leicht", "mittel"]
    items = []
    for kind, count in idea["mix"].items():
        for i in range(count):
            level = levels[min(len(levels) - 1, i * len(levels) // max(1, count))]
            items.append({"kind": kind, "level": level, "seed": rng.randrange(1, 2 ** 31)})
    # mixed books alternate the kinds so it never gets dull; levels rise
    if len(idea["mix"]) > 1:
        order = {"leicht": 0, "mittel": 1, "schwer": 2}
        items.sort(key=lambda it: (order.get(it["level"], 1), rng.random()))
    themes = list(WORDS_DE.keys())
    rng.shuffle(themes)
    t = 0
    for it in items:
        if it["kind"] == "wordsearch":
            it["theme"] = themes[t % len(themes)]
            t += 1
    book["items"] = items
    note(book, f"{len(items)} puzzles: " + ", ".join(f"{n} {k}" for k, n in idea["mix"].items()))


def puzzle_make(book: dict) -> None:
    """Every puzzle with its solution, saved as it is made (resumable)."""
    large = bool(book["idea"].get("large"))
    made = 0
    for it in book["items"]:
        if "data" in it:
            continue
        if stopping():
            raise InterruptedError()
        if it["kind"] == "sudoku":
            it["data"] = sudoku_make(it["seed"], it["level"])
        elif it["kind"] == "wordsearch":
            size = 13 if large else (14 if book["audience"] == "kids" else 15)
            words = WORDS_DE[it["theme"]].split()
            pick = random.Random(it["seed"]).sample(words, min(len(words), 12 if large else 16))
            it["data"] = wordsearch_make(it["seed"], pick, size, hard=it["level"] == "schwer" or
                                         (book["audience"] == "adults" and it["level"] != "leicht"))
        elif it["kind"] == "maze":
            dims = {"leicht": (12, 15), "mittel": (18, 23), "schwer": (24, 31)}[it["level"]]
            if book["audience"] == "kids":
                dims = {"leicht": (9, 11), "mittel": (13, 16), "schwer": (17, 21)}[it["level"]]
            it["data"] = maze_make(it["seed"], *dims)
        made += 1
        if made % 10 == 0:
            save_book(book)
    pages = 4 + puzzle_pages(book) + 2
    book["pages"] = even(pages)
    note(book, f"puzzles made, {book['pages']} pages")


def puzzle_pages(book: dict) -> int:
    """Pages for puzzles and solutions, as puzzle_interior lays them out."""
    large = bool(book["idea"].get("large"))
    count = {"sudoku": 0, "wordsearch": 0, "maze": 0}
    for it in book["items"]:
        count[it["kind"]] += 1
    per_page = {"sudoku": 1 if large else 2, "wordsearch": 1, "maze": 1}
    per_sol = {"sudoku": 4 if large else 6, "wordsearch": 2 if large else 4, "maze": 4}
    pages = 0
    for kind, n in count.items():
        if n:
            pages += math.ceil(n / per_page[kind]) + math.ceil(n / per_sol[kind])
    return pages + 1      # the solutions' title page


def draw_sudoku(doc: Doc, grid: list, x: float, y: float, size: float, givens: list = None, big: bool = False) -> None:
    ctx = doc.ctx
    cell = size / 9
    for i in range(10):
        ctx.set_source_rgb(*INK)
        ctx.set_line_width(2.4 if i % 3 == 0 else 0.7)
        ctx.move_to(x + i * cell, y)
        ctx.line_to(x + i * cell, y + size)
        ctx.move_to(x, y + i * cell)
        ctx.line_to(x + size, y + i * cell)
        ctx.stroke()
    font = cell * (0.56 if big else 0.52)
    for idx, v in enumerate(grid):
        if not v:
            continue
        r, c = divmod(idx, 9)
        given = givens is None or givens[idx]
        doc.text(x + c * cell, y + r * cell + cell * 0.18, str(v), "Noto Sans SemiBold" if given else "Noto Sans",
                 font * 0.75, cell, "center", INK if given else (0.35, 0.45, 0.75))


def draw_wordsearch(doc: Doc, data: dict, x: float, y: float, size: float, solved: bool = False) -> None:
    ctx = doc.ctx
    n = data["size"]
    cell = size / n
    if solved:
        ctx.save()
        ctx.set_line_cap(1)
        for p in data["words"]:
            L = len(p["word"]) - 1
            x0, y0 = x + (p["c"] + 0.5) * cell, y + (p["r"] + 0.5) * cell
            x1, y1 = x0 + p["dc"] * L * cell, y0 + p["dr"] * L * cell
            ctx.set_source_rgb(0.80, 0.80, 0.84)
            ctx.set_line_width(cell * 0.78)
            ctx.move_to(x0, y0)
            ctx.line_to(x1, y1)
            ctx.stroke()
        ctx.restore()
    ctx.set_source_rgb(*INK)
    ctx.set_line_width(1.2)
    ctx.rectangle(x - cell * 0.15, y - cell * 0.15, size + cell * 0.3, size + cell * 0.3)
    ctx.stroke()
    for r, row in enumerate(data["grid"]):
        for c, ch in enumerate(row):
            doc.text(x + c * cell, y + r * cell + cell * 0.12, ch, "Noto Sans SemiBold", cell * 0.5, cell, "center", INK)


def draw_maze(doc: Doc, data: dict, x: float, y: float, w: float, h: float, solved: bool = False,
              labels=("START", "ZIEL")) -> None:
    ctx = doc.ctx
    cols, rows = data["cols"], data["rows"]
    cell = min(w / cols, h / rows)
    ox, oy = x + (w - cols * cell) / 2, y + (h - rows * cell) / 2
    if solved:
        ctx.save()
        ctx.set_source_rgb(0.55, 0.58, 0.75)
        ctx.set_line_width(cell * 0.28)
        ctx.set_line_cap(1)
        ctx.set_line_join(1)
        for k, idx in enumerate(data["path"]):
            cx, cy = ox + (idx % cols + 0.5) * cell, oy + (idx // cols + 0.5) * cell
            (ctx.move_to if k == 0 else ctx.line_to)(cx, cy)
        ctx.stroke()
        ctx.restore()
    ctx.set_source_rgb(*INK)
    ctx.set_line_width(max(1.0, cell * 0.09))
    ctx.set_line_cap(2)
    for idx, walls in enumerate(data["cells"]):
        cx, cy = ox + (idx % cols) * cell, oy + (idx // cols) * cell
        if walls & 1 and idx != 0:
            ctx.move_to(cx, cy)
            ctx.line_to(cx + cell, cy)
        if walls & 8:
            ctx.move_to(cx, cy)
            ctx.line_to(cx, cy + cell)
        if idx // cols == rows - 1 and walls & 4 and idx != cols * rows - 1:
            ctx.move_to(cx, cy + cell)
            ctx.line_to(cx + cell, cy + cell)
        if idx % cols == cols - 1 and walls & 2:
            ctx.move_to(cx + cell, cy)
            ctx.line_to(cx + cell, cy + cell)
    ctx.stroke()
    if labels and not solved:
        doc.text(ox - 10, oy - 22, labels[0], "Noto Sans Bold", 10, 80, "left", INK)
        doc.text(ox + cols * cell - 70, oy + rows * cell + 6, labels[1], "Noto Sans Bold", 10, 80, "right", INK)


PUZZLE_NAMES = {"sudoku": ("Sudoku", "Sudoku"), "wordsearch": ("Suchsel", "Word search"), "maze": ("Labyrinth", "Maze")}
LEVEL_EN = {"leicht": "easy", "mittel": "medium", "schwer": "hard"}


def puzzle_interior(book: dict) -> None:
    w_in, h_in = book["trim"]
    large = bool(book["idea"].get("large"))
    path = book_path(book, "interior.pdf")
    doc = Doc(path + ".part", w_in, h_in)
    W, H = doc.w, doc.h
    gut = gutter_for(book["pages"]) * PT + 0.3 * PT
    out = 0.55 * PT
    top, bottom = 0.75 * PT, 0.75 * PT

    def margins():
        right_page = doc.count % 2 == 1
        left = gut if right_page else out
        return left, W - (out if right_page else gut)

    def footer():
        left, right = margins()
        doc.text(left, H - 0.5 * PT, str(doc.count), "Noto Sans", 9, right - left,
                 "right" if doc.count % 2 == 1 else "left", SOFT)

    # front matter
    doc.page()
    tw = W - 1.8 * PT
    y = H * 0.22
    y += doc.text(0.9 * PT, y, book["title"], "Noto Serif Bold", doc.fit(book["title"], "Noto Serif Bold", 34, tw, 130),
                  tw, "center", INK, 1.1) + 16
    if book.get("subtitle"):
        doc.text(0.9 * PT, y, book["subtitle"], "Noto Sans", 13, tw, "center", SOFT, 1.25)
    doc.text(0.9 * PT, H - 1.2 * PT, book["author"], "Noto Sans SemiBold", 12, tw, "center", INK)
    doc.page()
    copyright_page(doc, book, 0.9 * PT, W - 1.8 * PT, H - 0.9 * PT, False, False)
    doc.page()
    left, right = margins()
    y = top
    y += doc.text(left, y, T(book, "So geht's", "How to play"), "Noto Serif Bold", 24, right - left, "left", INK) + 18
    kinds = [k for k in ("sudoku", "wordsearch", "maze") if any(it["kind"] == k for it in book["items"])]
    rules = {
        "sudoku": T(book, "Sudoku: Trage die Ziffern 1 bis 9 so ein, dass jede Zeile, jede Spalte und jedes "
                          "3×3-Kästchen jede Ziffer genau einmal enthält.",
                    "Sudoku: fill in 1 to 9 so that every row, column and 3×3 box holds each digit exactly once."),
        "wordsearch": T(book, "Suchsel: Finde alle Wörter der Liste im Buchstabengitter – waagerecht, senkrecht "
                              "oder schräg" + (", auch rückwärts." if any(it["kind"] == "wordsearch" and it["level"] != "leicht"
                                                                       for it in book["items"]) else "."),
                        "Word search: find every word of the list in the grid — across, down or diagonal."),
        "maze": T(book, "Labyrinth: Finde den Weg vom START zum ZIEL, ohne eine Wand zu kreuzen.",
                  "Maze: find the way from START to FINISH without crossing a wall."),
    }
    for k in kinds:
        y += doc.text(left, y, rules[k], "Noto Serif", 14 if large else 12, right - left, "left", INK, 1.3) + 14
    y += 10
    doc.text(left, y, T(book, "Alle Lösungen findest du am Ende des Buches.", "All solutions are at the back."),
             "Noto Sans Italic", 11, right - left, "left", SOFT)
    doc.page()                                               # an empty left page: puzzles start on the right
    # the puzzles
    numbers = {}
    pending_sudoku = []

    def flush_sudokus():
        if not pending_sudoku:
            return
        doc.page()
        lft, rgt = margins()
        avail_w = rgt - lft
        if large or len(pending_sudoku) == 1:
            size = min(avail_w, H - top - bottom - 60) * (0.92 if large else 0.62)
            for no, it in pending_sudoku:
                doc.text(lft, top, f"{T(book, 'Rätsel', 'Puzzle')} {no} · Sudoku · {level_name(book, it['level'])}",
                         "Noto Sans SemiBold", 14 if large else 12, avail_w, "left", INK)
                draw_sudoku(doc, it["data"]["puzzle"], lft + (avail_w - size) / 2, top + 50, size, None, large)
        else:
            size = min(avail_w * 0.62, (H - top - bottom - 80) / 2 - 30)
            for k, (no, it) in enumerate(pending_sudoku):
                yy = top + k * (H - top - bottom) / 2
                doc.text(lft, yy, f"{T(book, 'Rätsel', 'Puzzle')} {no} · Sudoku · {level_name(book, it['level'])}",
                         "Noto Sans SemiBold", 12, avail_w, "left", INK)
                draw_sudoku(doc, it["data"]["puzzle"], lft + (avail_w - size) / 2, yy + 28, size)
        footer()
        pending_sudoku.clear()

    for no, it in enumerate(book["items"], start=1):
        if stopping():
            raise InterruptedError()
        numbers[id(it)] = no
        if it["kind"] == "sudoku":
            pending_sudoku.append((no, it))
            if large or len(pending_sudoku) == 2:
                flush_sudokus()
            continue
        flush_sudokus()
        doc.page()
        lft, rgt = margins()
        avail_w = rgt - lft
        name = PUZZLE_NAMES[it["kind"]][0 if lang_of(book) == "de" else 1]
        head = f"{T(book, 'Rätsel', 'Puzzle')} {no} · {name} · {level_name(book, it['level'])}"
        if it["kind"] == "wordsearch":
            head += f" · {it['theme']}"
        doc.text(lft, top, head, "Noto Sans SemiBold", 14 if large else 12, avail_w, "left", INK)
        if it["kind"] == "wordsearch":
            size = avail_w * (0.98 if large else 0.9)
            gx = lft + (avail_w - size) / 2
            draw_wordsearch(doc, it["data"], gx, top + 44, size)
            words = [p["word"] for p in it["data"]["words"]]
            per = math.ceil(len(words) / 3)
            colw = avail_w / 3
            ybase = top + 44 + size + 26
            for c in range(3):
                col = "\n".join(words[c * per:(c + 1) * per])
                doc.text(lft + c * colw, ybase, col, "Noto Sans", 14 if large else 11, colw, "left", INK, 1.35)
        else:
            draw_maze(doc, it["data"], lft, top + 50, avail_w, H - top - bottom - 70, False,
                      (T(book, "START", "START"), T(book, "ZIEL", "FINISH")))
        footer()
    flush_sudokus()
    # solutions
    doc.page()
    doc.text(0.9 * PT, H * 0.42, T(book, "Lösungen", "Solutions"), "Noto Serif Bold", 34, W - 1.8 * PT, "center", INK)
    for kind in ("sudoku", "wordsearch", "maze"):
        group = [it for it in book["items"] if it["kind"] == kind]
        if not group:
            continue
        cols, rows = {"sudoku": (2, 2) if large else (2, 3), "wordsearch": (1, 2) if large else (2, 2),
                      "maze": (2, 2)}[kind]
        per = cols * rows
        for start in range(0, len(group), per):
            doc.page()
            lft, rgt = margins()
            cw, ch = (rgt - lft) / cols, (H - top - bottom) / rows
            for k, it in enumerate(group[start:start + per]):
                cx, cy = lft + (k % cols) * cw, top + (k // cols) * ch
                no = numbers[id(it)]
                doc.text(cx, cy, f"{T(book, 'Rätsel', 'Puzzle')} {no}", "Noto Sans SemiBold", 10, cw, "left", INK)
                box = min(cw, ch - 24) * 0.9
                if kind == "sudoku":
                    draw_sudoku(doc, it["data"]["solution"], cx + (cw - box) / 2, cy + 18, box,
                                [bool(v) for v in it["data"]["puzzle"]])
                elif kind == "wordsearch":
                    draw_wordsearch(doc, it["data"], cx + (cw - box) / 2, cy + 20, box, solved=True)
                else:
                    draw_maze(doc, it["data"], cx, cy + 18, cw * 0.95, ch - 30, solved=True, labels=None)
            footer()
    doc.page()
    thanks_page(doc, book, W, H)
    if doc.count % 2:
        doc.page()
    n = doc.close()
    os.replace(path + ".part", path)
    book["pages"] = n
    note(book, f"interior.pdf: {n} pages")


def level_name(book: dict, level: str) -> str:
    return LEVEL_EN.get(level, level) if lang_of(book) == "en" else level


# ─────────────────────────────────────────────────────────────── picture book
PICTURE_BEATS = 14
PAINT_W, PAINT_H = 1344, 1360           # /16; ~ the bleed page's shape (8.625 × 8.75)

AUTHOR_SYSTEM = ("Du bist eine preisgekrönte Bilderbuchautorin. Du schreibst warme, kluge Geschichten zum "
                 "Vorlesen für Kinder von 3 bis 6 Jahren: kurze Sätze, lebendige Verben, ein klarer Bogen, ein "
                 "bisschen Humor, ein tröstliches Ende, nie belehrend. Deine Illustratorin braucht genaue, "
                 "englische Bildbeschreibungen. Du antwortest immer NUR mit gültigem JSON.")
EDITOR_SYSTEM = ("Du bist eine strenge, erfahrene Lektorin für Bilderbücher (3–6 Jahre). Du prüfst Sprache "
                 "(Grammatik, Rechtschreibung, Klang beim Vorlesen), Altersgerechtheit, roten Faden, Logik, "
                 "Spannung, Wärme und ob die Hauptfigur selbst das Problem löst. Du antwortest NUR mit JSON.")


def picture_plan(book: dict) -> None:
    idea = book["idea"].get("idea") or book["idea"].get("wish") or "Eine warmherzige Geschichte über Freundschaft."
    lang = "Englisch" if lang_of(book) == "en" else "Deutsch"
    plan = chat_json(AUTHOR_SYSTEM, f"""Entwirf ein Bilderbuch. Sprache des Buches: {lang}.
Idee: {idea}

JSON mit genau diesen Feldern:
{{"title": "kurzer, einprägsamer Titel (max. 6 Wörter)",
 "subtitle": "Untertitel, der sagt, worum es geht und für wen (z. B. 'Eine Gute-Nacht-Geschichte für Kinder ab 3')",
 "hero": {{"name": "Vorname", "species": "Tierart oder Wesen",
          "look": "ENGLISH, one sentence, very concrete and always the same: species, size, fur/skin colours, eye colour, one or two unmistakable clothes or marks (e.g. 'a small round orange fox cub with a cream belly, amber eyes and a blue knitted scarf')",
          "personality": "zwei, drei Eigenschaften"}},
 "friends": [{{"name": "...", "look": "ENGLISH, one concrete sentence"}}],
 "setting": "wo die Geschichte spielt",
 "message": "was Kinder mitnehmen (ein Satz)",
 "style": "ENGLISH: the illustration style, e.g. 'soft watercolour and gouache children's book illustration, warm light, gentle textures'",
 "palette": "ENGLISH: three to five colours",
 "cover_scene": "ENGLISH: the cover picture — the hero in a typical, happy moment, the top third calm (sky or wall) for the title"}}""",
                     effort="high", max_tokens=1800)
    for key in ("title", "hero", "style"):
        if not plan.get(key):
            raise RuntimeError(f"the plan has no {key}")
    book["plan"] = plan
    book["title"] = str(plan["title"]).strip()
    book["subtitle"] = str(plan.get("subtitle") or "").strip()
    book["pages"] = 32
    note(book, f"plan: {book['title']} — {plan['hero'].get('name')} the {plan['hero'].get('species')}")


EN_COMMON = {"the", "and", "he", "she", "they", "is", "are", "was", "his", "her", "with", "to", "of", "it", "says",
             "said", "in", "on", "a", "an", "you", "i", "not", "just", "little", "night", "dark"}
DE_COMMON = {"der", "die", "das", "und", "er", "sie", "ist", "war", "sein", "ihre", "mit", "zu", "von", "es", "sagt",
             "in", "auf", "ein", "eine", "du", "ich", "nicht", "nur", "kleine", "nacht", "dunkel", "den", "dem"}


def language_of(text: str) -> str:
    """'de', 'en' or '' — by the little words every sentence has."""
    words = re.findall(r"[a-zäöüß']+", str(text or "").lower())
    if len(words) < 4:
        return ""
    de = sum(1 for w in words if w in DE_COMMON) + 2 * len(re.findall(r"[äöüß]", " ".join(words)))
    en = sum(1 for w in words if w in EN_COMMON)
    return "de" if de > en else "en" if en > de else ""


def aspell_dict(lang: str) -> str:
    """The installed aspell dictionary for the book's language ('' when none)."""
    if not shutil.which("aspell"):
        return ""
    try:
        have = subprocess.run(["aspell", "dicts"], capture_output=True, text=True, timeout=10).stdout.split()
    except (OSError, subprocess.TimeoutExpired):
        return ""
    for want in (["de_DE", "de"] if lang == "de" else ["en_US", "en_GB", "en"]):
        if want in have:
            return want
    return ""


# Words of the trade the dictionary does not carry (lower case).
DOMAIN_WORDS = {"mandala", "mandalas", "suchsel", "sudoku", "sudokus", "großdruck", "ausmalbuch", "ausmalbücher",
                "malbuch", "malbücher", "rätselbuch", "rätselbücher", "wortsuchrätsel", "wortsuche", "labyrinthe",
                "labyrinthen", "kdp", "softcover", "taschenbuch", "achtsamkeitsübung", "kita", "vorlesebuch"}


def compound_known(word: str, cmd: list) -> bool:
    """A German compound the dictionary lacks, but whose parts it knows:
    "Pastelltönen" = Pastell + Tönen, "Lernhilfe" = Lern(en) + Hilfe,
    "Entspannungsaktivität" = Entspannung(s) + Aktivität. A typo in a part
    ("Entspannungsrätel") stays unknown."""
    w = word.strip()
    if len(w) < 7:
        return False
    cands = []
    for i in range(3, len(w) - 2):
        left, right = w[:i], w[i:]
        lefts = {left, left + "en", left + "e", left + "n"}
        if left.endswith(("s", "es")):
            lefts |= {left[:-1], left[:-2]}
        cands.append((lefts, {right.capitalize(), right.lower()}))
    words = sorted({x for ls, rs in cands for x in ls | rs if len(x) >= 3})
    try:
        unknown = set(subprocess.run(cmd, input="\n".join(words), capture_output=True, text=True, timeout=30).stdout.split())
    except (OSError, subprocess.TimeoutExpired):
        return False
    return any(any(x not in unknown and len(x) >= 3 for x in ls) and any(y not in unknown and len(y) >= 3 for y in rs)
               for ls, rs in cands)


def unknown_words(texts: list, lang: str, allow=()) -> list:
    """Words the dictionary does not know — slips like "Fuchskub", English
    in a German sentence ("hops", "Lullabies"). Names are allowed; German
    compounds are tried as joined words."""
    dic = aspell_dict(lang)
    if not dic:
        return []
    cmd = ["aspell", f"--lang={dic}", "--encoding=utf-8", "list"]
    if lang == "de":
        cmd[1:1] = ["--run-together", "--run-together-limit=4", "--run-together-min=3"]
    try:
        out = subprocess.run(cmd, input="\n".join(str(t or "") for t in texts), capture_output=True, text=True,
                             timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    names = [str(a).lower() for a in allow if a]
    odd = []
    for w in out.split():
        low = w.lower()
        # a name with an ending ("Flicks") is the name
        if len(w) <= 2 or w in odd or any(low.startswith(n) and len(low) - len(n) <= 2 for n in names):
            continue
        odd.append(w)
    odd = [w for w in odd if w.lower() not in DOMAIN_WORDS]
    if not odd or lang != "de":
        return odd
    odd = [w for w in odd if not compound_known(w, cmd)]
    if not odd:
        return odd
    # German endings the dictionary does not list for every word ("moosigen"):
    # a word whose stem it knows is a word
    stems = {}
    for w in odd:
        for end in ("en", "er", "es", "em", "e", "n", "s"):
            if w.lower().endswith(end) and len(w) - len(end) >= 4:
                stems.setdefault(w, []).append(w[:-len(end)])
    if stems:
        try:
            known_not = set(subprocess.run(cmd, input="\n".join(x for v in stems.values() for x in v),
                                           capture_output=True, text=True, timeout=30).stdout.split())
        except (OSError, subprocess.TimeoutExpired):
            known_not = set()
        odd = [w for w in odd if not any(st not in known_not for st in stems.get(w, []))]
    return odd


def story_checks(book: dict, beats: list, strict: bool = True) -> list:
    """What a machine can see is wrong with a draft (the editor sees the rest).
    strict=False is the final gate: two words a dictionary does not know are
    forgiven there (dictionaries miss rare words that are right)."""
    problems = []
    plan = book.get("plan") or {}
    names = [str(plan.get("hero", {}).get("name") or "")] + [str(f.get("name") or "") for f in plan.get("friends") or []]
    odd = unknown_words([b.get("text") for b in beats], lang_of(book), names)
    if len(odd) > (0 if strict else 2):
        problems.append(("Diese Wörter gibt es so nicht (Tippfehler, erfundene oder englische Wörter) — ersetze sie "
                         "durch richtige deutsche Wörter: " if lang_of(book) == "de" else
                         "These words are not in the dictionary — replace them: ") + ", ".join(odd[:20]))
    want = lang_of(book)
    wrong = [i for i, b in enumerate(beats, start=1) if language_of(b.get("text")) not in ("", want)]
    if wrong:
        problems.append(("Diese Abschnitte sind nicht auf Deutsch geschrieben — der ganze Text MUSS Deutsch sein: "
                         if want == "de" else "These parts are not in English — every word must be English: ")
                        + ", ".join(map(str, wrong)))
    if len(beats) != PICTURE_BEATS:
        problems.append(f"genau {PICTURE_BEATS} Abschnitte nötig, es sind {len(beats)}")
    words = 0
    hero = str((book.get("plan") or {}).get("hero", {}).get("name") or "")
    named = 0
    for i, b in enumerate(beats, start=1):
        text = str(b.get("text") or "").strip()
        n = len(re.findall(r"\w+", text))
        words += n
        if n < 8:
            problems.append(f"Abschnitt {i} ist zu kurz ({n} Wörter)")
        if n > 60:
            problems.append(f"Abschnitt {i} ist zu lang ({n} Wörter, höchstens 55)")
        if not str(b.get("scene") or "").strip():
            problems.append(f"Abschnitt {i} hat keine Bildbeschreibung")
        if hero and hero.lower() in text.lower():
            named += 1
    if words > 800:
        problems.append(f"insgesamt zu lang ({words} Wörter, höchstens 750)")
    if hero and named < PICTURE_BEATS // 2:
        problems.append(f"{hero} kommt zu selten vor")
    return problems


def picture_story(book: dict) -> None:
    plan = book["plan"]
    draft = chat_json(AUTHOR_SYSTEM, f"""Schreibe die Geschichte zu diesem Plan:
{json.dumps(plan, ensure_ascii=False)}

Sprache: der Text jedes Abschnitts ist {"Deutsch" if lang_of(book) == "de" else "Englisch"} (nur das Feld scene ist Englisch).
Genau {PICTURE_BEATS} Abschnitte, einer pro Doppelseite. Jeder Abschnitt: 2 bis 4 kurze Sätze, 15 bis 50 Wörter,
zum Vorlesen (Rhythmus, eine kleine Wiederholung darf wiederkehren, keine erzwungenen Reime).
Bogen: 1–2 Anfang und Held, 3–4 das Problem, 5–10 Versuche und Begegnungen, 11–12 der Höhepunkt,
13–14 die Lösung durch den Helden selbst und ein warmes Ende.

JSON: {{"beats": [{{"text": "der Text dieser Seite", "scene": "ENGLISH, 1–2 sentences: exactly what the picture shows — who, where, doing what, the mood, the light, wide or close"}}]}}""",
                      effort="high", max_tokens=5000)
    beats = draft.get("beats") if isinstance(draft, dict) else draft
    if not isinstance(beats, list):
        raise RuntimeError("the story came back without beats")
    book["story"] = {"beats": beats, "rounds": 0, "score": 0, "notes": []}
    words = sum(len(re.findall(r"\w+", str(b.get("text") or ""))) for b in beats)
    note(book, f"draft: {len(beats)} beats, {words} words")


def picture_edit(book: dict) -> None:
    """Editor and author in turns until the editor gives 8 of 10 with nothing
    that must be fixed — at most three rounds."""
    story = book["story"]
    plan = book["plan"]
    lang = "Deutsch" if lang_of(book) == "de" else "Englisch"
    while story["rounds"] < 3:
        if stopping():
            raise InterruptedError()
        checks = story_checks(book, story["beats"])
        review = chat_json(EDITOR_SYSTEM, f"""Plan: {json.dumps(plan, ensure_ascii=False)}
Geschichte (Abschnitt für Abschnitt): {json.dumps([b.get('text') for b in story['beats']], ensure_ascii=False)}
Die Maschine hat schon gefunden: {json.dumps(checks, ensure_ascii=False)}

Die Sprache des Buches ist {lang} — jeder Satz in einer anderen Sprache ist ein must_fix.
Bewerte streng von 1 bis 10: 10 = ein großer Verlag würde es so drucken, 7 = ordentlich, aber austauschbar,
5 = Fehler. Prüfe jeden Satz: Grammatik, Logik (kann eine Maus mit den Augen winken?), Bildhaftigkeit,
Rhythmus beim Vorlesen, ob die Hauptfigur das Problem SELBST löst, ein Höhepunkt, ein warmes Ende.
JSON:
{{"score": 7, "must_fix": ["was falsch ist und so nicht gedruckt werden darf"], "better": ["mindestens drei konkrete Verbesserungen"]}}""",
                           effort="high", max_tokens=1500)
        score = int(review.get("score") or 0) if isinstance(review, dict) else 0
        must = [str(x) for x in (review.get("must_fix") or [])] + checks if isinstance(review, dict) else checks
        better = [str(x) for x in (review.get("better") or [])] if isinstance(review, dict) else []
        story["score"] = score
        story["notes"].append({"round": story["rounds"] + 1, "score": score, "must": must[:8], "better": better[:6]})
        note(book, f"editor round {story['rounds'] + 1}: {score}/10, {len(must)} must-fix")
        # done only after at least one round of improvements, at 9 and nothing to fix
        if story["rounds"] >= 1 and score >= 9 and not must:
            break
        revised = chat_json(AUTHOR_SYSTEM, f"""Überarbeite deine Geschichte. Plan: {json.dumps(plan, ensure_ascii=False)}
Bisherige Fassung: {json.dumps(story['beats'], ensure_ascii=False)}
Die Lektorin sagt — das MUSS behoben werden: {json.dumps(must, ensure_ascii=False)}
— und das würde es besser machen: {json.dumps(better, ensure_ascii=False)}

Behebe alles. Gleiche Form wie vorher: {{"beats": [{{"text": "...", "scene": "..."}}]}} mit genau {PICTURE_BEATS} Abschnitten.""",
                            effort="high", max_tokens=5000)
        beats = revised.get("beats") if isinstance(revised, dict) else revised
        if isinstance(beats, list) and len(beats) >= PICTURE_BEATS - 1:
            story["beats"] = beats[:PICTURE_BEATS]
        story["rounds"] += 1
        save_book(book)
    weak = story["score"] < 8 or bool(story_checks(book, story["beats"], strict=False))
    if weak and story["rounds"] >= 3:
        # Three rounds without getting there: a fresh draft is better than a fourth patch on this
        # one — twice; then the book stops and says why.
        book["restarts"] = int(book.get("restarts") or 0) + 1
        why = "; ".join(story_checks(book, story["beats"], strict=False)) or f"the editor gives {story['score']}/10"
        if book["restarts"] <= 2:
            book["done"] = [s for s in book.get("done", []) if s != "story"]
            note(book, f"three rounds were not enough ({why[:120]}) — a fresh draft (start {book['restarts'] + 1})")
            raise RuntimeError("a fresh draft")
        raise RuntimeError(f"after three drafts still not good enough: {why}"[:240])
    note(book, f"story final: {story['score']}/10 after {story['rounds']} round(s)")


def art_prompt(book: dict, scene: str, cover: bool = False) -> str:
    plan = book["plan"]
    hero = plan.get("hero") or {}
    friends = "; ".join(str(f.get("look") or "") for f in (plan.get("friends") or []) if f.get("look"))
    parts = [str(plan.get("style") or "soft watercolour children's book illustration"),
             f"The main character: {hero.get('look')}",
             f"Other characters when they appear: {friends}" if friends else "",
             f"Scene: {scene}",
             f"Colour palette: {plan.get('palette')}" if plan.get("palette") else "",
             "Composition with calm open space in the top third for a title." if cover else
             "Full-page picture book illustration, the characters well inside the frame.",
             "No text, no letters, no words, no numbers, no watermark, no signature, no border."]
    return " ".join(p for p in parts if p)


def picture_art(book: dict) -> None:
    if not engine_status()["ok"]:
        book["state"] = "waiting-engine"
        raise RuntimeError("needs the picture engine — velvet-books engine (Settings → VELLY → BOOK STUDIO)")
    free_gpu_for_pictures()
    art = book.setdefault("art", {})
    jobs = [(f"page-{i + 1:02d}", b.get("scene") or "", False) for i, b in enumerate(book["story"]["beats"])]
    jobs.append(("cover", book["plan"].get("cover_scene") or book["story"]["beats"][0].get("scene", ""), True))
    folder = book_path(book, "art")
    os.makedirs(folder, exist_ok=True)
    w_px, h_px = round(8.625 * DPI), round(8.75 * DPI)
    for n, (name, scene, cover) in enumerate(jobs):
        final = os.path.join(folder, f"{name}.jpg")
        if os.path.isfile(final) and art.get(name):
            continue
        if stopping():
            raise InterruptedError()
        raw = os.path.join(folder, f"{name}.raw.png")
        seed = (book["seed"] + n * 101) % (2 ** 31)
        say_state(book=book["id"], doing=f"painting {name} ({n + 1}/{len(jobs)})")
        began = time.monotonic()
        paint(art_prompt(book, scene, cover), raw, PAINT_W, PAINT_H, seed)
        to_print(raw, final, w_px, h_px)
        os.unlink(raw)
        art[name] = {"seed": seed, "seconds": round(time.monotonic() - began, 1)}
        save_book(book)
    note(book, f"{len(jobs)} pictures painted")


def avg_colour(path: str):
    from PIL import Image                                           # noqa: PLC0415
    r, g, b = Image.open(path).convert("RGB").resize((1, 1), Image.BOX).getpixel((0, 0))
    return r / 255, g / 255, b / 255


def mix(a, b, t: float):
    return tuple(a[i] * (1 - t) + b[i] * t for i in range(3))


def picture_interior(book: dict) -> None:
    """32 pages, 8.5 × 8.5 with bleed: title · copyright · dedication, then 14
    spreads (text left, picture right), the end."""
    path = book_path(book, "interior.pdf")
    doc = Doc(path + ".part", 8.625, 8.75)
    W, H = doc.w, doc.h
    b = KDP["bleed"] * PT
    safe = 0.5 * PT                                                   # well inside the 0.375 in minimum
    art = book_path(book, "art")
    cover = os.path.join(art, "cover.jpg")
    cream = (0.99, 0.97, 0.92)

    def page_box():
        """(left, top, width, height) of the live area of the current page:
        a right (odd) page bleeds on the right, a left page on the left."""
        right = doc.count % 2 == 1
        left = safe if right else b + safe
        return left, b + safe, W - b - 2 * safe, H - 2 * b - 2 * safe

    # 1 · title
    doc.page()
    x, y, w, h = page_box()
    tsize = doc.fit(book["title"], "Noto Serif Bold", 40, w, 140, 1.05)
    yy = y + h * 0.08
    yy += doc.text(x, yy, book["title"], "Noto Serif Bold", tsize, w, "center", INK, 1.05) + 12
    if book.get("subtitle"):
        yy += doc.text(x, yy, book["subtitle"], "Noto Sans", 12, w, "center", SOFT, 1.2)
    d = min(w, h) * 0.5
    doc.ctx.save()
    doc.ctx.arc(x + w / 2, y + h * 0.62, d / 2, 0, 2 * math.pi)
    doc.ctx.clip()
    doc.image(cover, x + w / 2 - d / 2, y + h * 0.62 - d / 2, d, d)
    doc.ctx.restore()
    doc.text(x, y + h - 20, book["author"], "Noto Sans SemiBold", 12, w, "center", INK)
    # 2 · copyright
    doc.page()
    x, y, w, h = page_box()
    copyright_page(doc, book, x, w, y + h, True, True)
    # 3 · for you
    doc.page()
    x, y, w, h = page_box()
    hero = book["plan"].get("hero", {}).get("name", "")
    doc.text(x, y + h * 0.4, T(book, f"Für alle, die so mutig sind wie {hero}." if hero else "Für dich.",
                               f"For everyone as brave as {hero}." if hero else "For you."),
             "Noto Serif Italic", 16, w, "center", SOFT)
    # 4–31 · the story
    for i, beat in enumerate(book["story"]["beats"]):
        pic = os.path.join(art, f"page-{i + 1:02d}.jpg")
        tint = mix(avg_colour(pic), cream, 0.86)
        doc.page()                                                    # left: the words
        ctx = doc.ctx
        ctx.set_source_rgb(*tint)
        ctx.paint()
        x, y, w, h = page_box()
        ctx.set_source_rgb(*mix(tint, INK, 0.25))
        ctx.set_line_width(1.2)
        rr = 18
        ctx.new_path()
        ctx.arc(x + rr, y + rr, rr, math.pi, 1.5 * math.pi)
        ctx.arc(x + w - rr, y + rr, rr, 1.5 * math.pi, 2 * math.pi)
        ctx.arc(x + w - rr, y + h - rr, rr, 0, 0.5 * math.pi)
        ctx.arc(x + rr, y + h - rr, rr, 0.5 * math.pi, math.pi)
        ctx.close_path()
        ctx.stroke()
        text = str(beat.get("text") or "").strip()
        tw = w * 0.78
        size = doc.fit(text, "Noto Serif SemiBold", 24, tw, h * 0.7, 1.35, least=14)
        _ww, th = doc.measure(text, "Noto Serif SemiBold", size, tw, 1.35)
        doc.text(x + (w - tw) / 2, y + (h - th) / 2, text, "Noto Serif SemiBold", size, tw, "center", INK, 1.35)
        doc.text(x, y + h + 8, str(doc.count), "Noto Sans", 9, w, "left", SOFT)
        doc.page()                                                    # right: the picture, full bleed
        doc.image(pic, 0, 0, W, H)
    # 32 · the end
    doc.page()
    x, y, w, h = page_box()
    doc.text(x, y + h * 0.38, T(book, "Ende", "The End"), "Noto Serif Bold", 34, w, "center", INK)
    doc.text(x, y + h * 0.55, book["plan"].get("message", ""), "Noto Serif Italic", 13, w, "center", SOFT, 1.3)
    n = doc.close()
    os.replace(path + ".part", path)
    book["pages"] = n
    note(book, f"interior.pdf: {n} pages")


# ──────────────────────────────────────────────────────────────────── covers
def cover_geometry(book: dict) -> dict:
    w_in, h_in = book["trim"]
    spine = spine_width(book["pages"], book["ink"])
    bleed = KDP["bleed"]
    return {"w": bleed * 2 + w_in * 2 + spine, "h": h_in + bleed * 2, "spine": spine, "bleed": bleed,
            "trim_w": w_in, "trim_h": h_in}


def cover_pdf(book: dict, front_art=None, back_text: str = "", back_art=None) -> None:
    """The full wrap: back · spine · front, with bleed all round; the barcode
    corner on the back is kept free. `front_art(doc, x, y, w, h)` paints the
    front panel, `back_art(doc, x, y, w, h)` the samples on the back (the
    middle band of the back's live area)."""
    g = cover_geometry(book)
    path = book_path(book, "cover.pdf")
    doc = Doc(path + ".part", g["w"], g["h"])
    W, H = doc.w, doc.h
    bleed, spine, trim_w = g["bleed"] * PT, g["spine"] * PT, g["trim_w"] * PT
    front_x = bleed + trim_w + spine
    ctx = doc.page()
    base = book.setdefault("cover", {}).get("base") or (0.16, 0.22, 0.36)
    ctx.set_source_rgb(*base)
    ctx.paint()
    if front_art:
        front_art(doc, front_x, 0, trim_w + bleed, H)
    # back: the blurb, samples of the inside, the author — the barcode corner kept free
    safe = 0.5 * PT
    bx, by, bw = bleed + safe, bleed + safe, trim_w - 2 * safe
    live_h = g["trim_h"] * PT - 2 * safe
    if back_text:
        size = doc.fit(back_text, "Noto Serif", 13, bw, live_h * (0.42 if back_art else 0.6), 1.35, least=9)
        doc.text(bx, by + 0.2 * PT, back_text, "Noto Serif", size, bw, "left", (1, 1, 1), 1.35)
    if back_art:
        back_art(doc, bx, by + live_h * 0.47, bw, live_h * 0.30)
    doc.text(bx, H - bleed - safe - 16, book["author"], "Noto Sans SemiBold", 11, bw * 0.5, "left", (1, 1, 1))
    bw_in, bh_in = KDP["barcode"]
    ctx.set_source_rgb(1, 1, 1)
    ctx.rectangle(bleed + trim_w - 0.25 * PT - bw_in * PT, H - bleed - 0.25 * PT - bh_in * PT, bw_in * PT, bh_in * PT)
    ctx.fill()
    # spine text only from 80 pages (KDP), small and centred, read top to bottom
    if book["pages"] >= KDP["spineTextMin"] and spine >= 0.2 * PT:
        size = max(6.0, min(14.0, (spine - 0.125 * PT) * 0.72))
        label = f"{book['title']}  ·  {book['author']}"
        ctx.save()
        ctx.translate(bleed + trim_w + spine / 2, H / 2)
        ctx.rotate(math.pi / 2)
        tw, th = doc.measure(label, "Noto Sans SemiBold", size)
        avail = g["trim_h"] * PT - 1.0 * PT
        if tw > avail:
            size = size * avail / tw
            tw, th = doc.measure(label, "Noto Sans SemiBold", size)
        doc.text(-tw / 2, -th / 2, label, "Noto Sans SemiBold", size, 0, "left", (1, 1, 1))
        ctx.restore()
    doc.close()
    os.replace(path + ".part", path)
    book["cover"].update({"w_in": round(g["w"], 4), "h_in": round(g["h"], 4), "spine_in": round(g["spine"], 4)})
    note(book, f"cover.pdf: {g['w']:.3f} × {g['h']:.3f} in, spine {g['spine']:.4f} in")


def title_block(doc: Doc, book: dict, x: float, y: float, w: float, rgb=(1, 1, 1), shadow=None, band=None) -> float:
    """Title and subtitle centred in a box at the top of the front."""
    tsize = doc.fit(book["title"], "Noto Sans Black", 46, w, 150, 1.0, least=20)
    _tw, th = doc.measure(book["title"], "Noto Sans Black", tsize, w, 1.0)
    sub = book.get("subtitle") or ""
    ssize = doc.fit(sub, "Noto Sans SemiBold", 15, w, 60, 1.15, least=9) if sub else 0
    _sw, sh = doc.measure(sub, "Noto Sans SemiBold", ssize, w, 1.15) if sub else (0, 0)
    if band:
        doc.ctx.save()
        doc.ctx.set_source_rgba(*band)
        doc.ctx.rectangle(x - 0.3 * PT, y - 0.25 * PT, w + 0.6 * PT, th + sh + 0.8 * PT)
        doc.ctx.fill()
        doc.ctx.restore()
    if shadow:
        doc.text(x + 2, y + 2, book["title"], "Noto Sans Black", tsize, w, "center", shadow, 1.0)
    doc.text(x, y, book["title"], "Noto Sans Black", tsize, w, "center", rgb, 1.0)
    if sub:
        if shadow:
            doc.text(x + 1.5, y + th + 11.5, sub, "Noto Sans SemiBold", ssize, w, "center", shadow, 1.15)
        doc.text(x, y + th + 10, sub, "Noto Sans SemiBold", ssize, w, "center", rgb, 1.15)
    return th + sh + 10


def coloring_cover(book: dict) -> None:
    pal = PALETTES[int(book["id"]) % len(PALETTES)]
    base = mix(pal[3], (0.05, 0.05, 0.1), 0.35)
    book.setdefault("cover", {})["base"] = base
    md = mandala_for(book, 997)

    def art(doc, x, y, w, h):
        ctx = doc.ctx
        ctx.set_source_rgb(*mix(pal[5], (1, 1, 1), 0.3))
        ctx.rectangle(x, y, w, h)
        ctx.fill()
        bleed = KDP["bleed"] * PT
        live_w = w - bleed
        R = live_w * 0.47
        md.draw(ctx, x + live_w / 2, y + h * 0.58, R, fills=pal, line_rgb=(0.12, 0.10, 0.14))
        title_block(doc, book, x + 0.55 * PT, y + bleed + 0.55 * PT, live_w - 1.1 * PT, rgb=(1, 1, 1),
                    band=(*base, 0.92))
        author_band(doc, book, x, y + h - bleed - 0.78 * PT, w, base)

    def samples(doc, x, y, w, h):
        cards(doc, x, y, w, h, 3, lambda d, cx, cy, r, n: mandala_for(book, n * 11 + 3).draw(d.ctx, cx, cy, r * 0.92))

    blurb = book.get("listing", {}).get("back") or coloring_back(book)
    cover_pdf(book, art, blurb, samples)
    front_jpg(book, art)


def coloring_back(book: dict) -> str:
    n = book.get("count", 50)
    return T(book, f"{n} Mandalas zum Ausmalen – zum Abschalten, Durchatmen und Genießen.\n\n"
                   "• jedes Motiv auf einer eigenen Seite, die Rückseiten bleiben frei\n"
                   "• klare Linien, von einfach bis detailreich\n"
                   "• großes Format, 21,6 × 27,9 cm\n\nEin schönes Geschenk für alle, die gern malen.",
             f"{n} mandalas to colour — to switch off, breathe and enjoy.\n\n"
             "• every design on its own page, the backs left blank\n• clean lines, from simple to detailed\n"
             "• large format, 8.5 × 11 in\n\nA lovely gift for everyone who likes to colour.")


def author_band(doc: Doc, book: dict, x: float, y: float, w: float, base) -> None:
    doc.ctx.save()
    doc.ctx.set_source_rgb(*base)
    doc.ctx.rectangle(x, y, w, doc.h - y)
    doc.ctx.fill()
    doc.ctx.restore()
    doc.text(x, y + 0.2 * PT, book["author"], "Noto Sans SemiBold", 14, w - KDP["bleed"] * PT, "center", (1, 1, 1))


def cards(doc: Doc, x: float, y: float, w: float, h: float, n: int, draw) -> None:
    """n white cards in a row, gently tilted, each with draw(doc, cx, cy, r, i)."""
    ctx = doc.ctx
    gap = w * 0.04
    side = min(h, (w - gap * (n - 1)) / n)
    total = side * n + gap * (n - 1)
    for i in range(n):
        cx = x + (w - total) / 2 + side / 2 + i * (side + gap)
        cy = y + h / 2
        ctx.save()
        ctx.translate(cx, cy)
        ctx.rotate((-0.05, 0.03, -0.02, 0.05)[i % 4])
        ctx.set_source_rgba(0, 0, 0, 0.22)
        ctx.rectangle(-side / 2 + 3, -side / 2 + 4, side, side)
        ctx.fill()
        ctx.set_source_rgb(1, 1, 1)
        ctx.rectangle(-side / 2, -side / 2, side, side)
        ctx.fill()
        draw(doc, 0, 0, side * 0.42, i)
        ctx.restore()


def puzzle_cover(book: dict) -> None:
    pal = PALETTES[(int(book["id"]) + 1) % len(PALETTES)]
    base = mix(pal[2], (0.04, 0.05, 0.1), 0.25)
    book.setdefault("cover", {})["base"] = base
    first = {k: next((it for it in book["items"] if it["kind"] == k), None) for k in ("sudoku", "wordsearch", "maze")}

    def art(doc, x, y, w, h):
        ctx = doc.ctx
        bleed = KDP["bleed"] * PT
        live_w = w - bleed
        ctx.set_source_rgb(*mix(pal[5], (1, 1, 1), 0.2))
        ctx.rectangle(x, y, w, h)
        ctx.fill()
        # the puzzles themselves as the picture, tilted cards
        cards_ = [k for k in ("sudoku", "wordsearch", "maze") if first[k]]
        for n, k in enumerate(cards_):
            ctx.save()
            cx = x + live_w * (0.29 + 0.42 * (n / max(1, len(cards_) - 1))) if len(cards_) > 1 else x + live_w / 2
            cy = y + h * (0.64 + 0.04 * (n % 2))
            ctx.translate(cx, cy)
            ctx.rotate((-0.08, 0.06, -0.03)[n % 3])
            s = live_w * (0.40 if len(cards_) > 1 else 0.6)
            ctx.set_source_rgba(0, 0, 0, 0.18)
            ctx.rectangle(-s / 2 + 5, -s / 2 + 7, s, s)
            ctx.fill()
            ctx.set_source_rgb(1, 1, 1)
            ctx.rectangle(-s / 2, -s / 2, s, s)
            ctx.fill()
            inner = s * 0.86
            if k == "sudoku":
                draw_sudoku(doc, first[k]["data"]["puzzle"], -inner / 2, -inner / 2, inner)
            elif k == "wordsearch":
                draw_wordsearch(doc, first[k]["data"], -inner / 2, -inner / 2, inner, solved=True)
            else:
                draw_maze(doc, first[k]["data"], -inner / 2, -inner / 2, inner, inner, solved=True, labels=None)
            ctx.restore()
        title_block(doc, book, x + 0.55 * PT, y + bleed + 0.55 * PT, live_w - 1.1 * PT, rgb=(1, 1, 1),
                    band=(*base, 0.95))
        author_band(doc, book, x, y + h - bleed - 0.78 * PT, w, base)

    def samples(doc, x, y, w, h):
        kinds = [k for k in ("sudoku", "wordsearch", "maze") if first[k]] or ["sudoku"]
        picks = (kinds * 3)[:3]

        def one(d, cx, cy, r, i):
            it = [t for t in book["items"] if t["kind"] == picks[i]][i // len(kinds) + 1:][:1] or [first[picks[i]]]
            data = it[0]["data"]
            box = r * 2
            if picks[i] == "sudoku":
                draw_sudoku(d, data["puzzle"], cx - r, cy - r, box)
            elif picks[i] == "wordsearch":
                draw_wordsearch(d, data, cx - r, cy - r, box)
            else:
                draw_maze(d, data, cx - r, cy - r, box, box, labels=None)

        cards(doc, x, y, w, h, 3, one)

    blurb = book.get("listing", {}).get("back") or puzzle_back(book)
    cover_pdf(book, art, blurb, samples)
    front_jpg(book, art)


def puzzle_back(book: dict) -> str:
    mix_ = book["idea"].get("mix", {})
    names = {"sudoku": ("Sudokus", "sudokus"), "wordsearch": ("Suchsel", "word searches"), "maze": ("Labyrinthe", "mazes")}
    parts = [f"• {n} {names[k][0 if lang_of(book) == 'de' else 1]}" for k, n in mix_.items()]
    large = book["idea"].get("large")
    return T(book, f"{sum(mix_.values())} Rätsel für entspannte Stunden.\n\n" + "\n".join(parts)
             + ("\n• große, gut lesbare Schrift" if large else "") + "\n• alle Lösungen hinten im Buch"
             + "\n\nTrainiert Kopf und Gedächtnis – und macht einfach Spaß.",
             f"{sum(mix_.values())} puzzles for relaxed hours.\n\n" + "\n".join(parts)
             + ("\n• large, easy-to-read print" if large else "") + "\n• all solutions at the back")


def picture_cover(book: dict) -> None:
    pic = book_path(book, os.path.join("art", "cover.jpg"))
    base = mix(avg_colour(pic), (0.05, 0.05, 0.08), 0.45)
    book.setdefault("cover", {})["base"] = base

    def art(doc, x, y, w, h):
        doc.image(pic, x, y, w, h)
        bleed = KDP["bleed"] * PT
        title_block(doc, book, x + 0.5 * PT, y + bleed + 0.45 * PT, w - bleed - 1.0 * PT, rgb=(1, 1, 1),
                    shadow=(0.05, 0.05, 0.08))
        doc.text(x + 2, y + h - bleed - 0.7 * PT + 2, book["author"], "Noto Sans Bold", 14, w - bleed, "center",
                 (0.05, 0.05, 0.08))
        doc.text(x, y + h - bleed - 0.7 * PT, book["author"], "Noto Sans Bold", 14, w - bleed, "center", (1, 1, 1))

    blurb = book.get("listing", {}).get("back") or book.get("subtitle") or ""
    cover_pdf(book, art, blurb)
    front_jpg(book, art)


def front_jpg(book: dict, art) -> None:
    """The front alone as a picture (the review page, ads, your shop):
    rendered from the same drawing, 1600 px high."""
    cairo, _P, _PC = cairo_mods()
    w_in, h_in = book["trim"]
    tmp_pdf = book_path(book, ".front.pdf")
    doc = Doc(tmp_pdf, w_in + KDP["bleed"], h_in + 2 * KDP["bleed"])
    doc.page()
    art(doc, 0, 0, doc.w, doc.h)
    doc.close()
    out = book_path(book, "cover-front")
    subprocess.run(["pdftoppm", "-jpeg", "-jpegopt", "quality=90", "-scale-to-y", "1600", "-scale-to-x", "-1",
                    "-singlefile", tmp_pdf, out], capture_output=True, timeout=120)
    os.unlink(tmp_pdf)


# ────────────────────────────────────────────────────────────────── listing
# What a listing may say about the book — and only this. The first real run
# (gpt-oss, 2026-10-23) promised "hochwertiges Papier" and markers on KDP's thin
# standard paper, wrote "mit dicke Linien", and aimed a book for children of six
# at "Jugendliche". The machine checks below catch that kind; an editor round
# catches the grammar.
PRINT_FACTS = {
    "coloring": "Taschenbuch (Amazon KDP), Schwarzweißdruck auf normalem weißen Papier — dünn: Filzstifte und Marker "
                "können durchdrücken, deshalb sind die Rückseiten leer. Format 21,6 × 27,9 cm.",
    "puzzle": "Taschenbuch (Amazon KDP), Schwarzweißdruck auf normalem weißen Papier, Format 21,6 × 27,9 cm.",
    "picture": "Taschenbuch (Amazon KDP), Farbdruck, Format 21,6 × 21,6 cm, Softcover.",
}
BAD_CLAIMS = re.compile(r"(?i)(hochwertig\w*\s+(?:\w+\s+)?papier|dick\w*\s+papier|stark\w*\s+papier|premium[- ]?papier|"
                        r"extra\s*stark\w*|drück\w*\s+nicht\s+durch|kein\w*\s+durchdrück\w*|ohne\s+durchdrück\w*|"
                        r"\bmarker\b|alkoholmarker|bestseller|nr\.?\s*1\b|#\s*1\b|nummer\s+eins|garantiert|kostenlos|"
                        r"gratis|kindle|exklusiv\w*|preisgekrönt\w*)")
AUDIENCE_WORDS = {"kids": "Kinder", "seniors": "Seniorinnen und Senioren", "adults": "Erwachsene"}
AUDIENCE_WRONG = {"kids": re.compile(r"(?i)\b(jugendlich\w*|teenager\w*|erwachsen\w*|senior\w*)\b"),
                  "seniors": re.compile(r"(?i)\b(kinder\w*|kids|jugendlich\w*|teenager\w*)\b"),
                  "adults": re.compile(r"(?i)\b(kinder\s+ab|für\s+kinder|kids|jugendlich\w*|teenager\w*)\b")}
LISTING_EDITOR = ("Du bist eine strenge Lektorin für Amazon-KDP-Buchlistings auf Deutsch. Du prüfst jedes Wort: "
                  "Grammatik (Kasus und Endungen — 'mit dicken Linien', 'mit 70 Rätseln'), Rechtschreibung, ob jede "
                  "Aussage über das Buch WAHR ist (nur was in den Fakten steht; nichts über die Qualität des Papiers, "
                  "über Stifte oder Marker), die Zielgruppe, und die Regeln von KDP (Titel und Untertitel sind keine "
                  "Liste von Suchwörtern; keine Superlative, Preise, Rabatte oder Versprechen). Du antwortest NUR "
                  "mit JSON.")


def strip_html(text: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", str(text or ""))).strip()


def listing_checks(book: dict, data: dict, strict: bool = True) -> list:
    """What a machine can see is wrong with a listing."""
    problems = []
    fields = {"Titel": str(data.get("title") or ""), "Untertitel": str(data.get("subtitle") or ""),
              "Beschreibung": strip_html(data.get("description")), "Rückseite": str(data.get("back") or ""),
              "Schlüsselwörter": " | ".join(str(k) for k in data.get("keywords") or [])}
    for name, text in fields.items():
        bad = list(dict.fromkeys(m.group(0) for m in BAD_CLAIMS.finditer(text)))
        if bad:
            problems.append(f"{name}: " + ", ".join(f"„{b}“" for b in bad) +
                            " darf nicht drinstehen (stimmt nicht oder verbietet KDP)")
    wrong = AUDIENCE_WRONG.get(book.get("audience", ""))
    if wrong:
        for name in ("Titel", "Untertitel", "Schlüsselwörter", "Beschreibung", "Rückseite"):
            hit = wrong.search(fields[name])
            if hit:
                problems.append(f"{name}: „{hit.group(0)}“ ist die falsche Zielgruppe — das Buch ist für "
                                f"{AUDIENCE_WORDS[book['audience']]}")
    odd = unknown_words(list(fields.values()), lang_of(book),
                        [str((book.get("plan") or {}).get("hero", {}).get("name") or ""), "KDP", "Sudoku", "Sudokus"])
    if len(odd) > (0 if strict else 2):
        problems.append("Diese Wörter gibt es so nicht (Tippfehler): " + ", ".join(odd[:12]))
    if len(fields["Untertitel"]) > 120:
        problems.append("der Untertitel ist zu lang (höchstens 120 Zeichen)")
    kws = [str(k).strip().lower() for k in data.get("keywords") or [] if str(k).strip()]
    if len(set(kws)) < 7 or any(len(k) > 50 for k in kws):
        problems.append("es braucht 7 verschiedene Schlüsselwörter mit je höchstens 50 Zeichen")
    return problems


def keyword_ok(book: dict, k: str) -> bool:
    wrong = AUDIENCE_WRONG.get(book.get("audience", ""))
    return bool(k) and len(k) <= 50 and not BAD_CLAIMS.search(k) and not (wrong and wrong.search(k)) and \
        not unknown_words([k], lang_of(book), ["Sudoku", "Sudokus"])


def listing(book: dict) -> None:
    """Title, subtitle, description, seven keywords, three categories, age —
    from the local brain when it is there (an editor's eye), else from the
    idea's own words."""
    idea = book["idea"]
    facts = {"kind": book["kind"], "title": book["title"], "subtitle": book.get("subtitle", ""),
             "audience": book["audience"], "pages": book["pages"], "language": lang_of(book)}
    if book["kind"] == "puzzle":
        facts["contents"] = {k: sum(1 for it in book["items"] if it["kind"] == k) for k in ("sudoku", "wordsearch", "maze")}
        facts["large_print"] = bool(idea.get("large"))
    if book["kind"] == "coloring":
        facts["contents"] = f"{book['count']} mandalas, single-sided, style {idea.get('style')}"
    if book["kind"] == "picture":
        facts["story"] = [b.get("text") for b in book["story"]["beats"]]
        facts["message"] = book["plan"].get("message")
    facts["print"] = PRINT_FACTS[book["kind"]]
    facts["audience"] = AUDIENCE_WORDS.get(book["audience"], book["audience"])
    data = None
    if brain_ready(wait=120):
        try:
            data = chat_json("Du bist Expertin für Amazon-KDP-Buchlistings im deutschsprachigen Markt. Du schreibst "
                             "ehrlich, konkret und verkaufsstark — keine Superlative ohne Beleg, keine Wörter wie "
                             "'Bestseller', 'kostenlos', 'Kindle', keine Marken oder Namen anderer Autoren. NUR JSON.",
                             f"""Buch: {json.dumps(facts, ensure_ascii=False)}

Regeln (KDP prüft sie): Titel und Untertitel sind natürliche Sätze, KEINE Aufzählung von Suchwörtern;
korrekte Grammatik ("für Kinder ab 3 Jahren"). Die 7 Schlüsselwörter sind sieben verschiedene, natürliche
Suchphrasen, die Käufer wirklich tippen — ohne Wörter aus dem Titel zu wiederholen.
Sprache aller Texte: {"Deutsch" if lang_of(book) == "de" else "Englisch"}.

JSON:
{{"title": "der Titel (darf den bisherigen verbessern, max. 8 Wörter)",
 "subtitle": "ein kurzer, natürlicher Untertitel, max. 90 Zeichen",
 "description": "Beschreibung für die Produktseite, 900–1600 Zeichen, mit <b>, <br>, <ul><li> (KDP erlaubt einfaches HTML): wer es lieben wird, was drin ist, warum es gut ist",
 "back": "Klappentext für die Rückseite, 300–450 Zeichen, ohne HTML",
 "keywords": ["7 Suchbegriffe, je max. 50 Zeichen, Wörter des Titels nicht wiederholen"],
 "categories": ["3 passende Amazon.de-Buchkategorien als Pfad, z. B. 'Bücher › Kinderbücher › Tiere'"],
 "age": "Altersangabe z. B. '3–6' oder '' für Erwachsene"}}""", effort="medium", max_tokens=2500)
        except (RuntimeError, InterruptedError) as exc:
            if isinstance(exc, InterruptedError):
                raise
            data = None
    # the editor: once always, twice when the machine still finds something
    rounds = 0
    while isinstance(data, dict) and rounds < 2:
        problems = listing_checks(book, data)
        if rounds >= 1 and not problems:
            break
        try:
            fixed = chat_json(LISTING_EDITOR, f"""Fakten über das Buch (nur das ist wahr): {json.dumps(facts, ensure_ascii=False)}
Das Listing: {json.dumps(data, ensure_ascii=False)}
Die Maschine hat gefunden: {json.dumps(problems, ensure_ascii=False)}

Prüfe jedes Feld Wort für Wort und gib das VOLLSTÄNDIGE, korrigierte Listing zurück — dieselben Felder (title,
subtitle, description, back, keywords (genau 7), categories, age). Was stimmt, bleibt wie es ist.""",
                              effort="high", max_tokens=3000)
        except (RuntimeError, InterruptedError) as exc:
            if isinstance(exc, InterruptedError):
                raise
            break
        if isinstance(fixed, dict) and fixed.get("title") and fixed.get("description"):
            data = fixed
        rounds += 1
        note(book, f"listing editor round {rounds}: {len(problems)} finding(s) before")
    book["listing_by"] = "brain" if isinstance(data, dict) else "template"
    fallback = default_listing(book) if book["kind"] != "picture" else None
    if not isinstance(data, dict):
        data = fallback or {"title": book["title"], "subtitle": book.get("subtitle", ""), "description": "",
                            "back": book.get("subtitle", ""), "keywords": [], "categories": [], "age": "3–6"}
    # seven distinct keywords, always (KDP has seven boxes; fewer wastes reach) — none that a check refuses
    kws = []
    for k in [str(k).strip() for k in (data.get("keywords") or [])] + (fallback or {}).get("keywords", []) + \
            picture_keywords(book):
        if keyword_ok(book, k) and k.lower() not in {x.lower() for x in kws}:
            kws.append(k)
    data["keywords"] = kws[:7]
    # what the editor left: the hand-written words of the idea stand in
    left = listing_checks(book, data, strict=False)
    if left and fallback:
        for field, label in (("title", "Titel"), ("subtitle", "Untertitel"), ("description", "Beschreibung"),
                             ("back", "Rückseite")):
            if any(pr.startswith(label + ":") for pr in left) or \
                    (field in ("title", "subtitle") and any(pr.startswith("Diese Wörter") for pr in left)):
                data[field] = fallback[field]
                note(book, f"listing: {label} from the template ({[pr for pr in left if pr.startswith(label)][:1]})")
    if left and not fallback:
        for field in ("description", "back"):
            data[field] = " ".join(sent for sent in re.split(r"(?<=[.!?])\s+", str(data.get(field) or ""))
                                   if not BAD_CLAIMS.search(strip_html(sent)))
    book["listing_checks"] = listing_checks(book, data, strict=False)
    data["categories"] = [str(c) for c in (data.get("categories") or [])][:3]
    if data.get("title"):
        book["title"] = str(data["title"]).strip()
    if data.get("subtitle"):
        book["subtitle"] = str(data["subtitle"]).strip()[:200]
    book["listing"] = data
    market = config().get("market", "EUR")
    book["price"] = {cur: suggest_price(book["pages"], book["ink"], cur) for cur in ("EUR", "USD")}
    book["price"]["market"] = market
    write_listing_txt(book)
    note(book, f"listing ({book['listing_by']}): {book['title']} · {money(book['price']['EUR']['price'], 'EUR')} → "
               f"~{money(book['price']['EUR']['royalty'], 'EUR')} per copy")


def picture_keywords(book: dict) -> list:
    if book["kind"] != "picture":
        return []
    hero = str((book.get("plan") or {}).get("hero", {}).get("species") or "Tiere")
    return ["Bilderbuch ab 3 Jahren", "Vorlesebuch für Kinder", "Gute-Nacht-Geschichte", f"Kinderbuch {hero}"[:50],
            "Geschenk für Kinder", "Bilderbuch Gefühle", "Kita Vorlesen"]


def default_listing(book: dict) -> dict:
    idea = book["idea"]
    if book["kind"] == "coloring":
        n = book.get("count", 50)
        desc = (f"<b>{idea.get('title') or book['title']}</b><br><br>{n} Mandalas zum Ausmalen – jedes auf einer "
                "eigenen Seite; die Rückseiten bleiben frei, so stört nichts, was durchscheint.<br><br>"
                "<ul><li>großes Format 21,6 × 27,9 cm</li>"
                "<li>klare, saubere Linien</li><li>vom einfachen bis zum detailreichen Muster</li>"
                "<li>ideal zum Entspannen und als Geschenk</li></ul>")
        kws = {"kids": ["Ausmalbuch Kinder ab 6", "Malbuch für Mädchen und Jungen", "Kinder Beschäftigung Ferien",
                        "dicke Linien malen", "Geschenk Einschulung", "Konzentration Kinder", "kreativ ab 5 Jahren"],
               "seniors": ["Ausmalbuch Senioren", "Beschäftigung für Senioren", "Demenz Beschäftigung malen",
                           "große Flächen Ausmalbilder", "Geschenk Oma Opa", "Malen zur Entspannung", "Seniorenheim Ideen"]
               }.get(book["audience"], ["Ausmalbuch für Frauen", "Malbuch zum Entspannen", "Achtsamkeit und Meditation",
                                        "Geschenk Geburtstag Freundin", "Kreativ entspannen Stressabbau",
                                        "Ausmalbilder anspruchsvoll", "Anti Stress Malbuch"])
        cats = ["Bücher › Freizeit, Haus & Garten › Malbücher für Erwachsene",
                "Bücher › Kunst & Kultur › Malerei", "Bücher › Ratgeber › Entspannung & Meditation"]
    else:
        mix_ = idea.get("mix", {})
        parts = ", ".join(f"{n} {PUZZLE_NAMES[k][0]}" for k, n in mix_.items())
        desc = (f"<b>{book['title']}</b><br><br>{parts} – mit allen Lösungen am Ende des Buches.<br><br><ul>"
                + ("<li>große, gut lesbare Schrift</li>" if idea.get("large") else "")
                + "<li>Format 21,6 × 27,9 cm</li><li>vom leichten Einstieg bis zur kniffligen Aufgabe</li>"
                  "<li>ein schönes Geschenk</li></ul>")
        kws = ["Rätselbuch Erwachsene", "Sudoku leicht mittel schwer", "Suchsel Großdruck", "Gedächtnistraining",
               "Geschenk für Oma und Opa", "Labyrinth Rätsel", "Rätsel mit Lösungen"]
        cats = ["Bücher › Freizeit, Haus & Garten › Rätsel & Spiele › Sudoku",
                "Bücher › Freizeit, Haus & Garten › Rätsel & Spiele › Kreuzworträtsel",
                "Bücher › Freizeit, Haus & Garten › Rätsel & Spiele"]
    return {"title": idea.get("title") or book["title"], "subtitle": idea.get("subtitle") or book.get("subtitle", ""),
            "description": desc,
            "back": coloring_back(book) if book["kind"] == "coloring" else puzzle_back(book), "keywords": kws, "categories": cats,
            "age": "" if book["audience"] != "kids" else "6–10"}


def write_listing_txt(book: dict) -> None:
    L = book["listing"]
    price = book["price"]
    lines = [f"TITEL\n{book['title']}\n", f"UNTERTITEL\n{book.get('subtitle', '')}\n", f"AUTOR\n{book['author']}\n",
             f"BESCHREIBUNG (HTML)\n{L.get('description', '')}\n",
             "SCHLÜSSELWÖRTER\n" + "\n".join(f"{i + 1}. {k}" for i, k in enumerate(L.get("keywords", []))) + "\n",
             "KATEGORIEN (in KDP auswählen)\n" + "\n".join(L.get("categories", [])) + "\n",
             f"ALTER\n{L.get('age') or '–'}\n",
             f"DRUCK\n{trim_words(book)} · "
             f"{'Premium-Farbe, weißes Papier, Anschnitt (Bleed)' if book['ink'] == 'premium' else 'Schwarzweiß, weißes Papier, ohne Anschnitt'}"
             f" · {book['pages']} Seiten · Cover matt\n",
             f"PREIS (Vorschlag)\namazon.de: {money(price['EUR']['price'], 'EUR')} → Druck {money(price['EUR']['printing'], 'EUR')}, "
             f"Tantieme ~{money(price['EUR']['royalty'], 'EUR')} je Buch ({price['EUR']['rate']})\n"
             f"amazon.com: {money(price['USD']['price'], 'USD')} → printing {money(price['USD']['printing'], 'USD')}, "
             f"royalty ~{money(price['USD']['royalty'], 'USD')}\n",
             "KI-ANGABEN (KDP fragt danach)\n" + ai_disclosure(book) + "\n"]
    with open(book_path(book, "listing.txt"), "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines))


def ai_disclosure(book: dict) -> str:
    """What KDP's three questions (text, images, translation) get as an
    answer — honestly, by what really made the book."""
    if book["kind"] == "picture":
        return ("Text: KI-generiert — Ja (lokales Sprachmodell; von dir gelesen und freigegeben).\n"
                "Bilder: KI-generiert — Ja (Z-Image-Turbo).\nÜbersetzung: Nein.")
    if book.get("listing_by") == "brain":
        return ("Text: Die Seiten enthalten keinen KI-Text; Titel und Beschreibung hat eine KI vorgeschlagen — "
                "fragt KDP nach KI-generiertem Text, im Zweifel Ja angeben.\n"
                "Bilder: Nein — die Muster/Rätsel berechnet ein Programm, kein KI-Bildmodell.\nÜbersetzung: Nein.")
    return ("Text: Nein (Vorlagen).\nBilder: Nein — die Muster/Rätsel berechnet ein Programm, kein KI-Bildmodell.\n"
            "Übersetzung: Nein.")


def money(value: float, currency: str) -> str:
    return f"{value:.2f} €".replace(".", ",") if currency == "EUR" else f"${value:.2f}"


def trim_words(book: dict) -> str:
    w, h = book["trim"]
    cm = f"{w * 2.54:.1f} × {h * 2.54:.1f} cm".replace(".", ",")
    return f"{w:g} × {h:g} in ({cm})".replace(".", ",") if lang_of(book) == "de" else f"{w:g} × {h:g} in"


# ─────────────────────────────────────────────────────────────── review page
CHECKLIST = """# {title} — auf KDP hochladen

Dauer: etwa 10 Minuten. Alles, was du eintragen musst, steht in `listing.txt` (und auf der Prüfseite
`review.html` mit Kopier-Knöpfen).

## 0. Vorher: ansehen
- [ ] `review.html` öffnen und jede Seite ansehen. Passt alles? Sonst: „Velly, mach Seite N neu“ oder
      `velvet-books redo {id} --page N`.
- [ ] Bei Bilderbüchern: den ganzen Text einmal laut lesen.

## 1. kdp.amazon.com → „+ Erstellen“ → „Taschenbuch“
- [ ] Sprache: {lang} · Titel und Untertitel aus `listing.txt`
- [ ] Autor: {author}  (dein Pseudonym; in Velvet: VELLY → BOOK STUDIO → AUTHOR NAME)
- [ ] Beschreibung: den HTML-Block einfügen
- [ ] Veröffentlichungsrechte: „Ich besitze das Urheberrecht …“
- [ ] Die 7 Schlüsselwörter, die 3 Kategorien{age}
- [ ] Inhalte für Erwachsene: Nein

## 2. Inhalt
- [ ] ISBN: „Kostenlose KDP-ISBN zuweisen“
- [ ] Druckoptionen: {print}
- [ ] Manuskript: `interior.pdf` hochladen
- [ ] Buchcover: „Ein bereits vorhandenes Cover hochladen“ → `cover.pdf` (Maße {cover})
- [ ] KI-Inhalte: so beantworten, wie es in `listing.txt` unter KI-ANGABEN steht ({ai})
- [ ] Im Vorschauprogramm jede Seite durchblättern, Warnungen lesen

## 3. Preis
- [ ] Gebiete: alle · Hauptmarktplatz: amazon.de
- [ ] Preis: {price} (KDP rechnet dir die Tantieme aus — prüf sie dort, die Zahlen hier sind vom {checked})
- [ ] „Erweiterter Vertrieb“: aus (er senkt die Tantieme auf 40 %)

## 4. Veröffentlichen
- [ ] „Ihr Taschenbuch veröffentlichen“ — die Prüfung dauert bis zu 72 Stunden.
- [ ] Danach Velly sagen: „Buch {id} ist online“ (oder `velvet-books uploaded {id}`), dann macht sie das nächste.

Ehrlich: Ein Buch auf KDP verkauft sich nicht von allein. Was hilft: ein klarer Nutzen im Titel, ein Cover,
das in Briefmarkengröße wirkt, eine Nische mit Nachfrage — und Geduld. KDP nimmt höchstens drei neue
Titel pro Tag an.
"""


def review(book: dict) -> None:
    pages = preview_pdf(book_path(book, "interior.pdf"), book_path(book, ".preview"), dpi=36)
    rel = [os.path.relpath(p, book["dir"]) for p in pages]
    L = book["listing"]
    price = book["price"]["EUR"]
    g = book.get("cover", {})
    fields = [("Titel", book["title"]), ("Untertitel", book.get("subtitle", "")), ("Autor", book["author"]),
              ("Beschreibung (HTML)", L.get("description", ""))] + \
             [(f"Schlüsselwort {i + 1}", k) for i, k in enumerate(L.get("keywords", []))] + \
             [(f"Kategorie {i + 1}", c) for i, c in enumerate(L.get("categories", []))]
    rows = "\n".join(f'<div class="f"><div class="k">{html.escape(k)}</div><pre id="f{i}">{html.escape(v)}</pre>'
                     f'<button onclick="cp(\'f{i}\', this)">Kopieren</button></div>' for i, (k, v) in enumerate(fields))
    thumbs = "\n".join(f'<figure><img src="{html.escape(p)}" loading="lazy"><figcaption>{i + 1}</figcaption></figure>'
                       for i, p in enumerate(rel))
    page = f"""<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>{html.escape(book['title'])} · Prüfen</title><style>
:root{{color-scheme:light dark;--bg:#f6f4ef;--ink:#1c1b20;--soft:#6b6872;--card:#fff;--line:#ddd8cf;--acc:#6b4fd6}}
