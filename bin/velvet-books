    note(book, "review.html and CHECKLIST.md written")


# ──────────────────────────────────────────────────────────────── the worker
def run_step(book: dict, step: str) -> None:
    kind = book["kind"]
    if step == "plan":
        {"coloring": coloring_plan, "puzzle": puzzle_plan, "picture": picture_plan}[kind](book)
    elif step == "puzzles":
        puzzle_make(book)
    elif step == "story":
        picture_story(book)
    elif step == "edit":
        picture_edit(book)
    elif step == "art":
        picture_art(book)
    elif step == "interior":
        {"coloring": coloring_interior, "puzzle": puzzle_interior, "picture": picture_interior}[kind](book)
    elif step == "cover":
        {"coloring": coloring_cover, "puzzle": puzzle_cover, "picture": picture_cover}[kind](book)
        # the real page count is known now: the price and listing.txt follow it
        book["price"] = {cur: suggest_price(book["pages"], book["ink"], cur) for cur in ("EUR", "USD")}
        book["price"]["market"] = config().get("market", "EUR")
        write_listing_txt(book)
    elif step == "listing":
        listing(book)
    elif step == "review":
        review(book)
    else:
        raise ValueError(f"unknown step {step}")


def advance(book: dict) -> bool:
    """One step of one book. True when it moved."""
    steps = STEPS[book["kind"]]
    todo = [s for s in steps if s not in book.get("done", [])]
    if not todo:
        book["state"] = "ready"
        save_book(book)
        return False
    step = todo[0]
    book["step"] = step
    book["state"] = "working"
    book["error"] = ""
    save_book(book)
    say_state(book=book["id"], title=book.get("title", ""), doing=step)
    began = time.monotonic()
    try:
        run_step(book, step)
    except InterruptedError:
        note(book, f"{step}: stopped — goes on next time")
        save_book(book)
        raise
    except Exception as exc:                                         # noqa: BLE001
        book["error"] = f"{step}: {exc}"[:300]
        if book.get("state") != "waiting-engine":
            book["state"] = "failed" if book.get("fails", 0) >= 2 else "working"
        book["fails"] = int(book.get("fails") or 0) + 1
        note(book, f"{step} failed: {exc}")
        save_book(book)
        return False
    book.setdefault("done", []).append(step)
    book["fails"] = 0
    note(book, f"{step} done in {time.monotonic() - began:.0f} s")
    if len(book["done"]) == len(steps):
        book["state"] = "ready"
        note(book, "READY — waiting for your look and the upload")
    save_book(book)
    return True


def open_books() -> list:
    out = []
    for row in load_index()["books"]:
        if row.get("state") in ("working", "waiting-engine"):
            try:
                out.append(load_book(row["id"]))
            except KeyError:
                continue
    return out


def work(minutes: float = 0, only: str = "", until_done: bool = False) -> int:
    """Steps of the open books until the time is up, the studio is told to
    stop, a game starts — or there is nothing left that may be done."""
    lock = open(os.path.join(CONF_DIR, "books.lock"), "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("another studio run is already working")
        return 0
    end = time.monotonic() + minutes * 60 if minutes else None
    moved = 0
    try:
        while not stopping():
            if end and time.monotonic() > end:
                break
            if gpu_game():
                log("a game is running — the studio waits")
                return 75
            books = [b for b in open_books() if not only or b["id"] == only.zfill(3)]
            books = [b for b in books if b.get("state") != "waiting-engine" or engine_status()["ok"]]
            if not books:
                if only or waiting_count() >= int(config().get("maxWaiting") or 3):
                    break
                if until_done and moved:
                    break
                new_book()
                continue
            book = books[0]
            if advance(book):
                moved += 1
            elif book.get("error") and book.get("state") in ("failed", "working") and int(book.get("fails") or 0) >= 3:
                book["state"] = "failed"
                save_book(book)
            if until_done and load_book(book["id"]).get("state") == "ready":
                break
    except InterruptedError:
        pass
    finally:
        say_state(doing="", book="")
    return 0


# ────────────────────────────────────────────────────────────────── the CLI
def status() -> dict:
    ix = load_index()
    books = ix["books"]
    return {"studio": studio_dir(), "books": books, "ready": [b for b in books if b.get("state") == "ready"],
            "working": [b for b in books if b.get("state") == "working"],
            "uploaded": [b for b in books if b.get("state") == "uploaded"],
            "failed": [b for b in books if b.get("state") == "failed"],
            "engine": engine_status(), "brain": brain_health(0.4) or os.path.isfile(os.path.join(DATA_DIR, "models", "brain.gguf")),
            "now": read_json(STATE_PATH, {}), "maxWaiting": int(config().get("maxWaiting") or 3)}


def show(bid: str) -> dict:
    b = load_book(bid)
    return {k: b.get(k) for k in ("id", "kind", "title", "subtitle", "author", "state", "step", "done", "error",
                                  "pages", "dir", "price", "listing", "log")}


def redo(bid: str, what: str, page: int = 0) -> int:
    book = load_book(bid)
    if what == "page" and book["kind"] == "picture":
        for name in (f"page-{page:02d}",):
            for p in glob.glob(book_path(book, os.path.join("art", f"{name}*"))):
                os.unlink(p)
            (book.get("art") or {}).pop(name, None)
        drop = ["art", "interior", "cover", "review"]
    elif what == "cover":
        if book["kind"] == "picture":
            for p in glob.glob(book_path(book, os.path.join("art", "cover*"))):
                os.unlink(p)
            (book.get("art") or {}).pop("cover", None)
            drop = ["art", "cover", "review"]
        else:
            drop = ["cover", "review"]
    elif what == "listing":
        drop = ["listing", "interior", "cover", "review"]
    else:
        drop = list(STEPS[book["kind"]])[1:]
        book["seed"] = random.randrange(1, 2 ** 31)
    book["done"] = [s for s in book.get("done", []) if s not in drop]
    book["state"] = "working"
    book["error"] = ""
    note(book, f"redo {what}{' ' + str(page) if page else ''}")
    save_book(book)
    return 0


def selftest() -> int:
    fails = []
    if spine_width(32, "premium") != 32 * 0.002347 or abs(spine_width(106, "black") - 0.238712) > 1e-6:
        fails.append("spine")
    if print_cost(32, "premium", "EUR") != 3.61 or print_cost(106, "black", "EUR") != 2.48 or \
            print_cost(130, "black", "EUR") != round(0.75 + 130 * 0.016, 2) or print_cost(32, "premium", "USD") != 4.20:
        fails.append("printing cost")
    if royalty(9.99, 106, "black", "EUR") != round(0.6 * 9.99 - 2.48, 2) or royalty(8.99, 106, "black", "EUR") != round(0.5 * 8.99 - 2.48, 2):
        fails.append("royalty")
    p = suggest_price(32, "premium", "EUR")
    if p["price"] < 9.99 or p["royalty"] < 3.0 or abs(p["price"] * 100 % 100 - 99) > 0.5:
        fails.append(f"price {p}")
    if gutter_for(100) != 0.375 or gutter_for(200) != 0.5:
        fails.append("gutter")
    s = sudoku_make(7, "leicht")
    if sudoku_solutions(list(s["puzzle"])) != 1 or not singles_solve(s["puzzle"]) or s["givens"] < 34:
        fails.append("sudoku leicht")
    h = sudoku_make(9, "schwer")
    if sudoku_solutions(list(h["puzzle"])) != 1 or h["givens"] > 32:
        fails.append("sudoku schwer")
    if any(h["solution"][i] != v for i, v in enumerate(h["puzzle"]) if v):
        fails.append("sudoku: the solution must agree with the givens")
    ws = wordsearch_make(3, WORDS_DE["Tiere im Wald"].split(), 15, False)
    for pl in ws["words"]:
        got = "".join(ws["grid"][pl["r"] + pl["dr"] * i][pl["c"] + pl["dc"] * i] for i in range(len(pl["word"])))
        if got != pl["word"]:
            fails.append(f"wordsearch {pl['word']} → {got}")
    if len(ws["words"]) < 14:
        fails.append(f"wordsearch placed only {len(ws['words'])}")
    mz = maze_make(5, 12, 15)
    if mz["path"][0] != 0 or mz["path"][-1] != 12 * 15 - 1:
        fails.append("maze has no way through")
    if ws_word("Fuß-Ball") != "FUSSBALL":
        fails.append("word folding")
    if first_json('Sure! ```json\n{"a": [1, {"b": "}"}]}\n```') != {"a": [1, {"b": "}"}]}:
        fails.append("json extraction")
    if language_of("Flick the little red fox cub curls on a mossy log. The night is quiet.") != "en" or \
            language_of("Der kleine Fuchs rollt sich auf dem moosigen Baumstamm zusammen. Die Nacht ist still.") != "de":
        fails.append("language of a sentence")
    english = [{"text": "Flick the little fox is not scary. He says hello to the night and the stars.", "scene": "x"}] * 14
    if not any("Deutsch" in pr for pr in story_checks({"lang": "de", "plan": {"hero": {"name": "Flick"}}}, english)):
        fails.append("an English story in a German book must not pass")
    if [p for p in story_checks({"lang": "de", "plan": {"hero": {"name": "Flick"}}},
                                [{"text": "Flick sitzt auf dem Moos und schaut in die Nacht. Die Sterne sind schön.",
                                  "scene": "x"}] * 14) if "Deutsch" in p]:
        fails.append("a German story flagged as foreign")
    if fails:
        print("velvet-books selftest: FAILED\n  · " + "\n  · ".join(fails))
        return 1
    print("velvet-books selftest: ok")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    cmd, rest = argv[0], argv[1:]

    def opt(name, default=""):
        return rest[rest.index(name) + 1] if name in rest and rest.index(name) + 1 < len(rest) else default

    if cmd == "--selftest":
        return selftest()
    if cmd == "status":
        print(json.dumps(status(), ensure_ascii=False, indent=1))
        return 0
    if cmd == "new":
        kind = rest[0] if rest and not rest[0].startswith("--") else ""
        book = new_book(kind, opt("--idea"), opt("--lang"), opt("--audience"))
        print(json.dumps({"ok": True, "id": book["id"], "kind": book["kind"], "dir": book["dir"]}, ensure_ascii=False))
        return 0
    if cmd == "work":
        os.nice(5)
        return work(float(opt("--minutes", "0") or 0), opt("--book"), "--until-done" in rest)
    if cmd == "shelf":
        os.makedirs(studio_dir(), exist_ok=True)
        subprocess.Popen(["xdg-open", studio_dir()], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return 0
    if cmd == "list":
        for b in load_index()["books"]:
            print(f"{b['id']}  {b['state']:<14} {b['kind']:<9} {b.get('title') or '…'}")
        return 0
    if cmd == "show":
        print(json.dumps(show(rest[0]), ensure_ascii=False, indent=1))
        return 0
    if cmd == "open":
        b = load_book(rest[0])
        target = book_path(b, "review.html")
        subprocess.Popen(["xdg-open", target if os.path.isfile(target) else b["dir"]], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    if cmd == "redo":
        what = "page" if "--page" in rest else "cover" if "--cover" in rest else "listing" if "--listing" in rest else "all"
        return redo(rest[0], what, int(opt("--page", "0") or 0))
    if cmd == "uploaded":
        b = load_book(rest[0])
        b["state"] = "uploaded"
        b["uploaded"] = datetime.date.today().isoformat()
        if opt("--asin"):
            b["asin"] = opt("--asin")
        note(b, "uploaded to KDP")
        save_book(b)
        print(json.dumps({"ok": True, "id": b["id"], "title": b["title"]}, ensure_ascii=False))
        return 0
    if cmd == "engine":
        if rest[:1] == ["setup"]:
            return engine_setup()
        st = engine_status()
        st["download"] = [{"file": "stable-diffusion.cpp (Vulkan)", "mb": ENGINE["zip_mb"], "url": ENGINE["zip"]}] + \
                         [{"file": f["name"], "mb": f["mb"], "url": f["url"]} for f in ENGINE["files"]]
        print(json.dumps(st, ensure_ascii=False, indent=1))
        return 0
    print(f"velvet-books: unknown command {cmd!r} — see --help", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
