GERMAN_FILL = "EEEEEEENNNNNIIIIISSSSRRRRAAAAATTTTDDDHHHUUULLLCCGGMMOOBBWWFFKZPVÜÄÖJY"


def ws_word(w: str) -> str:
    return w.upper().replace("ß", "SS").replace("-", "").replace(" ", "")


def wordsearch_make(seed: int, words: list, size: int, hard: bool) -> dict:
    rng = random.Random(seed)
    dirs = [(0, 1), (1, 0), (1, 1)] + ([(0, -1), (-1, 0), (-1, -1), (1, -1), (-1, 1)] if hard else [(-1, 1)])
    grid = [["" for _ in range(size)] for _ in range(size)]
    placed = []
    for word in sorted({ws_word(w) for w in words if 3 <= len(ws_word(w)) <= size}, key=len, reverse=True):
        for _try in range(300):
            dr, dc = rng.choice(dirs)
            r0 = rng.randrange(size)
            c0 = rng.randrange(size)
            r1, c1 = r0 + dr * (len(word) - 1), c0 + dc * (len(word) - 1)
            if not (0 <= r1 < size and 0 <= c1 < size):
                continue
            if all(grid[r0 + dr * i][c0 + dc * i] in ("", ch) for i, ch in enumerate(word)):
                for i, ch in enumerate(word):
                    grid[r0 + dr * i][c0 + dc * i] = ch
                placed.append({"word": word, "r": r0, "c": c0, "dr": dr, "dc": dc})
                break
    for r in range(size):
        for c in range(size):
            if not grid[r][c]:
                grid[r][c] = rng.choice(GERMAN_FILL)
    placed.sort(key=lambda p: p["word"])
    return {"size": size, "grid": ["".join(row) for row in grid], "words": placed}


# ───────────────────────────────────────────────────────────────────── mazes
def maze_make(seed: int, cols: int, rows: int) -> dict:
    """A perfect maze (one way between any two cells), recursive backtracker;
    walls as bits per cell: 1 north, 2 east, 4 south, 8 west."""
    rng = random.Random(seed)
    cells = [15] * (cols * rows)
    seen = [False] * (cols * rows)
    stack = [0]
    seen[0] = True
    moves = [(0, -1, 1, 4), (1, 0, 2, 8), (0, 1, 4, 1), (-1, 0, 8, 2)]
    while stack:
        cur = stack[-1]
        x, y = cur % cols, cur // cols
        options = [(x + dx, y + dy, a, b) for dx, dy, a, b in moves
                   if 0 <= x + dx < cols and 0 <= y + dy < rows and not seen[(y + dy) * cols + x + dx]]
        if not options:
            stack.pop()
            continue
        nx, ny, a, b = rng.choice(options)
        nxt = ny * cols + nx
        cells[cur] &= ~a
        cells[nxt] &= ~b
        seen[nxt] = True
        stack.append(nxt)
    # the way through: breadth-first from the entrance (top left) to the exit (bottom right)
    prev = {0: None}
    queue = [0]
    while queue:
        cur = queue.pop(0)
        if cur == cols * rows - 1:
            break
        x, y = cur % cols, cur // cols
        for dx, dy, a, _b in moves:
            nx, ny = x + dx, y + dy
            if 0 <= nx < cols and 0 <= ny < rows and not cells[cur] & a and ny * cols + nx not in prev:
                prev[ny * cols + nx] = cur
                queue.append(ny * cols + nx)
    path, cur = [], cols * rows - 1
    while cur is not None:
        path.append(cur)
        cur = prev.get(cur)
    return {"cols": cols, "rows": rows, "cells": cells, "path": path[::-1]}


# ──────────────────────────────────────────────────────────── the local brain
#  The night writes with the LOCAL brain only: free, private, nothing leaves
#  the PC (a cloud key would cost money while you sleep). velvet-local starts
#  the server; the touch file keeps it up while she writes.
def touch_night() -> None:
    try:
        os.makedirs(CONF_DIR, exist_ok=True)
        with open(NIGHT_TOUCH, "a", encoding="utf-8"):
            pass
        os.utime(NIGHT_TOUCH, None)
    except OSError:
        pass


def brain_health(timeout: float = 1.0) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{LOCAL_PORT}/health", timeout=timeout) as resp:
            return resp.status == 200
    except Exception:                                              # noqa: BLE001
        return False


def brain_ready(wait: float = 240.0) -> bool:
    if brain_health():
        return True
    if os.environ.get("VELVET_BOOKS_NO_BRAIN") or not os.path.isfile(os.path.join(DATA_DIR, "models", "brain.gguf")):
        return False
    local = os.path.join(BIN, "velvet-local")
    if not os.path.isfile(local):
        return False
    touch_night()
    try:
        subprocess.Popen([sys.executable, local, "serve", "--idle", "300"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return False
    end = time.monotonic() + wait
    while time.monotonic() < end and not stopping():
        if brain_health():
            return True
        time.sleep(1.0)
    return False


def brain_family() -> str:
    running = str(read_json(os.path.join(CONF_DIR, "ai-local.json"), {}).get("model") or "")
    if not running:
        try:
            running = os.path.basename(os.path.realpath(os.path.join(DATA_DIR, "models", "brain.gguf")))
        except OSError:
            running = ""
    return "gpt-oss" if "oss" in running.lower() else "qwen"


def chat(messages: list, effort: str = "high", max_tokens: int = 4000, temperature: float = 0.7) -> str:
    """One answer from the local brain (no tools, no streaming)."""
    if not brain_ready():
        raise RuntimeError("the local brain is not there (Velly → SETUP)")
    touch_night()
    payload = {"model": "velvet", "messages": messages, "stream": False, "temperature": temperature,
               "max_tokens": int(max_tokens) + ({"high": 6000, "medium": 2500}.get(effort, 800)
                                                if brain_family() == "gpt-oss" else 0)}
    if brain_family() == "gpt-oss":
        payload["chat_template_kwargs"] = {"reasoning_effort": effort}
        payload.update({"top_p": 1.0, "top_k": 0, "min_p": 0.0})
    else:
        payload.update({"top_p": 0.9, "top_k": 40, "min_p": 0.03, "repeat_penalty": 1.05})
    req = urllib.request.Request(f"http://127.0.0.1:{LOCAL_PORT}/v1/chat/completions",
                                 data=json.dumps(payload, ensure_ascii=False).encode("utf-8"), method="POST")
    req.add_header("Content-Type", "application/json")
    # One request can think for minutes (high effort, part of the model in RAM: ~20 tokens/s
    # measured) — longer than velvet-local's idle watch: it once took the server down in the
    # middle of a listing. While she waits, the night file is touched every 30 s.
    import threading                                                # noqa: PLC0415
    waiting = threading.Event()

    def heartbeat():
        while not waiting.wait(30):
            touch_night()

    threading.Thread(target=heartbeat, daemon=True).start()
    try:
        with urllib.request.urlopen(req, timeout=1800) as resp:
            data = json.loads(resp.read().decode("utf-8", "replace") or "{}")
    except urllib.error.HTTPError as exc:
        raise RuntimeError(f"the brain said HTTP {exc.code}") from exc
    finally:
        waiting.set()
        touch_night()
    msg = ((data.get("choices") or [{}])[0].get("message") or {})
    text = str(msg.get("content") or "")
    text = re.sub(r"<think>.*?</think>", "", text, flags=re.S)
    text = re.sub(r"<\|[a-z_]+\|>(?:analysis|final|commentary)?", "", text)
    return text.strip()


def chat_json(system: str, user: str, effort: str = "high", max_tokens: int = 4000, tries: int = 3):
    """A JSON answer: the first {...} or [...] in what comes back, asked
    again (colder) when it does not parse."""
    messages = [{"role": "system", "content": system}, {"role": "user", "content": user}]
    last = ""
    for attempt in range(tries):
        if stopping():
            raise InterruptedError()
        last = chat(messages, effort, max_tokens, temperature=0.7 if attempt == 0 else 0.4)
        found = first_json(last)
        if found is not None:
            return found
        messages = messages + [{"role": "assistant", "content": last[:4000]},
                               {"role": "user", "content": "Das war kein gültiges JSON. Antworte NUR mit dem JSON, "
                                                           "ohne Text davor oder danach."}]
    raise RuntimeError(f"the brain gave no JSON: {last[:160]!r}")


def first_json(text: str):
    t = str(text or "")
    t = re.sub(r"^```(?:json)?\s*|\s*```$", "", t.strip())
    for open_ch, close_ch in (("{", "}"), ("[", "]")):
        start = t.find(open_ch)
        while start >= 0:
            depth, in_str, esc = 0, False, False
            for i in range(start, len(t)):
                ch = t[i]
                if in_str:
                    if esc:
                        esc = False
                    elif ch == "\\":
                        esc = True
                    elif ch == '"':
                        in_str = False
                elif ch == '"':
                    in_str = True
                elif ch == open_ch:
                    depth += 1
                elif ch == close_ch:
                    depth -= 1
                    if depth == 0:
                        try:
                            return json.loads(t[start:i + 1])
                        except ValueError:
                            break
            start = t.find(open_ch, start + 1)
    return None


# ──────────────────────────────────────────────────────────── the picture engine
#  stable-diffusion.cpp (Vulkan) + Z-Image-Turbo (Apache-2.0 — the pictures
#  may be sold), the FLUX VAE, and as text encoder the Qwen3-4B brain that is
#  already on disk for Velly (brain-4b.gguf). Nothing of it downloads by
#  itself: `velvet-books engine setup` is started by the user.
ENGINE = {
    "release": "master-959-d637cfb",
    "zip": "https://github.com/leejet/stable-diffusion.cpp/releases/download/master-959-d637cfb/"
           "sd-master-d637cfb-bin-Linux-Ubuntu-24.04-x86_64-vulkan.zip",
    "zip_mb": 37,
    "files": [
        {"name": "z_image_turbo-Q8_0.gguf", "mb": 6577,
         "url": "https://huggingface.co/leejet/Z-Image-Turbo-GGUF/resolve/main/z_image_turbo-Q8_0.gguf",
         "sha256": "df1c5baa86d1398c979495a6072dbcee79444fdb884a2445582ba0769c44e9a1"},
        {"name": "ae.safetensors", "mb": 335,
         "url": "https://huggingface.co/Comfy-Org/Z-Image-Turbo/resolve/main/split_files/vae/ae.safetensors",
         "sha256": "afc8e28272cd15db3919bacdb6918ce9c1ed22e96cb12c4d5ed0fba823529e38"},
    ],
    "encoder": os.path.join(DATA_DIR, "models", "brain-4b.gguf"),
    "encoder_url": "https://huggingface.co/unsloth/Qwen3-4B-Instruct-2507-GGUF/resolve/main/Qwen3-4B-Instruct-2507-Q4_K_M.gguf",
    "encoder_mb": 2497,
}


def engine_bin() -> str:
    for name in ("sd-cli", "sd"):
        hits = [p for p in glob.glob(os.path.join(ENGINE_DIR, "**", name), recursive=True)
                if os.path.isfile(p) and os.access(p, os.X_OK)]
        if hits:
            return sorted(hits)[0]
    return ""


def engine_status() -> dict:
    if os.environ.get("VELVET_BOOKS_FAKE_PAINT"):
        return {"ok": True, "binary": "fake", "models": {}, "encoder": True, "missing_mb": 0, "model": "test painter"}
    files = {f["name"]: os.path.join(IMAGE_MODELS, f["name"]) for f in ENGINE["files"]}
    have = {n: os.path.isfile(p) and os.path.getsize(p) > 1_000_000 for n, p in files.items()}
    encoder = os.path.isfile(ENGINE["encoder"])
    ok = bool(engine_bin()) and all(have.values()) and encoder
    missing_mb = (0 if engine_bin() else ENGINE["zip_mb"]) + sum(f["mb"] for f in ENGINE["files"] if not have[f["name"]]) \
        + (0 if encoder else ENGINE["encoder_mb"])
    return {"ok": ok, "binary": engine_bin(), "models": have, "encoder": encoder, "missing_mb": missing_mb,
            "model": "Z-Image-Turbo (Apache-2.0)"}


def fetch_resumable(url: str, dest: str, sha: str = "", tries: int = 12) -> bool:
    """A big file over a slow or shaky line: what is there (dest.part) is kept,
    the rest is asked for with a Range request, and a broken connection is
    tried again — for as long as it moves: only `tries` breaks in a row WITHOUT
    a single new byte give up (a 2.4 GHz Wi-Fi here broke 25 times in an hour
    while the file still grew). The whole file is checked against its SHA-256
    at the end."""
    part = dest + ".part"
    stalls = 0
    while stalls < tries:
        have = os.path.getsize(part) if os.path.isfile(part) else 0
        digest = hashlib.sha256()
        if have and sha:
            with open(part, "rb") as fh:
                for chunk in iter(lambda: fh.read(1 << 20), b""):
                    digest.update(chunk)
        req = urllib.request.Request(url)
        if have:
            req.add_header("Range", f"bytes={have}-")
        try:
            with urllib.request.urlopen(req, timeout=60) as resp:
                if have and resp.status != 206:              # the server ignored the range: from the start
                    have, digest = 0, hashlib.sha256()
                total = int(resp.headers.get("Content-Length") or 0) + have
                got, last = have, 0.0
                with open(part, "ab" if have else "wb") as out:
                    while True:
                        if stopping():                       # SIGTERM: keep what is there, go on next time
                            raise InterruptedError()
                        chunk = resp.read(1 << 20)
                        if not chunk:
                            break
                        out.write(chunk)
                        digest.update(chunk)
                        got += len(chunk)
                        if time.monotonic() - last > 2.0:
                            last = time.monotonic()
                            pct = f"{got * 100 / total:5.1f} %" if total else f"{got >> 20} MB"
                            print(f"\r  {pct} ({got >> 20} of {total >> 20} MB)", end="", flush=True)
            if total and os.path.getsize(part) < total:
                raise OSError("the connection ended early")
        except InterruptedError:
            print("\n  stopped — the next run goes on from here", flush=True)
            return False
        except Exception as exc:                                      # noqa: BLE001
            now = os.path.getsize(part) if os.path.isfile(part) else 0
            stalls = 0 if now > have else stalls + 1
            wait = 10 if stalls == 0 else min(300, 15 * stalls)
            print(f"\n  interrupted ({exc}) — again in {wait} s, from {now >> 20} MB", flush=True)
            for _ in range(wait):
                if stopping():
                    return False
                time.sleep(1)
            continue
        if sha and digest.hexdigest() != sha:
            os.unlink(part)
            print("\n  checksum wrong — the file was not kept (it starts again on the next run)")
            return False
        os.replace(part, dest)
        print("\r  done.                              ")
        return True
    return False


def engine_setup() -> int:
    """The download — only ever started by the user (a button or this
    command). Says what, from where and how big before each file, checks
    every model against its SHA-256."""
    os.makedirs(IMAGE_MODELS, exist_ok=True)
    os.makedirs(ENGINE_DIR, exist_ok=True)
    # one download at a time: two would append to the same .part
    lock = open(os.path.join(IMAGE_MODELS, ".setup.lock"), "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("The picture engine is already being downloaded (another window or the night shift).")
        return 0
    plan = []
    if not engine_bin():
        plan.append(("stable-diffusion.cpp (Vulkan)", ENGINE["zip"], os.path.join(ENGINE_DIR, "sd.zip"), ENGINE["zip_mb"], ""))
    for f in ENGINE["files"]:
        dest = os.path.join(IMAGE_MODELS, f["name"])
        if not (os.path.isfile(dest) and os.path.getsize(dest) > 1_000_000):
            plan.append((f["name"], f["url"], dest, f["mb"], f["sha256"]))
    if not os.path.isfile(ENGINE["encoder"]):
        plan.append(("Qwen3-4B (text encoder)", ENGINE["encoder_url"], ENGINE["encoder"], ENGINE["encoder_mb"], ""))
    if not plan:
        print("The picture engine is complete.")
        return 0
    print("The picture engine needs (nothing else is fetched):")
    for label, url, _dest, mb, _sha in plan:
        print(f"  · {label}: {mb / 1000:.2f} GB  ←  {url}")
    for label, url, dest, mb, sha in plan:
        print(f"\n{label} ({mb} MB) …", flush=True)
        if not fetch_resumable(url, dest, sha):
            print(f"\n  {label} did not come — run it again: it goes on where it stopped")
            return 1
        if dest.endswith("sd.zip"):
            import zipfile                                          # noqa: PLC0415
            with zipfile.ZipFile(dest) as zf:
                zf.extractall(ENGINE_DIR)
            os.unlink(dest)
            for p in glob.glob(os.path.join(ENGINE_DIR, "**", "*"), recursive=True):
                if os.path.basename(p) in ("sd-cli", "sd", "sd-server"):
                    os.chmod(p, 0o755)
    print("\nThe picture engine is ready." if engine_status()["ok"] else "\nSomething is still missing.")
    return 0 if engine_status()["ok"] else 1


def gpu_game() -> bool:
    try:
        sys.path.insert(0, BIN)
        import _gpu                                                 # noqa: PLC0415
        return bool(_gpu.game_running())
    except Exception:                                               # noqa: BLE001
        return False


def free_gpu_for_pictures() -> None:
    """The brain holds ~12 GB of the card; the painter needs it. Only when no
    Velly session is open (then she is talking to someone)."""
    session = read_json(os.path.join(CONF_DIR, "ai-session.json"), {})
    if isinstance(session, dict) and session.get("active") and float(session.get("until") or 0) > time.time() * 1000:
        return
    if brain_health(0.5):
        subprocess.run([sys.executable, os.path.join(BIN, "velvet-local"), "stop"], capture_output=True, timeout=60)


def paint(prompt: str, out: str, width: int, height: int, seed: int, steps: int = 9) -> bool:
    """One picture with the engine (PNG). Stops (and kills the painter) when
    the studio is told to stop."""
    status = engine_status()
    if not status["ok"]:
        raise RuntimeError("the picture engine is not installed")
    if status["binary"] == "fake":
        return fake_paint(prompt, out, width, height, seed)
    cmd = ["nice", "-n", "8", status["binary"],
           "--diffusion-model", os.path.join(IMAGE_MODELS, ENGINE["files"][0]["name"]),
           "--vae", os.path.join(IMAGE_MODELS, ENGINE["files"][1]["name"]),
           "--llm", ENGINE["encoder"],
           "-p", prompt, "--cfg-scale", "1.0", "--steps", str(steps), "-W", str(width), "-H", str(height),
           "-s", str(seed), "-o", out,
           # flash attention in the diffusion model: without it a 1344×1360 picture took 127 s per step on
           # the RX 9070 XT (the attention did not fit a Vulkan buffer), with it 5 s — 34 s a picture
           "--diffusion-fa"]
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, start_new_session=True)
    while proc.poll() is None:
        if stopping() or gpu_game():
            os.killpg(proc.pid, signal.SIGTERM)
            proc.wait(timeout=20)
            raise InterruptedError()
        time.sleep(0.5)
    if proc.returncode != 0 or not os.path.isfile(out):
        err = (proc.stderr.read() if proc.stderr else b"").decode("utf-8", "replace").strip().splitlines()
        raise RuntimeError(f"the painter failed: {err[-1][:160] if err else proc.returncode}")
    return True


def fake_paint(prompt: str, out: str, width: int, height: int, seed: int) -> bool:
    """Tests only (VELVET_BOOKS_FAKE_PAINT=1): a soft gradient, a few round
    shapes and the scene's words — enough to check every page and the cover."""
    from PIL import Image, ImageDraw                                # noqa: PLC0415
    rng = random.Random(seed)
    a = [rng.randrange(90, 230) for _ in range(3)]
    b = [rng.randrange(40, 200) for _ in range(3)]
    im = Image.new("RGB", (width, height))
    px = im.load()
    for y in range(height):
        t = y / max(1, height - 1)
        row = tuple(int(a[i] * (1 - t) + b[i] * t) for i in range(3))
        for x in range(width):
            px[x, y] = row
    d = ImageDraw.Draw(im)
    for _ in range(9):
        r = rng.randrange(40, 220)
        x, y = rng.randrange(width), rng.randrange(height)
        d.ellipse((x - r, y - r, x + r, y + r), fill=tuple(rng.randrange(60, 255) for _ in range(3)))
    scene = re.sub(r".*Scene: ", "", prompt)[:140]
    d.rectangle((40, height - 160, width - 40, height - 40), fill=(255, 255, 255))
    d.text((60, height - 140), scene[:70], fill=(0, 0, 0))
    d.text((60, height - 110), scene[70:140], fill=(0, 0, 0))
    im.save(out)
    return True


def to_print(src: str, dest: str, w_px: int, h_px: int) -> None:
    """A painted picture at print size (300 dpi): Lanczos up, a light
    unsharp mask, saved as a high-quality JPEG."""
    from PIL import Image, ImageFilter                              # noqa: PLC0415
    im = Image.open(src).convert("RGB")
    scale = max(w_px / im.width, h_px / im.height)
    im = im.resize((round(im.width * scale), round(im.height * scale)), Image.LANCZOS)
    left, top = (im.width - w_px) // 2, (im.height - h_px) // 2
    im = im.crop((left, top, left + w_px, top + h_px))
    im = im.filter(ImageFilter.UnsharpMask(radius=2, percent=60, threshold=2))
    im.save(dest, quality=94, subsampling=0, dpi=(DPI, DPI))


