import time
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
CONF_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "velvet")
DATA_DIR = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "velvet")
BIN = os.path.dirname(os.path.abspath(__file__))
CFG_PATH = os.path.join(CONF_DIR, "config.json")
INDEX_PATH = os.path.join(CONF_DIR, "books.json")
STATE_PATH = os.path.join(CONF_DIR, "books-state.json")       # what the studio does right now (the shell reads it)
NIGHT_TOUCH = os.path.join(CONF_DIR, "ai-night.touch")        # keeps velvet-local's server up while she writes
LOCAL_PORT = int(os.environ.get("VELLY_LOCAL_PORT") or "8137")
ENGINE_DIR = os.path.join(DATA_DIR, "engines", "sdcpp")
IMAGE_MODELS = os.path.join(DATA_DIR, "models", "image")

PT = 72.0                                                       # PDF points per inch
DPI = 300

# ── KDP's numbers (read from kdp.amazon.com help pages on 2026-10-23) ───────────
#  Large trim (> 6.12 in wide): both sizes used here. Printing cost =
#  fixed + pages × per page, by page range. Royalty 60 % from 9.99 (USD/EUR)
#  up, 50 % at 9.98 and below: royalty = rate × list price − printing cost.
KDP = {
    "checked": "2026-10-23",
    "bleed": 0.125,                       # top, bottom and outside; a bleed page is +0.125 wide, +0.25 high
    "spine": {"white": 0.002252, "cream": 0.0025, "premium": 0.002347},   # inches per page
    "spineTextMin": 80,                   # "only print spine text on books with more than 79 pages"
    "gutter": [(150, 0.375), (300, 0.5), (500, 0.625), (700, 0.75), (828, 0.875)],
    "outside": {"bleed": 0.375, "plain": 0.25},
    "pages": {"min": 24, "max": 590},
    "cost": {                             # large trim
        "USD": {"black": [(110, 2.84, 0.0), (828, 1.00, 0.017)], "premium": [(40, 4.20, 0.0), (828, 1.00, 0.08)]},
        "EUR": {"black": [(110, 2.48, 0.0), (828, 0.75, 0.016)], "premium": [(40, 3.61, 0.0), (828, 0.75, 0.0715)]},
    },
    "royalty": {"high": 0.60, "low": 0.50, "from": 9.99},
    "barcode": (2.0, 1.2),                # inches, KDP puts it in the lower right of the back cover
}

KINDS = {
    "coloring": {"trim": (8.5, 11.0), "ink": "black", "bleed": False, "label": {"de": "Malbuch", "en": "coloring book"}},
    "puzzle": {"trim": (8.5, 11.0), "ink": "black", "bleed": False, "label": {"de": "Rätselbuch", "en": "puzzle book"}},
    "picture": {"trim": (8.5, 8.5), "ink": "premium", "bleed": True, "label": {"de": "Bilderbuch", "en": "picture book"}},
}

STOP = {"now": False}


def log(msg: str) -> None:
    print(f"velvet-books: {msg}", file=sys.stderr, flush=True)


def read_json(path: str, fallback):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return fallback


def write_json(path: str, data) -> None:
    """In place (the shell's FileView watches the inode), then flushed."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a+", encoding="utf-8") as fh:
        fh.seek(0)
        fh.truncate()
        fh.write(json.dumps(data, ensure_ascii=False, indent=1))
        fh.flush()
        os.fsync(fh.fileno())


def config() -> dict:
    """The studio's dials from the shell's config.json (books.*)."""
    data = read_json(CFG_PATH, {})
    out = {"author": "", "lang": "de", "kinds": ["coloring", "puzzle", "picture"], "maxWaiting": 3,
           "audience": "adults", "market": "EUR"}
    books = data.get("books") if isinstance(data, dict) else None
    if isinstance(books, dict):
        out.update({k: v for k, v in books.items() if v not in (None, "")})
        # VELLY → BOOK STUDIO: one switch per kind
        out["kinds"] = [k for k in ("coloring", "puzzle", "picture") if books.get(k, True) is not False] or ["puzzle"]
    return out


def author_name() -> str:
    return str(config().get("author") or "").strip() or "Velly Studio"


def stopping() -> bool:
    return STOP["now"]


def on_term(_sig, _frm):
    STOP["now"] = True


def documents_dir() -> str:
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "user-dirs.dirs")
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r'\s*XDG_DOCUMENTS_DIR="(.*)"', line)
                if m:
                    return m.group(1).replace("$HOME", HOME)
    except OSError:
        pass
    for name in ("Dokumente", "Documents"):
        if os.path.isdir(os.path.join(HOME, name)):
            return os.path.join(HOME, name)
    return os.path.join(HOME, "Dokumente")


def studio_dir() -> str:
    return os.path.join(documents_dir(), "Velly Bücher")


def slug(text: str, n: int = 48) -> str:
    t = re.sub(r"[^\w äöüÄÖÜß&,.!-]+", "", str(text or "")).strip(" .-")
    return (t[:n].rstrip(" ,.-") or "Buch")


def say_state(**fields) -> None:
    """What the studio does right now — the settings page and Velly read it."""
    cur = read_json(STATE_PATH, {})
    if not isinstance(cur, dict):
        cur = {}
    cur.update(fields, at=int(time.time() * 1000))
    write_json(STATE_PATH, cur)


# ───────────────────────────────────────────────────────────── KDP arithmetic
def gutter_for(pages: int) -> float:
    for top, inch in KDP["gutter"]:
        if pages <= top:
            return inch
    return KDP["gutter"][-1][1]


def spine_width(pages: int, ink: str) -> float:
    paper = "premium" if ink == "premium" else "white"
    return pages * KDP["spine"][paper]


def print_cost(pages: int, ink: str, currency: str) -> float:
    for top, fixed, per in KDP["cost"][currency]["premium" if ink == "premium" else "black"]:
        if pages <= top:
            return round(fixed + pages * per, 2)
    raise ValueError("too many pages")


def royalty(price: float, pages: int, ink: str, currency: str) -> float:
    rate = KDP["royalty"]["high"] if price >= KDP["royalty"]["from"] else KDP["royalty"]["low"]
    return round(rate * price - print_cost(pages, ink, currency), 2)


def suggest_price(pages: int, ink: str, currency: str, floor: float = 0.0) -> dict:
    """The first .99 price at or above 9.99 that leaves at least ~3 (EUR/USD) per
    copy — 60 % only starts at 9.99, and below it 50 % of a cheap book is
    almost nothing after printing."""
    cost = print_cost(pages, ink, currency)
    price = max(9.99, floor)
    while royalty(price, pages, ink, currency) < 3.0 and price < 40:
        price = math.floor(price) + 1.99 if price % 1 > 0.98 else price + 1.0
        price = round(math.floor(price) + 0.99, 2)
    return {"currency": currency, "price": price, "printing": cost, "royalty": royalty(price, pages, ink, currency),
            "rate": "60 %" if price >= KDP["royalty"]["from"] else "50 %"}


def even(n: int) -> int:
    return n + (n % 2)


# ─────────────────────────────────────────────────────────────── drawing kit
def cairo_mods():
    import cairo                                                   # noqa: PLC0415
    import gi                                                      # noqa: PLC0415
    gi.require_version("Pango", "1.0")
    gi.require_version("PangoCairo", "1.0")
    from gi.repository import Pango, PangoCairo                    # noqa: PLC0415
    return cairo, Pango, PangoCairo


class Doc:
    """One PDF: pages of one size (inches), drawn with cairo in points.
    `page()` starts a page and returns the context; text goes through Pango
    (real wrapping, kerning, embedded fonts)."""

    def __init__(self, path: str, w_in: float, h_in: float):
        self.cairo, self.Pango, self.PangoCairo = cairo_mods()
        self.w, self.h = w_in * PT, h_in * PT
        self.surface = self.cairo.PDFSurface(path, self.w, self.h)
        try:
            self.surface.set_metadata(self.cairo.PDFMetadata.CREATOR, "Velvet · velly book studio")
        except Exception:                                          # noqa: BLE001
            pass
        self.ctx = self.cairo.Context(self.surface)
        self.count = 0
        self.started = False

    def page(self):
        if self.started:
            self.ctx.show_page()
        self.started = True
        self.count += 1
        self.ctx.save()
        self.ctx.set_source_rgb(1, 1, 1)
        self.ctx.paint()
        self.ctx.restore()
        return self.ctx

    def close(self) -> int:
        if not self.started:
            self.page()
        self.surface.finish()
        return self.count

    # text
    def layout(self, text: str, font: str, size: float, width: float = 0, align: str = "left",
               spacing: float = 1.0, markup: bool = False):
        lay = self.PangoCairo.create_layout(self.ctx)
        # points are points: PangoCairo assumes 96 dpi, the PDF has 72 units an inch
        self.PangoCairo.context_set_resolution(lay.get_context(), 72)
        lay.context_changed()
        desc = self.Pango.FontDescription.from_string(f"{font} {size}")
        lay.set_font_description(desc)
        if width:
            lay.set_width(int(width * self.Pango.SCALE))
            lay.set_wrap(self.Pango.WrapMode.WORD)
        lay.set_alignment({"center": self.Pango.Alignment.CENTER, "right": self.Pango.Alignment.RIGHT}.get(
            align, self.Pango.Alignment.LEFT))
        if spacing != 1.0:
            try:
                lay.set_line_spacing(spacing)
            except Exception:                                      # noqa: BLE001
                pass
        if markup:
            lay.set_markup(text, -1)
        else:
            lay.set_text(text, -1)
        return lay

    def text(self, x: float, y: float, text: str, font: str = "Noto Sans", size: float = 12, width: float = 0,
             align: str = "left", rgb=(0, 0, 0), spacing: float = 1.0, markup: bool = False) -> float:
        """Draws and returns the height."""
        lay = self.layout(text, font, size, width, align, spacing, markup)
        self.ctx.save()
        self.ctx.set_source_rgb(*rgb)
        self.ctx.move_to(x, y)
        self.PangoCairo.show_layout(self.ctx, lay)
        self.ctx.restore()
        return lay.get_pixel_extents()[1].height

    def measure(self, text: str, font: str, size: float, width: float = 0, spacing: float = 1.0):
        lay = self.layout(text, font, size, width, "left", spacing)
        ext = lay.get_pixel_extents()[1]
        return ext.width, ext.height

    def fit(self, text: str, font: str, size: float, width: float, height: float, spacing: float = 1.0,
            least: float = 6) -> float:
        """The largest size ≤ `size` at which `text` fits the box."""
        s = size
        while s > least:
            _w, h = self.measure(text, font, s, width, spacing)
            if h <= height:
                return s
            s -= 0.5
        return least

    def image(self, path: str, x: float, y: float, w: float, h: float, cover: bool = True) -> None:
        """A picture into a box (points): a JPEG goes into the PDF as it is
        (no re-encoding, no bloat); `cover` fills the box and crops."""
        from PIL import Image                                       # noqa: PLC0415
        im = Image.open(path).convert("RGB")
        iw, ih = im.size
        scale = max(w / iw, h / ih) if cover else min(w / iw, h / ih)
        dw, dh = iw * scale, ih * scale
        ox, oy = x + (w - dw) / 2, y + (h - dh) / 2
        tmp = None
        if not path.lower().endswith((".jpg", ".jpeg")):
            tmp = tempfile.NamedTemporaryFile(suffix=".jpg", delete=False)
            im.save(tmp.name, quality=93, subsampling=0)
            jpeg = tmp.name
        else:
            jpeg = path
        data = open(jpeg, "rb").read()
        surf = self.cairo.ImageSurface(self.cairo.FORMAT_RGB24, iw, ih)
        surf.set_mime_data(self.cairo.MIME_TYPE_JPEG, data)
        self.ctx.save()
        self.ctx.rectangle(x, y, w, h)
        self.ctx.clip()
        self.ctx.translate(ox, oy)
        self.ctx.scale(scale, scale)
        self.ctx.set_source_surface(surf, 0, 0)
        self.ctx.paint()
        self.ctx.restore()
        if tmp:
            os.unlink(tmp.name)


def preview_pdf(pdf: str, out_dir: str, dpi: int = 40, first: int = 1, last: int = 0) -> list:
    """Small PNGs of the pages (pdftoppm), for the review page."""
    os.makedirs(out_dir, exist_ok=True)
    for old in glob.glob(os.path.join(out_dir, "p-*.png")):
        os.unlink(old)
    cmd = ["pdftoppm", "-png", "-r", str(dpi), "-f", str(first)] + (["-l", str(last)] if last else []) + \
          [pdf, os.path.join(out_dir, "p")]
    subprocess.run(cmd, capture_output=True, timeout=600)
    return sorted(glob.glob(os.path.join(out_dir, "p-*.png")))


# ────────────────────────────────────────────────────────────────── mandalas
class Mandala:
    """A mandala as closed shapes in rings — every shape a region to colour.
    Seeded: the same seed draws the same mandala. `bold` (children): fewer,
    bigger shapes and thicker lines."""

    MOTIFS = ("petals", "petals2", "scallops", "dots", "teardrops", "leaves", "zigzag", "lattice", "rays", "hearts")

    def __init__(self, seed: int, bold: bool = False):
        self.rng = random.Random(seed)
        self.bold = bold
        self.n = self.rng.choice([8, 10, 12, 12, 16] if not bold else [6, 8, 8, 10])
        rings, r = [], self.rng.uniform(0.07, 0.11)
        widths = (0.10, 0.17) if bold else (0.06, 0.12)
        last = None
        while r < 0.97:
            w = min(0.97 - r, self.rng.uniform(*widths))
            if w < 0.035:
                break
            motif = self.rng.choice([m for m in self.MOTIFS if m != last])
            last = motif
            mult = self.rng.choice([1, 1, 2]) if motif in ("dots", "scallops", "zigzag", "rays") else 1
            rings.append({"r0": r, "r1": r + w, "motif": motif, "k": self.n * mult, "border": self.rng.random() < 0.88,
                          "phase": self.rng.choice([0.0, 0.5])})
            r += w
        self.rings = rings
        self.core = self.rng.choice(["flower", "circle", "star"])
        self.line = 3.2 if bold else 1.7

    # every shape as a path builder: fn(ctx, cx, cy, R)
    def shapes(self):
        out = []
        r0c = self.rings[0]["r0"] if self.rings else 0.1
        out.append(("core", -1, self._core(r0c)))
        for i, ring in enumerate(self.rings):
            for s in self._ring(ring):
                motif, build = s if isinstance(s, tuple) else (ring["motif"], s)
                out.append((motif, i, build))
        return out

    def _core(self, r):
        kind = self.core
        n = self.n

        def draw(ctx, cx, cy, R):
            rr = r * R
            if kind == "circle":
                ctx.new_sub_path()
                ctx.arc(cx, cy, rr * 0.95, 0, 2 * math.pi)
                ctx.close_path()
                ctx.new_sub_path()
                ctx.arc(cx, cy, rr * 0.45, 0, 2 * math.pi)
                ctx.close_path()
            elif kind == "star":
                pts = []
                for j in range(n * 2):
                    a = j * math.pi / n - math.pi / 2
                    rad = rr * (0.95 if j % 2 == 0 else 0.45)
                    pts.append((cx + rad * math.cos(a), cy + rad * math.sin(a)))
                ctx.move_to(*pts[0])
                for p in pts[1:]:
                    ctx.line_to(*p)
                ctx.close_path()
            else:
                for j in range(n):
                    a = j * 2 * math.pi / n
                    petal(ctx, cx, cy, 0.0, rr * 0.95, a, math.pi / n * 0.95)
        return draw

    def _ring(self, ring):
        r0, r1, k, motif, ph = ring["r0"], ring["r1"], ring["k"], ring["motif"], ring["phase"]
        step = 2 * math.pi / k
        shapes = []
        if ring["border"]:
            # a boundary, not a region: drawn, never filled
            shapes.append(("border", lambda ctx, cx, cy, R, r=r1: circle(ctx, cx, cy, r * R)))
        for j in range(k):
            a = (j + ph) * step
            if motif == "petals":
                shapes.append(lambda ctx, cx, cy, R, a=a: petal(ctx, cx, cy, r0 * R, r1 * R, a, step * 0.48))
            elif motif == "petals2":
                shapes.append(lambda ctx, cx, cy, R, a=a: petal(ctx, cx, cy, r0 * R, r1 * R, a, step * 0.5))
                shapes.append(lambda ctx, cx, cy, R, a=a: petal(ctx, cx, cy, r0 * R, (r0 + (r1 - r0) * 0.62) * R,
                                                                a, step * 0.25))
            elif motif == "scallops":
                shapes.append(lambda ctx, cx, cy, R, a=a: scallop(ctx, cx, cy, r0 * R, r1 * R, a, step))
            elif motif == "dots":
                rad = min((r1 - r0) * 0.38, math.sin(step / 2) * (r0 + r1) / 2 * 0.8)
                shapes.append(lambda ctx, cx, cy, R, a=a, rad=rad: circle(
                    ctx, cx + (r0 + r1) / 2 * R * math.cos(a), cy + (r0 + r1) / 2 * R * math.sin(a), rad * R))
            elif motif == "teardrops":
                shapes.append(lambda ctx, cx, cy, R, a=a: teardrop(ctx, cx, cy, r0 * R, r1 * R, a, step * 0.42))
            elif motif == "leaves":
                shapes.append(lambda ctx, cx, cy, R, a=a: leaf(ctx, cx, cy, r0 * R, r1 * R, a, step * 0.55))
            elif motif == "zigzag":
                shapes.append(lambda ctx, cx, cy, R, a=a: tooth(ctx, cx, cy, r0 * R, r1 * R, a, step))
            elif motif == "lattice":
                shapes.append(lambda ctx, cx, cy, R, a=a: lattice_cell(ctx, cx, cy, r0 * R, r1 * R, a, step))
            elif motif == "rays":
                shapes.append(lambda ctx, cx, cy, R, a=a: ray(ctx, cx, cy, r0 * R, r1 * R, a))
            elif motif == "hearts":
                shapes.append(lambda ctx, cx, cy, R, a=a: heart(ctx, cx, cy, r0 * R, r1 * R, a, step * 0.42))
        return shapes

    def draw(self, ctx, cx: float, cy: float, R: float, fills=None, line_rgb=(0, 0, 0)) -> None:
        """Outlines only (a page to colour), or with `fills` — a palette —
        coloured in (the cover)."""
        ctx.save()
        ctx.set_line_join(1)          # round
        ctx.set_line_cap(1)
        ctx.set_fill_rule(1)          # even-odd: a dot inside a drop stays a hole
        if fills:
            # ring grounds first, outermost first, then every shape filled
            for i in range(len(self.rings) - 1, -1, -1):
                ctx.new_path()
                circle(ctx, cx, cy, self.rings[i]["r1"] * R)
                ctx.set_source_rgb(*fills[(i * 2 + 1) % len(fills)])
                ctx.fill()
        for motif, ring, build in self.shapes():
            ctx.new_path()
            build(ctx, cx, cy, R)
            if fills and motif not in ("rays", "border"):
                ctx.set_source_rgb(*fills[(ring + 2) % len(fills)])
                ctx.fill_preserve()
            ctx.set_source_rgb(*line_rgb)
            ctx.set_line_width(self.line * (1.0 if motif != "rays" else 0.8))
            ctx.stroke()
        ctx.restore()


def circle(ctx, cx, cy, r):
    ctx.new_sub_path()
    ctx.arc(cx, cy, r, 0, 2 * math.pi)
    ctx.close_path()


def polar(cx, cy, r, a):
    return cx + r * math.cos(a), cy + r * math.sin(a)


def petal(ctx, cx, cy, r0, r1, a, half):
    """An almond from r0 to r1 around angle a, `half` its half-width (rad)."""
    base = polar(cx, cy, r0, a)
    tip = polar(cx, cy, r1, a)
    near = r0 + (r1 - r0) * 0.15
    mid = r0 + (r1 - r0) * 0.55
    ctx.new_sub_path()
    ctx.move_to(*base)
    ctx.curve_to(*polar(cx, cy, near, a - half * 0.9), *polar(cx, cy, mid, a - half), *tip)
    ctx.curve_to(*polar(cx, cy, mid, a + half), *polar(cx, cy, near, a + half * 0.9), *base)
    ctx.close_path()


def frame(ctx, cx, cy, r, a):
    """A local frame at radius r, angle a: x along the ring, y outward.
    (The path keeps device coordinates, so save/restore around a shape is safe.)"""
    ctx.save()
    ctx.translate(*polar(cx, cy, r, a))
    ctx.rotate(a - math.pi / 2)


def teardrop(ctx, cx, cy, r0, r1, a, half):
    """Round at the inside, pointed outward, a dot in the round end."""
    rm = (r0 + r1) / 2
    h = (r1 - r0) * 0.9
    w = min(h * 0.74, 2 * rm * math.sin(half))
    yc = -h / 2 + w / 2
    frame(ctx, cx, cy, rm, a)
    ctx.new_sub_path()
    ctx.move_to(0, h / 2)
    ctx.curve_to(w * 0.15, h * 0.2, w / 2, yc + w * 0.4, w / 2, yc)
    ctx.arc_negative(0, yc, w / 2, 0, math.pi)
    ctx.curve_to(-w / 2, yc + w * 0.4, -w * 0.15, h * 0.2, 0, h / 2)
    ctx.close_path()
    ctx.new_sub_path()
    ctx.arc(0, yc, w * 0.17, 0, 2 * math.pi)
    ctx.close_path()
    ctx.restore()


def leaf(ctx, cx, cy, r0, r1, a, half):
    petal(ctx, cx, cy, r0, r1, a, half)
    ctx.move_to(*polar(cx, cy, r0 + (r1 - r0) * 0.08, a))
    ctx.line_to(*polar(cx, cy, r1 - (r1 - r0) * 0.12, a))


def scallop(ctx, cx, cy, r0, r1, a, step):
    """An arch from r0 bulging to r1 across one step."""
    p0 = polar(cx, cy, r0, a)
    p1 = polar(cx, cy, r0, a + step)
    ctx.move_to(*p0)
    ctx.curve_to(*polar(cx, cy, r1 * 1.02, a + step * 0.05), *polar(cx, cy, r1 * 1.02, a + step * 0.95), *p1)
    ctx.arc_negative(cx, cy, r0, a + step, a)
    ctx.close_path()


def tooth(ctx, cx, cy, r0, r1, a, step):
    """One tooth of a zigzag band: its own region (a closed zigzag would
    be one region over the whole middle)."""
    ctx.new_sub_path()
    ctx.move_to(*polar(cx, cy, r0, a))
    ctx.line_to(*polar(cx, cy, r1, a + step / 2))
    ctx.line_to(*polar(cx, cy, r0, a + step))
    ctx.arc_negative(cx, cy, r0, a + step, a)
    ctx.close_path()


def lattice_cell(ctx, cx, cy, r0, r1, a, step):
    """A diamond spanning the ring."""
    ctx.move_to(*polar(cx, cy, r0, a))
    ctx.line_to(*polar(cx, cy, (r0 + r1) / 2, a + step / 2))
    ctx.line_to(*polar(cx, cy, r1, a))
    ctx.line_to(*polar(cx, cy, (r0 + r1) / 2, a - step / 2))
    ctx.close_path()


def ray(ctx, cx, cy, r0, r1, a):
    ctx.move_to(*polar(cx, cy, r0, a))
    ctx.line_to(*polar(cx, cy, r1, a))


def heart(ctx, cx, cy, r0, r1, a, half):
    """A heart with its tip to the centre."""
    rm = (r0 + r1) / 2
    h = (r1 - r0) * 0.86
    w = min(h * 1.05, 2 * rm * math.sin(half))
    frame(ctx, cx, cy, rm, a)
    ctx.new_sub_path()
    ctx.move_to(0, -h / 2)
    ctx.curve_to(-w * 0.1, -h * 0.3, -w / 2, -h * 0.05, -w / 2, h * 0.18)
    ctx.curve_to(-w / 2, h * 0.42, -w * 0.22, h / 2, 0, h * 0.28)
    ctx.curve_to(w * 0.22, h / 2, w / 2, h * 0.42, w / 2, h * 0.18)
    ctx.curve_to(w / 2, -h * 0.05, w * 0.1, -h * 0.3, 0, -h / 2)
    ctx.close_path()
    ctx.restore()


