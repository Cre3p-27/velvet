    [(0.62, 0.82, 0.95), (0.33, 0.55, 0.85), (0.20, 0.27, 0.55), (0.95, 0.78, 0.38), (0.98, 0.93, 0.80), (0.86, 0.45, 0.47)],
]


# ─────────────────────────────────────────────────────────────────── sudoku
def sudoku_solutions(grid: list, limit: int = 2) -> int:
    """How many solutions (stops at `limit`). Bitmask backtracking, the cell
    with the fewest candidates first."""
    rows = [0] * 9
    cols = [0] * 9
    boxes = [0] * 9
    empty = []
    for i, v in enumerate(grid):
        r, c = divmod(i, 9)
        if v:
            bit = 1 << v
            if rows[r] & bit or cols[c] & bit or boxes[(r // 3) * 3 + c // 3] & bit:
                return 0
            rows[r] |= bit
            cols[c] |= bit
            boxes[(r // 3) * 3 + c // 3] |= bit
        else:
            empty.append(i)
    count = [0]

    def walk():
        if count[0] >= limit:
            return
        best, best_mask, best_n = -1, 0, 10
        for i in empty:
            if grid[i]:
                continue
            r, c = divmod(i, 9)
            mask = ~(rows[r] | cols[c] | boxes[(r // 3) * 3 + c // 3]) & 0x3FE
            n = bin(mask).count("1")
            if n < best_n:
                best, best_mask, best_n = i, mask, n
                if n <= 1:
                    break
        if best < 0:
            count[0] += 1
            return
        if best_n == 0:
            return
        r, c = divmod(best, 9)
        b = (r // 3) * 3 + c // 3
        for v in range(1, 10):
            bit = 1 << v
            if best_mask & bit:
                grid[best] = v
                rows[r] |= bit
                cols[c] |= bit
                boxes[b] |= bit
                walk()
                rows[r] &= ~bit
                cols[c] &= ~bit
                boxes[b] &= ~bit
                grid[best] = 0
                if count[0] >= limit:
                    return

    walk()
    return count[0]


def sudoku_full(rng: random.Random) -> list:
    grid = [0] * 81

    def fill(i=0):
        if i == 81:
            return True
        r, c = divmod(i, 9)
        vals = list(range(1, 10))
        rng.shuffle(vals)
        for v in vals:
            if all(grid[r * 9 + x] != v for x in range(9)) and all(grid[x * 9 + c] != v for x in range(9)):
                br, bc = (r // 3) * 3, (c // 3) * 3
                if all(grid[(br + y) * 9 + bc + x] != v for y in range(3) for x in range(3)):
                    grid[i] = v
                    if fill(i + 1):
                        return True
                    grid[i] = 0
        return False

    fill()
    return grid


def singles_solve(grid: list) -> bool:
    """Solvable with naked and hidden singles alone — the easy and medium
    puzzles must be (no guessing)."""
    g = list(grid)
    units = [[r * 9 + c for c in range(9)] for r in range(9)] + [[r * 9 + c for r in range(9)] for c in range(9)] + \
            [[(br + y) * 9 + bc + x for y in range(3) for x in range(3)] for br in (0, 3, 6) for bc in (0, 3, 6)]
    peers = [set() for _ in range(81)]
    for u in units:
        for i in u:
            peers[i].update(u)
    for i in range(81):
        peers[i].discard(i)
    progress = True
    while progress:
        progress = False
        cand = {}
        for i in range(81):
            if not g[i]:
                cand[i] = set(range(1, 10)) - {g[p] for p in peers[i]}
                if not cand[i]:
                    return False
        if not cand:
            return True
        for i, cs in cand.items():
            if len(cs) == 1:
                g[i] = cs.pop()
                progress = True
        if progress:
            continue
        for u in units:
            for v in range(1, 10):
                spots = [i for i in u if not g[i] and v in cand.get(i, ())]
                if len(spots) == 1 and v not in {g[i] for i in u}:
                    g[spots[0]] = v
                    progress = True
    return all(g)


def sudoku_make(seed: int, level: str) -> dict:
    """{level, puzzle, solution}: unique solution, rotationally symmetric
    givens; leicht/mittel solvable without guessing."""
    rng = random.Random(seed)
    target = {"leicht": 38, "mittel": 31, "schwer": 26}.get(level, 31)
    for _attempt in range(20):
        solution = sudoku_full(rng)
        puzzle = list(solution)
        cells = list(range(41))
        rng.shuffle(cells)
        givens = 81
        for i in cells:
            if givens <= target:
                break
            j = 80 - i
            keep = (puzzle[i], puzzle[j])
            puzzle[i] = puzzle[j] = 0
            if sudoku_solutions(list(puzzle)) != 1 or (level != "schwer" and not singles_solve(puzzle)):
                puzzle[i], puzzle[j] = keep
                continue
            givens -= 2 if i != j else 1
        if givens <= target + 4 and (level != "schwer" or not singles_solve(puzzle)):
            return {"level": level, "puzzle": puzzle, "solution": solution, "givens": givens}
    return {"level": level, "puzzle": puzzle, "solution": solution, "givens": givens}


