.sub{{color:var(--soft);margin:0 0 22px}} .top{{display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start}}
.top img{{width:300px;max-width:100%;border-radius:6px;box-shadow:0 8px 30px #0003}}
.facts{{flex:1;min-width:260px}} .facts b{{display:inline-block;min-width:150px}}
h2{{margin:34px 0 12px;font-size:19px}} .f{{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin:8px 0;display:grid;grid-template-columns:170px 1fr auto;gap:12px;align-items:start}}
.k{{color:var(--soft);font-size:13px;padding-top:3px}} pre{{margin:0;white-space:pre-wrap;font:14px/1.45 ui-monospace,monospace;max-height:220px;overflow:auto}}
