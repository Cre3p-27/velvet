</main><script>
function cp(id,b){{const t=document.getElementById(id).innerText;navigator.clipboard.writeText(t).then(()=>{{b.textContent='Kopiert';setTimeout(()=>b.textContent='Kopieren',1400)}})}}
</script></body></html>"""
    with open(book_path(book, "review.html"), "w", encoding="utf-8") as fh:
        fh.write(page)
    age = f" · Alter: {L.get('age')}" if L.get("age") else ""
    printing = ("Premium-Farbe · weißes Papier · 8.5 × 8.5 in · Anschnitt: JA · Cover: matt" if book["ink"] == "premium"
