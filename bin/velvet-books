figure img{{width:100%;display:block;border-radius:4px}} figcaption{{color:var(--soft);font-size:12px}}
@media (max-width:640px){{.f{{grid-template-columns:1fr}}}}
</style></head><body><main>
<h1>{html.escape(book['title'])}</h1><p class="sub">{html.escape(book.get('subtitle', ''))}</p>
<div class="top"><img src="cover-front.jpg" alt="Cover"><div class="facts">
<p><b>Art</b>{html.escape(KINDS[book['kind']]['label']['de'])} · {book['pages']} Seiten · {html.escape(trim_words(book))}</p>
<p><b>Druck</b>{'Premium-Farbe, Anschnitt' if book['ink'] == 'premium' else 'Schwarzweiß, ohne Anschnitt'}</p>
<p><b>Cover-PDF</b>{g.get('w_in', '?')} × {g.get('h_in', '?')} in (Rücken {g.get('spine_in', '?')} in)</p>
<p><b>Preis-Vorschlag</b>{money(price['price'], 'EUR')} → Druck {money(price['printing'], 'EUR')}, Tantieme ~{money(price['royalty'], 'EUR')} je Buch</p>
<p><b>Dateien</b>interior.pdf · cover.pdf · listing.txt · CHECKLIST.md</p>
